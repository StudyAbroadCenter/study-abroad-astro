---
import '../styles/international-learning-impact.css';

interface Props {
  context?: 'site' | 'rwjp';
}

const { context = 'site' } = Astro.props;
const isRwjp = context === 'rwjp';

const copy = isRwjp
  ? {
      kicker: '受入から 共に学ぶ国際教育へ',
      title: '留学生を迎える\nキャンパスの学びがひらく',
      lead: 'RWJPは、海外から来る学生だけの学びではありません。立命館の学生と出会い、共に活動する機会を、キャンパスの国際教育へつなげます。',
      note: '海外へ行くだけが国際経験ではない。キャンパスにも、異なる言語・文化・価値観と出会う入口があります。',
    }
  : {
      kicker: 'キャンパスで育てる国際教育',
      title: '世界から迎える\nキャンパスで共に学ぶ',
      lead: '短期受入は、参加する留学生だけの学びではありません。立命館の学生にも、異なる言語・文化・考え方と出会い、共に学ぶ機会を生み出します。',
      note: '国際教育を、海外へ行く学生だけの経験にしない。受入を、キャンパスの国際化へつなげます。',
    };

const impacts = [
  {
    number: '01',
    eyebrow: '共に学ぶ',
    title: '会うだけでなく 共に学ぶ',
    body: '話す。一緒に考える。活動する。交流を、双方の学生の学びへつなげます。',
  },
  {
    number: '02',
    eyebrow: 'キャンパスで国際交流',
    title: 'キャンパスにも 国際交流を',
    body: '海外へ行かなくても、多文化・多言語に触れられる機会をキャンパスに増やします。',
  },
  {
    number: '03',
    eyebrow: 'ことばを使う自信',
    title: '外国語を つながる道具へ',
    body: '完璧でなくても、まず伝えてみる。人と話す経験が、外国語との距離を縮めます。',
  },
  {
    number: '04',
    eyebrow: '異文化を理解する',
    title: '違いを知り 一緒に学ぶ',
    body: '価値観や習慣の違いを、実際の関わりから知る。多文化共生を日常へ近づけます。',
  },
];
---
<section id={isRwjp ? 'rwjp-international-learning' : 'international-learning'} class={`international-impact international-impact--${context}`} aria-labelledby={`international-impact-title-${context}`}>
  <div class="site-shell international-impact__intro">
    <div>
      <p class="international-impact__kicker">{copy.kicker}</p>
      <h2 id={`international-impact-title-${context}`}>
        {copy.title.split('\n').map((line) => <span class="international-impact__title-line">{line}</span>)}
      </h2>
    </div>
    <div class="international-impact__lead">
      <p>{copy.lead}</p>
      <p class="international-impact__note">{copy.note}</p>
    </div>
  </div>

  <div class="site-shell international-impact__grid">
    {impacts.map((impact) => (
      <article class="international-impact__card">
        <header>
          <span>{impact.number}</span>
          <p>{impact.eyebrow}</p>
        </header>
        <h3>{impact.title.split(' ').map((phrase) => <span class="international-impact__phrase">{phrase}</span>)}</h3>
        <p>{impact.body}</p>
      </article>
    ))}
  </div>

  <div class="site-shell international-impact__outro">
    <p class="international-impact__outro-label">一方向ではない国際教育へ</p>
    <p class="international-impact__outro-copy">受入学生が学ぶ。立命館の学生も学ぶ。短期受入を、一方向ではない国際教育へ。</p>
  </div>
</section>
