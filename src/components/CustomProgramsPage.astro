---
import { customProgramPartners, customProgramVisuals } from '../data/custom-programs-shared';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const imageUrl = (path: string) => `${base}images/${path.replace(/^\//, '')}`;
const contactHref = `${base}contact/`;

const pillars = [
  { key: 'LEARN', title: '日本語と専門分野を学ぶ', text: '短期集中型の日本語学習に加え、国際関係、経営学、データサイエンス、ポップカルチャー等の専門講義を英語で組み込むことができます。' },
  { key: 'CONNECT', title: '立命館の学生と学ぶ', text: 'ゼミ、Buddy、学生団体、クラブ活動等との交流を、単なる交流行事ではなく、学生同士が一緒に学ぶ機会として設計します。' },
  { key: 'EXPERIENCE', title: '京都・大阪を教室にする', text: '企業訪問、日本文化体験、地域学習、フィールドワークを、貴学の教育目的と結びつけてプログラムに組み込みます。' },
  { key: 'DESIGN', title: '貴学の目的に合わせて組み直す', text: '過去の実施例をそのまま提供するのではなく、期間、人数、学生層、専門分野、希望内容に応じて再構成します。' },
];

const programmeExamples = [
  {
    id: 'oklahoma', label: 'Oklahoma', university: 'University of Oklahoma', status: '2026 実施例', dates: '2026年5月18日〜6月5日', focus: 'Business × Company Visits × Buddy',
    intro: 'ビジネスを学ぶ授業に、企業等へのフィールド訪問、日本文化体験、Buddyとの交流を組み合わせた例です。',
    days: [
      { day: 'START', type: 'support', title: 'Orientation & Campus Tour', note: '初日に学習・生活のオリエンテーション。キャンパス利用や滞在中のサポートにつなげます。' },
      { day: 'WEEK 1', type: 'academic', title: 'Business Study', note: '大学側の教育目的に応じた授業を軸に構成。専門テーマは相談により調整します。' },
      { day: 'WEEK 1', type: 'connect', title: 'Buddy Learning', note: 'Buddyは生活支援だけでなく、授業参加や昼食交流など学びの一部として組み込めます。' },
      { day: 'WEEK 2', type: 'field', title: 'Company / Field Visit', note: '企業訪問等を学習テーマと接続。訪問先は時期・受入状況により調整が必要です。' },
      { day: 'WEEK 2', type: 'culture', title: 'Japanese Cultural Activity', note: '文化体験は目的と日程に応じて選択。別の文化体験への変更も相談できます。' },
      { day: 'FINAL', type: 'support', title: 'Completion Ceremony', note: '最終日に学びを振り返り、修了証書を授与する構成も可能です。' },
    ],
  },
  {
    id: 'rutgers', label: 'Rutgers', university: 'Rutgers University', status: '2026 実施例', dates: '2026年6月15日〜7月6日', focus: 'Politics & Peace Studies × Field Learning',
    intro: '政治・平和学を中心に、立命館による専門講義、日本語学習、広島でのフィールド学習を組み合わせた例です。',
    days: [
      { day: 'START', type: 'support', title: 'Orientation & Campus Tour', note: '受入初日に大学・キャンパス環境を理解し、プログラム全体の目的を共有します。' },
      { day: 'WEEK 1', type: 'academic', title: 'Specialized Lectures in English', note: '国際関係・政治・平和学など、専門講義は英語で実施できます。テーマは学内調整の上で検討します。' },
      { day: 'WEEK 1', type: 'academic', title: 'Optional Japanese', note: '専門学習に加えて、日本語授業を短時間組み込む構成も可能です。' },
      { day: 'WEEK 2', type: 'connect', title: 'Seminar / Student Exchange', note: 'ゼミ交流など、日本人学生との共修を専門テーマに接続して設計できます。' },
      { day: 'FIELD', type: 'field', title: 'Hiroshima Field Trip', note: '教室での学びを現地で深めるフィールド学習。訪問地・日数は教育目的に応じて検討します。' },
      { day: 'FINAL', type: 'support', title: 'Completion', note: '修了証書を授与し、大学の学習プログラムとして完結させます。' },
    ],
  },
  {
    id: 'jmu', label: 'JMU', university: 'James Madison University', status: '2026 実施例', dates: '2026年5月25日〜6月12日', focus: 'Japanese Language × Kyoto × Buddy',
    intro: '日本語学習を中心に、京都でのフィールドワーク、歴史回廊ガイド、Buddyとの交流を組み合わせた例です。',
    days: [
      { day: 'START', type: 'support', title: 'Orientation', note: '初日に学習と生活の導入を行い、短期間でも安心して日本で学べる環境を整えます。' },
      { day: 'WEEK 1', type: 'academic', title: 'Japanese Language', note: '日本語授業は参加人数・レベル・目的に応じて構成を調整できます。' },
      { day: 'WEEK 1', type: 'connect', title: 'Lunch with Buddies', note: 'Buddyとの昼食や交流を通じて、日本語を教室外で使う機会をつくります。' },
      { day: 'WEEK 2', type: 'field', title: 'Kyoto Historic Corridor', note: '歴史回廊ガイド等、学生団体・地域学習と連携した体験も組み込めます。' },
      { day: 'WEEK 2', type: 'academic', title: 'Presentation', note: 'プレゼンテーションや成果発表を入れ、体験で終わらず学びとして残す構成も可能です。' },
      { day: 'FINAL', type: 'support', title: 'Completion Ceremony', note: '最終日に修了式を行い、修了証書を授与します。' },
    ],
  },
  {
    id: 'cwru', label: 'CWRU', university: 'Case Western Reserve University', status: '2026 実施例', dates: '2026年5月19日〜5月29日', focus: 'Japanese Culture × Buddy × Faculty-led',
    intro: '日本文化をテーマに、先方大学教員による授業、文化体験、立命館Buddyとの交流を組み合わせた例です。',
    days: [
      { day: 'START', type: 'support', title: 'Orientation & Campus Tour', note: '短期間でも大学生活に入りやすいよう、到着後の導入を設けます。' },
      { day: 'WEEK 1', type: 'academic', title: 'Faculty-led Classes', note: '先方大学の教員による授業と、立命館側の活動を組み合わせるFaculty-led型にも対応できます。' },
      { day: 'WEEK 1', type: 'culture', title: 'Japanese Cultural Study', note: '文化体験は授業テーマとの接続を意識して組み込みます。' },
      { day: 'WEEK 2', type: 'connect', title: 'Buddy Activities', note: 'Buddyとの散策や共修など、学生同士の直接交流を学習体験にできます。' },
      { day: 'WEEK 2', type: 'field', title: 'Kyoto Learning', note: '京都の文化資源をフィールドとして活用。訪問先は目的・季節・混雑状況等を踏まえて検討します。' },
      { day: 'FINAL', type: 'support', title: 'Completion Certificate', note: '最終日に修了証書を授与する構成が可能です。' },
    ],
  },
  {
    id: 'cityuhk', label: 'CityUHK', university: 'City University of Hong Kong', status: '2026 設計例', dates: '4週間型として設計', focus: 'Academic Coursework × Campus Life × Transcript',
    intro: '4週間のStudy Tourとして、大学科目、課題・レポート、キャンパス利用、修了証書・成績関連手続きを含めて設計した例です。',
    days: [
      { day: 'WEEK 1', type: 'support', title: 'Arrival & Academic Setup', note: '登録、学内ID、オリエンテーション等を含む受入設計。具体的な手順は案件ごとに調整します。' },
      { day: 'WEEK 1', type: 'academic', title: 'Academic Coursework', note: '大学教育として課題・レポート等を伴う構成も相談できます。' },
      { day: 'WEEK 2', type: 'academic', title: 'Specialized Learning', note: '専門内容は英語での実施を基本に、テーマと担当可能性を学内で調整します。' },
      { day: 'WEEK 3', type: 'connect', title: 'Campus Experience', note: '図書館・キャンパス施設等を利用し、大学で学ぶ体験として設計します。' },
      { day: 'WEEK 4', type: 'field', title: 'Applied / Field Learning', note: '教室外の学びを組み合わせる場合、訪問先・内容・移動を含めて実現可能性を確認します。' },
      { day: 'FINAL', type: 'support', title: 'Certificate / Academic Record', note: '案件の設計に応じて、修了証書や成績関連の手続きを組み込むことがあります。' },
    ],
  },
];

const flexible = ['日本語授業の時間数・レベル','英語による専門講義のテーマ','講義・交流・体験の比率','日本文化体験の内容','Buddy・ゼミ・学生団体との交流形式','企業・地域訪問の有無','期間と1日の学習構成'];
const coordination = ['特定企業・特定教員の指定','受入先の繁忙期・学年暦に左右される活動','短い準備期間での大規模な新規手配','15名未満の新規案件','極端に過密な行程','すべての希望内容を同時に実施する構成','宿泊・施設の空き状況に左右される手配'];

const galleryCopy = {
  learn: { label: 'LEARN', title: '日本語・専門学習', text: '授業をプログラムの軸に置きます。専門講義は英語で実施できます。' },
  connect: { label: 'CONNECT', title: '学生との共修', text: 'Buddy、ゼミ、学生団体など、立命館の学生と直接学ぶ場をつくります。' },
  output: { label: 'OUTPUT', title: '成果を残す', text: 'プレゼンテーションや振り返りを入れ、体験を学習成果へつなげます。' },
  culture: { label: 'CULTURE', title: '日本文化体験', text: '文化体験を単独イベントにせず、テーマや授業と接続して設計します。' },
  field: { label: 'FIELD', title: '京都・大阪で学ぶ', text: 'キャンパスの外も学びの場として、地域・文化・企業等との接点をつくります。' },
  specialist: { label: 'SPECIALIST', title: '専門テーマ', text: '経営、国際関係、データサイエンス、ポップカルチャー等、目的に応じて検討します。' },
  buddy: { label: 'BUDDY', title: 'Buddyとの交流', text: '学生同士の距離を縮め、日本で学ぶ実感をつくる交流機会を組み込みます。' },
  orientation: { label: 'SUPPORT', title: '始まりから修了まで', text: 'オリエンテーション、日々の支援、修了式まで、一連の受入体験として設計します。' },
} as const;

const gallery = customProgramVisuals.gallery.map((slot) => ({ ...slot, ...galleryCopy[slot.role] }));
const valueImages = [customProgramVisuals.gallery[0].image, customProgramVisuals.gallery[1].image, customProgramVisuals.gallery[4].image];
---

<article class="custom-programs-page">
  <section class="cp-hero" aria-labelledby="cp-title">
    <img class="cp-hero__image" src={imageUrl(customProgramVisuals.hero)} alt="立命館大学で学ぶ学生たちのイメージ" width="1600" height="1067" />
    <div class="cp-hero__veil"></div>
    <div class="cp-shell cp-hero__inner">
      <p class="cp-eyebrow">CUSTOM PROGRAMS FOR UNIVERSITIES</p>
      <h1 id="cp-title"><span>大学ごとに、</span><span>立命館ならではの</span><span>日本での学びを。</span></h1>
      <p class="cp-hero__lead">日本語学習、英語による専門講義、学生との共修、企業・地域での学び、日本文化体験。立命館の教育資源を組み合わせ、貴学の教育目的に応じた短期プログラムを一緒に設計します。</p>
      <div class="cp-hero__actions"><a class="cp-button cp-button--primary" href="#programme-examples">実例を見る</a><a class="cp-button cp-button--ghost" href={contactHref}>オンラインミーティングを相談する</a></div>
      <dl class="cp-hero__facts"><div><dt>GROUP SIZE</dt><dd>新規相談の目安 15名〜</dd></div><div><dt>DURATION</dt><dd>約2週間の実施例が中心</dd></div><div><dt>CAMPUS</dt><dd>衣笠 / OICを中心に検討</dd></div><div><dt>SUPPORT</dt><dd>バイリンガル対応</dd></div></dl>
    </div>
  </section>

  <section class="cp-purpose">
    <img class="cp-purpose__bg" src={imageUrl(customProgramVisuals.whyRitsumeikan)} alt="立命館の学生と留学生が共に学ぶイメージ" loading="lazy" decoding="async" />
    <div class="cp-purpose__veil"></div>
    <div class="cp-shell cp-purpose__content">
      <p class="cp-section-label">WHY RITSUMEIKAN</p>
      <h2><span>授業だけでも、観光だけでもない。</span><span><strong>大学教育として、日本での時間をつくる。</strong></span></h2>
      <div class="cp-purpose__copy"><p>立命館の教員、学生、ゼミ、学生団体、キャンパス、そして京都・大阪という学びの環境を一つにつなぎます。</p><p>「既存のプログラムを選ぶ」のではなく、<strong>貴学のカリキュラムに、日本での学びを組み込む</strong>という発想から始めます。</p></div>
    </div>
  </section>

  <section class="cp-pillars"><div class="cp-shell"><div class="cp-section-heading"><p class="cp-section-label">WHAT WE CAN BUILD TOGETHER</p><h2>立命館だから組み合わせられる、4つの学び</h2></div><div class="cp-pillar-grid">{pillars.map((pillar,index)=><article class="cp-pillar"><span class="cp-pillar__number">0{index+1}</span><small>{pillar.key}</small><h3>{pillar.title}</h3><p>{pillar.text}</p></article>)}</div></div></section>

  <section class="cp-value"><div class="cp-shell"><div class="cp-section-heading cp-section-heading--light"><p class="cp-section-label">VALUE FOR YOUR UNIVERSITY</p><h2>学生・大学・担当者。<br />それぞれに意味のあるプログラムへ。</h2></div><div class="cp-value__grid">
    <article><img src={imageUrl(valueImages[0])} alt="日本語・専門学習のイメージ" loading="lazy" /><div><span>FOR STUDENTS</span><h3>日本留学への第一歩に</h3><p>短期間、英語による専門学習、バイリンガル対応を組み合わせ、長期留学より参加しやすい入口をつくります。</p></div></article>
    <article><img src={imageUrl(valueImages[1])} alt="学生交流のイメージ" loading="lazy" /><div><span>FOR UNIVERSITIES</span><h3>国際教育の見える特色に</h3><p>貴学の専門分野や教育方針と日本での学びを接続し、特色あるFaculty-led / Short-term Study Abroadの形をつくります。</p></div></article>
    <article><img src={imageUrl(valueImages[2])} alt="フィールド学習のイメージ" loading="lazy" /><div><span>FOR COORDINATORS</span><h3>実施しやすく、育てやすく</h3><p>現地での受入・調整を支援し、初年度の実施をもとに翌年度以降の改善・定番化につなげることができます。</p></div></article>
  </div></div></section>

  <section class="cp-partners" aria-labelledby="cp-partners-title"><div class="cp-shell"><div class="cp-wide-heading"><p class="cp-section-label">PAST CUSTOM PROGRAM PARTNERS</p><h2 id="cp-partners-title">世界の大学と、<br />それぞれ違うプログラムをつくってきました。</h2><p>以下は過去の実施大学・機関例です。各大学の教育目的や学生層に応じて、内容・期間・学習テーマは異なります。</p></div><div class="cp-partner-list">{customProgramPartners.map((partner,index)=><div><span class="cp-partner-index">{String(index+1).padStart(2,'0')}</span><span class="cp-partner-flag" aria-label={partner.countryCode}>{partner.flag}</span><strong>{partner.name}</strong></div>)}</div></div></section>

  <section class="cp-examples" id="programme-examples" aria-labelledby="cp-examples-title"><div class="cp-shell"><div class="cp-wide-heading"><p class="cp-section-label">REAL PROGRAMME EXAMPLES</p><h2 id="cp-examples-title">実際のプログラムから見る、<br />日本での学びの組み立て方。</h2><p>2026年の実施記録・設計記録から代表的な構成を抜粋しています。個別契約の費用や内部運用情報は掲載せず、教育内容と調整の考え方が伝わる形に整理しています。</p></div>
    <div class="cp-example-tabs" role="tablist" aria-label="大学別プログラム例">{programmeExamples.map((example,index)=><button type="button" role="tab" aria-selected={index===0?'true':'false'} aria-controls={`example-${example.id}`} data-example-tab={example.id} class:list={['cp-example-tab',{'is-active':index===0}]}><strong>{example.label}</strong><small>{example.status}</small></button>)}</div>
    <div class="cp-example-panels">{programmeExamples.map((example,index)=><section id={`example-${example.id}`} role="tabpanel" data-example-panel={example.id} class="cp-example-panel" hidden={index!==0}><header class="cp-example-panel__header"><div><p>{example.status}</p><h3>{example.university}</h3><span>{example.dates}</span></div><div><strong>{example.focus}</strong><p>{example.intro}</p></div></header><div class="cp-schedule" aria-label={`${example.university}の代表的なプログラム構成`}>{example.days.map((item)=><article class={`cp-schedule__item cp-schedule__item--${item.type}`}><span class="cp-schedule__day">{item.day}</span><h4>{item.title}</h4><p>{item.note}</p></article>)}</div><p class="cp-example-panel__note">この内容をそのまま提供するものではありません。貴学の教育目的、期間、人数、希望テーマ、学年暦、受入先の状況等を確認しながら調整します。</p></section>)}</div>
  </div></section>

  <section class="cp-gallery"><div class="cp-shell"><div class="cp-wide-heading"><p class="cp-section-label">LEARNING IN ACTION</p><h2>写真で見る、<br />立命館での学びの組み合わせ。</h2><p>Custom Programsでは、授業・交流・フィールドでの学びを一つのストーリーとして設計します。ここではレイアウト確認のため既存の活動写真を仮配置しています。公開前に、利用許諾を確認したCustom Programsの実写真へ差し替えます。</p></div><div class="cp-gallery__grid">{gallery.map((item,index)=><figure class:list={['cp-gallery__item',`cp-gallery__item--${index+1}`]}><img src={imageUrl(item.image)} alt={`${item.title}の活動イメージ`} loading="lazy" decoding="async" width="960" height="640" /><figcaption><small>{item.label}</small><h3>{item.title}</h3><p>{item.text}</p></figcaption></figure>)}</div></div></section>

  <section class="cp-tailor"><div class="cp-shell"><div class="cp-wide-heading"><p class="cp-section-label">CUSTOM DOES NOT MEAN UNLIMITED</p><h2>できることを広げながら、<br />実現可能な形に整えます。</h2><p>Custom Programsは「何でも自由にできる」仕組みではありません。教育効果と実現可能性の両方を確認しながら、一緒に設計します。</p></div><div class="cp-tailor__grid"><article class="cp-tailor__card cp-tailor__card--yes"><span>WHAT WE CAN TAILOR</span><h3>調整しやすい内容</h3><ul>{flexible.map((item)=><li>{item}</li>)}</ul></article><article class="cp-tailor__card cp-tailor__card--check"><span>WHAT REQUIRES COORDINATION</span><h3>条件により調整が必要な内容</h3><ul>{coordination.map((item)=><li>{item}</li>)}</ul></article></div></div></section>

  <section class="cp-glance"><div class="cp-shell"><div class="cp-wide-heading cp-wide-heading--glance"><p class="cp-section-label">AT A GLANCE</p><h2>まず知っていただきたい、<br />基本的な考え方。</h2><p>最初から仕様を固める必要はありません。希望時期、参加予定人数、関心分野、学生層を伺い、実現可能な組み合わせを一緒に整理します。</p></div><dl><div><dt>対象</dt><dd>海外大学・教育機関の学生団体</dd></div><div><dt>人数</dt><dd>新規相談は15名以上を目安に検討</dd></div><div><dt>期間</dt><dd>2週間程度の実施例が多い</dd></div><div><dt>主な実施場所</dt><dd>衣笠キャンパス / 大阪いばらきキャンパス（OIC）を中心に検討</dd></div><div><dt>専門講義</dt><dd>英語で実施</dd></div><div><dt>日本語</dt><dd>希望に応じて短期集中型の日本語学習を組み込み可能</dd></div><div><dt>宿泊</dt><dd>ホテル等をプログラム内容とあわせて個別に調整</dd></div><div><dt>事務局</dt><dd>バイリンガル対応</dd></div></dl></div></section>

  <section class="cp-cta"><div class="cp-shell cp-cta__inner"><p class="cp-section-label">LET'S DESIGN IT TOGETHER</p><h2><span>貴学のカリキュラムに、</span><span>立命館での学びを。</span></h2><p>実例と可能性を先にお見せしながら、一緒にプログラムをつくります。まずはオンラインミーティングで、希望時期・参加予定人数・関心分野・学生層をお聞かせください。</p><a class="cp-button cp-button--primary cp-button--large" href={contactHref}>オンラインミーティングを相談する <span aria-hidden="true">→</span></a><small>特定の企業・教員・施設等を保証するものではありません。実施可否は内容・時期・人数等を確認した上でご相談します。</small></div></section>
</article>

<style>
