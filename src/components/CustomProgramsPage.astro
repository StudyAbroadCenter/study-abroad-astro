<script>
  const tabs = Array.from(document.querySelectorAll<HTMLElement>('[data-example-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-example-panel]'));
  const activate = (id: string | null) => {
    if (!id) return;
    tabs.forEach((tab) => { const active = tab.getAttribute('data-example-tab') === id; tab.classList.toggle('is-active', active); tab.setAttribute('aria-selected', String(active)); });
    panels.forEach((panel) => panel.toggleAttribute('hidden', panel.getAttribute('data-example-panel') !== id));
  };
  tabs.forEach((tab) => tab.addEventListener('click', () => activate(tab.getAttribute('data-example-tab'))));
</script>
