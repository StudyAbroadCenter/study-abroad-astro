---
import { sharedSiteImages } from '../data/shared-site-images';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path.replace(/^\//, '')}`;
---
<section class="recruitment-hero" aria-labelledby="hero-title">
  <img
    class="recruitment-hero__image"
    src={image(sharedSiteImages.home.hero)}
    alt="立命館大学の短期プログラムに参加する学生たち"
    width="1600"
    height="1067"
    loading="eager"
    fetchpriority="high"
  />
  <div class="recruitment-hero__overlay" aria-hidden="true"></div>

  <nav class="recruitment-hero__languages" aria-label="表示言語">
    <a href={`${base}en/`} lang="en" hreflang="en">English</a>
    <a href={`${base}ko/`} lang="ko" hreflang="ko">한국어</a>
    <a href={`${base}zh-cn/`} lang="zh-CN" hreflang="zh-CN">简体中文</a>
    <a href={`${base}zh-tw/`} lang="zh-TW" hreflang="zh-TW">繁體中文</a>
  </nav>

  <div class="site-shell recruitment-hero__content">
    <p class="recruitment-hero__location">立命館で学ぶ 日本で暮らす</p>
    <h1 id="hero-title">
      <span>学ぶだけでは</span>
      <span>終わらない</span>
    </h1>
    <p class="recruitment-hero__lead">
      大学で学ぶ　学生と出会う　街と文化を日常にする<br />
      世界の大学生へ　立命館の短期留学
    </p>
    <div class="recruitment-hero__actions">
      <a class="action-button action-button--primary" href="#program-finder">自分に合うプログラムを探す</a>
      <a class="action-button action-button--glass" href="#participant-day">参加者の一日を見る</a>
    </div>
    <dl class="recruitment-hero__facts">
      <div><dt>対象</dt><dd>大学生・大学院生</dd></div>
      <div><dt>参加方式</dt><dd>個人参加・大学団体</dd></div>
      <div><dt>プログラム</dt><dd>個人向け6・大学向け1</dd></div>
    </dl>
  </div>

  <p class="recruitment-hero__note">写真は過去のプログラム実施時に撮影したものです　授業・交流・文化体験等の内容はプログラムにより異なります</p>
  <a class="recruitment-hero__scroll" href="#program-finder" aria-label="プログラム検索へ移動">下へ <span>↓</span></a>
</section>

<style>
  .recruitment-hero__languages {
    position: absolute;
    z-index: 4;
    top: 82px;
    right: 16px;
    left: 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    pointer-events: none;
  }

  .recruitment-hero__languages a {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.56);
    border-radius: 999px;
    padding: 6px 11px;
    background: rgba(5, 18, 34, 0.42);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 750;
    line-height: 1;
    white-space: nowrap;
    backdrop-filter: blur(10px);
    pointer-events: auto;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .recruitment-hero__languages a:hover {
    border-color: rgba(255, 255, 255, 0.9);
    background: rgba(5, 18, 34, 0.68);
    transform: translateY(-1px);
  }

  @media (min-width: 560px) {
    .recruitment-hero__languages {
      right: 24px;
      left: 24px;
    }
  }

  @media (min-width: 900px) {
    .recruitment-hero__languages {
      top: 94px;
      right: max(34px, calc((100vw - 1200px) / 2));
      left: auto;
    }

    .recruitment-hero h1 {
      max-width: 980px;
      font-size: clamp(5.2rem, 6.5vw, 6.7rem);
      line-height: 1.02;
      letter-spacing: -0.035em;
    }

    .recruitment-hero h1 span {
      display: block;
      white-space: nowrap;
    }
  }
</style>
