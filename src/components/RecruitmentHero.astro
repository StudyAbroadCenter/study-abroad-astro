---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path.replace(/^\//, '')}`;
---
<section class="recruitment-hero" aria-labelledby="hero-title">
  <img
    class="recruitment-hero__image"
    src={image('IMG_1588.JPG')}
    alt="立命館大学の短期プログラムに参加する学生たち"
    width="1600"
    height="1067"
    loading="eager"
    fetchpriority="high"
  />
  <div class="recruitment-hero__overlay" aria-hidden="true"></div>

  <div class="site-shell recruitment-hero__content">
    <p class="recruitment-hero__location">立命館で学ぶ 日本で暮らす</p>
    <h1 id="hero-title">
      <span>学ぶだけでは</span>
      <span>終わらない</span>
    </h1>
    <p class="recruitment-hero__lead">
      大学で学ぶ　学生と出会う　街と文化を日常にする<br />
      世界の大学生へ　立命館の短期留学
    </p>
    <div class="recruitment-hero__actions">
      <a class="action-button action-button--primary" href="#program-finder">自分に合うプログラムを探す</a>
      <a class="action-button action-button--glass" href="#participant-day">参加者の一日を見る</a>
    </div>
    <dl class="recruitment-hero__facts">
      <div><dt>対象</dt><dd>大学生・大学院生</dd></div>
      <div><dt>参加方式</dt><dd>個人参加・大学団体</dd></div>
      <div><dt>プログラム</dt><dd>個人向け6・大学向け1</dd></div>
    </dl>
  </div>

  <p class="recruitment-hero__note">写真は過去のプログラム実施時に撮影したものです　授業・交流・文化体験等の内容はプログラムにより異なります</p>
  <a class="recruitment-hero__scroll" href="#program-finder" aria-label="プログラム検索へ移動">下へ <span>↓</span></a>
</section>

<style>
  @media (min-width: 900px) {
    .recruitment-hero h1 {
      max-width: 980px;
      font-size: clamp(5.2rem, 6.5vw, 6.7rem);
      line-height: 1.02;
      letter-spacing: -0.035em;
    }

    .recruitment-hero h1 span {
      display: block;
      white-space: nowrap;
    }
  }
</style>
