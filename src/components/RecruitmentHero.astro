---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path.replace(/^\//, '')}`;
---
<section class="recruitment-hero" aria-labelledby="hero-title">
  <img
    class="recruitment-hero__image"
    src={image('IMG_1588.JPG')}
    alt="立命館大学の短期プログラムに参加する学生たち"
    width="1600"
    height="1067"
    loading="eager"
    fetchpriority="high"
  />
  <div class="recruitment-hero__overlay" aria-hidden="true"></div>

  <div class="site-shell recruitment-hero__content">
    <p class="recruitment-hero__location">KYOTO · OSAKA · SHIGA</p>
    <h1 id="hero-title">
      <span>学ぶだけでは、</span>
      <span>終わらない。</span>
    </h1>
    <p class="recruitment-hero__lead">
      日本の大学で学び、学生と出会い、街と文化を日常として体験する。<br />
      世界の大学生のための短期プログラムです。
    </p>
    <div class="recruitment-hero__actions">
      <a class="action-button action-button--primary" href="#program-finder">自分に合うプログラムを探す</a>
      <a class="action-button action-button--glass" href="#experience-preview">体験から見る</a>
    </div>
    <dl class="recruitment-hero__facts">
      <div><dt>対象</dt><dd>大学生・大学院生</dd></div>
      <div><dt>開催地</dt><dd>京都・大阪・滋賀</dd></div>
      <div><dt>プログラム</dt><dd>個人向け5・大学向け1</dd></div>
    </dl>
  </div>

  <p class="recruitment-hero__note">掲載写真は過去の実施例です。授業・交流・文化体験等はプログラムにより異なります。</p>
  <a class="recruitment-hero__scroll" href="#program-finder" aria-label="プログラム検索へ移動">SCROLL <span>↓</span></a>
</section>
