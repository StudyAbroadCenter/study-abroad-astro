---
import '../styles/student-recruitment.css';
import '../styles/mvp-refinement.css';
import '../styles/institutional-polish.css';
import '../styles/typography-final.css';
import '../styles/global-reach-fiveweek.css';
import '../styles/homepage-final-fixes.css';
import '../styles/english-home.css';

interface Props {
  title: string;
  description: string;
  robots?: string;
}

const { title, description, robots = 'noindex,nofollow' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ja" href={Astro.site ? new URL('/', Astro.site) : `${base}`} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <meta name="theme-color" content="#fffdfa" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" />
    <title>{title}</title>
  </head>
  <body class="en-site">
    <a class="en-skip-link" href="#main-content">Skip to main content</a>
    <header class="en-header">
      <div class="site-shell en-header__inner">
        <a class="en-header__brand" href={`${base}en/`} aria-label="Ritsumeikan University Short-Term Programs home">
          <strong>Ritsumeikan University</strong>
          <span>Short-Term Programs</span>
        </a>
        <nav class="en-header__nav" aria-label="Primary navigation">
          <a href="#program-finder">Programs</a>
          <a href="#why-ritsumeikan">Why Ritsumeikan</a>
          <a href="#global-reach">Global Reach</a>
          <a href="#support">Support</a>
          <a class="en-header__language" href={base} lang="ja" hreflang="ja">日本語</a>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="recruitment-footer en-footer">
      <div class="site-shell recruitment-footer__inner">
        <div>
          <strong>Ritsumeikan University Study Abroad Center</strong>
          <p>Short-Term Inbound Programs</p>
        </div>
        <div class="recruitment-footer__legal">
          <p>Some photographs show past or related programs. Classes, activities and student interaction vary by program.</p>
          <small>© Ritsumeikan University. All Rights Reserved.</small>
        </div>
      </div>
    </footer>

    <script>
      const programmeTiming = {
        rwjp: {
          applicationLabel: 'Apply by',
          application: 'Oct 14, 2026',
          datesLabel: 'Program dates',
          dates: 'Jan 12–Feb 11, 2027',
        },
        'rwjp-express': {
          applicationLabel: 'Recruitment',
          application: 'Open now',
          datesLabel: 'Program dates',
          dates: 'Feb 16–26, 2027',
        },
        rbmp: {
          applicationLabel: 'Recruitment',
          application: 'Open now',
          datesLabel: 'Planned dates',
          dates: 'Feb 12–24, 2027',
        },
        rdsp: {
          applicationLabel: 'Recruitment',
          application: 'Open now',
          datesLabel: 'Program dates',
          dates: 'To be confirmed',
        },
        rsjp: {
          applicationLabel: 'Application',
          application: 'To be announced',
          datesLabel: 'Program period',
          dates: 'Summer 2027',
        },
        'rsjp-express': {
          applicationLabel: 'Application',
          application: 'To be announced',
          datesLabel: 'Program period',
          dates: 'Summer 2027',
        },
      };

      const addTimingRows = () => {
        document.querySelectorAll('[data-en-programme-link]').forEach((link) => {
          const id = link.getAttribute('data-en-programme-link');
          const timing = id ? programmeTiming[id] : null;
          if (!timing) return;

          const body = link.closest('.programme-card__body');
          if (!body || body.querySelector('.en-programme-timing')) return;

          const dl = document.createElement('dl');
          dl.className = 'en-programme-timing';
          dl.setAttribute('data-programme-timing', id);

          const applicationRow = document.createElement('div');
          const applicationDt = document.createElement('dt');
          const applicationDd = document.createElement('dd');
          applicationDt.textContent = timing.applicationLabel;
          applicationDd.textContent = timing.application;
          applicationRow.append(applicationDt, applicationDd);

          const datesRow = document.createElement('div');
          const datesDt = document.createElement('dt');
          const datesDd = document.createElement('dd');
          datesDt.textContent = timing.datesLabel;
          datesDd.textContent = timing.dates;
          datesRow.append(datesDt, datesDd);

          dl.append(applicationRow, datesRow);
          body.insertBefore(dl, link);
        });

        document.querySelectorAll('[data-recruiting-link]').forEach((link) => {
          const id = link.getAttribute('data-recruiting-link');
          const timing = id ? programmeTiming[id] : null;
          if (!timing || link.querySelector('.en-recruitment-banner__timing')) return;

          const timingLine = document.createElement('small');
          timingLine.className = 'en-recruitment-banner__timing';
          timingLine.textContent = `${timing.datesLabel}: ${timing.dates}`;
          link.insertBefore(timingLine, link.lastElementChild);
        });
      };

      addTimingRows();
    </script>
  </body>
</html>

<style is:global>
  /* English-home readability floor: keep supporting copy legible without adding another CSS layer. */
  .en-site .recruitment-hero__location,
  .en-site .recruitment-hero__note,
  .en-site .recruitment-hero__scroll,
  .en-site .recruitment-hero__facts dd,
  .en-site .programme-card__visual > small {
    font-size: 0.75rem;
  }

  .en-site .programme-pathways article > p,
  .en-site .en-partner .section-kicker,
  .en-site .partner-programme__themes > p {
    font-size: 0.75rem !important;
  }

  /* Programme application/date strip on English-home cards. */
  .en-site .en-programme-timing {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    margin: 1rem 0 0.2rem;
  }

  .en-site .en-programme-timing > div {
    min-width: 0;
    padding: 0.72rem 0.78rem;
    border: 1px solid #ddd7d2;
    border-radius: 0.75rem;
    background: #f7f5f2;
  }

  .en-site .en-programme-timing dt {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.2;
    font-weight: 700;
    color: #6f6863;
  }

  .en-site .en-programme-timing dd {
    margin: 0.28rem 0 0;
    font-size: 0.88rem;
    line-height: 1.35;
    font-weight: 800;
    color: #292624;
  }

  .en-site [data-programme-timing='rwjp'] > div:first-child,
  .en-site [data-programme-timing='rwjp-express'] > div:first-child,
  .en-site [data-programme-timing='rbmp'] > div:first-child,
  .en-site [data-programme-timing='rdsp'] > div:first-child {
    border-color: rgba(139, 36, 50, 0.28);
    background: #fff3f4;
  }

  .en-site [data-programme-timing='rwjp'] > div:first-child dd,
  .en-site [data-programme-timing='rwjp-express'] > div:first-child dd,
  .en-site [data-programme-timing='rbmp'] > div:first-child dd,
  .en-site [data-programme-timing='rdsp'] > div:first-child dd {
    color: #8b2432;
  }

  .en-site .en-recruitment-banner__timing {
    display: block;
    margin-top: 0.16rem;
    font-size: 0.75rem !important;
    line-height: 1.35;
    font-weight: 650;
    color: rgba(255, 255, 255, 0.94) !important;
  }

  /* Double the Custom Program theme-chip height and keep content vertically centered. */
  .en-site .partner-programme__themes li {
    min-height: 2.75rem !important;
    display: flex !important;
    align-items: center !important;
    padding-top: 0.6rem !important;
    padding-bottom: 0.6rem !important;
  }

  .en-site .partner-programme__themes li::before {
    top: 50% !important;
    transform: translateY(-50%);
  }

  @media (max-width: 560px) {
    .en-site .programme-card__visual > small {
      display: none;
    }

    .en-site .programme-card__meta span {
      font-size: 0.75rem;
    }

    /* Mobile-first programme cards: stack image and copy so no text is squeezed or clipped. */
    .en-site .en-programme-grid .programme-card {
      display: block !important;
      min-height: 0 !important;
      overflow: hidden !important;
    }

    .en-site .en-programme-grid .en-programme-card__visual {
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      aspect-ratio: 16 / 9 !important;
    }

    .en-site .en-programme-grid .en-programme-card__visual img {
      width: 100% !important;
      height: 100% !important;
      min-height: 0 !important;
      object-fit: cover !important;
    }

    .en-site .en-programme-grid .programme-card__body {
      width: 100% !important;
      min-width: 0 !important;
      padding: 1rem 1.05rem 1.1rem !important;
    }

    .en-site .en-programme-grid .programme-card__body h3,
    .en-site .en-programme-grid .programme-card__body > p,
    .en-site .en-programme-grid .en-programme-card__link {
      max-width: 100% !important;
      overflow: visible !important;
      text-overflow: clip !important;
    }

    .en-site .en-programme-grid .programme-card__body > p:not(.programme-card__experience) {
      display: block !important;
      -webkit-line-clamp: unset !important;
      overflow: visible !important;
      font-size: 0.86rem !important;
      line-height: 1.5 !important;
    }

    .en-site .en-programme-grid .en-programme-card__link {
      width: auto !important;
      font-size: 0.8rem !important;
      white-space: normal !important;
    }

    .en-site .en-programme-timing {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      margin-top: 0.85rem;
    }

    .en-site .en-programme-timing > div {
      display: grid;
      grid-template-columns: minmax(92px, 0.45fr) minmax(0, 1fr);
      gap: 0.65rem;
      align-items: center;
      padding: 0.68rem 0.75rem;
    }

    .en-site .en-programme-timing dd {
      margin-top: 0;
      text-align: right;
    }

    /* Photo story should read as full-width editorial photography on phones. */
    .en-site .en-photo-story__grid {
      grid-template-columns: 1fr !important;
    }

    .en-site .en-photo-story__grid figure,
    .en-site .en-photo-story__grid figure:first-child {
      grid-column: auto !important;
    }

    .en-site .en-photo-story__grid img {
      aspect-ratio: 4 / 3 !important;
    }
  }
</style>
