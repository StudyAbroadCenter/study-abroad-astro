---
import '../styles/student-recruitment.css';
import '../styles/mvp-refinement.css';
import '../styles/institutional-polish.css';
import '../styles/typography-final.css';
import '../styles/global-reach-fiveweek.css';
import '../styles/homepage-final-fixes.css';
import '../styles/english-home.css';

interface Props {
  title: string;
  description: string;
  robots?: string;
}

const { title, description, robots = 'noindex,nofollow' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ja" href={Astro.site ? new URL('/', Astro.site) : `${base}`} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <meta name="theme-color" content="#fffdfa" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" />
    <title>{title}</title>
  </head>
  <body class="en-site">
    <a class="en-skip-link" href="#main-content">Skip to main content</a>
    <header class="en-header">
      <div class="site-shell en-header__inner">
        <a class="en-header__brand" href={`${base}en/`} aria-label="Ritsumeikan University Short-Term Programs home">
          <strong>Ritsumeikan University</strong>
          <span>Short-Term Programs</span>
        </a>
        <nav class="en-header__nav" aria-label="Primary navigation">
          <a href="#program-finder">Programs</a>
          <a href="#why-ritsumeikan">Why Ritsumeikan</a>
          <a href="#global-reach">Global Reach</a>
          <a href="#support">Support</a>
          <a class="en-header__language" href={base} lang="ja" hreflang="ja">日本語</a>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="recruitment-footer en-footer">
      <div class="site-shell recruitment-footer__inner">
        <div>
          <strong>Ritsumeikan University Study Abroad Center</strong>
          <p>Short-Term Inbound Programs</p>
        </div>
        <div class="recruitment-footer__legal">
          <p>Some photographs show past or related programs. Classes, activities and student interaction vary by program.</p>
          <small>© Ritsumeikan University. All Rights Reserved.</small>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* English-home readability floor: keep supporting copy legible without adding another CSS layer. */
  .en-site .recruitment-hero__location,
  .en-site .recruitment-hero__note,
  .en-site .recruitment-hero__scroll,
  .en-site .recruitment-hero__facts dd,
  .en-site .programme-pathways article > p,
  .en-site .programme-card__visual > small,
  .en-site .en-partner .section-kicker,
  .en-site .partner-programme__themes > p {
    font-size: 0.75rem;
  }

  @media (max-width: 560px) {
    .en-site .programme-card__visual > small {
      display: none;
    }

    .en-site .programme-card__meta span {
      font-size: 0.75rem;
    }
  }
</style>
