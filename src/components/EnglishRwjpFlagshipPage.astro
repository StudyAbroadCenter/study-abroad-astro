---
import {
  rwjp2027Facts,
  isKnownFact,
  rwjp2027JourneyLinks,
  isJourneyLinkReady,
} from '../data/rwjp/index';
import {
  fiveWeekJapaneseProgrammeEvidence,
  participationHistorySource,
} from '../data/participation-history';
import '../styles/rwjp-flagship.css';
import '../styles/rwjp-professional-polish.css';
import '../styles/global-learning-evidence.css';
import '../styles/global-reach-network.css';

const f = rwjp2027Facts;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const asset = (name: string) => `${base}images/programs/rwjp/${name}`;
const realAsset = (name: string) => `${base}images/programs/rwjp/real/${name}`;
const formatDate = (iso: string) => new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(`${iso}T00:00:00`));
const programmeDates = isKnownFact(f.programmeDates) ? `${formatDate(f.programmeDates.value.start)} – ${formatDate(f.programmeDates.value.end)}` : 'To be confirmed';
const applicationDates = isKnownFact(f.applicationPeriod) ? `${formatDate(f.applicationPeriod.value.start)} – ${formatDate(f.applicationPeriod.value.end)}` : 'To be confirmed';
const dormDates = isKnownFact(f.accommodationDates) ? `${formatDate(f.accommodationDates.value.checkIn)} – ${formatDate(f.accommodationDates.value.checkOut)}` : 'To be confirmed';
const programmeFee = isKnownFact(f.programmeFee) ? `¥${f.programmeFee.value.toLocaleString('en-US')}` : 'To be confirmed';
const dormFee = isKnownFact(f.accommodationFee) ? `¥${f.accommodationFee.value.toLocaleString('en-US')}` : 'To be confirmed';
const refundAmount = isKnownFact(f.refundAmount) ? `¥${f.refundAmount.value.toLocaleString('en-US')}` : null;
const japaneseHours = isKnownFact(f.japaneseMinutes) ? `${(f.japaneseMinutes.value / 60).toFixed(1)} hours` : 'To be confirmed';
const cultureHours = isKnownFact(f.cultureMinutes) ? `${(f.cultureMinutes.value / 60).toFixed(1)} hours` : 'To be confirmed';
const cultureSessions = isKnownFact(f.cultureSessions) ? f.cultureSessions.value : null;
const applicationStart = isKnownFact(f.applicationPeriod) ? f.applicationPeriod.value.start : null;
const applicationEnd = isKnownFact(f.applicationPeriod) ? f.applicationPeriod.value.end : null;
const applicationLink = rwjp2027JourneyLinks.application;
const inquiryLink = rwjp2027JourneyLinks.inquiry;
const applicationReady = isJourneyLinkReady(applicationLink) && Boolean(applicationLink.url);

const networkRegions = fiveWeekJapaneseProgrammeEvidence.regions.map((region) => ({ ...region, institutionCount: region.institutions }));
const majorNetworkRegions = networkRegions.slice(0, 8);
const minorNetworkRegions = networkRegions.slice(8);
const networkSlots = Array.from({ length: majorNetworkRegions.length }, (_, index) => {
  const angle = (-90 + (index * 360) / majorNetworkRegions.length) * Math.PI / 180;
  return { x: 50 + 31 * Math.cos(angle), y: 50 + 34 * Math.sin(angle) };
});
const programmeNetwork = majorNetworkRegions.map((region, index) => {
  const slot = networkSlots[index];
  const size = region.participants >= 20 ? 'lg' : region.participants >= 3 ? 'md' : 'sm';
  return { ...region, ...slot, size };
});
---
<article class="rwjp-flagship rwjp-en">
  <header class="en-rwjp-cinematic-hero">
    <img class="en-rwjp-cinematic-hero__image" src={asset('rwjp-kyoto-winter.webp')} alt="Winter in Kyoto during a Ritsumeikan short-term study program" width="1600" height="1067" decoding="async" fetchpriority="high" />
    <div class="en-rwjp-cinematic-hero__shade" aria-hidden="true"></div>
    <div class="site-shell en-rwjp-cinematic-hero__content">
      <p class="en-rwjp-cinematic-hero__eyebrow">Ritsumeikan Winter Japanese Program · 2027</p>
      <h1>Study Japanese.<br /><em>Live in Kyoto.</em></h1>
      <p class="en-rwjp-cinematic-hero__lead">Five weeks of serious Japanese study, university life and enough time in Kyoto for daily routines to become part of the experience.</p>
      <div class="en-rwjp-cinematic-hero__meta" aria-label="Key program details"><span>Jan. 12 – Feb. 11, 2027</span><span>Kinugasa Campus</span><span>Five weeks</span></div>
    </div>
  </header>

  <nav class="rwjp-flagship__nav en-rwjp-subnav" aria-label="RWJP page navigation"><div class="site-shell rwjp-flagship__nav-inner"><a href="#five-weeks">Five weeks</a><a href="#experience">Experience</a><a href="#study">Study</a><a href="#kyoto">Kyoto</a><a href="#fit">Is it for me?</a><a href="#global-reach">Global reach</a><a href="#essentials">2027 details</a><a href="#apply">Apply</a></div></nav>

  <section class="rwjp-flagship__opening" id="five-weeks"><div class="site-shell rwjp-flagship__opening-grid"><div><p class="rwjp-flagship__kicker">Five weeks to make it yours</p><h2>Stay long enough to find your own Kyoto</h2></div><div class="rwjp-flagship__prose"><p>A short visit gives you landmarks. Five weeks gives you routines: the walk to campus, a place you return to for lunch, classmates you begin to know, and Japanese from class turning up in everyday conversations.</p><p>RWJP gives you a structured academic program without scripting every hour around it. You study seriously, take part in the program, and still have the independence to decide how you spend your time in Kyoto.</p></div></div></section>

  <section class="rwjp-persona rwjp-en-persona" id="fit" aria-labelledby="en-rwjp-fit-title"><div class="site-shell rwjp-persona__grid"><div class="rwjp-persona__card"><p class="rwjp-flagship__kicker">Before you decide</p><p class="rwjp-persona__meta">University & graduate students · Beginners welcome · Individual applications accepted</p><h2 id="en-rwjp-fit-title">Could five weeks in Kyoto work for me?</h2><p class="rwjp-persona__lead">You do not need to arrive as an advanced Japanese speaker. You do need to be ready to study, participate fully and handle the everyday independence that comes with living abroad.</p><p class="rwjp-persona__decision">Complete beginners may apply. JLPT N1 holders are not eligible. Before the program begins, every participant must be able to read hiragana and katakana.</p></div><div class="rwjp-persona__note"><p><strong>Enrollment requirement</strong></p><p>You must remain enrolled at a university or graduate school from application through participation. Part-time students are eligible.</p></div></div></section>

  <section class="rwjp-en-experience" id="experience" aria-labelledby="en-rwjp-experience-title"><div class="site-shell rwjp-en-experience__head"><p class="rwjp-flagship__kicker">What fills the five weeks</p><h2 id="en-rwjp-experience-title">Class. Conversation. Culture. And time that is yours.</h2><p>These are confirmed elements of RWJP, not a fictional sample day. The exact order and annual arrangements may vary.</p></div><div class="site-shell rwjp-en-editorial-list">
    <article><div><p class="rwjp-day__time">Program · Japanese</p><h3>Start with serious language study</h3><p>Japanese is the academic center of RWJP. Classes, presentations, quizzes and examinations help you build and check your progress.</p><p class="rwjp-day__fact">Your academic performance is recorded in a transcript.</p></div><figure><img src={realAsset('rwjp-real-japanese-class.webp')} alt="Students studying Japanese in a Ritsumeikan University classroom" loading="lazy" decoding="async" /></figure></article>
    <article><div><p class="rwjp-day__time">Program · Student interaction</p><h3>Use what you learn with people</h3><p>Interaction with Ritsumeikan students can give you a reason to try new Japanese and talk about university life. Format and frequency follow the official arrangements for the year.</p></div><figure><img src={realAsset('rwjp-real-learning-hub.webp')} alt="Students sharing ideas in a university learning space" loading="lazy" decoding="async" /></figure></article>
    <article><div><p class="rwjp-day__time">Program · Culture</p><h3>Take part, not just look</h3><p>The 2027 program includes {cultureSessions ?? 11} cultural sessions. Activities may include tea ceremony, calligraphy or Zen meditation; exact content is finalized through annual arrangements.</p></div><figure><img src={realAsset('rwjp-real-culture-tatami.webp')} alt="Students taking part in a Japanese cultural activity" loading="lazy" decoding="async" /></figure></article>
  </div></section>

  <section class="rwjp-flagship__morning rwjp-en-study" id="study"><div class="site-shell"><div class="rwjp-flagship__section-head"><p class="rwjp-flagship__kicker">Japanese at the center</p><h2>Study it. Use it. Check your progress.</h2><p>Classes use a direct-method approach and are taught primarily in Japanese. The aim is not to promise fluency in five weeks, but to create a concentrated period in which Japanese becomes the language you study, hear and try to use every day.</p></div><div class="rwjp-flagship__study-line"><div><span>01</span><strong>Learn</strong><p>Structured Japanese language classes form the academic core.</p></div><div><span>02</span><strong>Use</strong><p>Presentations and interaction create opportunities to put Japanese into practice.</p></div><div><span>03</span><strong>Check</strong><p>Quizzes and examinations help you see what you have understood.</p></div><div><span>04</span><strong>Record</strong><p>Academic performance is documented in a transcript.</p></div></div></div></section>

  <section class="rwjp-flagship__switch rwjp-en-study-stat"><div class="site-shell rwjp-flagship__switch-grid"><p class="rwjp-flagship__switch-time">{japaneseHours}<span>Japanese language study · 2027</span></p><div><p>Five weeks gives the program room to build a learning rhythm rather than compress everything into a few days. Cultural learning adds another {cultureHours}{cultureSessions ? ` across ${cultureSessions} sessions` : ''}.</p><small>CONFIRMED 2027 ACADEMIC LOAD</small></div></div></section>

  <section class="rwjp-flagship__kyoto" id="kyoto"><div class="site-shell"><div class="rwjp-flagship__kyoto-intro"><p class="rwjp-flagship__kicker">Living in Kyoto</p><h2>The program has a schedule. Your five weeks have a life.</h2><p>Classes and organized activities are only part of the experience. Meals, walks, study, errands, conversations and your own exploration of Kyoto fill the time around them. That ordinary time is not an organized itinerary, and that is exactly why it matters.</p></div><div class="rwjp-flagship__photo-story rwjp-en-kyoto-story"><figure class="rwjp-flagship__photo-story-main"><img src={asset('rwjp-winter-life.webp')} alt="Daily life in Kyoto during winter" loading="lazy" decoding="async" /><figcaption>Daily routines are part of what turns a five-week stay into something different from a short visit.</figcaption></figure><div class="rwjp-flagship__kyoto-notes"><p><strong>CAMPUS</strong><span>Kinugasa Campus in north-west Kyoto.</span></p><p><strong>DORM</strong><span>Taishogun Dormitory is approximately a 10–15 minute walk from campus.</span></p><p><strong>FREE TIME</strong><span>How you use time outside program activities is your decision.</span></p><p><strong>WINTER</strong><span>Kyoto in January and February can be cold. Come prepared for winter.</span></p></div></div></div></section>

  <section class="rwjp-flagship__future rwjp-en-dorm"><div class="site-shell rwjp-flagship__future-inner"><p class="rwjp-flagship__kicker">Taishogun Dormitory</p><h2>A base for everyday life</h2><p>Rooms accommodate up to four students and are assigned by gender. Showers, toilets and kitchen facilities are shared. Wi-Fi and bedding are included; meals are not provided. Participants may also arrange external accommodation at their own expense.</p><div class="rwjp-flagship__future-path"><span>{dormDates}</span><i>·</i><span>{dormFee} additional</span><i>·</i><span>Subject to availability</span></div><p class="rwjp-flagship__future-line">The program does not promise a private room or a specific roommate.</p></div></section>

  <section class="global-evidence global-evidence--rwjp rwjp-en-global" id="global-reach" aria-labelledby="en-global-title"><div class="site-shell global-evidence__intro"><div><p class="global-evidence__kicker">Ritsumeikan's five-week Japanese programs</p><h2 id="en-global-title"><span class="global-evidence__title-line">From 21 countries and regions</span><span class="global-evidence__title-line">to five weeks at Ritsumeikan</span></h2></div><div class="global-evidence__lead-wrap"><p class="global-evidence__lead">From 2023 to 2026, 293 students from 81 universities and institutions took part in the five-week RSJP and RWJP programs.</p><p class="global-evidence__source-note">Reporting period: {participationHistorySource.period}. Country / region refers to the location of the participant's university or institution, not nationality. Express programs are not included.</p></div></div><div class="site-shell global-evidence__visual-grid global-evidence__visual-grid--network"><figure class="global-evidence__photo global-evidence__photo--primary"><img src={asset('rwjp-student-interaction.webp')} alt="Students interacting during a Ritsumeikan Japanese program" loading="lazy" decoding="async" /><figcaption>Connect — students come to Ritsumeikan from universities around the world</figcaption></figure><div class="global-evidence__network rwjp-en-globe" aria-label="Participation network for the five-week RSJP and RWJP programs"><svg class="global-evidence__network-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><circle cx="50" cy="50" r="24" class="global-evidence__network-orbit" /><ellipse cx="50" cy="50" rx="32" ry="34" class="global-evidence__network-orbit global-evidence__network-orbit--outer" />{programmeNetwork.map((region) => <path class={`global-evidence__network-line global-evidence__network-line--${region.size}`} d={`M 50 50 L ${region.x} ${region.y}`} />)}</svg><div class="global-evidence__network-center"><span>RSJP + RWJP · FIVE WEEKS</span><strong>Ritsumeikan</strong><b>Learn across borders</b><small>{fiveWeekJapaneseProgrammeEvidence.participants} participants · {fiveWeekJapaneseProgrammeEvidence.countriesOrRegions} countries / regions · {fiveWeekJapaneseProgrammeEvidence.institutions} institutions</small></div>{programmeNetwork.map((region) => <div class={`global-evidence__network-node global-evidence__network-node--${region.size}`} style={`--node-x:${region.x}%;--node-y:${region.y}%;`}><strong>{region.flag && <span aria-hidden="true">{region.flag} </span>}{region.countryOrRegion}</strong><span><b>{region.participants}</b><small>{region.institutionCount} institutions</small></span></div>)}{minorNetworkRegions.length > 0 && <div class="global-evidence__network-more"><span>More countries / regions</span><div>{minorNetworkRegions.map((region) => <small><i aria-hidden="true">{region.flag}</i>{region.countryOrRegion}<b>{region.participants}</b></small>)}</div></div>}</div><figure class="global-evidence__photo global-evidence__photo--secondary"><img src={asset('rwjp-japanese-class.webp')} alt="Students studying Japanese at Ritsumeikan University" loading="lazy" decoding="async" /><figcaption>Learn — Japanese remains at the center of the five-week program</figcaption></figure></div><dl class="site-shell global-evidence__stats" aria-label="RSJP and RWJP participation from 2023 to 2026"><div><dt>Participants</dt><dd>{fiveWeekJapaneseProgrammeEvidence.participants}</dd><span>2023–2026</span></div><div><dt>Countries / regions</dt><dd>{fiveWeekJapaneseProgrammeEvidence.countriesOrRegions}</dd><span>Institution location</span></div><div><dt>Universities / institutions</dt><dd>{fiveWeekJapaneseProgrammeEvidence.institutions}</dd><span>Historical participation</span></div></dl></section>

  <section class="rwjp-flagship__facts" id="essentials"><div class="site-shell"><p class="rwjp-flagship__kicker">2027 program essentials</p><h2>Check the facts before you decide</h2><p class="rwjp-flagship__facts-intro">These details come from confirmed 2027 RWJP data. When an annual arrangement is not yet final, we do not fill the gap with an assumption.</p><dl><div><dt>Official name</dt><dd>Ritsumeikan Winter Japanese Program</dd></div><div><dt>Program dates</dt><dd>{programmeDates}</dd></div><div><dt>Application period</dt><dd>{applicationDates}</dd></div><div><dt>Campus</dt><dd>Kinugasa Campus, Kyoto</dd></div><div><dt>Program fee</dt><dd>{programmeFee}</dd></div><div><dt>Japanese study</dt><dd>{japaneseHours}</dd></div><div><dt>Cultural activities</dt><dd>{cultureHours}{cultureSessions ? ` · ${cultureSessions} sessions` : ''}</dd></div><div><dt>Accommodation</dt><dd>Taishogun Dormitory · {dormFee} additional</dd></div></dl></div></section>

  <section class="rwjp-en-policy"><div class="site-shell rwjp-en-policy-grid"><article><p class="rwjp-flagship__kicker">Payment</p><h2>Pay after admission</h2><p>Payment instructions are sent after admission. The program fee, and the dormitory fee if applicable, must be paid in full by the specified deadline. If payment is not completed by the deadline, your place is automatically forfeited.</p></article><article><p class="rwjp-flagship__kicker">Cancellation & refunds</p><h2>Know the deductions before you pay</h2><p>There is no cancellation charge before payment. After payment, {refundAmount ? `a ${refundAmount} administrative fee` : 'an administrative fee'} is deducted, together with any non-refundable costs already incurred for arrangements. The remaining balance is refunded.</p></article></div></section>

  <section class="rwjp-flagship__apply en-rwjp-apply" id="apply"><div class="site-shell rwjp-flagship__apply-grid"><div><p class="rwjp-flagship__kicker">How to apply</p><h2>Start with your home university</h2><p>RWJP accepts direct applications, but some universities coordinate applications or require nomination. Ask your home university first.</p><ol class="rwjp-en-apply-steps"><li><strong>01</strong><span>Check whether your home university requires nomination or an internal process.</span></li><li><strong>02</strong><span>If no separate instruction applies, submit the official web application during {applicationDates}.</span></li><li><strong>03</strong><span>Watch your email for the selection result and follow the payment instructions after admission.</span></li></ol></div><div><p class="rwjp-flagship__closing">APPLICATIONS · {applicationDates}</p><p class="rwjp-flagship__status" data-rwjp-en-status data-start={applicationStart ?? undefined} data-end={applicationEnd ?? undefined}>Application period: {applicationDates}</p><div class="rwjp-en-apply-actions">{applicationReady && applicationLink.url && applicationStart && applicationEnd ? <><a class="rwjp-en-apply-button" href={applicationLink.url} target="_blank" rel="noopener noreferrer" data-rwjp-en-apply data-start={applicationStart} data-end={applicationEnd} hidden>Apply for 2027 RWJP</a><span class="rwjp-en-apply-button rwjp-en-apply-button--disabled" aria-disabled="true" data-rwjp-en-closed data-start={applicationStart} data-end={applicationEnd}>Applications are not currently open</span></> : <span class="rwjp-en-apply-button rwjp-en-apply-button--disabled" aria-disabled="true">Application form not yet published</span>}</div>{isJourneyLinkReady(inquiryLink) && inquiryLink.url && <p class="rwjp-en-contact">Questions? <a href={inquiryLink.url}>rsjprwjp@st.ritsumei.ac.jp</a>{inquiryLink.phone && <> · <a href="tel:+81754663009">+81-75-466-3009</a></>}</p>}</div></div></section>
</article>

<script is:inline>
  (() => {
    const jstToday = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
    const status = document.querySelector('[data-rwjp-en-status]');
    const apply = document.querySelector('[data-rwjp-en-apply]');
    const closed = document.querySelector('[data-rwjp-en-closed]');
    const start = apply?.getAttribute('data-start') || closed?.getAttribute('data-start');
    const end = apply?.getAttribute('data-end') || closed?.getAttribute('data-end');
    if (!start || !end) return;
    const open = jstToday >= start && jstToday <= end;
    if (apply instanceof HTMLElement) apply.hidden = !open;
    if (closed instanceof HTMLElement) {
      closed.hidden = open;
      closed.textContent = jstToday < start
        ? `Applications open on ${new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(`${start}T00:00:00`))}`
        : 'Applications for 2027 RWJP are closed';
    }
    if (status) {
      status.textContent = jstToday < start
        ? `Applications open on ${new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(`${start}T00:00:00`))}.`
        : open
          ? `Applications are open until ${new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(`${end}T00:00:00`))}.`
          : 'Applications for 2027 RWJP are closed.';
    }
  })();
</script>
