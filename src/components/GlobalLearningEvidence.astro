---
import {
  participationByCountry,
  participationByProgramme,
  participationHistorySource,
  shortTermParticipationEvidence,
  summarizeParticipation,
} from '../data/participation-history';
import { rwjp2027Facts, isKnownFact } from '../data/rwjp/index';
import '../styles/global-learning-evidence.css';

interface Props {
  context?: 'site' | 'rwjp' | 'rwjp-express';
}

const { context = 'site' } = Astro.props;
const isRwjp = context === 'rwjp';
const isExpress = context === 'rwjp-express';
const isProgramme = isRwjp || isExpress;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path.replace(/^\//, '')}`;

const records = isRwjp
  ? participationByProgramme('RWJP')
  : isExpress
    ? participationByProgramme('RWJP Express')
    : [];
const historical = isProgramme ? summarizeParticipation(records) : null;
const countries = isProgramme ? participationByCountry(records) : [];
const topCountries = countries.slice(0, 3);

const rwjpJapaneseHours = isKnownFact(rwjp2027Facts.japaneseMinutes)
  ? rwjp2027Facts.japaneseMinutes.value / 60
  : null;
const rwjpCultureSessions = isKnownFact(rwjp2027Facts.cultureSessions)
  ? rwjp2027Facts.cultureSessions.value
  : null;

const copy = isRwjp
  ? {
      kicker: 'RWJP · GLOBAL REACH',
      title: '「京都で学ぶ5週間」を、\n実績と実際の場面で見る。',
      lead: 'RWJPは、2023–2026年に140名、9か国・地域、18大学・機関から参加実績があります。自分の国・地域や大学から過去に参加した学生がいるか、ここで確認できます。',
      imageA: 'programs/rwjp/rwjp-student-interaction.webp',
      imageAAlt: 'RWJPで参加者同士や学生が交流する様子',
      imageACaption: 'CONNECT — 教室の外にも、ことばを使い、人と出会う時間がある。',
      imageB: 'programs/rwjp/rwjp-japanese-class.webp',
      imageBAlt: 'RWJPの日本語授業の様子',
      imageBCaption: 'STUDY — 日本語学習が5週間の中心にある。',
    }
  : isExpress
    ? {
        kicker: 'RWJP EXPRESS · GLOBAL REACH',
        title: '短く集中して学ぶ。\nその教室も、世界につながっている。',
        lead: 'RWJP Expressは、2023–2026年に71名、6か国・地域、15大学・機関から参加実績があります。2024年度は中止のため参加者0名です。',
        imageA: 'programs/rwjp/rwjp-student-interaction.webp',
        imageAAlt: '日本語プログラムで学生が交流する様子',
        imageACaption: 'CONNECT — 短期間でも、同世代との出会いを学びにつなげる。',
        imageB: 'programs/rwjp/rwjp-presentation.webp',
        imageBAlt: '日本語学習で発表する学生',
        imageBCaption: 'OUTPUT — 学んだことばを、自分のことばとして使う。',
      }
    : {
        kicker: 'RITSUMEIKAN · GLOBAL LEARNING NETWORK',
        title: '世界から522名。\n大学と大学の間に、人と人のつながりを。',
        lead: '2023–2026年のRSJP・RSJP Express・RWJP・RWJP Expressでは、522名が114大学・機関、27か国・地域から参加しました。受入の規模を、キャンパスでの共修と国際交流の機会へつなげます。',
        imageA: 'IMG_1588.JPG',
        imageAAlt: '立命館大学の短期プログラムに参加する学生たち',
        imageACaption: 'PEOPLE — 国や大学を越えて、学生が同じ場所で学ぶ。',
        imageB: 'hero/hero-kinugasa-clocktower.jpg',
        imageBAlt: '立命館大学衣笠キャンパスの時計台',
        imageBCaption: 'PLACE — 立命館のキャンパスそのものが国際交流の舞台になる。',
      };
---
<section id={`global-evidence-${context}`} class={`global-evidence global-evidence--${context}`} aria-labelledby={`global-evidence-title-${context}`}>
  <div class="site-shell global-evidence__intro">
    <div>
      <p class="global-evidence__kicker">{copy.kicker}</p>
      <h2 id={`global-evidence-title-${context}`}>
        {copy.title.split('\n').map((line) => <span>{line}</span>)}
      </h2>
    </div>
    <div class="global-evidence__lead-wrap">
      <p class="global-evidence__lead">{copy.lead}</p>
      <p class="global-evidence__source-note">集計期間：{participationHistorySource.period} ／ 出典：短期受入プログラム参加実績の統合データ。国・地域は参加者の国籍ではなく、大学・機関の所在地で整理しています。</p>
    </div>
  </div>

  <div class="site-shell global-evidence__visual-grid">
    <figure class="global-evidence__photo global-evidence__photo--primary">
      <img src={image(copy.imageA)} alt={copy.imageAAlt} loading="lazy" decoding="async" />
      <figcaption>{copy.imageACaption}</figcaption>
    </figure>

    <div class="global-evidence__globe" aria-label="世界と立命館キャンパスのつながりを表す図">
      <div class="global-evidence__globe-ring global-evidence__globe-ring--one"></div>
      <div class="global-evidence__globe-ring global-evidence__globe-ring--two"></div>
      <div class="global-evidence__globe-ring global-evidence__globe-ring--three"></div>
      {isProgramme ? topCountries.map((country, index) => (
        <span class={`global-evidence__origin global-evidence__origin--${index + 1}`}>
          <strong>{country.countryOrRegion}</strong>
          <small>{country.participants}名</small>
        </span>
      )) : (
        <>
          <span class="global-evidence__origin global-evidence__origin--1"><strong>South Korea</strong><small>219名</small></span>
          <span class="global-evidence__origin global-evidence__origin--2"><strong>Australia</strong><small>90名</small></span>
          <span class="global-evidence__origin global-evidence__origin--3"><strong>United States</strong><small>81名</small></span>
        </>
      )}
      <strong class="global-evidence__globe-title">RITSUMEIKAN<br />GLOBAL LEARNING</strong>
    </div>

    <figure class="global-evidence__photo global-evidence__photo--secondary">
      <img src={image(copy.imageB)} alt={copy.imageBAlt} loading="lazy" decoding="async" />
      <figcaption>{copy.imageBCaption}</figcaption>
    </figure>
  </div>

  {isProgramme && historical ? (
    <dl class="site-shell global-evidence__stats" aria-label={`${isRwjp ? 'RWJP' : 'RWJP Express'}の2023年から2026年の参加実績`}>
      <div><dt>参加者</dt><dd>{historical.participants.toLocaleString('ja-JP')}名</dd><span>PARTICIPANTS</span></div>
      <div><dt>国・地域</dt><dd>{historical.countries}</dd><span>COUNTRIES / REGIONS</span></div>
      <div><dt>大学・機関</dt><dd>{historical.institutions}</dd><span>INSTITUTIONS</span></div>
    </dl>
  ) : (
    <dl class="site-shell global-evidence__stats" aria-label="2023年から2026年の短期受入プログラム参加実績">
      <div><dt>参加者</dt><dd>{shortTermParticipationEvidence.participants.toLocaleString('ja-JP')}名</dd><span>PARTICIPANTS</span></div>
      <div><dt>国・地域</dt><dd>{shortTermParticipationEvidence.countriesOrRegions}</dd><span>COUNTRIES / REGIONS</span></div>
      <div><dt>大学・機関</dt><dd>{shortTermParticipationEvidence.institutions}</dd><span>INSTITUTIONS</span></div>
    </dl>
  )}

  {!isProgramme && (
    <div class="site-shell global-evidence__programme-totals" aria-label="プログラム群別参加者数">
      {Object.entries(shortTermParticipationEvidence.programmeParticipants).map(([programme, participants]) => (
        <div><span>{programme}</span><strong>{participants}名</strong></div>
      ))}
    </div>
  )}

  {isRwjp && (
    <div class="site-shell global-evidence__current-design" aria-label="2027 RWJPの確定学習設計">
      <p>2027 PROGRAMME DESIGN</p>
      <dl>
        <div><dt>期間</dt><dd>5週間</dd></div>
        <div><dt>日本語学習</dt><dd>{rwjpJapaneseHours !== null ? `${rwjpJapaneseHours}時間` : '確認中'}</dd></div>
        <div><dt>文化体験</dt><dd>{rwjpCultureSessions !== null ? `${rwjpCultureSessions}回` : '確認中'}</dd></div>
      </dl>
    </div>
  )}

  {isProgramme && (
    <div class="site-shell global-evidence__directory" data-participation-directory>
      <div class="global-evidence__directory-heading">
        <div>
          <p>FIND YOUR COUNTRY / UNIVERSITY</p>
          <h3>自分の国・地域、大学を探す。</h3>
          <span>過去の参加実績です。現在の募集対象・提携関係を意味するものではありません。</span>
        </div>
        <label>
          <span>国・地域・大学名で検索</span>
          <input type="search" placeholder="例：Australia / Melbourne" autocomplete="off" data-participation-search />
        </label>
      </div>

      <div class="global-evidence__country-list" data-participation-list>
        {countries.map((country) => (
          <details class="global-evidence__country" data-participation-country data-search-text={`${country.countryOrRegion} ${country.institutions.map((item) => item.institution).join(' ')}`.toLowerCase()}>
            <summary>
              <span><strong>{country.countryOrRegion}</strong><small>{country.institutions.length}大学・機関</small></span>
              <b>{country.participants}名</b>
            </summary>
            <ul>
              {country.institutions.map((item) => (
                <li><span>{item.institution}</span><strong>{item.participants}名</strong></li>
              ))}
            </ul>
          </details>
        ))}
      </div>
      <p class="global-evidence__no-results" data-participation-empty hidden>該当する国・地域、大学・機関はこの実績データでは見つかりませんでした。</p>
    </div>
  )}
</section>

{isProgramme && (
  <script>
    document.querySelectorAll('[data-participation-directory]').forEach((directory) => {
      const input = directory.querySelector('[data-participation-search]');
      const countries = Array.from(directory.querySelectorAll('[data-participation-country]'));
      const empty = directory.querySelector('[data-participation-empty]');
      if (!(input instanceof HTMLInputElement)) return;

      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        let visible = 0;
        countries.forEach((country) => {
          if (!(country instanceof HTMLDetailsElement)) return;
          const matches = !query || (country.dataset.searchText ?? '').includes(query);
          country.hidden = !matches;
          if (matches) {
            visible += 1;
            if (query) country.open = true;
          }
        });
        if (empty instanceof HTMLElement) empty.hidden = visible > 0;
      });
    });
  </script>
)}
