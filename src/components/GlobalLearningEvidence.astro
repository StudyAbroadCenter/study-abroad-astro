---
import {
  expressProgrammeEvidence,
  fiveWeekJapaneseProgrammeEvidence,
  participationByCountry,
  participationByProgramme,
  participationHistorySource,
  shortTermParticipationEvidence,
  summarizeParticipation,
} from '../data/participation-history';
import { rwjp2027Facts, isKnownFact } from '../data/rwjp/index';
import '../styles/global-learning-evidence.css';
import '../styles/global-reach-network.css';

interface Props {
  context?: 'site' | 'rwjp' | 'rwjp-express';
}

const { context = 'site' } = Astro.props;
const isRwjp = context === 'rwjp';
const isExpress = context === 'rwjp-express';
const isProgramme = isRwjp || isExpress;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path.replace(/^\//, '')}`;

const records = isRwjp
  ? participationByProgramme('RWJP')
  : isExpress
    ? participationByProgramme('RWJP Express')
    : [];
const historical = isProgramme ? summarizeParticipation(records) : null;
const countries = isProgramme ? participationByCountry(records) : [];

const networkRegions = isRwjp
  ? fiveWeekJapaneseProgrammeEvidence.regions.map((region) => ({ ...region, institutionCount: region.institutions }))
  : countries.map((country) => ({
      countryOrRegion: country.countryOrRegion,
      flag: '',
      participants: country.participants,
      institutionCount: country.institutions.length,
    }));

const majorNetworkRegions = isRwjp ? networkRegions.slice(0, 8) : networkRegions;
const minorNetworkRegions = isRwjp ? networkRegions.slice(8) : [];
const networkSlots = Array.from({ length: majorNetworkRegions.length }, (_, index) => {
  const angle = (-90 + (index * 360) / majorNetworkRegions.length) * Math.PI / 180;
  return { x: 50 + 31 * Math.cos(angle), y: 50 + 34 * Math.sin(angle) };
});
const programmeNetwork = majorNetworkRegions.map((country, index) => {
  const slot = networkSlots[index];
  const size = country.participants >= 20 ? 'lg' : country.participants >= 3 ? 'md' : 'sm';
  return { ...country, ...slot, size };
});

const networkSummary = isRwjp
  ? {
      participants: fiveWeekJapaneseProgrammeEvidence.participants,
      countries: fiveWeekJapaneseProgrammeEvidence.countriesOrRegions,
      institutions: fiveWeekJapaneseProgrammeEvidence.institutions,
    }
  : historical;

const rwjpJapaneseHours = isKnownFact(rwjp2027Facts.japaneseMinutes)
  ? rwjp2027Facts.japaneseMinutes.value / 60
  : null;
const rwjpCultureSessions = isKnownFact(rwjp2027Facts.cultureSessions)
  ? rwjp2027Facts.cultureSessions.value
  : null;

const copy = isRwjp
  ? {
      kicker: '立命館の5週間 日本語プログラム',
      title: '世界21か国・地域から\n立命館の5週間へ',
      lead: '2023–2026年、RSJP・RWJPに293名。21か国・地域、81大学・機関から学生が参加しました。夏と冬、5週間の日本語プログラムがつくる広がりです。',
      imageA: 'programs/rwjp/rwjp-student-interaction.webp',
      imageAAlt: '短期日本語プログラムで参加者同士や学生が交流する様子',
      imageACaption: '交流 — 世界から立命館へ',
      imageB: 'programs/rwjp/rwjp-japanese-class.webp',
      imageBAlt: '短期日本語プログラムの日本語授業の様子',
      imageBCaption: '学ぶ — 5週間の中心に日本語',
    }
  : isExpress
    ? {
        kicker: 'RWJP Express · 世界から立命館へ',
        title: '6か国・地域から\n冬の2週間へ',
        lead: '2023–2026年のRWJP Expressには、6か国・地域、15大学・機関から71名が参加しました。2024年度は中止のため参加者0名です。',
        imageA: 'programs/rwjp/rwjp-student-interaction.webp',
        imageAAlt: '日本語プログラムで学生が交流する様子',
        imageACaption: '交流 — 短期でも 学びは人へ',
        imageB: 'programs/rwjp/rwjp-presentation.webp',
        imageBAlt: '日本語学習で発表する学生',
        imageBCaption: '発信 — 学んだことばを使う',
      }
    : {
        kicker: '立命館の短期受入プログラム',
        title: '27か国・地域から\n522名が立命館へ',
        lead: '2023–2026年、検証済みの定型4プログラムに522名、27か国・地域、114大学・機関から参加がありました。5週間、Express、Custom Programs。それぞれ違う入口があります。',
        imageA: 'IMG_1588.JPG',
        imageAAlt: '立命館大学の短期プログラムに参加する学生たち',
        imageACaption: '人 — 国や大学を越えて学ぶ',
        imageB: 'hero/hero-kinugasa-clocktower.jpg',
        imageBAlt: '立命館大学衣笠キャンパスの時計台',
        imageBCaption: '場所 — キャンパスが出会いの舞台になる',
      };
---
<section id={`global-evidence-${context}`} class={`global-evidence global-evidence--${context}`} aria-labelledby={`global-evidence-title-${context}`}>
  <div class="site-shell global-evidence__intro">
    <div>
      <p class="global-evidence__kicker">{copy.kicker}</p>
      <h2 id={`global-evidence-title-${context}`}>
        {copy.title.split('\n').map((line) => <span class="global-evidence__title-line">{line}</span>)}
      </h2>
    </div>
    <div class="global-evidence__lead-wrap">
      <p class="global-evidence__lead">{copy.lead}</p>
      <p class="global-evidence__source-note">
        集計期間：{participationHistorySource.period} ／ 出典：短期受入プログラム参加実績の統合データ。国・地域は参加者の国籍ではなく、大学・機関の所在地で整理しています。{isRwjp ? ' RSJP・RWJPのみを合算し、Expressは含みません。' : !isProgramme ? ' 522名の集計はRSJP・RSJP Express・RWJP・RWJP Expressのみで、Custom Programsは別集計です。' : ''}
      </p>
    </div>
  </div>

  <div class={`site-shell global-evidence__visual-grid ${isProgramme ? 'global-evidence__visual-grid--network' : 'global-evidence__visual-grid--portfolio'}`}>
    <figure class="global-evidence__photo global-evidence__photo--primary">
      <img src={image(copy.imageA)} alt={copy.imageAAlt} loading="lazy" decoding="async" />
      <figcaption>{copy.imageACaption}</figcaption>
    </figure>

    {isProgramme && networkSummary ? (
      <div class="global-evidence__network" aria-label={`${isRwjp ? 'RSJPとRWJPの5週間日本語プログラム' : 'RWJP Express'}の参加実績ネットワーク`}>
        <svg class="global-evidence__network-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <circle cx="50" cy="50" r="24" class="global-evidence__network-orbit" />
          <ellipse cx="50" cy="50" rx="32" ry="34" class="global-evidence__network-orbit global-evidence__network-orbit--outer" />
          {programmeNetwork.map((country) => (
            <path class={`global-evidence__network-line global-evidence__network-line--${country.size}`} d={`M 50 50 L ${country.x} ${country.y}`} />
          ))}
        </svg>
        <div class="global-evidence__network-center">
          <span>{isRwjp ? 'RSJP + RWJP · 5週間' : 'RWJP EXPRESS'}</span>
          <strong>立命館</strong>
          <b>世界と学ぶ</b>
          <small>{networkSummary.participants}名 · {networkSummary.countries}か国・地域 · {networkSummary.institutions}大学・機関</small>
        </div>
        {programmeNetwork.map((country) => (
          <div class={`global-evidence__network-node global-evidence__network-node--${country.size}`} style={`--node-x:${country.x}%;--node-y:${country.y}%;`}>
            <strong>{country.flag && <span aria-hidden="true">{country.flag} </span>}{country.countryOrRegion}</strong>
            <span><b>{country.participants}名</b><small>{country.institutionCount}大学・機関</small></span>
          </div>
        ))}
        {minorNetworkRegions.length > 0 && (
          <div class="global-evidence__network-more" aria-label="その他の参加国・地域">
            <span>その他の国・地域</span>
            <div>
              {minorNetworkRegions.map((country) => (
                <small><i aria-hidden="true">{country.flag}</i>{country.countryOrRegion}<b>{country.participants}</b></small>
              ))}
            </div>
          </div>
        )}
      </div>
    ) : (
      <div class="global-evidence__portfolio" aria-label="立命館の短期受入プログラム群">
        <article>
          <p>5週間 日本語プログラム</p>
          <div class="global-evidence__portfolio-flags" aria-hidden="true">🇦🇺 🇺🇸 🇰🇷 🇨🇦 🇳🇿 🇬🇧</div>
          <strong>{fiveWeekJapaneseProgrammeEvidence.participants}名</strong>
          <span>{fiveWeekJapaneseProgrammeEvidence.countriesOrRegions}か国・地域 · {fiveWeekJapaneseProgrammeEvidence.institutions}大学・機関</span>
          <small>RSJP + RWJP / 5週間</small>
        </article>
        <article>
          <p>Express</p>
          <div class="global-evidence__portfolio-flags" aria-hidden="true">{expressProgrammeEvidence.representativeFlags.join(' ')}</div>
          <strong>{expressProgrammeEvidence.participants}名</strong>
          <span>{expressProgrammeEvidence.countriesOrRegions}か国・地域 · {expressProgrammeEvidence.institutions}大学・機関</span>
          <small>RSJP Express + RWJP Express</small>
        </article>
        <article class="global-evidence__portfolio-custom">
          <p>大学・機関向け Custom Programs</p>
          <div class="global-evidence__portfolio-flags" aria-hidden="true">🤝 🌏 🏫</div>
          <strong>大学ごとに設計</strong>
          <span>地域・人数・期間は案件ごとに異なるため別集計</span>
          <small>Custom Programsは別集計・確認中</small>
        </article>
      </div>
    )}

    <figure class="global-evidence__photo global-evidence__photo--secondary">
      <img src={image(copy.imageB)} alt={copy.imageBAlt} loading="lazy" decoding="async" />
      <figcaption>{copy.imageBCaption}</figcaption>
    </figure>
  </div>

  {isRwjp ? (
    <>
      <dl class="site-shell global-evidence__stats" aria-label="2023年から2026年のRSJP・RWJP 5週間日本語プログラム参加実績">
        <div><dt>参加者</dt><dd>{fiveWeekJapaneseProgrammeEvidence.participants.toLocaleString('ja-JP')}名</dd><span>参加者</span></div>
        <div><dt>国・地域</dt><dd>{fiveWeekJapaneseProgrammeEvidence.countriesOrRegions}</dd><span>国・地域</span></div>
        <div><dt>大学・機関</dt><dd>{fiveWeekJapaneseProgrammeEvidence.institutions}</dd><span>大学・機関</span></div>
      </dl>
      <p class="site-shell global-evidence__scope-note">※ 2023–2026年（コロナ後の再開期）のRSJP・RWJP実績を合算。両プログラムはいずれも5週間の日本語プログラムです。Express系は含みません。</p>
    </>
  ) : isExpress && historical ? (
    <dl class="site-shell global-evidence__stats" aria-label="RWJP Expressの2023年から2026年の参加実績">
      <div><dt>参加者</dt><dd>{historical.participants.toLocaleString('ja-JP')}名</dd><span>参加者</span></div>
      <div><dt>国・地域</dt><dd>{historical.countries}</dd><span>国・地域</span></div>
      <div><dt>大学・機関</dt><dd>{historical.institutions}</dd><span>大学・機関</span></div>
    </dl>
  ) : (
    <dl class="site-shell global-evidence__stats" aria-label="2023年から2026年の検証済み定型短期受入プログラム参加実績">
      <div><dt>参加者</dt><dd>{shortTermParticipationEvidence.participants.toLocaleString('ja-JP')}名</dd><span>定型プログラム</span></div>
      <div><dt>国・地域</dt><dd>{shortTermParticipationEvidence.countriesOrRegions}</dd><span>国・地域</span></div>
      <div><dt>大学・機関</dt><dd>{shortTermParticipationEvidence.institutions}</dd><span>大学・機関</span></div>
    </dl>
  )}

  {isRwjp && (
    <div class="site-shell global-evidence__current-design" aria-label="2027 RWJPの確定学習設計">
      <p>2027年度 プログラム設計</p>
      <dl>
        <div><dt>期間</dt><dd>5週間</dd></div>
        <div><dt>日本語学習</dt><dd>{rwjpJapaneseHours !== null ? `${rwjpJapaneseHours}時間` : '確認中'}</dd></div>
        <div><dt>文化体験</dt><dd>{rwjpCultureSessions !== null ? `${rwjpCultureSessions}回` : '確認中'}</dd></div>
      </dl>
    </div>
  )}

  {isProgramme && (
    <div class="site-shell global-evidence__directory" data-participation-directory>
      <div class="global-evidence__directory-heading">
        <div>
          <p>{isRwjp ? 'RWJP単独 · 2023–2026' : '国・地域・大学から探す'}</p>
          <h3>{isRwjp ? 'RWJPの参加実績を探す' : '自分の国・地域や大学を探す'}</h3>
          <span>{isRwjp ? `ここからはRWJP単独：140名・9か国・地域・18大学・機関。` : ''} 過去の参加実績は、現在の募集対象・提携関係を意味するものではありません。</span>
        </div>
        <label>
          <span>国・地域・大学名で検索</span>
          <input type="search" placeholder="例：Australia / Melbourne" autocomplete="off" data-participation-search />
        </label>
      </div>
      <div class="global-evidence__country-list" data-participation-list>
        {countries.map((country) => (
          <details class="global-evidence__country" data-participation-country data-search-text={`${country.countryOrRegion} ${country.institutions.map((item) => item.institution).join(' ')}`.toLowerCase()}>
            <summary>
              <span><strong>{country.countryOrRegion}</strong><small>{country.institutions.length}大学・機関</small></span>
              <b>{country.participants}名</b>
            </summary>
            <ul>
              {country.institutions.map((item) => (
                <li><span>{item.institution}</span><strong>{item.participants}名</strong></li>
              ))}
            </ul>
          </details>
        ))}
      </div>
      <p class="global-evidence__no-results" data-participation-empty hidden>この実績データでは見つかりませんでした。</p>
    </div>
  )}
</section>

{isProgramme && (
  <script>
    document.querySelectorAll('[data-participation-directory]').forEach((directory) => {
      const input = directory.querySelector('[data-participation-search]');
      const countries = Array.from(directory.querySelectorAll('[data-participation-country]'));
      const empty = directory.querySelector('[data-participation-empty]');
      if (!(input instanceof HTMLInputElement)) return;
      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        let visible = 0;
        countries.forEach((country) => {
          if (!(country instanceof HTMLDetailsElement)) return;
          const matches = !query || (country.dataset.searchText ?? '').includes(query);
          country.hidden = !matches;
          if (matches) {
            visible += 1;
            if (query) country.open = true;
          }
        });
        if (empty instanceof HTMLElement) empty.hidden = visible > 0;
      });
    });
  </script>
)}