---
import '../styles/support-preview.css';

const supportSteps = [
  {
    number: '01',
    eyebrow: '応募',
    title: '応募・手続き',
    body: '募集要項、必要書類、支払い。まず、応募に必要なことを整理します。',
  },
  {
    number: '02',
    eyebrow: '準備',
    title: '渡航前の準備',
    body: '渡航、保険、持ち物、連絡方法。日本へ来る前の確認を一つずつ。',
  },
  {
    number: '03',
    eyebrow: '到着',
    title: '到着・宿泊',
    body: 'チェックインと生活の立ち上げ。到着直後に迷いやすいポイントを案内します。',
  },
  {
    number: '04',
    eyebrow: '滞在',
    title: '滞在中の安心',
    body: '学習・生活の相談や、体調不良・緊急時に備える情報を分かりやすく案内します。留学サポートデスクでは英語での対応が可能です。',
  },
  {
    number: '05',
    eyebrow: '帰国',
    title: '修了・帰国',
    body: '修了から帰国準備まで。短期留学の最後も、必要な情報をつなぎます。',
  },
];
---
<section class="support-preview" id="support-preview" aria-labelledby="support-preview-title">
  <div class="site-shell support-preview__intro">
    <div>
      <p class="section-kicker">来る前から 支える</p>
      <h2 id="support-preview-title">来る前から 帰るまで</h2>
    </div>
    <div class="support-preview__lead">
      <p>応募、渡航、宿泊、保険、滞在、帰国。必要な情報を、必要なタイミングで。</p>
      <small>サポート内容と利用条件はプログラムにより異なります。留学サポートデスクでは英語での対応が可能です。詳細は各プログラムページで確認してください。</small>
    </div>
  </div>

  <ol class="site-shell support-preview__rail" aria-label="参加前から帰国までの支援の流れ">
    {supportSteps.map((step) => (
      <li>
        <article class="support-step">
          <div class="support-step__meta">
            <span>{step.number}</span>
            <p>{step.eyebrow}</p>
          </div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
          <span class="support-step__line" aria-hidden="true"></span>
        </article>
      </li>
    ))}
  </ol>
</section>
