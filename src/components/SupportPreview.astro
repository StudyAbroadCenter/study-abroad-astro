---
import '../styles/support-preview.css';

const supportSteps = [
  {
    number: '01',
    eyebrow: 'APPLY',
    title: '応募・手続き',
    body: '募集要項 必要書類 支払いなど 参加決定までに必要な情報を整理します。',
  },
  {
    number: '02',
    eyebrow: 'PREPARE',
    title: '渡航前の準備',
    body: '渡航 保険 持ち物 連絡方法など 日本へ来る前に確認する内容を案内します。',
  },
  {
    number: '03',
    eyebrow: 'ARRIVE',
    title: '到着・宿泊',
    body: 'チェックインや生活の立ち上げなど 到着直後に迷いやすいポイントを支えます。',
  },
  {
    number: '04',
    eyebrow: 'STAY',
    title: '滞在中の安心',
    body: '学習や生活の相談 体調不良や緊急時に備える情報を分かりやすくまとめます。',
  },
  {
    number: '05',
    eyebrow: 'RETURN',
    title: '修了・帰国',
    body: '修了時の案内から帰国準備まで 短期留学の最後に必要な情報をつなぎます。',
  },
];
---
<section class="support-preview" id="support-preview" aria-labelledby="support-preview-title">
  <div class="site-shell support-preview__intro">
    <div>
      <p class="section-kicker">STAY SUPPORTED</p>
      <h2 id="support-preview-title">参加前から帰国まで</h2>
    </div>
    <div class="support-preview__lead">
      <p>応募から渡航準備 宿泊 保険 緊急時対応 そして帰国まで。短期留学の前後を必要な情報とサポートでつなぎます。</p>
      <small>サポート内容と利用条件はプログラムにより異なります。詳細は各プログラムページで案内します。</small>
    </div>
  </div>

  <ol class="site-shell support-preview__rail" aria-label="参加前から帰国までの支援の流れ">
    {supportSteps.map((step) => (
      <li>
        <article class="support-step">
          <div class="support-step__meta">
            <span>{step.number}</span>
            <p>{step.eyebrow}</p>
          </div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
          <span class="support-step__line" aria-hidden="true"></span>
        </article>
      </li>
    ))}
  </ol>
</section>
