<style is:global>
  [data-demo-reel] .rwjpx__video-main{position:relative;overflow:hidden;background:#111}
  [data-demo-reel] .rwjpx__video-main>img{transition:opacity .28s ease,transform .8s ease}
  [data-demo-reel].is-playing .rwjpx__video-main>img{transform:scale(1.025)}
  [data-demo-reel] .rwjpx__play{display:grid;place-items:center;cursor:pointer;user-select:none;outline:none;transition:transform .18s ease,background .18s ease}
  [data-demo-reel] .rwjpx__play:hover,[data-demo-reel] .rwjpx__play:focus-visible{transform:translate(-50%,-50%) scale(1.08);background:#fff}
  [data-demo-reel] .rwjpx__play:focus-visible{box-shadow:0 0 0 3px rgba(139,23,54,.25)}
  .rwjpx__demo-badge{position:absolute;left:.65rem;top:.65rem;z-index:5;padding:.28rem .5rem;border-radius:999px;background:rgba(22,22,24,.72);color:#fff;font-size:.65rem;font-weight:850;letter-spacing:.08em;backdrop-filter:blur(6px)}
  .rwjpx__demo-progress{position:absolute;left:0;right:0;bottom:0;z-index:6;height:.2rem;background:rgba(255,255,255,.36)}
  .rwjpx__demo-progress>i{display:block;width:0;height:100%;background:#fff;transition:width 1.7s linear}
  [data-demo-reel].is-playing .rwjpx__demo-progress>i{width:100%}
  [data-demo-reel] .rwjpx__video-list span{cursor:pointer;border-radius:.35rem;outline:none;transition:background .18s ease,transform .18s ease}
  [data-demo-reel] .rwjpx__video-list span:hover,[data-demo-reel] .rwjpx__video-list span:focus-visible{background:#f5eff1;transform:translateY(-1px)}
  [data-demo-reel] .rwjpx__video-list span.is-active{background:#f5e9ed;color:#8b1736;font-weight:800}
  .rwjpx__lead,.rwjpx__copy p,.rwjpx__memories-grid>div:first-child p,.rwjpx__screens-head>p,.rwjpx__supporters-head>p,.rwjpx__next-inner>p{max-width:42rem}
  @media(max-width:600px){.rwjpx__lead{font-size:1rem;line-height:1.78}.rwjpx__hero h1{max-width:8.5em}.rwjpx__kicker{letter-spacing:.11em}.rwjpx__screens-head>p,.rwjpx__supporters-head>p{line-height:1.78}}
  @media(prefers-reduced-motion:reduce){[data-demo-reel] .rwjpx__video-main>img,[data-demo-reel] .rwjpx__play,[data-demo-reel] .rwjpx__video-list span,.rwjpx__demo-progress>i{transition:none!important}}
</style>

<script is:inline>
  (() => {
    const reels = document.querySelectorAll('[data-demo-reel]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    reels.forEach((reel) => {
      const main = reel.querySelector('.rwjpx__video-main');
      const mainImg = main?.querySelector('img');
      const play = reel.querySelector('.rwjpx__play');
      const chapters = Array.from(reel.querySelectorAll('.rwjpx__video-list span'));
      if (!main || !mainImg || !play || chapters.length === 0) return;

      const frameDuration = Number(reel.getAttribute('data-frame-duration')) || 1800;
      const progressDuration = Math.max(frameDuration - 100, 300);
      const frames = [
        { src: mainImg.getAttribute('src'), alt: '文化活動のサンプルフレーム', label: '文化体験' },
        ...chapters.map((chapter) => {
          const img = chapter.querySelector('img');
          return { src: img?.getAttribute('src'), alt: `${chapter.textContent?.trim() || '活動'}のサンプルフレーム`, label: chapter.textContent?.trim() || '' };
        })
      ].filter((frame) => frame.src);

      let index = 0;
      let timer = null;
      let playing = false;

      const badge = document.createElement('span');
      badge.className = 'rwjpx__demo-badge';
      badge.textContent = 'サンプルリール · 操作デモ';
      main.appendChild(badge);

      const progress = document.createElement('span');
      progress.className = 'rwjpx__demo-progress';
      progress.setAttribute('aria-hidden', 'true');
      progress.innerHTML = '<i></i>';
      main.appendChild(progress);

      play.setAttribute('role', 'button');
      play.setAttribute('tabindex', '0');
      play.setAttribute('aria-label', 'サンプルリールを再生');

      chapters.forEach((chapter, chapterIndex) => {
        chapter.setAttribute('role', 'button');
        chapter.setAttribute('tabindex', '0');
        chapter.setAttribute('aria-label', `${chapter.textContent?.trim() || 'チャプター'}を表示`);
        const targetIndex = chapterIndex + 1;
        const choose = () => {
          stop();
          show(targetIndex);
        };
        chapter.addEventListener('click', choose);
        chapter.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            choose();
          }
        });
      });

      function show(nextIndex) {
        index = nextIndex % frames.length;
        const frame = frames[index];
        mainImg.style.opacity = '0';
        window.setTimeout(() => {
          mainImg.setAttribute('src', frame.src);
          mainImg.setAttribute('alt', frame.alt);
          mainImg.style.opacity = '1';
        }, reduced ? 0 : 140);
        chapters.forEach((chapter, chapterIndex) => chapter.classList.toggle('is-active', chapterIndex + 1 === index));
        const bar = progress.querySelector('i');
        if (bar) {
          bar.style.transition = 'none';
          bar.style.width = '0';
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              bar.style.transition = reduced ? 'none' : `width ${progressDuration}ms linear`;
              bar.style.width = playing && !reduced ? '100%' : '0';
            });
          });
        }
      }

      function stop() {
        playing = false;
        reel.classList.remove('is-playing');
        play.textContent = '▶';
        play.setAttribute('aria-label', 'サンプルリールを再生');
        if (timer) window.clearInterval(timer);
        timer = null;
      }

      function start() {
        if (reduced) {
          show((index + 1) % frames.length);
          return;
        }
        playing = true;
        reel.classList.add('is-playing');
        play.textContent = 'Ⅱ';
        play.setAttribute('aria-label', 'サンプルリールを一時停止');
        show(index);
        timer = window.setInterval(() => show((index + 1) % frames.length), frameDuration);
      }

      function toggle() {
        if (playing) stop(); else start();
      }

      play.addEventListener('click', toggle);
      play.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          toggle();
        }
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden && playing) stop();
      });
    });
  })();
</script>