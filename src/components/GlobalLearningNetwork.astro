---
import { evidenceCountries, regularProgrammeEvidence } from '../data/globalNetworkEvidence';

const defaultCountry = 'united-states';
const defaultConnection = evidenceCountries.find((country) => country.id === defaultCountry) ?? evidenceCountries[0];
---
<section class="network-atlas" id="global-network" data-network-atlas style={`--globe-rotation:${defaultConnection.focusRotation}deg`}>
  <div class="site-shell network-atlas__inner">
    <header class="network-atlas__heading">
      <p>GLOBAL LEARNING NETWORK</p>
      <h2>世界の同世代と、<br /><em>ここでつながる。</em></h2>
      <p class="network-atlas__lead">
        {regularProgrammeEvidence.period}年のRSJP・RWJP系プログラム実績を、国・地域と大学・機関から可視化しました。
        国・地域を選ぶと、実際の参加実績をご覧いただけます。
      </p>
    </header>

    <div class="network-atlas__layout">
      <aside class="network-atlas__summary" aria-label="2023年から2026年の参加実績概要">
        <div class="network-atlas__metric"><span>◎</span><strong>{regularProgrammeEvidence.countryRegionCount}</strong><p>国・地域<small>Countries & Regions</small></p></div>
        <div class="network-atlas__metric"><span>▥</span><strong>{regularProgrammeEvidence.institutionCount}</strong><p>大学・機関<small>Institutions</small></p></div>
        <div class="network-atlas__metric"><span>○</span><strong>{regularProgrammeEvidence.participants}</strong><p>参加者数<small>Participants</small></p></div>
        <p class="network-atlas__scope">集計期間：{regularProgrammeEvidence.period}<br />対象：{regularProgrammeEvidence.scopeJa}</p>
        <p class="network-atlas__scope-note">※ Custom Programs等の実績は上記集計に含みません。国・地域は大学・機関の所在地で整理しています。</p>
      </aside>

      <div class="network-atlas__globe-wrap" aria-label="世界と立命館のつながりを表す模式的な地球儀">
        <svg class="network-atlas__globe" viewBox="0 0 640 640" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="atlasOcean" cx="35%" cy="26%" r="74%"><stop offset="0" stop-color="#fffefb"/><stop offset=".7" stop-color="#f6f0ea"/><stop offset="1" stop-color="#e8dfd7"/></radialGradient>
            <filter id="atlasShadow" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="14" stdDeviation="17" flood-color="#76655e" flood-opacity=".13"/></filter>
            <clipPath id="atlasClip"><circle cx="320" cy="300" r="228"/></clipPath>
          </defs>
          <circle cx="320" cy="300" r="228" fill="url(#atlasOcean)" filter="url(#atlasShadow)"/>
          <g class="network-atlas__globe-surface" clip-path="url(#atlasClip)">
            <g class="network-atlas__graticule">
              <ellipse cx="320" cy="300" rx="222" ry="72"/><ellipse cx="320" cy="300" rx="222" ry="142"/>
              <path d="M320 72c-79 83-79 373 0 456M320 72c79 83 79 373 0 456M92 300h456"/>
            </g>
            <g class="network-atlas__land network-atlas__land--realistic">
              <!-- North America -->
              <path d="M116 184l18-32 36-20 28 5 19-18 35 10 18 23-8 25 14 17-7 22-26 8-18 28-24 11-15-15-24 2-18-19-4-25-24-22Z"/>
              <path d="M195 258l24-5 18 13 6 20-12 19-18-5-11-17-14-8 7-17Z"/>
              <!-- Greenland -->
              <path d="M245 112l24-24 28 8 7 28-20 24-28-9-11-27Z"/>
              <!-- South America -->
              <path d="M235 300l28-7 26 13 16 28-4 30-17 31-10 42-16 33-17-9-6-35-12-29 8-33-9-34 13-30Z"/>
              <!-- Europe -->
              <path d="M332 177l20-14 20 6 13-12 17 8 10 18-12 16-17-3-10 13-18-4-11 11-15-9 6-15-9-8 6-7Z"/>
              <!-- Africa -->
              <path d="M349 224l37-9 34 14 14 27-8 39-23 44-15 43-23 8-14-30-20-25-4-41 10-35-2-24 14-11Z"/>
              <!-- Asia -->
              <path d="M402 168l29-25 46-5 23 17 32 1 31 22 18 29-7 29-26 7-17 28-26 1-17-19-27 8-20-13-16 6-17-18 8-20-16-15 10-24Z"/>
              <path d="M455 258l18 5 8 19-13 18-15-10-9-18 11-14Z"/>
              <!-- Japan -->
              <path d="M530 236l6 8-4 14-7 9-4-7 5-10-2-8 6-6Z"/>
              <!-- Southeast Asia -->
              <path d="M470 309l14 4 9 15-5 16-13-4-8-15 3-16Z"/>
              <path d="M492 341l9 4 3 16-10 5-6-12 4-13Z"/>
              <!-- Australia -->
              <path d="M475 392l31-17 41 4 26 24-5 34-31 24-39-8-22-24-1-37Z"/>
              <!-- New Zealand -->
              <path d="M574 443l8 11-5 17-8-8 5-20Z"/>
              <!-- UK / Ireland -->
              <path d="M324 185l7-15 9 7-2 15-8 5-6-12Z"/>
            </g>
            <g class="network-atlas__routes">
              <path d="M162 198Q264 235 354 294"/><path d="M222 151Q294 224 354 294"/><path d="M382 183Q372 231 354 294"/><path d="M491 181Q420 241 354 294"/><path d="M531 246Q430 268 354 294"/><path d="M514 415Q418 354 354 294"/><path d="M258 445Q305 365 354 294"/><path d="M161 340Q260 327 354 294"/>
            </g>
          </g>
          <circle cx="320" cy="300" r="228" class="network-atlas__rim"/>
          <g class="network-atlas__hub-mark"><circle cx="354" cy="294" r="21"/><text x="354" y="301" text-anchor="middle">R</text></g>
        </svg>
        <div class="network-atlas__focus-card" data-focus-card><img src={`https://flagcdn.com/w80/${defaultConnection.flagCode}.png`} alt="" width="40" height="30" data-focus-flag /><div><strong data-focus-name>{defaultConnection.countryJa}</strong><span><b data-focus-institutions>{defaultConnection.institutionCount}</b>大学・機関 / <b data-focus-participants>{defaultConnection.participants}</b>名</span></div></div>
        <div class="network-atlas__ritsumeikan"><span>RITSUMEIKAN</span><strong>立命館</strong><small>SHORT-TERM GLOBAL LEARNING<br />KYOTO · OSAKA · SHIGA</small></div>
      </div>

      <aside class="network-atlas__detail" aria-live="polite">
        <div class="network-atlas__detail-panels">
          {evidenceCountries.map((country) => (
            <article class:list={['network-atlas__panel', country.id === defaultCountry && 'is-active']} data-country-panel={country.id} hidden={country.id !== defaultCountry}>
              <header><img src={`https://flagcdn.com/w80/${country.flagCode}.png`} alt={`${country.countryJa}の国旗・地域旗`} width="56" height="42" loading="lazy" /><div><h3>{country.countryJa}</h3><p>{country.countryEn}</p></div></header>
              <div class="network-atlas__country-stats"><div><strong>{country.participants}</strong><span>名</span><small>参加者数</small></div><div><strong>{country.institutionCount}</strong><span>大学・機関</span><small>参加実績あり</small></div></div>
              <div class="network-atlas__institutions"><div class="network-atlas__list-heading"><strong>参加大学・機関</strong><span>主な実績</span></div><ul>{country.institutions.map((institution) => (<li><span>{institution.name}</span><b>{institution.participants}名</b></li>))}</ul>{country.institutionCount > country.institutions.length && <p>ほか {country.institutionCount - country.institutions.length} 大学・機関</p>}</div>
            </article>
          ))}
        </div>
        <p class="network-atlas__data-note">実施報告・参加者リストを統合した2023–2026年データに基づきます。人数・機関数はRSJP/RWJP系のみ。Custom Programs等を加えた実際のネットワークはさらに広がります。</p>
      </aside>
    </div>

    <div class="network-atlas__country-grid" aria-label="国・地域を選択">
      {evidenceCountries.map((country) => (
        <button type="button" class:list={['network-atlas__country-chip', country.id === defaultCountry && 'is-active']} data-country-select={country.id} data-rotation={country.focusRotation} data-flag={country.flagCode} data-name={country.countryJa} data-participants={country.participants} data-institutions={country.institutionCount} aria-pressed={country.id === defaultCountry ? 'true' : 'false'}><img src={`https://flagcdn.com/w40/${country.flagCode}.png`} alt="" width="24" height="18" loading="lazy" /><span><strong>{country.countryJa}</strong><small>{country.participants}名 · {country.institutionCount}機関</small></span></button>
      ))}
    </div>
    <div class="network-atlas__closing"><div><span>↗</span><strong>Different universities. One place to meet.</strong></div><p>大学と大学のつながりを、学生一人ひとりの出会いへ。</p></div>
  </div>
</section>
<script>
  const atlas = document.querySelector('[data-network-atlas]');
  if (atlas instanceof HTMLElement) {
    const buttons = Array.from(atlas.querySelectorAll('[data-country-select]'));
    const panels = Array.from(atlas.querySelectorAll('[data-country-panel]'));
    const focusName = atlas.querySelector('[data-focus-name]');
    const focusParticipants = atlas.querySelector('[data-focus-participants]');
    const focusInstitutions = atlas.querySelector('[data-focus-institutions]');
    const focusFlag = atlas.querySelector('[data-focus-flag]');
    const activate = (button: HTMLButtonElement) => {
      const id = button.dataset.countrySelect;
      if (!id) return;
      buttons.forEach((item) => { if (!(item instanceof HTMLButtonElement)) return; const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', active ? 'true' : 'false'); });
      panels.forEach((panel) => { if (!(panel instanceof HTMLElement)) return; const active = panel.dataset.countryPanel === id; panel.hidden = !active; panel.classList.toggle('is-active', active); });
      atlas.style.setProperty('--globe-rotation', `${button.dataset.rotation ?? 0}deg`);
      if (focusName) focusName.textContent = button.dataset.name ?? '';
      if (focusParticipants) focusParticipants.textContent = button.dataset.participants ?? '';
      if (focusInstitutions) focusInstitutions.textContent = button.dataset.institutions ?? '';
      if (focusFlag instanceof HTMLImageElement && button.dataset.flag) focusFlag.src = `https://flagcdn.com/w80/${button.dataset.flag}.png`;
    };
    buttons.forEach((item) => { if (!(item instanceof HTMLButtonElement)) return; item.addEventListener('click', () => activate(item)); item.addEventListener('focus', () => activate(item)); });
  }
</script>
