---
import { evidenceCountries, regularProgrammeEvidence } from '../data/globalNetworkEvidence';

const defaultCountry = 'united-states';
const defaultConnection = evidenceCountries.find((country) => country.id === defaultCountry) ?? evidenceCountries[0];
---
<section class="network-atlas" id="global-network" data-network-atlas style={`--globe-rotation:${defaultConnection.focusRotation}deg`}>
  <div class="site-shell network-atlas__inner">
    <header class="network-atlas__heading">
      <p>GLOBAL LEARNING NETWORK</p>
      <h2>世界の同世代と、<br /><em>ここでつながる。</em></h2>
      <p class="network-atlas__lead">
        {regularProgrammeEvidence.period}年のRSJP・RWJP系プログラム実績を、国・地域と大学・機関から可視化しました。
        国・地域を選ぶと、実際の参加実績をご覧いただけます。
      </p>
    </header>

    <div class="network-atlas__layout">
      <aside class="network-atlas__summary" aria-label="2023年から2026年の参加実績概要">
        <div class="network-atlas__metric">
          <span>◎</span><strong>{regularProgrammeEvidence.countryRegionCount}</strong><p>国・地域<small>Countries & Regions</small></p>
        </div>
        <div class="network-atlas__metric">
          <span>▥</span><strong>{regularProgrammeEvidence.institutionCount}</strong><p>大学・機関<small>Institutions</small></p>
        </div>
        <div class="network-atlas__metric">
          <span>○</span><strong>{regularProgrammeEvidence.participants}</strong><p>参加者数<small>Participants</small></p>
        </div>
        <p class="network-atlas__scope">集計期間：{regularProgrammeEvidence.period}<br />対象：{regularProgrammeEvidence.scopeJa}</p>
        <p class="network-atlas__scope-note">※ Custom Programs等の実績は上記集計に含みません。国・地域は大学・機関の所在地で整理しています。</p>
      </aside>

      <div class="network-atlas__globe-wrap" aria-label="世界と立命館のつながりを表す模式的な地球儀">
        <svg class="network-atlas__globe" viewBox="0 0 640 640" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="atlasOcean" cx="36%" cy="28%" r="72%">
              <stop offset="0" stop-color="#fffdf9"/><stop offset=".72" stop-color="#f3ede7"/><stop offset="1" stop-color="#e6ddd5"/>
            </radialGradient>
            <filter id="atlasShadow" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="16" stdDeviation="18" flood-color="#7d6a61" flood-opacity=".14"/></filter>
            <clipPath id="atlasClip"><circle cx="320" cy="320" r="250"/></clipPath>
          </defs>
          <circle cx="320" cy="320" r="250" fill="url(#atlasOcean)" filter="url(#atlasShadow)"/>
          <g class="network-atlas__globe-surface" clip-path="url(#atlasClip)">
            <g class="network-atlas__graticule">
              <ellipse cx="320" cy="320" rx="244" ry="82"/><ellipse cx="320" cy="320" rx="244" ry="160"/>
              <path d="M320 70c-88 90-88 410 0 500M320 70c88 90 88 410 0 500M70 320h500"/>
            </g>
            <g class="network-atlas__land">
              <path d="M110 185c42-46 92-59 139-36 34 16 39 51 20 78-18 25-54 19-72 45-23 33-70 27-94-8-22-33-18-59 7-79Z"/>
              <path d="M247 294c31-18 57-3 64 29 6 29-10 55-25 79-16 27-31 67-55 61-25-6-31-42-17-72 11-24 4-78 33-97Z"/>
              <path d="M344 153c48-29 107-16 131 27 20 35-8 62-13 96-4 30 27 47 13 81-16 40-73 32-93 5-23-32-9-65-34-91-27-28-39-89-4-118Z"/>
              <path d="M424 353c35-8 78 13 83 49 4 32-29 55-59 60-34 6-59-22-50-53 7-25-7-49 26-56Z"/>
              <path d="M510 216c25-8 52 1 65 23 12 20 1 44-17 52-24 10-54-4-60-28-5-18-8-40 12-47Z"/>
            </g>
            <g class="network-atlas__routes">
              <path d="M135 205Q258 250 350 318"/><path d="M182 157Q286 226 350 318"/><path d="M480 187Q410 246 350 318"/>
              <path d="M523 259Q430 278 350 318"/><path d="M492 421Q414 365 350 318"/><path d="M261 470Q302 386 350 318"/>
              <path d="M126 355Q250 344 350 318"/><path d="M550 365Q446 340 350 318"/>
            </g>
          </g>
          <circle cx="320" cy="320" r="250" class="network-atlas__rim"/>
          <g class="network-atlas__hub-mark"><circle cx="350" cy="318" r="24"/><text x="350" y="325" text-anchor="middle">R</text></g>
        </svg>

        <div class="network-atlas__focus-card" data-focus-card>
          <img src={`https://flagcdn.com/w80/${defaultConnection.flagCode}.png`} alt="" width="40" height="30" data-focus-flag />
          <div><strong data-focus-name>{defaultConnection.countryJa}</strong><span><b data-focus-institutions>{defaultConnection.institutionCount}</b>大学・機関 / <b data-focus-participants>{defaultConnection.participants}</b>名</span></div>
        </div>
        <div class="network-atlas__ritsumeikan"><span>RITSUMEIKAN</span><strong>立命館</strong><small>SHORT-TERM GLOBAL LEARNING<br />KYOTO · OSAKA · SHIGA</small></div>
      </div>

      <aside class="network-atlas__detail" aria-live="polite">
        {evidenceCountries.map((country) => (
          <article class:list={['network-atlas__panel', country.id === defaultCountry && 'is-active']} data-country-panel={country.id} hidden={country.id !== defaultCountry}>
            <header>
              <img src={`https://flagcdn.com/w80/${country.flagCode}.png`} alt={`${country.countryJa}の国旗・地域旗`} width="56" height="42" loading="lazy" />
              <div><h3>{country.countryJa}</h3><p>{country.countryEn}</p></div>
            </header>
            <div class="network-atlas__country-stats">
              <div><strong>{country.participants}</strong><span>名</span><small>参加者数</small></div>
              <div><strong>{country.institutionCount}</strong><span>大学・機関</span><small>参加実績あり</small></div>
            </div>
            <div class="network-atlas__institutions">
              <div class="network-atlas__list-heading"><strong>参加大学・機関</strong><span>主な実績</span></div>
              <ul>
                {country.institutions.map((institution) => (
                  <li><span>{institution.name}</span><b>{institution.participants}名</b></li>
                ))}
              </ul>
              {country.institutionCount > country.institutions.length && <p>ほか {country.institutionCount - country.institutions.length} 大学・機関</p>}
            </div>
          </article>
        ))}
        <p class="network-atlas__data-note">実施報告・参加者リストを統合した2023–2026年データに基づきます。人数・機関数はRSJP/RWJP系のみ。Custom Programs等を加えた実際のネットワークはさらに広がります。</p>
      </aside>
    </div>

    <div class="network-atlas__country-rail" aria-label="国・地域を選択">
      {evidenceCountries.map((country) => (
        <button type="button" class:list={['network-atlas__country-chip', country.id === defaultCountry && 'is-active']} data-country-select={country.id} data-rotation={country.focusRotation} data-flag={country.flagCode} data-name={country.countryJa} data-participants={country.participants} data-institutions={country.institutionCount} aria-pressed={country.id === defaultCountry ? 'true' : 'false'}>
          <img src={`https://flagcdn.com/w40/${country.flagCode}.png`} alt="" width="28" height="21" loading="lazy" />
          <span><strong>{country.countryJa}</strong><small>{country.participants}名 · {country.institutionCount}大学・機関</small></span>
        </button>
      ))}
    </div>

    <div class="network-atlas__closing"><div><span>↗</span><strong>Different universities. One place to meet.</strong></div><p>大学と大学のつながりを、学生一人ひとりの出会いへ。</p></div>
  </div>
</section>

<script>
  const atlas = document.querySelector('[data-network-atlas]');
  if (atlas instanceof HTMLElement) {
    const buttons = Array.from(atlas.querySelectorAll('[data-country-select]'));
    const panels = Array.from(atlas.querySelectorAll('[data-country-panel]'));
    const focusName = atlas.querySelector('[data-focus-name]');
    const focusParticipants = atlas.querySelector('[data-focus-participants]');
    const focusInstitutions = atlas.querySelector('[data-focus-institutions]');
    const focusFlag = atlas.querySelector('[data-focus-flag]');
    const activate = (button: HTMLButtonElement) => {
      const id = button.dataset.countrySelect;
      if (!id) return;
      buttons.forEach((item) => {
        if (!(item instanceof HTMLButtonElement)) return;
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return;
        const active = panel.dataset.countryPanel === id;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });
      atlas.style.setProperty('--globe-rotation', `${button.dataset.rotation ?? 0}deg`);
      if (focusName) focusName.textContent = button.dataset.name ?? '';
      if (focusParticipants) focusParticipants.textContent = button.dataset.participants ?? '';
      if (focusInstitutions) focusInstitutions.textContent = button.dataset.institutions ?? '';
      if (focusFlag instanceof HTMLImageElement && button.dataset.flag) focusFlag.src = `https://flagcdn.com/w80/${button.dataset.flag}.png`;
    };
    buttons.forEach((item) => {
      if (!(item instanceof HTMLButtonElement)) return;
      item.addEventListener('click', () => activate(item));
      item.addEventListener('focus', () => activate(item));
    });
  }
</script>
