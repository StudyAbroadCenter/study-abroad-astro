---
import '../styles/participant-day.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const optimizedImage = (path: string, width: number) => {
  const stem = path.replace(/^\//, '').replace(/\.[^.]+$/, '');
  return `${base}images/optimized/${stem}-${width}.webp`;
};
const responsiveImages = (path: string) => ({
  mobile: optimizedImage(path, 960),
  mobileSrcset: `${optimizedImage(path, 640)} 640w, ${optimizedImage(path, 960)} 960w`,
  desktop: optimizedImage(path, 1920),
  desktopSrcset: `${optimizedImage(path, 1280)} 1280w, ${optimizedImage(path, 1920)} 1920w`,
});
const transparentPixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';

const scenes = [
  {
    time: 'ARRIVE',
    label: 'CAMPUS',
    title: '知らないキャンパスが 自分の場所になる',
    text: '教室を探し、同じプログラムの参加者と挨拶を交わす。旅先だった日本が、少しずつ「通う場所」に変わります。',
    shift: '訪問者から キャンパスで学ぶ人へ',
    image: 'IMG_1656.JPG',
    alt: '立命館大学のキャンパスと時計台',
    focus: 'center 46%',
  },
  {
    time: 'CLASS',
    label: 'LEARN',
    title: '教室で学ぶ その先で使う',
    text: '日本語や専門テーマを学び、質問し、考え、伝える。授業で得た視点は、交流や街での発見にもつながります。',
    shift: '知識から 使える経験へ',
    image: 'IMG_8178.JPG',
    alt: '立命館大学で日本語の授業を受ける学生たち',
    focus: 'center 42%',
  },
  {
    time: 'BREAK',
    label: 'CONNECT',
    title: '何気ない会話も 学びになる',
    text: '休憩や活動の中で、参加者や立命館の学生と話す機会が生まれることがあります。完璧なことばでなくても、まず伝えてみる。',
    shift: '教室の外へ 会話が広がる',
    image: 'IMG_1588.JPG',
    alt: '短期プログラムに参加する学生が集まる教室',
    focus: 'center 58%',
  },
  {
    time: 'ACTIVITY',
    label: 'DISCOVER',
    title: '見るだけじゃ もったいない',
    text: '文化、地域、企業、フィールドワーク。背景を知り、実際に体験し、自分の文化と比べて考える。',
    shift: '知っている日本から 考える日本へ',
    image: 'IMG_5092.JPG',
    alt: '茶道体験で使う茶釜と茶道具',
    focus: 'center 52%',
  },
  {
    time: 'AFTER',
    label: 'EXPLORE',
    title: '授業のあとも 街へ出る',
    text: '自由時間の過ごし方は自分次第。電車に乗る。店に入る。道を歩く。日常の小さな経験も、短期留学の一部です。',
    shift: 'キャンパスから 自分の世界へ',
    image: 'IMG_1687.JPG',
    alt: '青空の下に広がる立命館大学のキャンパス',
    focus: 'center 48%',
  },
];
---
<section class="participant-day" id="participant-day" aria-labelledby="participant-day-title" data-participant-day>
  <div class="site-shell participant-day__intro">
    <p class="participant-day__kicker">A DAY THAT CHANGES YOUR VIEW</p>
    <h2 id="participant-day-title">
      <span>一日の中で</span>
      <span>学びがつながる</span>
    </h2>
    <div class="participant-day__intro-copy">
      <p>授業、会話、文化、街。過去の実施例から、短期留学を形づくる代表的な場面をつないでいます。</p>
      <small>順序・内容はプログラムや年度により異なります。下へスクロールして場面を見てください。</small>
    </div>
  </div>

  <div class="day-journey">
    <div class="day-stage" aria-hidden="true">
      <div class="day-stage__images">
        {scenes.map((scene, index) => {
          const sources = responsiveImages(scene.image);
          return (
            <picture class="day-stage__picture">
              <source media="(max-width: 899px)" srcset={transparentPixel} />
              <img
                class={`day-stage__image ${index === 0 ? 'is-active' : ''}`}
                src={index === 0 ? sources.desktop : transparentPixel}
                srcset={index === 0 ? sources.desktopSrcset : undefined}
                data-src={sources.desktop}
                data-srcset={sources.desktopSrcset}
                sizes="min(64vw, 1180px)"
                alt=""
                loading="lazy"
                decoding="async"
                data-day-image
                data-scene-index={index}
                style={`--day-focus: ${scene.focus}`}
              />
            </picture>
          );
        })}
      </div>
      <div class="day-stage__shade"></div>
      <div class="day-stage__hud">
        <p class="day-stage__eyebrow">YOUR DAY AT RITSUMEIKAN</p>
        <p class="day-stage__clock" data-day-clock>{scenes[0].time}</p>
        <p class="day-stage__label" data-day-label>{scenes[0].label}</p>
        <div class="day-stage__progress" aria-hidden="true"><span data-day-progress></span></div>
        <ol class="day-stage__rail">
          {scenes.map((scene, index) => (
            <li class={index === 0 ? 'is-active' : ''} data-day-rail data-scene-index={index}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <b>{scene.time}</b>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="day-scenes">
      {scenes.map((scene, index) => {
        const sources = responsiveImages(scene.image);
        return (
          <article
            class={`day-scene ${index === 0 ? 'is-active' : ''}`}
            data-day-scene
            data-scene-index={index}
            style={`--day-focus: ${scene.focus}`}
          >
            <picture class="day-scene__picture">
              <source media="(min-width: 900px)" srcset={transparentPixel} />
              <img
                class="day-scene__image"
                src={sources.mobile}
                srcset={sources.mobileSrcset}
                sizes="100vw"
                alt={scene.alt}
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="day-scene__shade" aria-hidden="true"></div>
            <div class="day-scene__content">
              <div class="day-scene__meta">
                <span>{String(index + 1).padStart(2, '0')} / {String(scenes.length).padStart(2, '0')}</span>
                <strong>{scene.time}</strong>
                <b>{scene.label}</b>
              </div>
              <h3>{scene.title}</h3>
              <p>{scene.text}</p>
              <div class="day-scene__shift">
                <small>THIS MOMENT CHANGES</small>
                <strong>{scene.shift}</strong>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <div class="site-shell participant-day__outro">
    <p class="participant-day__outro-mark" aria-hidden="true">“</p>
    <div>
      <p class="participant-day__kicker">NOT JUST A SCHEDULE</p>
      <h2>持ち帰るのは 知識だけじゃない</h2>
      <p>使ってみたことば。誰かと交わした会話。自分の足で歩いた街。短期留学には、予定表に収まらない学びがあります。</p>
    </div>
    <small>掲載している授業・交流・文化体験等は過去実施例です。実際の内容はプログラムにより異なります。</small>
  </div>
</section>

<script>
  const dayRoot = document.querySelector('[data-participant-day]');

  if (dayRoot) {
    const scenes = Array.from(dayRoot.querySelectorAll<HTMLElement>('[data-day-scene]'));
    const images = Array.from(dayRoot.querySelectorAll<HTMLImageElement>('[data-day-image]'));
    const rails = Array.from(dayRoot.querySelectorAll<HTMLElement>('[data-day-rail]'));
    const clock = dayRoot.querySelector<HTMLElement>('[data-day-clock]');
    const label = dayRoot.querySelector<HTMLElement>('[data-day-label]');
    const progress = dayRoot.querySelector<HTMLElement>('[data-day-progress]');
    const desktop = window.matchMedia('(min-width: 900px)');

    let activeIndex = -1;
    let pendingIndex = 0;
    let animationFrame = 0;

    const loadStageImage = (index: number) => {
      if (!desktop.matches) return;
      const item = images[index];
      const source = item?.dataset.src;
      const sourceSet = item?.dataset.srcset;
      if (!item || !source) return;
      if (sourceSet && item.getAttribute('srcset') !== sourceSet) item.setAttribute('srcset', sourceSet);
      if (item.getAttribute('src') !== source) item.setAttribute('src', source);
    };

    const preloadUpcomingImages = (index: number) => {
      for (let offset = 0; offset <= 2; offset += 1) {
        loadStageImage(Math.min(index + offset, images.length - 1));
      }
    };

    const activateScene = (index: number) => {
      const scene = scenes[index];
      if (!scene || index === activeIndex) return;
      activeIndex = index;

      preloadUpcomingImages(index);

      scenes.forEach((item, itemIndex) => item.classList.toggle('is-active', itemIndex === index));
      images.forEach((item, itemIndex) => item.classList.toggle('is-active', itemIndex === index));
      rails.forEach((item, itemIndex) => item.classList.toggle('is-active', itemIndex === index));

      if (clock) clock.textContent = scene.querySelector('.day-scene__meta strong')?.textContent ?? '';
      if (label) label.textContent = scene.querySelector('.day-scene__meta b')?.textContent ?? '';
      if (progress) progress.style.width = `${((index + 1) / scenes.length) * 100}%`;
    };

    const scheduleScene = (index: number) => {
      pendingIndex = index;
      if (animationFrame) return;
      animationFrame = window.requestAnimationFrame(() => {
        animationFrame = 0;
        activateScene(pendingIndex);
      });
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (!visible) return;
          const index = Number((visible.target as HTMLElement).dataset.sceneIndex ?? 0);
          scheduleScene(index);
        },
        { rootMargin: '-30% 0px -38%', threshold: [0.24, 0.52] },
      );

      scenes.forEach((scene) => observer.observe(scene));
    }

    const refreshForViewport = () => {
      if (desktop.matches) preloadUpcomingImages(Math.max(activeIndex, 0));
    };

    desktop.addEventListener('change', refreshForViewport);
    activateScene(0);
  }
</script>
