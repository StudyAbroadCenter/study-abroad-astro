---
import '../styles/rwjp-professional-polish.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const realBase = `${base}images/programs/rwjp/real/`;
---
<div class="rwjp-professional-polish" data-real-base={realBase} hidden aria-hidden="true"></div>

<script is:inline>
  (() => {
    const marker = document.querySelector('.rwjp-professional-polish');
    if (!(marker instanceof HTMLElement)) return;

    const realBase = marker.dataset.realBase || '/images/programs/rwjp/real/';

    const polish = () => {
      const root = document.querySelector('.rwjp-flagship');
      if (!(root instanceof HTMLElement) || root.dataset.professionalPolish === 'done') return;
      root.dataset.professionalPolish = 'done';

      const heroTitle = root.querySelector('.rwjp-flagship__hero-copy h1');
      if (heroTitle) heroTitle.innerHTML = '京都で<br /><em>5週間暮らしてみる</em>';

      const headingReplacements = new Map([
        ['旅行者から、少しずつ京都の住民へ。', '旅行者から 少しずつ京都の住民へ'],
        ['「一人で参加して、大丈夫かな。」', '一人で参加しても大丈夫かな'],
        ['授業、交流、文化体験、そして自分の時間。', '授業 交流 文化体験 そして自分の時間'],
        ['大学へ向かう時間も、京都で暮らす時間。', '通学の時間も 京都で暮らす時間'],
        ['日本語講座のある日は、午前を中心に集中する。', '日本語講座の日は 午前の学びが中心'],
        ['授業の合間は、自分で過ごし方を選ぶ。', '授業の合間は 自分のペースで'],
        ['教室の外でも、日本語を使うきっかけがある。', '教室の外で 日本語を使ってみる'],
        ['文化は、見るだけでなく体験する。', '文化は 見るだけでなく体験する'],
        ['授業後の京都は、自分で見つける。', '授業後の京都を 自分で見つける'],
        ['学んだことを、自分のペースで振り返る。', '今日の学びを 自分のペースで振り返る'],
        ['日本語講座では、日本語に向き合う。', '日本語講座では 日本語に向き合う'],
      ]);

      root.querySelectorAll('h2, h3').forEach((heading) => {
        const current = (heading.textContent || '').replace(/\s+/g, ' ').trim();
        const replacement = headingReplacements.get(current);
        if (replacement) {
          heading.textContent = replacement;
          return;
        }

        heading.textContent = current
          .replace(/、/g, ' ')
          .replace(/。$/g, '')
          .replace(/\s{2,}/g, ' ')
          .trim();
      });

      root.querySelectorAll('.rwjp-day__aside').forEach((banner) => {
        banner.textContent = (banner.textContent || '')
          .replace(/[、。,.]/g, '')
          .replace(/\s{2,}/g, ' ')
          .trim();
      });

      const swaps = [
        {
          selector: '.rwjp-day__scene--japanese .rwjp-day__scene-media img',
          file: 'rwjp-real-japanese-class.webp',
          alt: '大学の教室で授業を受ける短期受入プログラムの学生たち',
          cropClass: 'rwjp-real-photo--class',
        },
        {
          selector: '.rwjp-day__scene--buddy .rwjp-day__scene-media img',
          file: 'rwjp-real-learning-hub.webp',
          alt: '学生たちが発表と学びを共有する短期受入プログラムの活動風景',
          cropClass: 'rwjp-real-photo--hub',
        },
        {
          selector: '.rwjp-day__scene--culture .rwjp-day__scene-media img',
          file: 'rwjp-real-culture-tatami.webp',
          alt: '畳の部屋で日本文化を学ぶ短期受入プログラムの学生たち',
          cropClass: 'rwjp-real-photo--culture',
        },
        {
          selector: '.rwjp-day__scene--kyoto .rwjp-day__scene-media img',
          file: 'rwjp-real-kyoto-field.webp',
          alt: '京都の街でグループ活動を行う短期受入プログラムの学生たち',
          cropClass: 'rwjp-real-photo--kyoto',
        },
        {
          selector: '.rwjp-flagship__photo-grid--dark figure:nth-child(2) img',
          file: 'rwjp-real-academic-presentation.webp',
          alt: '大学の教室で発表を聞く短期受入プログラムの学生たち',
          cropClass: 'rwjp-real-photo--presentation',
        },
      ];

      swaps.forEach(({ selector, file, alt, cropClass }) => {
        const image = root.querySelector(selector);
        if (!(image instanceof HTMLImageElement)) return;

        image.src = `${realBase}${file}`;
        image.alt = alt;
        image.width = 960;
        image.height = 640;
        image.classList.add('rwjp-real-photo', cropClass);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', polish, { once: true });
    } else {
      polish();
    }
  })();
</script>
