---
import '../styles/english-shell.css';
import type { ChineseLocale } from '../data/chinese-localisation';
interface Props{locale:ChineseLocale;title:string;description:string;programmeId?:string;robots?:string}
const{locale,title,description,programmeId,robots='noindex,nofollow'}=Astro.props;const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:`${import.meta.env.BASE_URL}/`;const cn=locale==='zh-CN';const prefix=cn?'zh-cn':'zh-tw';const other=cn?'zh-tw':'zh-cn';const suffix=programmeId?`programs/${programmeId}/`:'';const canonical=Astro.site?new URL(Astro.url.pathname,Astro.site):Astro.url;const abs=(p:string)=>Astro.site?new URL(p,Astro.site):p;const ja=`${base}${programmeId?`programs/${programmeId}/`:''}`,en=`${base}en/${suffix}`,ko=`${base}ko/${suffix}`,alt=`${base}${other}/${suffix}`,home=`${base}${prefix}/`;
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content={robots}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="ja" href={abs(ja)}/><link rel="alternate" hreflang="en" href={abs(en)}/><link rel="alternate" hreflang="ko" href={abs(ko)}/><link rel="alternate" hreflang={locale} href={canonical}/><link rel="alternate" hreflang={cn?'zh-TW':'zh-CN'} href={abs(alt)}/><meta name="theme-color" content="#fff"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><title>{title}</title></head><body class={`en-detail-site zh-detail-site ${cn?'zh-cn-site':'zh-tw-site'}`}><a class="en-shell-skip" href="#main-content">{cn?'跳到主要内容':'跳到主要內容'}</a><header class="en-shell-header"><div class="en-shell en-shell-header__inner"><a class="en-shell-brand" href={home}><strong>RITSUMEIKAN UNIVERSITY</strong><span>{cn?'短期留学项目':'短期留學課程'}</span></a><nav class="en-shell-nav"><a href={`${home}#program-finder`}>{cn?'项目':'課程'}</a><a href={`${home}#why-ritsumeikan`}>{cn?'学习体验':'學習體驗'}</a><a href={`${home}#support`}>{cn?'申请准备':'申請準備'}</a><a class="en-shell-language" href={alt} lang={cn?'zh-TW':'zh-CN'}>{cn?'繁體中文':'简体中文'}</a><a class="en-shell-language" href={en} lang="en">English</a><a class="en-shell-language" href={ko} lang="ko">한국어</a><a class="en-shell-language" href={ja} lang="ja">日本語</a></nav></div></header><main id="main-content" tabindex="-1"><slot/></main><footer class="en-shell-footer"><div class="en-shell en-shell-footer__inner"><div><strong>Ritsumeikan University Study Abroad Center</strong><p>{cn?'短期国际学生项目':'短期國際學生課程'}</p></div><div class="en-shell-footer__legal"><p>{cn?'各项目只发布已完成年度确认的信息。':'各課程只公布已完成年度確認的資訊。'}</p><small>© Ritsumeikan University. All Rights Reserved.</small></div></div></footer></body></html>
<style is:global>.zh-detail-site{font-family:Inter,"Noto Sans CJK SC","Noto Sans CJK TC","PingFang SC","PingFang TC","Microsoft YaHei","Microsoft JhengHei",sans-serif}.zh-detail-site h1,.zh-detail-site h2,.zh-detail-site h3,.zh-detail-site p,.zh-detail-site li,.zh-detail-site dd{word-break:normal;overflow-wrap:break-word}@media(max-width:760px){.zh-detail-site .en-shell-nav{gap:.7rem}}</style>
