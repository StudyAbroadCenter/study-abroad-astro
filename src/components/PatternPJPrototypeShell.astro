---
const { title = 'RSJP Pattern P + J Prototype', description = 'Comparison prototype using current RSJP data.', active = '' } = Astro.props;
const nav = [
  ['home','Home','/pattern-pj-prototype/'],
  ['programs','Programs','/pattern-pj-prototype/programs/'],
  ['about','Why Ritsumeikan','/pattern-pj-prototype/about/'],
  ['stories','Stories','/pattern-pj-prototype/stories/'],
  ['buddy','Buddy','/pattern-pj-prototype/buddy/'],
  ['custom','Custom Programs','/pattern-pj-prototype/custom-programs/'],
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,nofollow" />
</head>
<body>
<div class="proto">
  <div class="localeBar"><strong>日本語 MASTER</strong><span>English</span><span>한국어</span><span>简体中文</span><span>繁體中文</span><em>Prototype: locale architecture preview</em></div>
  <header class="siteHeader">
    <a class="brand" href="/pattern-pj-prototype/"><span class="rmark">R</span><span><b>Ritsumeikan University</b><small>Study Abroad Center</small></span></a>
    <nav>{nav.map(([key,label,href]) => <a class={active===key?'active':''} href={href}>{label}</a>)}</nav>
    <a class="headerCta" href="/pattern-pj-prototype/programs/">プログラムを探す →</a>
  </header>
  <main><slot /></main>
  <footer>
    <div class="footerBrand"><span class="rmark">R</span><div><b>Ritsumeikan University</b><p>Short-Term Study / International Co-Learning Prototype</p></div></div>
    <div class="footerLinks"><a href="/pattern-pj-prototype/programs/">Programs</a><a href="/pattern-pj-prototype/buddy/">Buddy</a><a href="/pattern-pj-prototype/custom-programs/">Custom Programs</a></div>
    <small>Comparison prototype only. Programme facts are read from the current RSJP repository; unverified facts are not added.</small>
  </footer>
</div>
</body>
</html>

<style is:global>
:root{--red:#a81320;--red2:#7f1019;--ink:#171717;--cream:#f5f0e8;--green:#234d3b;--gold:#c59a33;--peach:#f2b4a8;--pink:#f6d7de;--lav:#ded6f5;--mint:#dce9d5;--sky:#d9ebf4}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fff;color:var(--ink);font-family:Arial,'Noto Sans JP',sans-serif}.proto{min-height:100vh}.localeBar{min-height:34px;padding:8px 3vw;display:flex;gap:20px;align-items:center;background:#181818;color:#fff;font-size:11px;letter-spacing:.02em}.localeBar span{opacity:.72}.localeBar em{margin-left:auto;opacity:.58;font-style:normal}.siteHeader{height:76px;padding:0 3vw;display:grid;grid-template-columns:1.15fr auto .7fr;align-items:center;border-bottom:1px solid #e8e4df;background:rgba(255,255,255,.97);position:sticky;top:0;z-index:40;backdrop-filter:blur(10px)}.brand{display:flex;gap:12px;align-items:center;color:var(--ink);text-decoration:none}.rmark{font-family:Georgia,serif;font-size:40px;color:var(--red);line-height:1}.brand b{display:block;font-size:16px}.brand small{display:block;font-size:10px;letter-spacing:.08em;margin-top:3px;color:#666}.siteHeader nav{display:flex;gap:25px}.siteHeader nav a{font-size:12px;text-decoration:none;color:#333;padding:29px 0 25px;border-bottom:3px solid transparent}.siteHeader nav a.active{border-bottom-color:var(--red);font-weight:800}.headerCta{justify-self:end;background:var(--red);color:#fff;text-decoration:none;padding:12px 16px;font-size:12px;font-weight:800}.shell{max-width:1440px;margin:auto;padding:64px 42px}.splitHero{min-height:610px;display:grid;grid-template-columns:1.08fr 1fr}.splitHero .media{min-height:540px;overflow:hidden}.splitHero img,.cover{width:100%;height:100%;object-fit:cover}.heroPanel{background:var(--red);color:#fff;padding:78px 7vw;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden}.heroPanel:after{content:'立';position:absolute;right:4%;bottom:-90px;font-family:Georgia,serif;font-size:330px;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.13);transform:rotate(-8deg)}.eyebrow,.kicker{font-size:11px;letter-spacing:.15em;font-weight:900}.heroPanel h1{font-size:clamp(48px,5vw,80px);line-height:.98;letter-spacing:-.045em;margin:15px 0 24px;max-width:720px}.heroPanel p{font-size:20px;line-height:1.55;max-width:620px;position:relative;z-index:2}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px;position:relative;z-index:2}.btn{display:inline-flex;justify-content:space-between;align-items:center;min-width:190px;padding:15px 18px;text-decoration:none;font-size:13px;font-weight:900;border:1px solid currentColor}.btn.light{background:#fff;color:#111;border-color:#fff}.btn.ghost{color:#fff}.sectionGrid{display:grid;grid-template-columns:220px 1fr;gap:40px}.sectionIntro h2,.pageLead h1{font-size:clamp(34px,4vw,60px);line-height:1.03;letter-spacing:-.045em;margin:8px 0 20px}.sectionIntro p,.pageLead p{line-height:1.7;color:#555}.textLink{color:var(--red);font-weight:800;text-decoration:none;font-size:12px}.programGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.programTile{border:1px solid #e7e1da;min-height:360px;display:flex;flex-direction:column;background:#fff}.programTile img{width:100%;height:165px;object-fit:cover}.programTile .body{padding:19px;display:flex;flex-direction:column;flex:1}.programTile h3{font-size:21px;margin:0 0 8px}.programTile p{font-size:13px;line-height:1.55;color:#555}.status{margin-top:auto;font-size:11px;font-weight:800;color:var(--red);padding-top:14px}.mosaic{display:grid;grid-template-columns:1.2fr .85fr 1fr;grid-template-rows:260px 240px;gap:12px}.mTile{position:relative;overflow:hidden;background:#ddd;min-height:180px}.mTile img{width:100%;height:100%;object-fit:cover}.mTile.tall{grid-row:1/3}.mTile.wide{grid-column:2/4}.mOverlay{position:absolute;inset:0;padding:24px;color:#fff;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(to top,rgba(0,0,0,.66),rgba(0,0,0,.03) 65%)}.mOverlay h3{margin:0 0 6px;font-size:27px;line-height:1}.mOverlay p{margin:0;max-width:420px;font-size:13px;line-height:1.5}.proofBand{background:#161616;color:#fff;padding:72px 5vw}.proofGrid{max-width:1320px;margin:auto;display:grid;grid-template-columns:1.2fr repeat(3,1fr);gap:18px;align-items:end}.proofGrid h2{font-size:42px;line-height:1.05;margin:0}.metric b{display:block;font-size:clamp(48px,6vw,86px);line-height:.9}.metric span{font-size:12px;color:#bbb}.softBand{background:var(--cream)}.pageLead{max-width:1000px;padding:80px 42px 40px;margin:auto}.factGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.fact{background:#f5f1eb;padding:20px;min-height:130px}.fact small{display:block;color:#7b6f66;font-weight:800;margin-bottom:10px}.fact strong{font-size:20px;line-height:1.35}.fact p{font-size:12px;line-height:1.6;color:#555}.quietSection{max-width:1180px;margin:auto;padding:35px 42px 75px}.quietSection h2{font-size:30px;margin:0 0 24px}.quietSection p,.quietSection li{line-height:1.75;color:#444}.infoRows{border-top:1px solid #ddd}.infoRow{display:grid;grid-template-columns:220px 1fr;gap:35px;padding:22px 0;border-bottom:1px solid #ddd}.infoRow b{font-size:13px}.photoStoryGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.photoStory{min-height:420px;position:relative;overflow:hidden}.photoStory img{width:100%;height:100%;object-fit:cover}.photoStory .caption{position:absolute;inset:auto 0 0;padding:24px;color:#fff;background:linear-gradient(to top,rgba(0,0,0,.7),transparent)}.photoStory h3{margin:0 0 8px;font-size:23px}.notice{background:#fff3d8;border-left:4px solid var(--gold);padding:16px 18px;font-size:12px;line-height:1.7}.institutionalHero{display:grid;grid-template-columns:1fr 1fr;min-height:520px}.institutionalHero .copy{padding:72px 7vw;background:#f3efe9;display:flex;flex-direction:column;justify-content:center}.institutionalHero h1{font-size:clamp(46px,5vw,72px);line-height:.98;margin:10px 0 20px}.partnerCloud{display:flex;flex-wrap:wrap;gap:8px}.partnerCloud span{border:1px solid #ddd;padding:10px 12px;background:#fff;font-size:12px}.jPage{--jink:#314039;--jcoral:#ec7e71;--jpink:#f6cdd8;--jgreen:#dbe9cf;--jlav:#dfd7f3;--jcream:#fff9f2;color:var(--jink);background:var(--jcream)}.jHero{min-height:650px;padding:72px 6vw;display:grid;grid-template-columns:.95fr 1.05fr;align-items:center;gap:50px;overflow:hidden;position:relative}.jHero:before,.jHero:after{content:'';position:absolute;border-radius:48% 52% 54% 46%;z-index:0}.jHero:before{width:420px;height:380px;background:var(--jgreen);left:-110px;top:-100px;transform:rotate(18deg)}.jHero:after{width:520px;height:480px;background:var(--jlav);right:-160px;bottom:-180px;transform:rotate(-12deg)}.jHero>*{position:relative;z-index:2}.jHero h1{font-family:Georgia,'Yu Mincho',serif;font-size:clamp(48px,5vw,76px);line-height:1.12;margin:12px 0 24px;font-weight:500}.jHero .hand{font-family:'Comic Sans MS','Yu Gothic',sans-serif;color:#c65f55;font-size:18px;transform:rotate(-2deg);display:inline-block}.organicPhoto{height:480px;overflow:hidden;border-radius:48% 52% 44% 56% / 58% 42% 58% 42%;transform:rotate(2deg);box-shadow:20px 24px 0 var(--jpink)}.organicPhoto img{width:100%;height:100%;object-fit:cover}.jSection{max-width:1250px;margin:auto;padding:75px 42px}.jSection h2{font-family:Georgia,'Yu Mincho',serif;font-size:42px;font-weight:500;margin:0 0 30px}.jCards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.jCard{padding:28px;border-radius:34px;background:#fff;min-height:220px}.jCard:nth-child(2){background:var(--jgreen)}.jCard:nth-child(3){background:var(--jlav)}.jNumber{font-family:Georgia,serif;font-size:40px;color:var(--jcoral)}.jJourney{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.jStep{padding:22px 14px;min-height:170px;border-radius:80px 80px 18px 18px;background:#fff;text-align:center}.jStep:nth-child(2n){background:var(--jpink)}.jStep b{display:block;margin:13px 0 7px}.faceGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.faceCard{background:#fff;border-radius:38px;padding:12px 12px 22px;overflow:hidden}.faceCard img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:32px}.faceCard h3{margin:15px 10px 5px}.faceCard p{margin:0 10px;font-size:12px;line-height:1.6;color:#6d756f}.jCta{margin-top:40px;background:var(--jcoral);color:#fff;padding:42px;border-radius:44px;display:flex;justify-content:space-between;align-items:center}.jCta h2{margin:0;font-family:Georgia,'Yu Mincho',serif}.jCta a{background:#fff;color:var(--jink);padding:14px 20px;text-decoration:none;font-weight:800;border-radius:30px}footer{padding:55px 4vw;background:#161616;color:#fff;display:grid;grid-template-columns:1fr auto;gap:35px;align-items:start}.footerBrand{display:flex;gap:15px;align-items:center}.footerBrand p{margin:5px 0;color:#aaa;font-size:12px}.footerLinks{display:flex;gap:22px}.footerLinks a{color:#fff;text-decoration:none;font-size:12px}footer>small{grid-column:1/-1;color:#8d8d8d;border-top:1px solid #333;padding-top:20px}
@media(max-width:980px){.siteHeader{grid-template-columns:1fr auto}.siteHeader nav{display:none}.localeBar em{display:none}.splitHero,.institutionalHero,.jHero{grid-template-columns:1fr}.splitHero .media{min-height:390px}.heroPanel{padding:55px 8vw}.sectionGrid{grid-template-columns:1fr}.programGrid{grid-template-columns:repeat(2,1fr)}.mosaic{grid-template-columns:1fr 1fr;grid-template-rows:300px 240px 220px}.mTile.tall{grid-row:1/3}.mTile.wide{grid-column:1/3;grid-row:3}.proofGrid{grid-template-columns:1fr repeat(3,1fr)}.proofGrid h2{grid-column:1/-1}.factGrid{grid-template-columns:repeat(2,1fr)}.jJourney{grid-template-columns:repeat(3,1fr)}.faceGrid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:620px){.localeBar{overflow:auto;white-space:nowrap}.siteHeader{height:68px;padding:0 18px}.brand b{font-size:13px}.brand small,.headerCta{display:none}.splitHero{min-height:0}.splitHero .media{min-height:310px}.heroPanel{padding:42px 24px}.heroPanel h1{font-size:48px}.heroPanel p{font-size:16px}.shell,.pageLead,.quietSection,.jSection{padding-left:20px;padding-right:20px}.programGrid{display:flex;overflow:auto;scroll-snap-type:x mandatory}.programTile{min-width:82vw;scroll-snap-align:start}.mosaic{display:block}.mTile{min-height:260px;margin-bottom:10px}.proofGrid{grid-template-columns:1fr}.metric b{font-size:62px}.factGrid{grid-template-columns:1fr}.infoRow{grid-template-columns:1fr;gap:8px}.photoStoryGrid{grid-template-columns:1fr}.photoStory{min-height:360px}.jHero{padding:45px 20px 70px}.jHero h1{font-size:46px}.organicPhoto{height:350px}.jCards,.faceGrid{grid-template-columns:1fr}.jJourney{display:flex;overflow:auto}.jStep{min-width:180px}.jCta{display:block}.jCta a{display:inline-block;margin-top:20px}footer{grid-template-columns:1fr}.footerLinks{flex-wrap:wrap}}
</style>