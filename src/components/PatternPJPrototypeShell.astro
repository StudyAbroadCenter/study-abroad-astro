ebrow,.kicker{font-size:11px;letter-spacing:.15em;font-weight:900}.heroPanel h1,.pageHero h1,.institutionalHero h1{margin:14px 0 22px;letter-spacing:-.045em;line-height:1.03;text-wrap:balance}.heroPanel h1{font-size:clamp(48px,5vw,78px);max-width:13ch}.heroPanel h1 span,.pageHero h1 span,.sectionTitle span,.jHero h1 span{display:block}.heroPanel p{font-size:19px;line-height:1.7;max-width:650px;position:relative;z-index:2}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px;position:relative;z-index:2}.btn{display:inline-flex;justify-content:space-between;align-items:center;min-width:185px;padding:14px 17px;text-decoration:none;font-size:13px;font-weight:900;border:1px solid currentColor}.btn.light{background:#fff;color:#111;border-color:#fff}.btn.ghost{color:#fff}.pageHero{max-width:1320px;margin:auto;padding:70px 42px 44px;display:grid;grid-template-columns:minmax(0,.78fr) minmax(280px,.42fr);gap:60px;align-items:end;border-bottom:1px solid #eee7e1}.pageHero h1{font-size:clamp(42px,4.5vw,66px);max-width:16ch}.pageHero .lead{font-size:16px;line-height:1.8;color:#555;max-width:520px;margin:0}.editorialHead{max-width:1320px;margin:auto;padding:68px 42px 30px;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.55fr);gap:55px;align-items:end}.editorialHead h2,.sectionTitle{font-size:clamp(32px,3.2vw,50px);line-height:1.08;letter-spacing:-.035em;margin:9px 0 0;text-wrap:balance}.editorialHead p{margin:0;line-height:1.75;color:#555}.textLink{color:var(--red);font-weight:800;text-decoration:none;font-size:12px}.programEditorial{max-width:1320px;margin:auto;padding:0 42px 78px;display:grid;grid-template-columns:1.25fr .75fr .75fr;grid-auto-rows:minmax(265px,auto);gap:14px}.programTile{border:1px solid #e7e1da;display:grid;grid-template-rows:165px 1fr;background:#fff;min-width:0}.programTile.feature{grid-row:span 2;grid-template-rows:330px 1fr}.programTile img{width:100%;height:100%;object-fit:cover}.programTile .body{padding:19px;display:flex;flex-direction:column;min-width:0}.programTile h3{font-size:20px;line-height:1.18;margin:0 0 8px;overflow-wrap:anywhere}.programTile.feature h3{font-size:27px}.programTile p{font-size:13px;line-height:1.62;color:#555}.programTile strong{font-size:13px;line-height:1.5;margin-bottom:8px}.status{margin-top:auto;font-size:11px;font-weight:800;color:var(--red);padding-top:14px}.mosaic{display:grid;grid-template-columns:1.2fr .85fr 1fr;grid-template-rows:260px 240px;gap:12px}.mTile{position:relative;overflow:hidden;background:#ddd;min-height:180px}.mTile img{width:100%;height:100%;object-fit:cover}.mTile.tall{grid-row:1/3}.mTile.wide{grid-column:2/4}.mOverlay{position:absolute;inset:0;padding:24px;color:#fff;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(to top,rgba(0,0,0,.66),rgba(0,0,0,.03) 65%)}.mOverlay h3{margin:0 0 6px;font-size:27px;line-height:1.08}.mOverlay p{margin:0;max-width:440px;font-size:13px;line-height:1.55}.proofBand{background:#161616;color:#fff;padding:72px 5vw}.proofGrid{max-width:1320px;margin:auto;display:grid;grid-template-columns:1.2fr repeat(3,1fr);gap:18px;align-items:end}.proofGrid h2{font-size:clamp(34px,3.5vw,48px);line-height:1.08;margin:0;max-width:14ch;text-wrap:balance}.metric b{display:block;font-size:clamp(48px,6vw,86px);line-height:.9}.metric span{font-size:12px;color:#bbb}.softBand{background:var(--cream)}.quietSection{max-width:1180px;margin:auto;padding:58px 42px}.quietSection h2{font-size:clamp(28px,3vw,40px);line-height:1.15;margin:0 0 26px;text-wrap:balance}.quietSection p,.quietSection li{line-height:1.78;color:#444}.factGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.fact{background:#f5f1eb;padding:20px;min-height:130px}.fact small{display:block;color:#7b6f66;font-weight:800;margin-bottom:10px}.fact strong{font-size:20px;line-height:1.35}.fact p{font-size:12px;line-height:1.6;color:#555}.infoRows{border-top:1px solid #ddd}.infoRow{display:grid;grid-template-columns:220px 1fr;gap:35px;padding:22px 0;border-bottom:1px solid #ddd}.infoRow b{font-size:13px}.photoStoryGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.photoStory{min-height:430px;position:relative;overflow:hidden}.photoStory img{width:100%;height:100%;object-fit:cover}.photoStory .caption{position:absolute;inset:auto 0 0;padding:24px;color:#fff;background:linear-gradient(to top,rgba(0,0,0,.72),transparent)}.photoStory h3{margin:0 0 8px;font-size:23px}.institutionalHero{display:grid;grid-template-columns:1fr 1fr;min-height:520px}.institutionalHero .copy{padding:70px 7vw;background:#f3efe9;display:flex;flex-direction:column;justify-content:center}.institutionalHero h1{font-size:clamp(42px,4.8vw,68px);max-width:16ch}.institutionalHero .copy>p{line-height:1.75;max-width:650px}.partnerCloud{display:flex;flex-wrap:wrap;gap:8px}.partnerCloud span{border:1px solid #ddd;padding:10px 12px;background:#fff;font-size:12px}.sectionGridWide{max-width:1320px;margin:auto;padding:0 42px 76px}.sectionGridWide .mosaic{margin-top:0}.storyIntro{max-width:1320px;margin:auto;padding:18px 42px 34px}.storyIntro p{max-width:780px;line-height:1.8;color:#555}.jPage{--jink:#2d3c36;--jcoral:#ed8d84;--jpink:#f8d8df;--jgreen:#dcebdc;--jlav:#e4ddf6;--jcream:#fffaf4;--jblue:#dceef2;color:var(--jink);background:var(--jcream)}.jFrame{display:grid;grid-template-columns:154px minmax(0,1fr);max-width:1540px;margin:auto;background:#fff}.jSide{border-right:1px solid #ece8e1;background:#fffaf5;display:flex;flex-direction:column;min-height:100%}.jSideBrand{padding:30px 24px 25px;font-family:'Comic Sans MS','Yu Gothic',sans-serif;font-size:28px;color:#58bdb4}.jSideBrand small{display:block;margin-top:10px;font-family:Arial,sans-serif;font-size:8px;letter-spacing:.04em;color:#7c8883}.jSide nav{position:sticky;top:122px;display:flex;flex-direction:column;padding:15px 0}.jSide nav a{padding:15px 23px;color:#34443d;text-decoration:none;font-size:12px}.jSide nav a:first-child{background:#e7f3f0;color:#4aaea6}.jMain{overflow:hidden}.jHero{min-height:650px;padding:64px 6vw;display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:48px;position:relative;overflow:hidden}.jHero:before,.jHero:after,.jBlob{content:'';position:absolute;border-radius:48% 52% 54% 46%;z-index:0}.jHero:before{width:360px;height:320px;background:var(--jblue);left:-130px;top:-130px;transform:rotate(18deg)}.jHero:after{width:460px;height:430px;background:var(--jlav);right:-170px;bottom:-180px;transform:rotate(-12deg)}.jHero>*{position:relative;z-index:2}.jHero h1{font-family:'Yu Mincho',Georgia,serif;font-size:clamp(44px,4.3vw,66px);line-height:1.18;margin:18px 0 24px;font-weight:500;letter-spacing:.02em}.jHeroCopy{font-size:16px;line-height:1.9;max-width:540px}.hand{font-family:'Comic Sans MS','Yu Gothic',sans-serif;color:#3c9189;font-size:16px;display:inline-block}.handBig{font-family:'Comic Sans MS','Yu Gothic',sans-serif;color:#272d2a;font-size:18px;transform:rotate(-4deg);display:block;margin:20px 0 0 62%;width:max-content}.organicPhoto{height:440px;overflow:hidden;border-radius:45% 55% 42% 58% / 58% 44% 56% 42%;transform:rotate(2deg);box-shadow:18px 24px 0 rgba(246,205,216,.8);position:relative}.organicPhoto:after{content:'';position:absolute;inset:-14px;border:2px solid rgba(86,190,181,.45);border-radius:50%;transform:rotate(-5deg)}.organicPhoto img{width:100%;height:100%;object-fit:cover}.jButton{display:inline-flex;align-items:center;justify-content:space-between;min-width:220px;background:#61c2b7;color:#fff;text-decoration:none;border-radius:30px;padding:15px 22px;font-size:13px;font-weight:800}.jSection{max-width:1180px;margin:auto;padding:62px 38px}.jSectionHead{display:grid;grid-template-columns:260px 1fr;gap:48px;align-items:start;margin-bottom:34px}.jSectionHead h2{font-family:'Yu Mincho',Georgia,serif;font-size:clamp(30px,3vw,42px);font-weight:500;line-height:1.2;margin:6px 0;text-wrap:balance}.jSectionHead p{line-height:1.85;margin:0;color:#56645e}.jValues{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.jValue{background:#fff;border:1px solid #f1ece7;border-radius:18px;padding:24px;text-align:center;min-height:200px;box-shadow:0 8px 25px rgba(63,53,47,.04)}.jValueIcon{width:72px;height:72px;margin:0 auto 16px;border-radius:50%;display:grid;place-items:center;font-size:28px}.jValue:nth-child(1) .jValueIcon{background:var(--jpink)}.jValue:nth-child(2) .jValueIcon{background:var(--jgreen)}.jValue:nth-child(3) .jValueIcon{background:var(--jlav)}.jValue:nth-child(4) .jValueIcon{background:#f8e8b9}.jValue h3{margin:0 0 8px;font-family:'Yu Mincho',Georgia,serif}.jValue p{font-size:12px;line-height:1.7;color:#596760}.jFlow{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;position:relative}.jFlow:before{content:'';position:absolute;left:8%;right:8%;top:44px;border-top:1px dashed #79c9c1;z-index:0}.jStep{text-align:center;position:relative;z-index:1}.jStepIcon{width:88px;height:88px;border-radius:50%;margin:auto;display:grid;place-items:center;background:#e7f2ef;font-size:24px}.jStep:nth-child(2) .jStepIcon{background:var(--jpink)}.jStep:nth-child(3) .jStepIcon{background:var(--jlav)}.jStep:nth-child(4) .jStepIcon{background:#f8e8b9}.jStep:nth-child(5) .jStepIcon{background:var(--jblue)}.jStep small{display:block;color:#55b8af;margin-top:8px}.jStep b{display:block;margin:8px 0 6px;font-size:14px}.jStep p{font-size:11px;line-height:1.6;color:#68746f;margin:0}.jActivities{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.jActivity{background:#fff;border-radius:8px;overflow:hidden}.jActivity img{width:100%;aspect-ratio:1.35/1;object-fit:cover}.jActivity div{padding:18px;min-height:118px}.jActivity:nth-child(1) div,.jActivity:nth-child(5) div{background:#dceee8}.jActivity:nth-child(2) div{background:#f7d9df}.jActivity:nth-child(3) div{background:#e6def6}.jActivity:nth-child(4) div{background:#f8e9bd}.jActivity h3{font-size:13px;margin:0 0 8px}.jActivity p{font-size:11px;line-height:1.6;margin:0}.jVoices{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.jVoice{border:2px solid #d5e8e4;border-radius:28px;padding:20px;display:grid;grid-template-columns:72px 1fr;gap:16px;align-items:center;background:#fff;position:relative}.jVoice:nth-child(2){border-color:#f0d0d7}.jVoice:nth-child(3){border-color:#dcd4f0}.jVoice img{width:72px;height:72px;border-radius:50%;object-fit:cover}.jVoice strong{display:block;font-family:'Yu Mincho',Georgia,serif;font-size:16px;line-height:1.55}.jVoice small{display:block;margin-top:8px;color:#78847f;font-size:9px}.jCtaWrap{padding:22px 38px 65px}.jCta{max-width:1180px;margin:auto;background:linear-gradient(90deg,#ef9790,#e88380);color:#fff;padding:38px 42px;border-radius:48% 52% 8% 9% / 18% 20% 10% 12%;display:flex;justify-content:space-between;align-items:center;gap:28px}.jCta h2{font-family:'Yu Mincho',Georgia,serif;font-size:30px;line-height:1.3;margin:0}.jCta .jButton{background:#5ec4b9}.photoCredit{font-size:9px;color:#7e8984;margin-top:9px}.buddyNote{font-size:11px;color:#65726c;margin-top:18px}footer{padding:50px 4vw;background:#161616;color:#fff;display:grid;grid-template-columns:1fr auto;gap:35px;align-items:start}.footerBrand{display:flex;gap:15px;align-items:center}.footerBrand p{margin:5px 0;color:#aaa;font-size:12px}.footerLinks{display:flex;gap:22px}.footerLinks a{color:#fff;text-decoration:none;font-size:12px}footer>small{grid-column:1/-1;color:#8d8d8d;border-top:1px solid #333;padding-top:20px}
@media(max-width:1050px){.siteHeader{grid-template-columns:1fr auto}.siteHeader nav{display:none}.splitHero,.institutionalHero{grid-template-columns:1fr}.splitHero .media{min-height:390px}.heroPanel{padding:55px 8vw}.pageHero,.editorialHead{grid-template-columns:1fr;gap:20px}.programEditorial{grid-template-columns:1fr 1fr}.programTile.feature{grid-row:auto;grid-column:1/-1;grid-template-columns:1.1fr 1fr;grid-template-rows:330px}.programTile.feature .body{justify-content:center}.mosaic{grid-template-columns:1fr 1fr;grid-template-rows:300px 240px 220px}.mTile.tall{grid-row:1/3}.mTile.wide{grid-column:1/3;grid-row:3}.proofGrid{grid-template-columns:1fr repeat(3,1fr)}.proofGrid h2{grid-column:1/-1}.factGrid{grid-template-columns:repeat(2,1fr)}.jFrame{grid-template-columns:1fr}.jSide{display:none}.jHero{grid-template-columns:1fr}.jHero .organicPhoto{max-width:720px}.jValues{grid-template-columns:repeat(2,1fr)}.jActivities{grid-template-columns:repeat(3,1fr)}.jVoices{grid-template-columns:1fr 1fr}.jFlow{grid-template-columns:repeat(5,170px);overflow:auto;padding-bottom:10px}.jFlow:before{display:none}}
@media(max-width:650px){.localeBar{overflow:auto;white-space:nowrap}.siteHeader{height:68px;padding:0 18px}.brand b{font-size:13px}.brand small,.headerCta{display:none}.splitHero{min-height:0}.splitHero .media{min-height:300px}.heroPanel{padding:42px 24px}.heroPanel h1{font-size:44px}.heroPanel p{font-size:16px}.shell,.pageHero,.editorialHead,.programEditorial,.quietSection,.sectionGridWide,.storyIntro{padding-left:20px;padding-right:20px}.pageHero{padding-top:48px}.pageHero h1{font-size:40px}.editorialHead{padding-top:48px}.editorialHead h2{font-size:34px}.programEditorial{display:flex;overflow:auto;scroll-snap-type:x mandatory}.programTile,.programTile.feature{min-width:84vw;display:grid;grid-template-columns:1fr;grid-template-rows:180px 1fr;scroll-snap-align:start}.programTile.feature{grid-column:auto}.mosaic{display:block}.mTile{min-height:260px;margin-bottom:10px}.proofGrid{grid-template-columns:1fr}.metric b{font-size:62px}.factGrid{grid-template-columns:1fr}.infoRow{grid-template-columns:1fr;gap:8px}.photoStoryGrid{grid-template-columns:1fr}.photoStory{min-height:360px}.institutionalHero .copy{padding:50px 24px}.jHero{padding:44px 22px 64px}.jHero h1{font-size:40px}.organicPhoto{height:330px}.handBig{margin-left:30%}.jSection{padding:50px 20px}.jSectionHead{grid-template-columns:1fr;gap:14px}.jValues{grid-template-columns:1fr 1fr}.jActivities{display:flex;overflow:auto}.jActivity{min-width:72vw}.jVoices{grid-template-columns:1fr}.jCtaWrap{padding:15px 20px 48px}.jCta{display:block;border-radius:34px}.jCta .jButton{margin-top:20px}footer{grid-template-columns:1fr}.footerLinks{flex-wrap:wrap}}
