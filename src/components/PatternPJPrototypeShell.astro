---
const { title = 'Ritsumeikan University Short-Term Study', description = 'Ritsumeikan University short-term study programmes.', active = '' } = Astro.props;
const nav = [
  ['home','Home','/pattern-pj-prototype/'],
  ['programs','Programs','/pattern-pj-prototype/programs/'],
  ['about','Why Ritsumeikan','/pattern-pj-prototype/about/'],
  ['stories','Stories','/pattern-pj-prototype/stories/'],
  ['buddy','Buddy','/pattern-pj-prototype/buddy/'],
  ['custom','Custom Programs','/pattern-pj-prototype/custom-programs/'],
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,nofollow" />
</head>
<body>
<div class="proto">
  <div class="localeBar" aria-label="Language editions"><strong>日本語</strong><span>English</span><span>한국어</span><span>简体中文</span><span>繁體中文</span></div>
  <header class="siteHeader">
    <a class="brand" href="/pattern-pj-prototype/"><span class="rmark">R</span><span><b>Ritsumeikan University</b><small>Study Abroad Center</small></span></a>
    <nav aria-label="Primary navigation">{nav.map(([key,label,href]) => <a class={active===key?'active':''} href={href}>{label}</a>)}</nav>
    <a class="headerCta" href="/pattern-pj-prototype/programs/">プログラムを探す →</a>
  </header>
  <main><slot /></main>
  <footer>
    <div class="footerBrand"><span class="rmark">R</span><div><b>Ritsumeikan University</b><p>Study Abroad Center</p></div></div>
    <div class="footerLinks"><a href="/pattern-pj-prototype/programs/">Programs</a><a href="/pattern-pj-prototype/buddy/">Buddy</a><a href="/pattern-pj-prototype/custom-programs/">Custom Programs</a></div>
    <small>© Ritsumeikan University</small>
  </footer>
</div>
</body>
</html>

<style is:global>
