---
import { programmeAcademicLoads } from '../data/programme-academic-loads';
const load = programmeAcademicLoads.express;
---
<section class="site-shell" aria-labelledby="rwjpx-academic-load-title" style="padding:2.5rem 0 4rem">
  <div style="border:1px solid #d9e3df;border-radius:16px;background:#fff;padding:clamp(1.4rem,3vw,2rem)">
    <p style="margin:0 0 .5rem;font-size:.78rem;font-weight:800;letter-spacing:.12em;color:#187a70">学習時間</p>
    <h2 id="rwjpx-academic-load-title" style="margin:.1rem 0 .9rem;font-size:clamp(1.7rem,2.6vw,2.25rem);line-height:1.2">2週間の日本語学習</h2>
    <p style="margin:0;line-height:1.8;color:#3f515b;font-size:1rem"><strong>{load.totalMinutes.toLocaleString('ja-JP')}分（{load.totalHours}時間）</strong>。1コマ{load.classMinutes}分 × 1日{load.classesPerDay}コマ × {load.teachingDays}日です。</p>
    <p style="margin:.7rem 0 0;line-height:1.75;color:#5d6e76;font-size:.94rem">日本文化体験は別枠で、90分 × 4回 = 360分です。</p>
  </div>
</section>
