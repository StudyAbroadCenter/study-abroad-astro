---
import type { KoreanProgrammePage } from '../data/korean-programme-pages';
import { programmes } from '../data/programs';
import '../styles/english-programme-detail.css';

interface Props { page: KoreanProgrammePage; }
const { page } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const sharedProgramme = programmes.find((programme) => programme.id === page.id);
const heroImage = sharedProgramme ? `${base}images/${sharedProgramme.image}` : page.heroImage;
const overviewTitle = page.id === 'rsjp'
  ? '교토에서 일본어를 경험하는 여름 프로그램'
  : page.overviewTitle;
---
<article class={`epd epd--${page.status}`} data-program-id={page.id} data-program-status={page.status}>
  <section class="epd-hero" aria-labelledby={`${page.id}-title`}>
    <img class="epd-hero__image" src={heroImage} alt={page.heroAlt} width="1600" height="900" fetchpriority="high" decoding="async" />
    <div class="epd-hero__shade" aria-hidden="true"></div>
    <div class="en-shell epd-hero__content">
      <p class="epd-kicker epd-kicker--light">{page.kicker}</p>
      <h1 id={`${page.id}-title`}>{page.headline}</h1>
      <p class="epd-hero__lead">{page.lead}</p>
      <div class="epd-hero__meta" aria-label="프로그램 정보"><span>{page.code}</span><span>{page.campus}</span></div>
      <div class="epd-hero__actions">
        <a class="epd-button epd-button--solid" href="#details">확인된 정보 보기</a>
        <a class="epd-button epd-button--glass" href="#fit">참가 조건 확인</a>
      </div>
    </div>
  </section>

  <section class="epd-status" aria-label="정보 공개 상태"><div class="en-shell epd-status__inner">
    <span class={`epd-status__badge epd-status__badge--${page.status}`}>{page.statusLabel}</span><p>{page.statusNote}</p>
  </div></section>

  <nav class="epd-rail" aria-label={`${page.code} 페이지 내비게이션`}><div class="en-shell epd-rail__inner">
    <a href="#overview">개요</a><a href="#learning">학습</a><a href="#fit">참가</a><a href="#stay">숙소</a><a href="#details">상세 정보</a>
  </div></nav>

  <section class="epd-overview" id="overview" aria-labelledby={`${page.id}-overview-title`}><div class="en-shell epd-overview__grid">
    <div class="epd-copy"><p class="epd-kicker">프로그램 개요</p><h2 id={`${page.id}-overview-title`}>{overviewTitle}</h2><p>{page.overviewText}</p></div>
    <dl class="epd-highlights" aria-label="프로그램 주요 정보">{page.highlights.map((h) => <div><dt>{h.value}</dt><dd>{h.label}</dd></div>)}</dl>
  </div></section>

  <section class="epd-learning" id="learning" aria-labelledby={`${page.id}-learning-title`}><div class="en-shell">
    <div class="epd-heading"><p class="epd-kicker">학습 구성</p><h2 id={`${page.id}-learning-title`}>{page.academicTitle}</h2><p>{page.academicIntro}</p></div>
    <ol class="epd-learning__grid">{page.academicItems.map((item, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><p>{item}</p></li>)}</ol>
  </div></section>

  <section class="epd-fit" id="fit" aria-labelledby={`${page.id}-fit-title`}><div class="en-shell epd-fit__grid">
    <div class="epd-copy"><p class="epd-kicker">참가 정보</p><h2 id={`${page.id}-fit-title`}>{page.eligibilityTitle}</h2></div>
    <ul class="epd-checklist">{page.eligibilityItems.map((item) => <li>{item}</li>)}</ul>
  </div></section>

  <section class="epd-stay" id="stay" aria-labelledby={`${page.id}-stay-title`}><div class="en-shell epd-stay__grid">
    <div><p class="epd-kicker">숙소</p><h2 id={`${page.id}-stay-title`}>{page.accommodationTitle}</h2></div><p class="epd-stay__copy">{page.accommodationText}</p>
  </div></section>

  <section class="epd-details" id="details" aria-labelledby={`${page.id}-details-title`}><div class="en-shell">
    <div class="epd-heading epd-heading--split"><div><p class="epd-kicker">결정에 필요한 정보</p><h2 id={`${page.id}-details-title`}>확정된 정보와 아직 확인 중인 정보를 구분합니다.</h2></div><p>검토 중인 값은 최종 모집 조건처럼 표시하지 않습니다.</p></div>
    <dl class="epd-facts">{page.facts.map((fact) => <div data-fact-key={fact.key}><dt>{fact.label}</dt><dd><span>{fact.value}</span>{fact.status && <small class="epd-fact-status">{fact.status}</small>}</dd></div>)}</dl>
    <p class="epd-verification">{page.verificationNote}</p>
  </div></section>

  <section class="epd-next" aria-labelledby={`${page.id}-next-title`}><div class="en-shell epd-next__inner">
    <div><p class="epd-kicker epd-kicker--light">다음 단계</p><h2 id={`${page.id}-next-title`}>{page.nextTitle}</h2><p>{page.nextText}</p></div>
    <a class="epd-button epd-button--solid" href="/ko/#program-finder">6개 프로그램 비교하기</a>
  </div></section>
</article>

<style>
  .ko-detail-site .epd-copy h2, .ko-detail-site .epd-fit h2, .ko-detail-site .epd-stay h2 { max-width: 22ch; word-break: keep-all; }
  .ko-detail-site .epd-heading h2, .ko-detail-site .epd-next h2 { word-break: keep-all; text-wrap: pretty; }
  .ko-detail-site .epd-hero h1 { word-break: keep-all; text-wrap: balance; }
  .ko-detail-site [data-program-id='rsjp'] .epd-overview .epd-copy h2 { font-size: clamp(2.1rem, 3.25vw, 3rem); max-width: 26ch; }
  @media (max-width: 640px) {
    .ko-detail-site .epd-copy h2, .ko-detail-site .epd-fit h2, .ko-detail-site .epd-stay h2 { max-width: none; }
    .ko-detail-site [data-program-id='rsjp'] .epd-overview .epd-copy h2 { font-size: inherit; max-width: none; }
    .ko-detail-site .epd-rail__inner { gap: 0.8rem; }
  }
</style>
