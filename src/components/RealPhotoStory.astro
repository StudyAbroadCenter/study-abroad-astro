---
import '../styles/real-photo-story.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path}`;

const scenes = [
  {
    src: image('hero/hero-kinugasa-clocktower.jpg'),
    alt: '立命館大学衣笠キャンパスの時計台とキャンパス風景',
    label: 'キャンパス',
    caption: '大学で過ごす時間から始まる',
    className: 'real-photo-story__item--feature',
  },
  {
    src: image('programs/rwjp/real/rwjp-real-japanese-class.webp'),
    alt: '大学の教室で日本語を学ぶ短期受入プログラムの学生たち',
    label: '学ぶ',
    caption: '教室で学ぶ',
    className: 'real-photo-story__item--standard',
  },
  {
    src: image('programs/rwjp/real/rwjp-real-learning-hub.webp'),
    alt: '学生が集まり学びを共有する短期受入プログラムの活動風景',
    label: '交流',
    caption: '学生と出会い ことばを使う',
    className: 'real-photo-story__item--standard',
  },
  {
    src: image('programs/rwjp/real/rwjp-real-academic-presentation.webp'),
    alt: '教室で発表を聞く短期受入プログラムの学生たち',
    label: '伝える',
    caption: '学んだことを伝える',
    className: 'real-photo-story__item--wide',
  },
  {
    src: image('programs/rwjp/real/rwjp-real-culture-tatami.webp'),
    alt: '畳の部屋で日本文化を学ぶ短期受入プログラムの学生たち',
    label: '文化',
    caption: '見るだけで終わらせない',
    className: 'real-photo-story__item--standard',
  },
  {
    src: image('programs/rwjp/real/rwjp-real-kyoto-field.webp'),
    alt: '京都でグループ活動を行う短期受入プログラムの学生たち',
    label: '京都',
    caption: 'キャンパスの外へ',
    className: 'real-photo-story__item--standard',
  },
  {
    src: image('programs/rwjp/rwjp-student-interaction.webp'),
    alt: '立命館大学の学生と短期受入プログラム参加者が一緒に活動する様子',
    label: '共修',
    caption: '立命館の学生と共に学ぶ',
    className: 'real-photo-story__item--standard',
  },
];
---
<section class="real-photo-story" aria-labelledby="real-photo-story-title">
  <div class="site-shell">
    <header class="real-photo-story__header">
      <div>
        <p class="real-photo-story__eyebrow">実際の風景 · 立命館と京都</p>
        <h2 id="real-photo-story-title">写真で見る<br />学びと京都</h2>
      </div>
      <p class="real-photo-story__lead">教室、キャンパス、人、文化、京都。短期留学の日々を、実際の風景から。</p>
    </header>

    <div class="real-photo-story__grid">
      {scenes.map((scene) => (
        <figure class={`real-photo-story__item ${scene.className}`}>
          <img src={scene.src} alt={scene.alt} loading="lazy" decoding="async" />
          <figcaption>
            <span>{scene.label}</span>
            <strong>{scene.caption}</strong>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="real-photo-story__note">写真は過去の実施・関連活動の記録です。個人が特定されにくいよう一部をトリミング・加工しています。実施内容はプログラム・年度により異なります。</p>
  </div>
</section>
