---
import type { ProgrammePageDraft } from '../data/programme-page-drafts';
import { sharedSiteImages } from '../data/shared-site-images';
import RwjpDecisionPanel from './RwjpDecisionPanel.astro';
import RwjpPracticalGuide from './RwjpPracticalGuide.astro';
import '../styles/rwjp-flagship.css';
import '../styles/rwjp-day-story.css';
import '../styles/rwjp-professional-polish.css';

interface Props { programme: ProgrammePageDraft; }
const { programme } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const shared = (path: string) => `${base}images/${path}`;
const rwjpAssetByName: Record<string, string> = {
  'rwjp-kyoto-winter.webp': sharedSiteImages.rwjp.hero,
  'rwjp-winter-life.webp': sharedSiteImages.rwjp.winterLife,
  'rwjp-japanese-class.webp': sharedSiteImages.rwjp.japaneseClass,
  'rwjp-student-interaction.webp': sharedSiteImages.rwjp.studentInteraction,
  'rwjp-cultural-experience.webp': sharedSiteImages.rwjp.culturalExperience,
  'rwjp-cultural-activity.webp': sharedSiteImages.rwjp.culturalActivity,
  'rwjp-presentation.webp': sharedSiteImages.rwjp.presentation,
  'rwjp-learning-evidence.webp': sharedSiteImages.rwjp.learningEvidence,
};
const rwjpRealByName: Record<string, string> = {
  'rwjp-real-japanese-class.webp': sharedSiteImages.rwjp.real.classroom,
  'rwjp-real-learning-hub.webp': sharedSiteImages.rwjp.real.interaction,
  'rwjp-real-academic-presentation.webp': sharedSiteImages.rwjp.real.presentation,
  'rwjp-real-culture-tatami.webp': sharedSiteImages.rwjp.real.culture,
  'rwjp-real-kyoto-field.webp': sharedSiteImages.rwjp.real.kyoto,
};
const asset = (name: string) => shared(rwjpAssetByName[name] ?? `programs/rwjp/${name}`);
const realAsset = (name: string) => shared(rwjpRealByName[name] ?? `programs/rwjp/real/${name}`);
---
<article class="rwjp-flagship">
  <header class="rwjp-flagship__hero"><div class="site-shell rwjp-flagship__hero-grid"><div class="rwjp-flagship__hero-copy"><p class="rwjp-flagship__eyebrow">{programme.category} · {programme.code}</p><h1>京都で<br /><em>5週間暮らしてみる</em></h1><p class="rwjp-flagship__lead">日本語講座のある日は、午前を中心にしっかり学ぶ。授業が終われば、そこから先はあなたの時間。RWJPは、日本語の勉強と「京都で暮らす」を一つにする5週間です。</p><p class="rwjp-flagship__micro">日本語を学ぶ · 京都で暮らす</p></div><figure class="rwjp-flagship__hero-photo" data-ja-overlay="冬の京都で 5週間暮らす"><img class="crop-winter" src={asset('rwjp-kyoto-winter.webp')} alt="冬の京都で過ごす短期プログラムの様子" width="1600" height="1067" decoding="async" /><figcaption>冬の京都で過ごす時間も、RWJPの5週間の一部です。</figcaption></figure></div></header>
  <nav class="rwjp-flagship__nav" aria-label="RWJPページ内ナビゲーション"><div class="site-shell rwjp-flagship__nav-inner"><a href="#five-weeks">5週間</a><a href="#day">体験</a><a href="#morning">学ぶ</a><a href="#kyoto">暮らす</a><a href="#people">出会う</a><a href="#facts">基本情報</a><a href="#prepare">応募前の確認</a></div></nav>
  <section class="rwjp-flagship__opening" id="five-weeks"><div class="site-shell rwjp-flagship__opening-grid"><div><p class="rwjp-flagship__kicker">5週間を 自分の物語に</p><h2>旅行者から 少しずつ京都の住民へ</h2></div><div class="rwjp-flagship__prose"><p>短い観光では見えにくい京都があります。5週間、大学へ通い、同じ道を歩き、自分の生活圏をつくる。RWJPでは、京都を「訪れる場所」だけではなく、学びながら暮らす場所として経験します。</p><p>主役は参加するあなたです。用意されたものを見るだけではなく、自分で動き、自分の京都を見つける。そのための時間が5週間あります。</p></div></div></section>
  <section class="rwjp-persona" id="persona" aria-labelledby="rwjp-persona-title"><div class="site-shell rwjp-persona__grid"><div class="rwjp-persona__card"><p class="rwjp-flagship__kicker">参加する前に</p><p class="rwjp-persona__meta">大学生・大学院生 · 初心者も応募可 · 一人参加も可能</p><h2 id="rwjp-persona-title">一人で参加しても大丈夫かな</h2><p class="rwjp-persona__lead">そんな不安を感じる学生もいるかもしれません。日本語がまだ初心者でも、海外で5週間暮らすのが初めてでも、まず確認したいのは「自分に合うプログラムか」です。</p><p class="rwjp-persona__decision">ここでは、誰かの成功談ではなく、<strong>RWJPで実際に用意される学習と体験の要素</strong>から参加後の生活を想像できるようにします。</p></div><div class="rwjp-persona__note"><p><strong>応募資格について</strong></p><p>応募時・参加時に大学または大学院へ在籍している学生が対象です。詳しい条件はページ後半の基本情報で確認してください。</p></div></div></section>
  <section class="rwjp-day" id="day" aria-labelledby="rwjp-day-title"><div class="site-shell rwjp-day__intro"><p class="rwjp-flagship__kicker">5週間の中にあるもの</p><h2 id="rwjp-day-title">授業 交流 文化体験 そして自分の時間</h2><p>下のカードは「架空の一日」ではありません。RWJPで確認しているプログラム要素と、授業外に学生自身が選べる時間を分けながら、5週間の生活をイメージできるように並べています。</p><p class="rwjp-day__note">順序や実施日は固定ではありません。昼食、移動、図書館利用、授業後の過ごし方などは参加者自身の選択や当日の状況によって変わります。</p></div><div class="site-shell rwjp-day__layout" data-rwjp-day><aside class="rwjp-day__rail" aria-hidden="true"><span class="rwjp-day__rail-label">はじまり</span><div class="rwjp-day__track"><span class="rwjp-day__progress" data-day-progress></span><span class="rwjp-day__traveller" data-day-traveller>●</span></div><span class="rwjp-day__rail-label">つぎへ</span></aside><div class="rwjp-day__scenes">
    <article class="rwjp-day__scene rwjp-day__scene--commute" data-day-scene><div class="rwjp-day__scene-copy"><p class="rwjp-day__time">自分の時間 · キャンパスへ</p><h3>通学の時間も 京都で暮らす時間</h3><p class="rwjp-day__voice">大将軍寮からキャンパスまでは徒歩を基本に考えます。プログラム期間中は安全上の理由から、自転車等の車輪付き個人移動手段は利用しません。</p><span class="rwjp-day__aside">通学も 京都で暮らす時間</span></div><figure class="rwjp-day__scene-media"><img src={asset('rwjp-winter-life.webp')} alt="冬の京都で過ごす生活の様子" loading="lazy" decoding="async" /></figure></article>
    <article class="rwjp-day__scene rwjp-day__scene--japanese rwjp-day__scene--reverse" data-day-scene><div class="rwjp-day__scene-copy"><p class="rwjp-day__time">プログラム · 日本語</p><h3>日本語講座の日は 午前の学びが中心</h3><p class="rwjp-day__voice">RWJPの中心は日本語学習です。プレゼンテーション、クイズ、試験などを通じて学習を積み重ねます。2027 RWJPの日本語講座はプログラム2日目から始まります。</p><p class="rwjp-day__fact">学習の成果は成績表として確認できます。</p><span class="rwjp-day__aside">学ぶ → 使う → 確かめる → 残す</span></div><figure class="rwjp-day__scene-media rwjp-day__scene-media--real"><img class="rwjp-real-photo rwjp-real-photo--class" src={realAsset('rwjp-real-japanese-class.webp')} alt="大学の教室で授業を受ける短期受入プログラムの学生たち" width="960" height="640" loading="lazy" decoding="async" /></figure></article>
    <article class="rwjp-day__scene rwjp-day__scene--lunch" data-day-scene><div class="rwjp-day__scene-copy"><p class="rwjp-day__time">自分の時間 · 休憩</p><h3>授業の合間は 自分のペースで</h3><p class="rwjp-day__voice">昼食をとる。クラスメイトと話す。少し休む。次の予定を確認する。こうした何気ない時間も、5週間の生活の一部です。</p><span class="rwjp-day__aside">何気ない時間も大切に</span></div><figure class="rwjp-day__scene-media"><img src={asset('rwjp-student-interaction.webp')} alt="参加者同士が交流する様子" loading="lazy" decoding="async" /></figure></article>
    <article class="rwjp-day__scene rwjp-day__scene--buddy rwjp-day__scene--reverse" data-day-scene><div class="rwjp-day__scene-copy"><p class="rwjp-day__time">プログラム · 学生交流</p><h3>教室の外で 日本語を使ってみる</h3><p class="rwjp-day__voice">RWJPでは、立命館の学生との交流機会があります。授業で学んだ日本語を使ったり、大学生活について話したりするきっかけになります。</p><p class="rwjp-day__fact">交流の形式・頻度・内容は、実施年度の正式な運営内容に従います。</p><span class="rwjp-day__aside">会う · 話す · 使ってみる</span></div><figure class="rwjp-day__scene-media rwjp-day__scene-media--real"><img class="rwjp-real-photo rwjp-real-photo--hub" src={realAsset('rwjp-real-learning-hub.webp')} alt="学生たちが発表と学びを共有する短期受入プログラムの活動風景" width="960" height="640" loading="lazy" decoding="async" /></figure></article>
    <article class="rwjp-day__scene rwjp-day__scene--culture" data-day-scene><div class="rwjp-day__scene-copy"><p class="rwjp-day__time">プログラム · 文化体験</p><h3>文化は 見るだけでなく体験する</h3><p class="rwjp-day__voice">RWJPでは日本文化体験を11回実施します。茶道、書道、坐禅などを採用することがありますが、具体的な内容は年度ごとの手配時に決定します。</p><p class="rwjp-day__fact">文化体験は選択制ではなく、原則としてすべてのプログラム活動への参加を求めます。</p><span class="rwjp-day__aside">見るだけでなく 体験する</span></div><figure class="rwjp-day__scene-media rwjp-day__scene-media--real"><img class="rwjp-real-photo rwjp-real-photo--culture" src={realAsset('rwjp-real-culture-tatami.webp')} alt="畳の部屋で日本文化を学ぶ短期受入プログラムの学生たち" width="960" height="640" loading="lazy" decoding="async" /></figure></article>
    <article class="rwjp-day__scene rwjp-day__scene--kyoto rwjp-day__scene--reverse" data-day-scene><div class="rwjp-day__scene-copy"><p class="rwjp-day__time">自分の時間 · 京都</p><h3>授業後の京都を 自分で見つける</h3><p class="rwjp-day__voice">自由時間の過ごし方は自分次第です。歴史、文化、アニメ、街歩き、カフェ。何を選ぶかによって、自分だけの京都の見え方が変わります。</p><span class="rwjp-day__aside">街へ出て 自分で見つける</span></div><figure class="rwjp-day__scene-media rwjp-day__scene-media--real"><img class="rwjp-real-photo rwjp-real-photo--kyoto" src={realAsset('rwjp-real-kyoto-field.webp')} alt="京都の街でグループ活動を行う短期受入プログラムの学生たち" width="960" height="640" loading="lazy" decoding="async" /></figure></article>
    <article class="rwjp-day__scene rwjp-day__scene--night" data-day-scene><div class="rwjp-day__scene-copy"><p class="rwjp-day__time">自分の時間 · 振り返り</p><h3>今日の学びを 自分のペースで振り返る</h3><p class="rwjp-day__voice">授業で分からなかったことを確認する。明日使ってみたい表現をメモする。授業外の時間をどう使うかも、5週間をつくる大切な選択です。</p><span class="rwjp-day__aside">今日学び 明日もう一度使う</span></div><figure class="rwjp-day__scene-media"><img src={asset('rwjp-presentation.webp')} alt="日本語学習の発表活動" loading="lazy" decoding="async" /></figure></article>
  </div></div></section>
  <section class="rwjp-flagship__morning" id="morning"><div class="site-shell"><div class="rwjp-flagship__section-head"><p class="rwjp-flagship__kicker">日本語に向き合う</p><h2>日本語講座では 日本語に向き合う</h2><p>RWJPの中心は日本語学習です。日本語講座のある日は午前を中心に集中して学び、プレゼンテーション、学生交流、クイズ、試験にも取り組みます。日本語授業は直接法を基本とし、日本語で進めます。</p></div><div class="rwjp-flagship__study-line" aria-label="RWJPで行う学習活動"><div><span>01</span><strong>学ぶ</strong><p>日本語で日本語を学ぶ。</p></div><div><span>02</span><strong>使う</strong><p>プレゼンや学生交流で使う。</p></div><div><span>03</span><strong>確かめる</strong><p>クイズや試験で理解を確かめる。</p></div><div><span>04</span><strong>残す</strong><p>学習の成果を成績表で残す。</p></div></div><div class="rwjp-flagship__photo-grid rwjp-flagship__photo-grid--dark"><figure><img class="crop-class" src={asset('rwjp-japanese-class.webp')} alt="日本語授業を受ける学生たち" loading="lazy" decoding="async" /><figcaption><strong>集中</strong> 教室で日本語に集中する。</figcaption></figure><figure><img class="crop-presentation rwjp-real-photo rwjp-real-photo--presentation" src={realAsset('rwjp-real-academic-presentation.webp')} alt="大学の教室で発表を聞く短期受入プログラムの学生たち" width="960" height="640" loading="lazy" decoding="async" /><figcaption><strong>発信</strong> 学んだことを、自分の言葉で伝える。</figcaption></figure><figure><img class="crop-evidence" src={asset('rwjp-learning-evidence.webp')} alt="日本語授業で使われる黒板と学習内容" loading="lazy" decoding="async" /><figcaption><strong>積み重ね</strong> 学習内容を積み上げ、理解を確かめる。</figcaption></figure></div></div></section>
  <section class="rwjp-flagship__switch"><div class="site-shell rwjp-flagship__switch-grid"><p class="rwjp-flagship__switch-time">授業<span>終了</span></p><div><p class="rwjp-flagship__kicker">街へ出て 自分で見つける</p><h2>授業が終わったら 街へ出よう</h2><p>自由時間は、自分の時間です。世界遺産へ行く。アニメやポップカルチャーを探す。歴史のある路地を歩く。カフェで日本語を使ってみる。予定を詰めてもいいし、鴨川で何もしない午後があってもいい。</p><small>自分の京都を見つける</small></div></div></section>
  <section class="rwjp-flagship__kyoto" id="kyoto"><div class="site-shell"><div class="rwjp-flagship__kyoto-intro"><p class="rwjp-flagship__kicker">京都を暮らすように知る</p><h2>YouTubeでは分からない京都へ</h2><p>京都には寺社仏閣と長い歴史があり、その一方でアニメ、ゲーム、ポップカルチャーなど新しい文化もあります。観光都市であり、大学の街でもある。5週間あれば、有名な場所だけではなく、日常の京都にも出会えます。</p></div><div class="rwjp-flagship__photo-story"><figure class="rwjp-flagship__photo-story-main" data-ja-overlay="観光ではなく 京都で暮らす"><img class="crop-life" src={asset('rwjp-winter-life.webp')} alt="冬の京都で過ごす学生たちの様子" loading="lazy" decoding="async" /><figcaption>京都は「見る場所」だけではなく、5週間を過ごす生活の場所。</figcaption></figure><div class="rwjp-flagship__kyoto-notes"><p><strong>歴史と今</strong><span>寺社、歴史、伝統。そして現代のアニメやポップカルチャー。</span></p><p><strong>名所と日常</strong><span>世界的に知られた場所のすぐ近くに、生活の京都がある。</span></p><p><strong>見るから 見つけるへ</strong><span>画面で見て終わらない。自分の足で、自分の「推しの景色」を見つける。</span></p></div></div></div></section>
  <section class="rwjp-flagship__people" id="people"><div class="site-shell rwjp-flagship__people-grid"><div><p class="rwjp-flagship__kicker">人と出会う</p><h2>新しい街には 新しい出会いの機会がある</h2></div><div class="rwjp-flagship__people-copy"><p>RWJPでは、世界から集まる参加者と一緒に日本語を学びます。また、立命館の学生との交流機会があります。日本を知るだけではなく、日本語を実際に使うきっかけをつくります。</p><p>大学は交流の機会を用意します。その先で誰と話すか、何を一緒にするかは、参加者や実施内容によって異なります。</p></div></div><div class="site-shell rwjp-flagship__people-photo"><figure data-ja-overlay="人と出会い 日本語を使う"><img class="crop-interaction" src={asset('rwjp-student-interaction.webp')} alt="学生同士が交流する様子" loading="lazy" decoding="async" /><figcaption><strong>会う · 話す · 使ってみる</strong> 人との交流が、日本語を使う機会になる。</figcaption></figure></div></section>
  <section class="rwjp-flagship__future" id="future"><div class="site-shell rwjp-flagship__future-inner"><p class="rwjp-flagship__kicker">次の学びへ</p><h2>まず家を出る 京都へ来る 自分を試してみる</h2><p>日本語を学び、京都で暮らして、「もっと日本で学びたい」と思ったら、その先を考えることができます。RWJPは進学を保証するプログラムではありません。でも、日本で学ぶ未来を自分で考えるきっかけにはなります。</p></div></section>
  <RwjpDecisionPanel />
  <RwjpPracticalGuide />
  <section class="rwjp-flagship__apply" id="apply"><div class="site-shell rwjp-flagship__apply-grid"><div><p class="rwjp-flagship__kicker">観光だけでは終わらない</p><h2>今回は 京都に住んでみる</h2></div><div><p>まず基本情報と応募条件を確認し、必要書類を準備してください。正式な申請フォームと問い合わせ先は、年度版の公開確認後にこのページから案内します。</p><p class="rwjp-flagship__closing">主役はあなた</p><p class="rwjp-flagship__status">2027年度の主要情報は確認済みです。申請フォーム・所定様式の正式リンクは公開前の最終確認中です。</p></div></div></section>
</article>
<script>const root=document.querySelector('[data-rwjp-day]');if(root){const scenes=Array.from(root.querySelectorAll('[data-day-scene]'));const progress=root.querySelector('[data-day-progress]');const traveller=root.querySelector('[data-day-traveller]');const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;const setProgress=()=>{const rect=root.getBoundingClientRect();const viewportMid=window.innerHeight*.5;const total=Math.max(rect.height-window.innerHeight*.35,1);const travelled=Math.min(Math.max(viewportMid-rect.top,0),total);const pct=Math.min(Math.max(travelled/total,0),1)*100;if(progress instanceof HTMLElement)progress.style.height=`${pct}%`;if(traveller instanceof HTMLElement)traveller.style.top=`${pct}%`};if(reducedMotion){scenes.forEach(scene=>scene.classList.add('is-visible'))}else{const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting)entry.target.classList.add('is-visible')})},{threshold:.28});scenes.forEach(scene=>observer.observe(scene));window.addEventListener('scroll',setProgress,{passive:true});window.addEventListener('resize',setProgress);setProgress()}}</script>
