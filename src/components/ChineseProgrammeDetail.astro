---
import type{ChineseLocale,ChineseProgrammePage}from'../data/chinese-localisation';import'../styles/english-programme-detail.css';interface Props{locale:ChineseLocale;page:ChineseProgrammePage}const{locale,page}=Astro.props;const cn=locale==='zh-CN';const t=cn?{overview:'项目概览',learning:'学习内容',fit:'参加信息',stay:'住宿',details:'详细信息',verified:'查看已确认信息',check:'确认参加条件',decision:'申请前需要确认',decisionTitle:'区分已确认信息、工作方案与待确认信息。',decisionBody:'未确认内容不会写成最终募集条件。',next:'下一步',compare:'比较6个项目'}:{overview:'課程概覽',learning:'學習內容',fit:'參加資訊',stay:'住宿',details:'詳細資訊',verified:'查看已確認資訊',check:'確認參加條件',decision:'申請前需要確認',decisionTitle:'區分已確認資訊、營運方案與待確認資訊。',decisionBody:'未確認內容不會寫成最終招生條件。',next:'下一步',compare:'比較6個課程'};const prefix=cn?'zh-cn':'zh-tw';
---
<article class={`epd epd--${page.status}`} data-program-id={page.id}><section class="epd-hero"><img class="epd-hero__image" src={page.heroImage} alt={page.heroAlt} width="1600" height="900" fetchpriority="high"/><div class="epd-hero__shade"></div><div class="en-shell epd-hero__content"><p class="epd-kicker epd-kicker--light">{page.kicker}</p><h1>{page.headline}</h1><p class="epd-hero__lead">{page.lead}</p><div class="epd-hero__meta"><span>{page.code}</span><span>{page.campus}</span></div><div class="epd-hero__actions"><a class="epd-button epd-button--solid" href="#details">{t.verified}</a><a class="epd-button epd-button--glass" href="#fit">{t.check}</a></div></div></section><section class="epd-status"><div class="en-shell epd-status__inner"><span class={`epd-status__badge epd-status__badge--${page.status}`}>{page.statusLabel}</span><p>{page.statusNote}</p></div></section><nav class="epd-rail"><div class="en-shell epd-rail__inner"><a href="#overview">{t.overview}</a><a href="#learning">{t.learning}</a><a href="#fit">{t.fit}</a><a href="#stay">{t.stay}</a><a href="#details">{t.details}</a></div></nav><section class="epd-overview" id="overview"><div class="en-shell epd-overview__grid"><div class="epd-copy"><p class="epd-kicker">{t.overview}</p><h2>{page.overviewTitle}</h2><p>{page.overviewText}</p></div><dl class="epd-highlights">{page.facts.slice(0,3).map(f=><div><dt>{f.value}</dt><dd>{f.label}</dd></div>)}</dl></div></section><section class="epd-learning" id="learning"><div class="en-shell"><div class="epd-heading"><p class="epd-kicker">{t.learning}</p><h2>{page.academicTitle}</h2><p>{page.academicIntro}</p></div><ol class="epd-learning__grid">{page.academicItems.map((x,i)=><li><span>{String(i+1).padStart(2,'0')}</span><p>{x}</p></li>)}</ol></div></section><section class="epd-fit" id="fit"><div class="en-shell epd-fit__grid"><div class="epd-copy"><p class="epd-kicker">{t.fit}</p><h2>{page.eligibilityTitle}</h2></div><ul class="epd-checklist">{page.eligibilityItems.map(x=><li>{x}</li>)}</ul></div></section><section class="epd-stay" id="stay"><div class="en-shell epd-stay__grid"><div><p class="epd-kicker">{t.stay}</p><h2>{page.accommodationTitle}</h2></div><p class="epd-stay__copy">{page.accommodationText}</p></div></section><section class="epd-details" id="details"><div class="en-shell"><div class="epd-heading epd-heading--split"><div><p class="epd-kicker">{t.decision}</p><h2>{t.decisionTitle}</h2></div><p>{t.decisionBody}</p></div><dl class="epd-facts">{page.facts.map(f=><div><dt>{f.label}</dt><dd><span>{f.value}</span>{f.status&&<small class="epd-fact-status">{f.status}</small>}</dd></div>)}</dl></div></section><section class="epd-next"><div class="en-shell epd-next__inner"><div><p class="epd-kicker epd-kicker--light">{t.next}</p><h2>{page.nextTitle}</h2><p>{page.nextText}</p></div><a class="epd-button epd-button--solid" href={`/${prefix}/#program-finder`}>{t.compare}</a></div></section></article><style>.zh-detail-site h1,.zh-detail-site h2{text-wrap:balance}.zh-detail-site .epd-copy h2,.zh-detail-site .epd-fit h2,.zh-detail-site .epd-stay h2{max-width:20em}@media(max-width:640px){.zh-detail-site .epd-copy h2,.zh-detail-site .epd-fit h2,.zh-detail-site .epd-stay h2{max-width:none}}</style>
