    const strip = (node) => {
      if (node?.nodeType === Node.TEXT_NODE && node.textContent) {
        node.textContent = node.textContent.replace(/[。、！!？?]+\s*$/, '');
      }
    };
    strip(heading.lastChild);
    heading.querySelectorAll('span, strong, em').forEach((part) => strip(part.lastChild));
  });

