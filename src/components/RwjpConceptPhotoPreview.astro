---
import '../styles/rwjp-concept-photo-preview.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const concept = (name: string) => `${base}images/programs/rwjp/concept/${name}`;

const scenes = [
  {
    eyebrow: 'STUDY',
    title: '日本語に集中する。',
    body: '日本語講座を中心に、学ぶ時間の密度を視覚化したイメージです。',
    image: 'rwjp-concept-classroom.webp',
    alt: 'RWJPの日本語授業を想定した生成イメージ',
  },
  {
    eyebrow: 'CONNECT',
    title: 'キャンパスで人と出会う。',
    body: '教室外での交流や、ことばを使うきっかけをイメージしています。',
    image: 'rwjp-concept-campus-exchange.webp',
    alt: 'RWJPでのキャンパス交流を想定した生成イメージ',
  },
  {
    eyebrow: 'KYOTO',
    title: '京都そのものを学びの場所に。',
    body: '授業外の街歩きや観察を、自分の学びにつなげる時間をイメージしています。',
    image: 'rwjp-concept-kyoto-learning.webp',
    alt: 'RWJPで京都を学びの場として過ごす様子を想定した生成イメージ',
  },
];
---
<section class="rwjp-concept" id="concept-preview" aria-labelledby="rwjp-concept-title">
  <div class="site-shell rwjp-concept__intro">
    <div>
      <p class="rwjp-concept__kicker">IMAGE PREVIEW · 生成イメージ</p>
      <h2 id="rwjp-concept-title">RWJPの5週間を、<br />もう少し具体的に想像する。</h2>
    </div>
    <div class="rwjp-concept__copy">
      <p>授業、キャンパスでの交流、京都で過ごす時間。文章だけでは伝わりにくい5週間の雰囲気を、ページ構成確認用のイメージ写真で可視化しています。</p>
      <aside class="rwjp-concept__disclosure" aria-label="生成イメージについての注意">
        <strong>IMAGE PHOTO</strong>
        <span>以下の写真はAIで作成した生成イメージで、実際のRWJP参加者・授業・実施風景ではありません。正式公開時には、可能な範囲で実際のプログラム写真へ差し替えます。</span>
      </aside>
    </div>
  </div>

  <div class="site-shell rwjp-concept__grid">
    {scenes.map((scene) => (
      <figure class="rwjp-concept__card">
        <div class="rwjp-concept__media">
          <img src={concept(scene.image)} alt={scene.alt} width="720" height="480" loading="lazy" decoding="async" />
          <span class="rwjp-concept__badge">生成イメージ</span>
        </div>
        <figcaption>
          <p>{scene.eyebrow}</p>
          <h3>{scene.title}</h3>
          <span>{scene.body}</span>
        </figcaption>
      </figure>
    ))}
  </div>

  <div class="site-shell rwjp-concept__closing">
    <span>CONCEPT → REAL EXPERIENCE</span>
    <p>このイメージを入口に、ページ内の「学ぶ」「出会う」「京都で暮らす」の各セクションで、確認済みのプログラム内容を確認してください。</p>
  </div>
</section>
