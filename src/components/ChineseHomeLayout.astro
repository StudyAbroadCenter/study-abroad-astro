---
import'../styles/student-recruitment.css';import'../styles/mvp-refinement.css';import'../styles/institutional-polish.css';import'../styles/typography-final.css';import'../styles/global-reach-fiveweek.css';import'../styles/homepage-final-fixes.css';import'../styles/english-home.css';import type{ChineseLocale}from'../data/chinese-localisation';interface Props{locale:ChineseLocale;title:string;description:string;robots?:string}const{locale,title,description,robots='noindex,nofollow'}=Astro.props;const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:`${import.meta.env.BASE_URL}/`;const cn=locale==='zh-CN',prefix=cn?'zh-cn':'zh-tw',other=cn?'zh-tw':'zh-cn',canonical=Astro.site?new URL(Astro.url.pathname,Astro.site):Astro.url,abs=(p:string)=>Astro.site?new URL(p,Astro.site):p;
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content={robots}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="ja" href={abs(base)}/><link rel="alternate" hreflang="en" href={abs(`${base}en/`)}/><link rel="alternate" hreflang="ko" href={abs(`${base}ko/`)}/><link rel="alternate" hreflang={locale} href={canonical}/><link rel="alternate" hreflang={cn?'zh-TW':'zh-CN'} href={abs(`${base}${other}/`)}/><meta name="theme-color" content="#fffdfa"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><title>{title}</title></head><body class={`en-site zh-home-site ${cn?'zh-cn-home':'zh-tw-home'}`}><a class="en-skip-link" href="#main-content">{cn?'跳到主要内容':'跳到主要內容'}</a><header class="en-header"><div class="site-shell en-header__inner"><a class="en-header__brand" href={`${base}${prefix}/`}><strong>Ritsumeikan University</strong><span>{cn?'短期留学项目':'短期留學課程'}</span></a><nav class="en-header__nav"><a href="#program-finder">{cn?'项目':'課程'}</a><a href="#why-ritsumeikan">{cn?'学习体验':'學習體驗'}</a><a href="#global-reach">{cn?'全球参与':'全球參與'}</a><a href="#support">{cn?'申请准备':'申請準備'}</a><a class="en-header__language" href={`${base}${other}/`} lang={cn?'zh-TW':'zh-CN'}>{cn?'繁體中文':'简体中文'}</a><a class="en-header__language" href={`${base}en/`} lang="en">English</a><a class="en-header__language" href={`${base}ko/`} lang="ko">한국어</a><a class="en-header__language" href={base} lang="ja">日本語</a></nav></div></header><main id="main-content" tabindex="-1"><slot/></main><footer class="recruitment-footer en-footer"><div class="site-shell recruitment-footer__inner"><div><strong>Ritsumeikan University Study Abroad Center</strong><p>{cn?'短期国际学生项目':'短期國際學生課程'}</p></div><div class="recruitment-footer__legal"><p>{cn?'照片可能来自往年或相关项目；实际课程、活动与学生交流因项目而异。':'照片可能來自往年或相關課程；實際課程、活動與學生交流依課程而異。'}</p><small>© Ritsumeikan University. All Rights Reserved.</small></div></div></footer></body></html>
<style is:global>
.zh-home-site{font-family:Inter,"Noto Sans CJK SC","Noto Sans CJK TC","PingFang SC","PingFang TC","Microsoft YaHei","Microsoft JhengHei",sans-serif}
.zh-home-site h1,.zh-home-site h2,.zh-home-site h3,.zh-home-site p,.zh-home-site li,.zh-home-site dd{word-break:normal;overflow-wrap:break-word}
.zh-home-site .recruitment-hero__location,.zh-home-site .recruitment-hero__note,.zh-home-site .recruitment-hero__scroll,.zh-home-site .recruitment-hero__facts dd,.zh-home-site .programme-card__visual>small,.zh-home-site .programme-pathways article>p,.zh-home-site .en-partner .section-kicker,.zh-home-site .partner-programme__themes>p,.zh-home-site .en-recruitment-banner__links small,.zh-home-site .en-evidence__note,.zh-home-site figcaption{font-size:.75rem!important}
.zh-home-site .zh-programme-timing{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin:1rem 0 .2rem}
.zh-home-site .zh-programme-timing>div{padding:.72rem .78rem;border:1px solid #ddd7d2;border-radius:.75rem;background:#f7f5f2}
.zh-home-site .zh-programme-timing dt{font-size:.75rem;font-weight:700;color:#6f6863}
.zh-home-site .zh-programme-timing dd{margin:.28rem 0 0;font-size:.88rem;font-weight:800}
.zh-home-site .partner-programme__themes li{min-height:2.75rem!important;display:flex!important;align-items:center!important;padding-top:.6rem!important;padding-bottom:.6rem!important}
@media(max-width:560px){
.zh-home-site .en-header__inner{flex-direction:column!important;align-items:flex-start!important;gap:.55rem!important;padding-top:.65rem!important;padding-bottom:.65rem!important}
.zh-home-site .en-header__brand{max-width:100%!important}
.zh-home-site .en-header__nav{width:100%!important;display:flex!important;flex-wrap:wrap!important;justify-content:flex-start!important;gap:.35rem .55rem!important;min-width:0!important}
.zh-home-site .en-header__nav>a:not(.en-header__language){display:none!important}
.zh-home-site .en-header__language{white-space:nowrap!important;font-size:.75rem!important}
.zh-home-site .en-programme-grid .programme-card{display:block!important;min-height:0!important;overflow:hidden!important}
.zh-home-site .en-programme-grid .en-programme-card__visual{width:100%!important;height:auto!important;aspect-ratio:16/9!important}
.zh-home-site .en-programme-grid .en-programme-card__visual img{width:100%!important;height:100%!important;object-fit:cover!important}
.zh-home-site .en-programme-grid .programme-card__body{width:100%!important;padding:1rem 1.05rem 1.1rem!important}
.zh-home-site .en-programme-grid .programme-card__body>p:not(.programme-card__experience){display:block!important;-webkit-line-clamp:unset!important;overflow:visible!important;font-size:.86rem!important;line-height:1.5!important}
.zh-home-site .zh-programme-timing{grid-template-columns:1fr}
.zh-home-site .zh-programme-timing>div{display:grid;grid-template-columns:minmax(78px,.42fr) minmax(0,1fr);gap:.65rem;align-items:center}
.zh-home-site .zh-programme-timing dd{margin-top:0;text-align:right}
.zh-home-site .en-photo-story__grid{grid-template-columns:1fr!important}
}
</style>
