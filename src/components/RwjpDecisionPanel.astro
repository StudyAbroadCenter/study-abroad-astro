---
import { rwjp2027Facts, isKnownFact } from '../data/rwjp-2027-facts';
import '../styles/rwjp-decision-panel.css';

const f = rwjp2027Facts;
const dateLabel = isKnownFact(f.programmeDates)
  ? `${f.programmeDates.value.start.replaceAll('-', '.')} — ${f.programmeDates.value.end.replaceAll('-', '.')}`
  : '確認中';
const feeLabel = isKnownFact(f.programmeFee)
  ? `${f.programmeFee.value.toLocaleString('ja-JP')}円`
  : '正式決定後に掲載';
const applicationStart = isKnownFact(f.applicationPeriod) ? f.applicationPeriod.value.start : null;
const applicationEnd = isKnownFact(f.applicationPeriod) ? f.applicationPeriod.value.end : null;
const applicationLabel = applicationStart && applicationEnd
  ? `${applicationStart.replaceAll('-', '.')} — ${applicationEnd.replaceAll('-', '.')}`
  : '正式決定後に掲載';
---
<section class="rwjp-decision" id="facts" aria-labelledby="rwjp-decision-title">
  <div class="site-shell">
    <div class="rwjp-decision__head">
      <p class="rwjp-decision__kicker">2027 RWJP · DECISION FACTS</p>
      <h2 id="rwjp-decision-title">参加を決める前に、条件を確認する。</h2>
      <p>魅力だけでなく、日程・学習量・宿泊・支払・応募資格など、判断に必要な情報を確認済みの範囲で掲載します。</p>
    </div>

    <dl class="rwjp-decision__facts">
      <div><dt>正式名称</dt><dd>{f.officialName.value}</dd></div>
      <div><dt>実施日程</dt><dd>{dateLabel}</dd></div>
      <div><dt>期間</dt><dd>{f.durationLabel.value}</dd></div>
      <div><dt>キャンパス</dt><dd>{f.campus.value}</dd></div>
      <div><dt>日本語学習</dt><dd>{f.japaneseMinutes.value}分</dd></div>
      <div><dt>文化学習・体験</dt><dd>{f.cultureMinutes.value}分</dd></div>
      <div><dt>宿泊</dt><dd>{f.accommodation.value}</dd></div>
      <div><dt>支払方法</dt><dd>{f.paymentMethod.value}</dd></div>
      <div><dt>参加費</dt><dd>{feeLabel}</dd></div>
      <div><dt>募集期間</dt><dd>{applicationLabel}</dd></div>
      <div>
        <dt>募集状況</dt>
        <dd>
          {applicationStart && applicationEnd ? (
            <span data-rwjp-application-status data-start={applicationStart} data-end={applicationEnd}>
              募集期間：{applicationLabel}
            </span>
          ) : '確認中'}
        </dd>
      </div>
    </dl>

    <div class="rwjp-decision__requirements" aria-label="RWJP応募資格と日本語要件">
      <article>
        <strong>応募資格</strong>
        <p>{f.eligibility.value}</p>
      </article>
      <article>
        <strong>日本語要件</strong>
        <p>{f.japaneseRequirement.value}</p>
      </article>
    </div>

    <div class="rwjp-decision__notice" aria-label="キャンセルと返金">
      <strong>キャンセル・返金</strong>
      <p>{f.refundPolicy.value}</p>
    </div>

    <div class="rwjp-decision__actions" aria-label="RWJPの次の確認項目">
      <a href="#rwjp-fit">自分に合うか確認する</a>
      <span aria-disabled="true">問い合わせ導線は日本語Contact完成後に有効化</span>
    </div>
  </div>
</section>

<section class="rwjp-fit" id="rwjp-fit" aria-labelledby="rwjp-fit-title">
  <div class="site-shell rwjp-fit__grid">
    <div>
      <p class="rwjp-decision__kicker">IS RWJP FOR YOU?</p>
      <h2 id="rwjp-fit-title">こんな学生に向いています。</h2>
    </div>
    <div class="rwjp-fit__body">
      <ul>
        <li>短期旅行ではなく、京都で数週間生活しながら日本語を学びたい。</li>
        <li>日本語学習をプログラムの中心に置きたい。</li>
        <li>授業だけでなく、学生交流や文化体験にも参加したい。</li>
        <li>一人で参加しても、自分から動いて新しい環境に入ってみたい。</li>
      </ul>
      <p>応募前に、上記の在籍条件と日本語要件を必ず確認してください。</p>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-rwjp-application-status]').forEach((node) => {
    const start = node.getAttribute('data-start');
    const end = node.getAttribute('data-end');
    if (!start || !end) return;

    const jstToday = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
    if (jstToday < start) {
      node.textContent = `募集開始前（${start.replaceAll('-', '.')} 受付開始）`;
    } else if (jstToday <= end) {
      node.textContent = `募集中（${end.replaceAll('-', '.')} 締切）`;
    } else {
      node.textContent = `募集終了（募集期間 ${start.replaceAll('-', '.')} — ${end.replaceAll('-', '.')}）`;
    }
  });
</script>
