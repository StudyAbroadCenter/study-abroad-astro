---
import { rwjp2027Facts, isKnownFact, rwjp2027JourneyLinks, isJourneyLinkReady } from '../data/rwjp/index';
import '../styles/rwjp-decision-panel.css';

const f = rwjp2027Facts;
const applicationLink = rwjp2027JourneyLinks.application;
const inquiryLink = rwjp2027JourneyLinks.inquiry;
const dateLabel = isKnownFact(f.programmeDates) ? `${f.programmeDates.value.start.replaceAll('-', '.')} — ${f.programmeDates.value.end.replaceAll('-', '.')}` : '確認中';
const feeLabel = isKnownFact(f.programmeFee) ? `${f.programmeFee.value.toLocaleString('ja-JP')}円` : '正式決定後に掲載';
const accommodationFeeLabel = isKnownFact(f.accommodationFee) ? `${f.accommodationFee.value.toLocaleString('ja-JP')}円` : '確認中';
const accommodationDateLabel = isKnownFact(f.accommodationDates) ? `${f.accommodationDates.value.checkIn.replaceAll('-', '.')} チェックイン — ${f.accommodationDates.value.checkOut.replaceAll('-', '.')} チェックアウト` : '確認中';
const japaneseLoadLabel = isKnownFact(f.japaneseMinutes) && isKnownFact(f.japaneseClassMinutes) && isKnownFact(f.japaneseClassesPerDay) && isKnownFact(f.japaneseTeachingDays)
  ? `5週間合計 ${f.japaneseMinutes.value.toLocaleString('ja-JP')}分（${f.japaneseClassMinutes.value}分 × 1日${f.japaneseClassesPerDay.value}コマ × ${f.japaneseTeachingDays.value}日）／57.5時間`
  : '確認中';
const cultureLoadLabel = isKnownFact(f.cultureMinutes) && isKnownFact(f.cultureSessions) && isKnownFact(f.cultureSessionMinutes)
  ? `5週間合計 ${f.cultureMinutes.value.toLocaleString('ja-JP')}分（${f.cultureSessionMinutes.value}分 × ${f.cultureSessions.value}回）`
  : '確認中';
const refundAmountLabel = isKnownFact(f.refundAmount) ? `${f.refundAmount.value.toLocaleString('ja-JP')}円` : null;
const applicationStart = isKnownFact(f.applicationPeriod) ? f.applicationPeriod.value.start : null;
const applicationEnd = isKnownFact(f.applicationPeriod) ? f.applicationPeriod.value.end : null;
const applicationLabel = applicationStart && applicationEnd ? `${applicationStart.replaceAll('-', '.')} — ${applicationEnd.replaceAll('-', '.')}` : '正式決定後に掲載';
const applicationReady = isJourneyLinkReady(applicationLink) && Boolean(applicationLink.url);
---
<section class="rwjp-decision" id="facts" aria-labelledby="rwjp-decision-title">
  <div class="site-shell">
    <div class="rwjp-decision__head"><p class="rwjp-decision__kicker">2027 RWJP · DECISION FACTS</p><h2 id="rwjp-decision-title">参加を決める前に 条件を確認</h2><p>魅力だけでなく、日程・学習量・宿泊・支払・応募資格など、判断に必要な情報を確認済みの範囲で掲載します。</p></div>
    <dl class="rwjp-decision__facts">
      <div><dt>正式名称</dt><dd>{f.officialName.value}</dd></div><div><dt>実施日程</dt><dd>{dateLabel}</dd></div><div><dt>期間</dt><dd>{f.durationLabel.value}</dd></div><div><dt>キャンパス</dt><dd>{f.campus.value}</dd></div><div><dt>日本語講座</dt><dd>{japaneseLoadLabel}</dd></div><div><dt>日本文化体験</dt><dd>{cultureLoadLabel}</dd></div><div><dt>プログラム費用</dt><dd>{feeLabel}</dd></div><div><dt>大将軍寮 宿泊費</dt><dd>{accommodationFeeLabel}（プログラム費用には含まれません）</dd></div><div><dt>大将軍寮 宿泊期間</dt><dd>{accommodationDateLabel}（この日程は必須）</dd></div><div><dt>宿泊</dt><dd>{f.accommodation.value}</dd></div><div><dt>支払方法</dt><dd>{f.paymentMethod.value}</dd></div><div><dt>募集期間</dt><dd>{applicationLabel}</dd></div>
      <div><dt>募集状況</dt><dd>{applicationStart && applicationEnd ? <span data-rwjp-application-status data-start={applicationStart} data-end={applicationEnd}>募集期間：{applicationLabel}</span> : '確認中'}</dd></div>
    </dl>
    <div class="rwjp-decision__requirements" aria-label="RWJP応募資格と日本語要件"><article><strong>応募資格</strong><p>{f.eligibility.value}</p></article><article><strong>日本語要件</strong><p>{f.japaneseRequirement.value}</p></article></div>
    <div class="rwjp-decision__notice" aria-label="支払いに関する注意"><strong>支払いについて</strong><p>{f.paymentPolicy.value}</p></div>
    <div class="rwjp-decision__notice" aria-label="宿泊に関する注意"><strong>宿泊について</strong><p>{f.accommodationPolicy.value}</p></div>
    <div class="rwjp-decision__notice" aria-label="キャンセルと返金"><strong>キャンセル・返金</strong><p>{refundAmountLabel ? `支払後のキャンセルでは管理手数料${refundAmountLabel}を差し引きます。` : '管理手数料は正式決定後に掲載します。'} {f.refundPolicy.value}</p></div>
    <div class="rwjp-decision__contact" aria-label="RWJP公式問い合わせ先">
      <strong>公式問い合わせ先</strong>
      <p><a href="mailto:rsjprwjp@st.ritsumei.ac.jp">rsjprwjp@st.ritsumei.ac.jp</a> ／ <a href="tel:+81754663009">075-466-3009</a></p>
    </div>
    <div class="rwjp-decision__actions" aria-label="RWJPの応募・問い合わせ">
      <a href="#prepare">応募前の詳細を確認する</a>
      {applicationReady && applicationLink.url && applicationStart && applicationEnd
        ? <>
            <a href={applicationLink.url} target={applicationLink.external ? '_blank' : undefined} rel={applicationLink.external ? 'noopener noreferrer' : undefined} data-rwjp-apply-link data-start={applicationStart} data-end={applicationEnd} hidden>{applicationLink.labelJa}</a>
            <span aria-disabled="true" data-rwjp-apply-closed data-start={applicationStart} data-end={applicationEnd}>応募受付期間外</span>
          </>
        : <span aria-disabled="true">応募フォーム：Microsoft Forms準備中</span>}
      {isJourneyLinkReady(inquiryLink) && inquiryLink.url
        ? <a href={inquiryLink.url}>{inquiryLink.labelJa}</a>
        : <span aria-disabled="true">問い合わせ先：確認待ち</span>}
    </div>
  </div>
</section>
<section class="rwjp-fit" id="rwjp-fit" aria-labelledby="rwjp-fit-title"><div class="site-shell rwjp-fit__grid"><div><p class="rwjp-decision__kicker">IS RWJP FOR YOU?</p><h2 id="rwjp-fit-title">こんな学生に向いています</h2></div><div class="rwjp-fit__body"><ul><li>短期旅行ではなく、京都で数週間生活しながら日本語を学びたい。</li><li>日本語学習をプログラムの中心に置きたい。</li><li>授業だけでなく、学生交流や文化体験にも参加したい。</li><li>一人で参加しても、自分から動いて新しい環境に入ってみたい。</li></ul><p>応募前に、上記の在籍条件・日本語要件・宿泊条件を必ず確認してください。</p></div></div></section>
<script is:inline>
  (() => {
    const jstToday = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
    const statusNodes = document.querySelectorAll('[data-rwjp-application-status]');
    statusNodes.forEach((node) => {
      const start = node.getAttribute('data-start');
      const end = node.getAttribute('data-end');
      if (!start || !end) return;
      if (jstToday < start) node.textContent = `募集開始前（${start.replaceAll('-', '.')} 受付開始）`;
      else if (jstToday <= end) node.textContent = `募集中（${end.replaceAll('-', '.')} 締切）`;
      else node.textContent = `募集終了（募集期間 ${start.replaceAll('-', '.')} — ${end.replaceAll('-', '.')}）`;
    });

    const applyLink = document.querySelector('[data-rwjp-apply-link]');
    const closedState = document.querySelector('[data-rwjp-apply-closed]');
    const start = applyLink?.getAttribute('data-start') || closedState?.getAttribute('data-start');
    const end = applyLink?.getAttribute('data-end') || closedState?.getAttribute('data-end');
    const isOpen = Boolean(start && end && jstToday >= start && jstToday <= end);
    if (applyLink instanceof HTMLElement) applyLink.hidden = !isOpen;
    if (closedState instanceof HTMLElement) {
      closedState.hidden = isOpen;
      if (start && end) {
        closedState.textContent = jstToday < start
          ? `応募受付は ${start.replaceAll('-', '.')} から開始します`
          : `2027 RWJPの応募受付は終了しました`;
      }
    }

    const closingStatus = document.querySelector('.rwjp-flagship__status');
    if (closingStatus) {
      if (!applyLink) closingStatus.textContent = '2027年度の主要情報は確認済みです。Microsoft Formsの申請URLと所定様式は公開前の最終確認中です。';
      else if (isOpen) closingStatus.textContent = '2027 RWJPは現在応募受付中です。応募前に条件と必要書類を確認してください。';
      else if (start && jstToday < start) closingStatus.textContent = `2027 RWJPの応募受付は ${start.replaceAll('-', '.')} に開始します。`;
      else closingStatus.textContent = '2027 RWJPの応募受付は終了しました。問い合わせは公式メールまたは電話をご利用ください。';
    }
  })();
</script>
