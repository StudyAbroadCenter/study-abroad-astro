  const initials = (name: string) => name
    .replace(/\([^)]*\)/g, '')
    .split(/[\s,&-]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');

  const makeLogo = (name: string, domain?: string) => {
    const holder = document.createElement('span');
    holder.className = 'network-atlas__institution-logo';
    const fallback = document.createElement('span');
    fallback.textContent = initials(name);
    holder.appendChild(fallback);
    if (domain) {
      const image = document.createElement('img');
      image.src = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`;
      image.alt = '';
      image.loading = 'lazy';
      image.decoding = 'async';
      image.addEventListener('error', () => holder.classList.add('is-fallback'), { once: true });
      holder.prepend(image);
    } else {
      holder.classList.add('is-fallback');
    }
    return holder;
  };

  const enhanceRow = (row: HTMLLIElement) => {
    if (row.querySelector('.network-atlas__institution-logo')) return;
    const nameElement = row.querySelector('span');
    const countElement = row.querySelector('b');
    if (!(nameElement instanceof HTMLElement)) return;
    const name = nameElement.textContent?.trim() ?? '';
    nameElement.classList.add('network-atlas__institution-name');
    countElement?.classList.add('network-atlas__institution-count');
    row.prepend(makeLogo(name, knownDomains[name]));
  };

  const appendExtra = (list: HTMLUListElement, entry: InstitutionEntry) => {
    const existing = Array.from(list.querySelectorAll('li span')).some((item) => item.textContent?.trim() === entry.name);
    if (existing) return;
    const row = document.createElement('li');
    row.appendChild(makeLogo(entry.name, entry.domain));
    const name = document.createElement('span');
    name.className = 'network-atlas__institution-name';
    name.textContent = entry.name;
    const status = document.createElement('b');
    status.className = 'network-atlas__institution-count network-atlas__institution-count--unquantified';
    status.textContent = '実績あり';
    row.append(name, status);
    list.appendChild(row);
  };

  const atlas = document.querySelector('[data-network-atlas]');
  if (atlas instanceof HTMLElement) {
    atlas.querySelectorAll('[data-country-panel]').forEach((panel) => {
      if (!(panel instanceof HTMLElement)) return;
      const list = panel.querySelector('.network-atlas__institutions ul');
      if (!(list instanceof HTMLUListElement)) return;
      list.querySelectorAll('li').forEach((row) => {
        if (row instanceof HTMLLIElement) enhanceRow(row);
      });
      const countryId = panel.dataset.countryPanel ?? '';
      (extraInstitutions[countryId] ?? []).forEach((entry) => appendExtra(list, entry));
      const remainder = panel.querySelector('.network-atlas__institutions > p');
      if (remainder instanceof HTMLElement && (extraInstitutions[countryId]?.length ?? 0) > 0) {
        remainder.textContent = '上記以外にも参加・連携実績があります。';
      }
    });

    const note = atlas.querySelector('.network-atlas__data-note');
    if (note instanceof HTMLElement) {
      note.textContent = '人数・機関数は2023–2026年のRSJP/RWJP系実績。大学一覧には、確認済みの短期受入・連携実績例を追加掲載しています。人数内訳を確認できる大学は人数を表示しています。';
    }
  }
</script>