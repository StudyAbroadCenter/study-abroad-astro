---
const customByCountry: Record<string, string[]> = {
  'united-states': [
    'Case Western Reserve University',
    'James Madison University',
    'Florida International University',
    'University of North Carolina Asheville',
  ],
  australia: ['RMIT University'],
  'hong-kong': ['City University of Hong Kong'],
};

type ApprovedLogo = {
  src: string;
  alt: string;
  source: string;
  permissionNote: string;
};

// Production rule:
// Only logos for which Ritsumeikan / the site operator can demonstrate permission for this
// external web use belong in approvedLogos. Finding an official logo file is NOT sufficient.
// Until permission is documented, the UI intentionally falls back to neutral monograms.
// Never use favicons, guessed domains, third-party logo services, or AI-redrawn marks.
const approvedLogos: Record<string, ApprovedLogo> = {
  // Add an institution only after approval / licence for this external website is documented.
};

// Neutral text monograms are not logos. Explicit entries are used where a familiar abbreviation
// improves recognition. They do not claim or reproduce an institution's graphic trademark.
const preferredMonograms: Record<string, string> = {
  'Case Western Reserve University': 'CWRU',
  'James Madison University': 'JMU',
  'Florida International University': 'FIU',
  'University of North Carolina Asheville': 'UNCA',
  'College of Staten Island (CUNY)': 'CSI',
  'Hunter College (CUNY)': 'HC',
  'Western Michigan University': 'WMU',
  'University of New Mexico': 'UNM',
  'University of Pittsburgh': 'PITT',
  'University of Wisconsin - Madison': 'UW',
  'University of Wisconsin–Madison': 'UW',
  'University of Melbourne': 'MELB',
  'Australian National University': 'ANU',
  'University of Queensland': 'UQ',
  'Monash University': 'MON',
  'University of Sydney': 'USYD',
  'RMIT University': 'RMIT',
  'University of Alberta': 'UA',
  'University of Toronto': 'UofT',
  'University of Waterloo': 'UW',
  'Gachon University': 'GU',
  'Konkuk University': 'KU',
  'Ajou University': 'AU',
  'Daejeon University': 'DJU',
  'Sookmyung Women\'s University': 'SMU',
  'Chung-Ang University': 'CAU',
  'Beihang University': 'BUAA',
  'East China University of Science and Technology': 'ECUST',
  'Nanjing University': 'NJU',
  'Shanghai Jiao Tong University': 'SJTU',
  'National Taiwan University': 'NTU',
  'National Chengchi University': 'NCCU',
  'Singapore Management University': 'SMU',
  'Nanyang Technological University': 'NTU',
  'National University of Singapore': 'NUS',
  'University of Leeds': 'LEEDS',
  'King\'s College London': 'KCL',
  'Cardiff University': 'CU',
  'University of Leicester': 'LEIC',
  'University of Helsinki': 'UH',
  'University of Auckland': 'UoA',
  'The Chinese University of Hong Kong': 'CUHK',
  'City University of Hong Kong': 'CityU',
  'University of Macau': 'UM',
  'Qatar University': 'QU',
};

// Official brand assets or rules were found, but permission for this external Ritsumeikan
// recruitment/evidence site is required or has not yet been demonstrated. Keep monograms.
const permissionRequiredInstitutions = new Set([
  'Case Western Reserve University',
  'James Madison University',
  'University of Wisconsin - Madison',
  'University of Wisconsin–Madison',
  'Western Michigan University',
  'University of New Mexico',
  'University of Pittsburgh',
  'Monash University',
  'University of Waterloo',
  'University of Melbourne',
  'Australian National University',
  'University of Queensland',
  'RMIT University',
  'University of Sydney',
  'National University of Singapore',
  'Nanyang Technological University',
  'Singapore Management University',
  'Sookmyung Women\'s University',
  'National Taiwan University',
  'University of Helsinki',
  'University of Leeds',
  'University of Toronto',
  'University of Alberta',
]);

// The institution publishes an official UI/logo asset, but public availability alone does not
// establish third-party usage permission. These also stay on monograms until permission is clear.
const permissionUnconfirmedInstitutions = new Set([
  'Gachon University',
  'Ajou University',
  'Konkuk University',
  'Daejeon University',
  'Chung-Ang University',
]);
---
<script is:inline define:vars={{
  customByCountry,
  approvedLogos,
  preferredMonograms,
  permissionRequiredInstitutions: [...permissionRequiredInstitutions],
  permissionUnconfirmedInstitutions: [...permissionUnconfirmedInstitutions],
}}>
  const permissionRequired = new Set(permissionRequiredInstitutions);
  const permissionUnconfirmed = new Set(permissionUnconfirmedInstitutions);

  const fallbackInitials = (name) => name
    .replace(/\([^)]*\)/g, '')
    .split(/[\s,&\-/]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');

  const monogramFor = (name) => preferredMonograms[name] || fallbackInitials(name) || '•';

  const setMonogram = (mark, name) => {
    const monogram = monogramFor(name);
    mark.textContent = monogram;
    mark.classList.toggle('is-long-monogram', monogram.length >= 4);
    mark.classList.toggle('is-very-long-monogram', monogram.length >= 5);
  };

  const makeMark = (name) => {
    const mark = document.createElement('span');
    mark.className = 'network-atlas__institution-mark';
    mark.setAttribute('aria-hidden', 'true');

    const approved = approvedLogos[name];
    if (approved) {
      const image = document.createElement('img');
      image.src = approved.src;
      image.alt = '';
      image.loading = 'lazy';
      image.decoding = 'async';
      image.addEventListener('error', () => {
        image.remove();
        mark.classList.remove('has-logo');
        setMonogram(mark, name);
      }, { once: true });
      mark.classList.add('has-logo');
      mark.appendChild(image);
      mark.title = `${name} — logo use approved for this site`;
    } else {
      setMonogram(mark, name);
      if (permissionRequired.has(name)) {
        mark.classList.add('logo-approval-required');
        mark.title = `${name} — official logo exists; external-use approval required`;
      } else if (permissionUnconfirmed.has(name)) {
        mark.classList.add('logo-permission-unconfirmed');
        mark.title = `${name} — official asset found; third-party usage permission not yet confirmed`;
      } else {
        mark.title = `${name} — neutral monogram used until official logo usage rights are confirmed`;
      }
    }
    return mark;
  };

  const makeCustomBadge = () => {
    const badge = document.createElement('span');
    badge.className = 'network-atlas__custom-badge';
    badge.textContent = 'CUSTOM';
    badge.title = 'Custom Programの実施実績あり（RSJP/RWJP系の人数集計とは別）';
    return badge;
  };

  const enhanceRegularRow = (row, customNames) => {
    if (!(row instanceof HTMLLIElement) || row.dataset.institutionEnhanced === 'true') return;
    const nameElement = row.querySelector('span');
    const countElement = row.querySelector('b');
    if (!(nameElement instanceof HTMLElement)) return;

    const name = nameElement.textContent?.trim() ?? '';
    row.dataset.institutionEnhanced = 'true';
    row.prepend(makeMark(name));
    nameElement.classList.add('network-atlas__institution-name');
    countElement?.classList.add('network-atlas__institution-count');

    if (customNames.includes(name)) {
      nameElement.insertAdjacentElement('afterend', makeCustomBadge());
    }
  };

  const appendCustomOnlyRow = (list, name) => {
    const exists = Array.from(list.querySelectorAll('li .network-atlas__institution-name, li > span'))
      .some((item) => item.textContent?.trim() === name);
    if (exists) return;

    const row = document.createElement('li');
    row.className = 'network-atlas__institution-row--custom-only';
    row.dataset.institutionEnhanced = 'true';
    row.appendChild(makeMark(name));

    const nameElement = document.createElement('span');
    nameElement.className = 'network-atlas__institution-name';
    nameElement.textContent = name;
    row.appendChild(nameElement);
    row.appendChild(makeCustomBadge());

    const spacer = document.createElement('span');
    spacer.className = 'network-atlas__institution-count network-atlas__institution-count--custom';
    spacer.textContent = '';
    row.appendChild(spacer);
    list.appendChild(row);
  };

  const atlas = document.querySelector('[data-network-atlas]');
  if (atlas instanceof HTMLElement) {
    atlas.querySelectorAll('[data-country-panel]').forEach((panel) => {
      if (!(panel instanceof HTMLElement)) return;
      const countryId = panel.dataset.countryPanel ?? '';
      const list = panel.querySelector('.network-atlas__institutions ul');
      if (!(list instanceof HTMLUListElement)) return;

      const customNames = customByCountry[countryId] ?? [];
      list.querySelectorAll(':scope > li').forEach((row) => enhanceRegularRow(row, customNames));
      customNames.forEach((name) => appendCustomOnlyRow(list, name));

      const remainder = panel.querySelector('.network-atlas__institutions > p');
      if (remainder instanceof HTMLElement && countryId === 'china') {
        remainder.textContent = '原票1件は大学名を要確認のため、一覧では非表示にしています。';
      }
    });

    const note = atlas.querySelector('.network-atlas__data-note');
    if (note instanceof HTMLElement) {
      note.textContent = '人数・大学/機関数は2023–2026年のRSJP/RWJP系統合データ。CUSTOMは別途確認したCustom Program実績で、522名・114大学/機関には加算していません。大学ロゴは、この外部Webサイトでの利用許可を確認できたものだけ表示し、それ以外は中立的な略称・イニシャル表示としています。';
    }
  }
</script>
