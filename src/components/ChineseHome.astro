---
import { programmes } from '../data/programs';
import { shortTermParticipationEvidence } from '../data/participation-history';
import { chineseHomeCopy, getChineseProgrammePages, type ChineseLocale } from '../data/chinese-localisation';
import { getCurrentOfferingFact } from '../data/current-offerings';

interface Props { locale: ChineseLocale }
const { locale } = Astro.props;
const c = chineseHomeCopy[locale];
const pages = getChineseProgrammePages(locale);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const img = (p: string) => `${base}images/${p.replace(/^\/images\//, '').replace(/^\//, '')}`;
const byId = new Map(programmes.filter((p) => p.audience === 'individual').map((p) => [p.id, p]));
const rec = ['rwjp', 'rwjp-express', 'rbmp', 'rdsp'] as const;
const sum = ['rsjp', 'rsjp-express'] as const;
const evidence = shortTermParticipationEvidence;
const custom = programmes.find((p) => p.audience === 'partner');
const cn = locale === 'zh-CN';

const current = Object.fromEntries([...rec, ...sum].map((id) => [id, getCurrentOfferingFact(id)])) as Record<typeof rec[number] | typeof sum[number], NonNullable<ReturnType<typeof getCurrentOfferingFact>>>;
const date = (iso?: string | null) => {
  if (!iso) return cn ? '待确认' : '待確認';
  const [year, month, day] = iso.split('-').map(Number);
  return `${year}年${month}月${day}日`;
};
const range = (id: keyof typeof current) => {
  const dates = current[id].programmeDates;
  return dates ? `${date(dates.start)}－${date(dates.end)}` : (cn ? '日期待确认' : '日期待確認');
};
const application = (id: keyof typeof current) => {
  const period = current[id].applicationPeriod;
  if (!period) return cn ? '申请期待确认' : '申請期間待確認';
  return cn ? `${date(period.end)}截止` : `${date(period.end)}截止`;
};
const timing = Object.fromEntries([...rec, ...sum].map((id) => [id, {
  application: application(id),
  dates: current[id].programmeDates ? range(id) : (id === 'rsjp' || id === 'rsjp-express' ? `${current[id].academicYear}年${cn ? '夏季' : '夏季'}` : range(id)),
}])) as Record<string, { application: string; dates: string }>;
---
<section class="recruitment-hero en-hero">
  <img class="recruitment-hero__image" src={img('/images/IMG_1588.JPG')} alt={cn ? '参加立命馆大学短期留学项目的学生' : '參加立命館大學短期留學課程的學生'} width="1600" height="1067" loading="eager" />
  <div class="recruitment-hero__overlay"></div>
  <div class="site-shell recruitment-hero__content en-hero__content">
    <p class="recruitment-hero__location">{c.heroEyebrow}</p>
    <h1><span>{c.heroTitle[0]}</span><span>{c.heroTitle[1]}</span></h1>
    <p class="recruitment-hero__lead">{c.heroLead}</p>
    <div class="recruitment-hero__actions"><a class="action-button action-button--primary" href="#program-finder">{c.find}</a><a class="action-button action-button--glass" href="#why-ritsumeikan">{c.why}</a></div>
    <dl class="recruitment-hero__facts"><div><dt>{cn ? '对象' : '對象'}</dt><dd>{cn ? '大学生、研究生为主' : '大學生、研究生為主'}</dd></div><div><dt>{cn ? '方式' : '方式'}</dt><dd>{cn ? '个人或大学团体' : '個人或大學團體'}</dd></div><div><dt>{cn ? '领域' : '領域'}</dt><dd>{cn ? '日语・文化・专业主题' : '日語・文化・專業主題'}</dd></div></dl>
  </div>
  <p class="recruitment-hero__note">{cn ? '照片为往年项目记录，实际内容因项目而异。' : '照片為往年課程紀錄，實際內容依課程而異。'}</p>
</section>

<section class="programme-finder programme-finder--reframed en-finder" id="program-finder"><div class="site-shell">
  <div class="section-intro programme-finder__intro"><p class="section-kicker">{c.individual}</p><h2>{c.finderTitle}</h2><div class="programme-finder__intro-copy"><p>{c.finderLead}</p><small>{cn ? '校区由各项目确定。' : '校區由各課程確定。'}</small></div></div>
  <aside class="en-recruitment-banner"><div class="en-recruitment-banner__copy"><p class="en-recruitment-banner__eyebrow">{c.current}</p><h3>{c.currentTitle}</h3><p>{c.currentBody}</p></div><div class="en-recruitment-banner__links">{rec.map((id) => <a href={`${base}${c.prefix}/programs/${id}/`}><span>{c.current}</span><strong>{pages[id].code}</strong><small>{timing[id].dates}</small></a>)}</div></aside>
  <div class="programme-pathways programme-pathways--student"><article><span>01</span><p>{cn ? '在真实语境中使用语言' : '在真實脈絡中使用語言'}</p><h3>{c.japanese}</h3><small>RSJP / RSJP Express / RWJP / RWJP Express</small></article><article><span>02</span><p>{cn ? '围绕专业主题深入学习' : '圍繞專業主題深入學習'}</p><h3>{c.themed}</h3><small>RDSP / RBMP</small></article></div>
  <div class="en-programme-groups">
    <section class="en-programme-group en-programme-group--recruiting"><div class="en-programme-group__heading"><div><p>Current offerings</p><h3>{c.recruiting}</h3></div><p>{cn ? '申请前请在详情页确认日期、资格、费用与住宿条件。' : '申請前請在詳細頁確認日期、資格、費用與住宿條件。'}</p></div><div class="programme-grid en-programme-grid">{rec.map((id) => { const p = byId.get(id), x = pages[id]; if (!p) return null; return <article class={`programme-card programme-card--${p.goals[0]} en-programme-card--recruiting`}><div class="programme-card__visual en-programme-card__visual"><img src={img(p.image)} alt={x.heroAlt} width="960" height="640" loading="lazy"/><span>{x.code}</span><small>{x.family}</small></div><div class="programme-card__body"><div class="en-programme-status en-programme-status--recruiting"><span>{c.current}</span></div><div class="programme-card__meta programme-card__meta--status"><span>{x.campus}</span></div><h3>{x.name}</h3><dl class="zh-programme-timing"><div><dt>{c.application}</dt><dd>{timing[id].application}</dd></div><div><dt>{c.dates}</dt><dd>{timing[id].dates}</dd></div></dl><p>{x.lead}</p><a class="en-programme-card__link" href={`${base}${c.prefix}/programs/${id}/`}>{c.details} <span>→</span></a></div></article>; })}</div></section>
    <section class="en-programme-group en-programme-group--summer-2027"><div class="en-programme-group__heading"><div><p>Plan ahead</p><h3>{c.summer}</h3></div><p>{c.summerBody}</p></div><div class="programme-grid en-programme-grid">{sum.map((id) => { const p = byId.get(id), x = pages[id]; if (!p) return null; return <article class={`programme-card programme-card--${p.goals[0]} en-programme-card--summer`}><div class="programme-card__visual en-programme-card__visual"><img src={img(p.image)} alt={x.heroAlt} width="960" height="640" loading="lazy"/><span>{x.code}</span><small>{x.family}</small></div><div class="programme-card__body"><div class="en-programme-status en-programme-status--summer"><span>{current[id].academicYear} Summer Program</span></div><div class="programme-card__meta programme-card__meta--status"><span>{x.campus}</span></div><h3>{x.name}</h3><dl class="zh-programme-timing"><div><dt>{c.application}</dt><dd>{timing[id].application}</dd></div><div><dt>{c.dates}</dt><dd>{timing[id].dates}</dd></div></dl><p>{x.lead}</p><a class="en-programme-card__link" href={`${base}${c.prefix}/programs/${id}/`}>{c.details} <span>→</span></a></div></article>; })}</div></section>
  </div>
  {custom && <aside class="partner-programme partner-programme--expanded en-partner"><div class="partner-programme__label">{c.custom}</div><div class="partner-programme__content"><div class="partner-programme__lead"><p class="section-kicker">Custom Programs</p><h2>{c.customTitle}</h2><p>{c.customBody}</p></div><div class="partner-programme__themes"><p>{cn ? '可讨论主题示例' : '可討論主題示例'}</p><ul><li>{c.japanese}</li><li>{cn ? '商业' : '商業'}</li><li>{cn ? '市场营销' : '行銷'}</li><li>{cn ? '创业' : '創業'}</li><li>{cn ? '数据科学' : '資料科學'}</li><li>AI</li><li>{cn ? '媒体' : '媒體'}</li><li>{cn ? '流行文化' : '流行文化'}</li></ul></div></div></aside>}
</div></section>

<section class="en-experience" id="why-ritsumeikan"><div class="site-shell"><div class="section-intro"><p class="section-kicker">Why Ritsumeikan</p><h2>{c.experienceTitle}</h2></div><div class="en-experience__grid"><article><span>01</span><h3>{cn ? '学术学习' : '學術學習'}</h3><p>{cn ? '提升日语能力，或围绕专业主题深入探索。' : '提升日語能力，或圍繞專業主題深入探索。'}</p></article><article><span>02</span><h3>{cn ? '学生交流' : '學生交流'}</h3><p>{cn ? '项目包含交流时，与立命馆学生的互动也是学习的一部分。' : '課程包含交流時，與立命館學生的互動也是學習的一部分。'}</p></article><article><span>03</span><h3>{cn ? '理解日本' : '理解日本'}</h3><p>{cn ? '通过文化与地区体验，把课堂内容放进真实环境。' : '透過文化與地區體驗，把課堂內容放進真實環境。'}</p></article></div></div></section>
<section class="en-evidence" id="global-reach"><div class="site-shell"><div class="section-intro"><p class="section-kicker">Global Reach</p><h2>{c.globalTitle}</h2></div><dl class="en-evidence__stats"><div><dt>{evidence.participants}</dt><dd>{cn ? '参加者' : '參加者'}</dd></div><div><dt>{evidence.institutions}</dt><dd>{cn ? '大学・机构' : '大學・機構'}</dd></div><div><dt>{evidence.countriesOrRegions}</dt><dd>{cn ? '国家・地区' : '國家・地區'}</dd></div></dl></div></section>
<section class="en-photo-story"><div class="site-shell"><div class="section-intro"><p class="section-kicker">Campus and community</p><h2>{cn ? '看看短期留学的真实日常。' : '看看短期留學的真實日常。'}</h2></div><div class="en-photo-story__grid"><figure><img src={img('/images/IMG_8178.JPG')} alt={cn ? '短期项目课堂学习' : '短期課程課堂學習'} loading="lazy"/><figcaption>{cn ? '课堂学习' : '課堂學習'}</figcaption></figure><figure><img src={img('/images/IMG_5092.JPG')} alt={cn ? '学生文化体验' : '學生文化體驗'} loading="lazy"/><figcaption>{cn ? '文化学习' : '文化學習'}</figcaption></figure><figure><img src={img('/images/IMG_1687.JPG')} alt={cn ? '学生交流活动' : '學生交流活動'} loading="lazy"/><figcaption>{cn ? '校园与交流' : '校園與交流'}</figcaption></figure></div></div></section>
<section class="en-support" id="support"><div class="site-shell en-support__inner"><div><p class="section-kicker">Next step</p><h2>{c.supportTitle}</h2><p>{c.supportBody}</p></div><a class="action-button action-button--primary" href="#program-finder">{c.find}</a></div></section>