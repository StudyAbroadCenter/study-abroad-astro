---
import { programmes } from '../data/programs';
import { koreanProgrammePages } from '../data/korean-programme-pages';
import { shortTermParticipationEvidence } from '../data/participation-history';
import { getCurrentOfferingFact } from '../data/current-offerings';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path.replace(/^\//, '')}`;
const evidence = shortTermParticipationEvidence;
const studentProgrammes = programmes.filter((programme) => programme.audience === 'individual');
const customProgramme = programmes.find((programme) => programme.audience === 'partner');
const byId = new Map(studentProgrammes.map((programme) => [programme.id, programme]));
const currentIds = ['rwjp', 'rwjp-express', 'rbmp', 'rdsp'] as const;
const summerIds = ['rsjp', 'rsjp-express'] as const;
const currentProgrammes = currentIds.map((id) => byId.get(id)).filter(Boolean);
const summerProgrammes = summerIds.map((id) => byId.get(id)).filter(Boolean);
const offering = Object.fromEntries([...currentIds, ...summerIds].map((id) => [id, getCurrentOfferingFact(id)])) as Record<string, NonNullable<ReturnType<typeof getCurrentOfferingFact>>>;
const koDate = (iso?: string | null) => {
  if (!iso) return '추후 안내';
  const [year, month, day] = iso.split('-').map(Number);
  return `${year}년 ${month}월 ${day}일`;
};
const koRange = (id: string) => {
  const dates = offering[id]?.programmeDates;
  return dates ? `${koDate(dates.start)} ~ ${koDate(dates.end)}` : '일정 추후 안내';
};
const applicationLabel = (id: string) => {
  const period = offering[id]?.applicationPeriod;
  return period ? `${koDate(period.end)} 마감` : '지원 일정 추후 안내';
};
const summerYear = offering.rsjp.academicYear;
const detailLabel: Record<string, string> = {
  rwjp: `${offering.rwjp.academicYear} RWJP 상세 보기`,
  'rwjp-express': `${offering['rwjp-express'].academicYear} RWJP Express 상세 보기`,
  rbmp: `${offering.rbmp.academicYear} RBMP 계획 보기`,
  rdsp: 'RDSP 현재 계획 보기',
  rsjp: `${offering.rsjp.academicYear} 여름 프로그램 개요`,
  'rsjp-express': `${offering['rsjp-express'].academicYear} 여름 프로그램 개요`,
};
---
<section class="recruitment-hero en-hero" aria-labelledby="ko-hero-title">
  <img class="recruitment-hero__image" src={image('IMG_1588.JPG')} alt="리츠메이칸대학교 단기 프로그램에 참가하는 학생들" width="1600" height="1067" loading="eager" fetchpriority="high" />
  <div class="recruitment-hero__overlay" aria-hidden="true"></div>
  <div class="site-shell recruitment-hero__content en-hero__content">
    <p class="recruitment-hero__location">리츠메이칸에서 배우고, 일본에서 생활하세요.</p>
    <h1 id="ko-hero-title"><span>교실을 넘어</span><span>일본에서 배우는 시간.</span></h1>
    <p class="recruitment-hero__lead">캠퍼스에서 배우고, 학생들과 만나고, 일본의 일상 속에서 공부의 맥락을 넓혀 보세요.<br />리츠메이칸대학교 단기 유학 프로그램.</p>
    <div class="recruitment-hero__actions"><a class="action-button action-button--primary" href="#program-finder">프로그램 찾기</a><a class="action-button action-button--glass" href="#why-ritsumeikan">학습 경험 살펴보기</a></div>
    <dl class="recruitment-hero__facts"><div><dt>대상</dt><dd>대학생·대학원생 중심</dd></div><div><dt>참가 방식</dt><dd>개인 또는 대학 단체</dd></div><div><dt>프로그램</dt><dd>일본어·문화·전문 테마</dd></div></dl>
  </div>
  <p class="recruitment-hero__note">과거 프로그램 사진입니다. 실제 구성은 프로그램별로 다릅니다.</p>
</section>

<section class="programme-finder programme-finder--reframed en-finder" id="program-finder" aria-labelledby="ko-finder-title"><div class="site-shell">
  <div class="section-intro programme-finder__intro"><p class="section-kicker">개인 참가 프로그램</p><h2 id="ko-finder-title">어떤 방식으로 배우고 싶은지부터 선택하세요</h2><div class="programme-finder__intro-copy"><p>일본어·일본문화 · 전문 테마 학습</p><small>캠퍼스는 프로그램별로 정해져 있습니다.</small></div></div>
  <aside class="en-recruitment-banner" aria-labelledby="ko-current-title"><div class="en-recruitment-banner__copy"><p class="en-recruitment-banner__eyebrow">Current offerings</p><h3 id="ko-current-title">현재 먼저 확인할 프로그램 4개</h3><p>지원 상태를 포함한 연도별 정보는 확인된 값만 표시합니다. 미확정 값은 추정하지 않습니다.</p></div><div class="en-recruitment-banner__links">{currentProgrammes.map((programme) => programme && <a href={`${base}ko/programs/${programme.id}/`}><span>{offering[programme.id].status}</span><strong>{programme.code}</strong><small>{koRange(programme.id)}</small></a>)}</div></aside>
  <div class="programme-pathways programme-pathways--student"><article><span>01</span><p>일본어를 실제 맥락에서</p><h3>일본어·일본문화</h3><small>RSJP / RSJP Express / RWJP / RWJP Express</small></article><article><span>02</span><p>전문 주제를 중심으로</p><h3>테마형 학습</h3><small>RDSP / RBMP</small></article></div>
  <div class="finder-results-heading"><p>개인 참가 프로그램 <strong>{studentProgrammes.length}</strong></p><small>현재 상세 정보가 있는 프로그램을 먼저 표시하고, {summerYear}년 여름 프로그램은 별도로 구분합니다.</small></div>
  <div class="en-programme-groups">
    <section class="en-programme-group en-programme-group--current"><div class="en-programme-group__heading"><div><p>Current offerings</p><h3>현재 프로그램</h3></div><p>지원 전에 상세 페이지에서 일정, 참가 조건, 비용과 신청 정보를 확인하세요.</p></div><div class="programme-grid en-programme-grid">{currentProgrammes.map((programme) => { if (!programme) return null; const page = koreanProgrammePages[programme.id as keyof typeof koreanProgrammePages]; return <article class={`programme-card programme-card--${programme.goals[0]} en-programme-card--recruiting`}><div class="programme-card__visual en-programme-card__visual"><img src={image(programme.image)} alt={page.heroAlt} width="960" height="640" loading="lazy"/><span>{programme.code}</span><small>{page.family}</small></div><div class="programme-card__body"><div class="en-programme-status en-programme-status--recruiting"><span>{offering[programme.id].status}</span></div><div class="programme-card__meta programme-card__meta--status"><span>{page.campus}</span></div><h3>{page.name}</h3><dl class="ko-programme-timing"><div><dt>지원</dt><dd>{applicationLabel(programme.id)}</dd></div><div><dt>일정</dt><dd>{koRange(programme.id)}</dd></div></dl><p>{page.lead}</p><a class="en-programme-card__link" href={`${base}ko/programs/${programme.id}/`}>{detailLabel[programme.id]} <span>→</span></a></div></article>; })}</div></section>
    <section class="en-programme-group en-programme-group--summer"><div class="en-programme-group__heading"><div><p>Plan ahead</p><h3>{summerYear} 여름 프로그램</h3></div><p>RSJP와 RSJP Express의 연도별 모집 정보는 공식 확인 후 공개합니다.</p></div><div class="programme-grid en-programme-grid">{summerProgrammes.map((programme) => { if (!programme) return null; const page = koreanProgrammePages[programme.id as keyof typeof koreanProgrammePages]; return <article class={`programme-card programme-card--${programme.goals[0]} en-programme-card--summer`}><div class="programme-card__visual en-programme-card__visual"><img src={image(programme.image)} alt={page.heroAlt} width="960" height="640" loading="lazy"/><span>{programme.code}</span><small>{page.family}</small></div><div class="programme-card__body"><div class="en-programme-status en-programme-status--summer"><span>{offering[programme.id].academicYear} Summer Program</span></div><div class="programme-card__meta programme-card__meta--status"><span>{page.campus}</span></div><h3>{page.name}</h3><dl class="ko-programme-timing"><div><dt>지원</dt><dd>{applicationLabel(programme.id)}</dd></div><div><dt>일정</dt><dd>{offering[programme.id].programmeDates ? koRange(programme.id) : `${offering[programme.id].academicYear}년 여름`}</dd></div></dl><p>{page.lead}</p><a class="en-programme-card__link" href={`${base}ko/programs/${programme.id}/`}>{detailLabel[programme.id]} <span>→</span></a></div></article>; })}</div></section>
  </div>
  {customProgramme && <aside class="partner-programme partner-programme--expanded en-partner"><div class="partner-programme__label">대학·교육기관 대상</div><div class="partner-programme__content"><div class="partner-programme__lead"><p class="section-kicker">교육 목적에 맞춰 설계</p><h2>귀 대학과 함께 만드는 맞춤형 단기 프로그램</h2><p>해외 대학 및 교육기관의 학생 단체를 대상으로 교육 목적, 일정, 참가 인원, 학습 내용과 캠퍼스를 협의하며 프로그램을 설계합니다.</p></div><div class="partner-programme__themes"><p>협의 가능한 주제 예시</p><ul><li>일본어와 일본문화</li><li>비즈니스</li><li>마케팅</li><li>기업가정신</li><li>데이터사이언스</li><li>AI</li><li>미디어</li><li>대중문화</li></ul></div></div></aside>}
</div></section>

<section class="en-experience" id="why-ritsumeikan"><div class="site-shell"><div class="section-intro"><p class="section-kicker">Why Ritsumeikan</p><h2>캠퍼스에서 배우고, 사람을 만나고, 일본을 맥락 속에서 이해합니다.</h2><p class="en-section-lead">프로그램에 따라 수업, 학생 교류, 문화 학습과 현장 경험이 서로 연결됩니다.</p></div><div class="en-experience__grid"><article><span>01</span><h3>학문적 학습</h3><p>일본어 능력을 키우거나 전문 주제를 집중적으로 탐구합니다.</p></article><article><span>02</span><h3>학생 교류</h3><p>프로그램에 포함되는 경우 리츠메이칸 학생들과의 교류도 학습의 일부가 됩니다.</p></article><article><span>03</span><h3>일본을 맥락 속에서</h3><p>문화와 지역을 통해 교실에서 배운 내용을 실제 환경과 연결합니다.</p></article></div></div></section>
<section class="en-evidence" id="global-reach"><div class="site-shell"><div class="section-intro"><p class="section-kicker">Global Reach</p><h2>세계 여러 대학의 학생들이 리츠메이칸 단기 프로그램에 참가해 왔습니다.</h2><p class="en-section-lead">2023~2026년 4개 일본어 프로그램의 확인된 참가 실적입니다.</p></div><dl class="en-evidence__stats"><div><dt>{evidence.participants}</dt><dd>참가자</dd></div><div><dt>{evidence.institutions}</dt><dd>대학·기관</dd></div><div><dt>{evidence.countriesOrRegions}</dt><dd>국가·지역</dd></div></dl></div></section>
<section class="en-photo-story"><div class="site-shell"><div class="section-intro"><p class="section-kicker">Campus and community</p><h2>단기 유학의 일상을 사진으로 만나보세요.</h2></div><div class="en-photo-story__grid"><figure><img src={image('IMG_8178.JPG')} alt="단기 프로그램 수업" loading="lazy"/><figcaption>캠퍼스에서 함께 배우기</figcaption></figure><figure><img src={image('IMG_5092.JPG')} alt="문화 학습" loading="lazy"/><figcaption>문화와 장소에서 배우기</figcaption></figure><figure><img src={image('IMG_1687.JPG')} alt="학생 교류" loading="lazy"/><figcaption>캠퍼스와 사람을 만나기</figcaption></figure></div></div></section>
<section class="en-support" id="support"><div class="site-shell en-support__inner"><div><p class="section-kicker">Next step</p><h2>지원 전, 해당 연도의 확정 정보를 확인하세요.</h2><p>일정, 참가비, 자격, 숙소와 신청 절차는 확인된 값만 공개합니다.</p></div><a class="action-button action-button--primary" href="#program-finder">프로그램 찾기</a></div></section>