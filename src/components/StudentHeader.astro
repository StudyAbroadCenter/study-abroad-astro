---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const japaneseHomeAnchor = (id: string) => withBase(`/#${id}`);

const links = [
  { href: japaneseHomeAnchor('program-finder'), label: 'プログラム' },
  { href: japaneseHomeAnchor('experience-pillars'), label: '学びと体験' },
  { href: japaneseHomeAnchor('international-learning'), label: '国際交流' },
  { href: japaneseHomeAnchor('participant-day'), label: '参加者の一日' },
  { href: japaneseHomeAnchor('campus-journey'), label: '学ぶ場所' },
];
---
<header class="recruitment-header" data-recruitment-header>
  <a class="skip-link" href="#main-content">本文へ移動</a>
  <div class="site-shell recruitment-header__inner">
    <a class="recruitment-brand" href={withBase('/')} aria-label="立命館大学短期受入プログラム 日本語トップ">
      <span class="recruitment-brand__mark" aria-hidden="true">R</span>
      <span class="recruitment-brand__text">
        <strong>RITSUMEIKAN UNIVERSITY</strong>
        <small>SHORT-TERM PROGRAMS · 立命館大学</small>
      </span>
    </a>

    <nav class="recruitment-nav recruitment-nav--desktop" aria-label="メインナビゲーション">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="recruitment-nav__cta" href={japaneseHomeAnchor('program-finder')}>自分に合うプログラム</a>
    </nav>

    <details class="recruitment-menu" data-recruitment-menu>
      <summary aria-label="メニューを開く">
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label="モバイルナビゲーション">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a class="recruitment-menu__cta" href={japaneseHomeAnchor('program-finder')}>自分に合うプログラムを探す</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector('[data-recruitment-header]');
  const menu = document.querySelector('[data-recruitment-menu]');

  const updateHeader = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 24);
  };

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (menu instanceof HTMLDetailsElement) menu.open = false;
    });
  });
</script>
