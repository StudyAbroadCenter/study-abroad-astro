---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const japaneseHomeAnchor = (id: string) => withBase(`/#${id}`);

// Publicly rendered preview of the official horizontal R / RITSUMEIKAN
// communication mark. Keep the mark intact. Replace with an internally
// approved transparent local asset before final public launch when supplied.
const officialLogo = 'https://www.ritsumei.ac.jp/image.jsp?id=228381';

const links = [
  { href: japaneseHomeAnchor('program-finder'), label: 'プログラム' },
  { href: japaneseHomeAnchor('experience-pillars'), label: '学びと体験' },
  { href: japaneseHomeAnchor('international-learning'), label: '国際交流' },
  { href: withBase('/buddy/'), label: 'Buddy' },
  { href: japaneseHomeAnchor('participant-day'), label: '参加者の一日' },
  { href: japaneseHomeAnchor('support-preview'), label: 'サポート' },
];
---
<header class="recruitment-header" data-recruitment-header>
  <a class="skip-link" href="#main-content">本文へ移動</a>
  <div class="site-shell recruitment-header__inner">
    <a class="recruitment-brand" href={withBase('/')} aria-label="立命館大学 短期受入プログラム 日本語トップ">
      <span class="recruitment-brand__logo-plate">
        <img
          class="recruitment-brand__logo"
          src={officialLogo}
          alt="RITSUMEIKAN"
          loading="eager"
          decoding="async"
          data-official-logo
        />
        <span class="recruitment-brand__fallback" aria-hidden="true">RITSUMEIKAN</span>
      </span>
      <span class="recruitment-brand__office">立命館大学<br />Study Abroad Center</span>
    </a>

    <nav class="recruitment-nav recruitment-nav--desktop" aria-label="メインナビゲーション">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="recruitment-nav__cta" href={japaneseHomeAnchor('program-finder')}>自分に合うプログラム</a>
    </nav>

    <details class="recruitment-menu" data-recruitment-menu>
      <summary aria-label="メニューを開く">
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label="モバイルナビゲーション">
        <p class="recruitment-menu__eyebrow">立命館大学 Study Abroad Center</p>
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a class="recruitment-menu__cta" href={japaneseHomeAnchor('program-finder')}>自分に合うプログラムを探す</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector('[data-recruitment-header]');
  const menu = document.querySelector('[data-recruitment-menu]');
  const officialLogo = document.querySelector('[data-official-logo]');

  const updateHeader = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 24);
  };

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  officialLogo?.addEventListener('error', () => {
    header?.classList.add('has-logo-fallback');
  }, { once: true });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (menu instanceof HTMLDetailsElement) menu.open = false;
    });
  });
</script>
