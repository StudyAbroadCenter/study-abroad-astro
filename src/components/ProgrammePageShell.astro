---
import type { ProgrammePageDraft } from '../data/programme-page-drafts';
import { getCoreProgramme2027Fact } from '../data/core-programme-2027-facts';
import '../styles/programme-page.css';

interface Props { programme: ProgrammePageDraft; }
const { programme } = Astro.props;
const isCustom = programme.id === 'custom-programs';
const coreFact = getCoreProgramme2027Fact(programme.id);
const publicFact = coreFact?.status === 'Confirmed' ? coreFact : undefined;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const facts = isCustom
  ? [
      { label: '対象', value: '海外大学・教育機関の学生団体' },
      { label: '申込方法', value: '大学・機関単位で相談' },
      { label: '実施場所', value: '教育内容等を踏まえて相談' },
      { label: '内容', value: '教育目的に合わせて設計' },
      { label: '言語対応', value: '留学サポートデスクは英語対応可能' },
      { label: '個人申込', value: '対象外' },
    ]
  : [
      publicFact?.dates ? { label: '実施日程', value: `${publicFact.dates.start.replaceAll('-', '/')}〜${publicFact.dates.end.replaceAll('-', '/')}` } : null,
      publicFact?.audience ? { label: '対象', value: publicFact.audience } : null,
      publicFact?.campus ? { label: 'キャンパス', value: publicFact.campus } : programme.campus ? { label: 'キャンパス', value: programme.campus } : null,
      publicFact?.fee ? { label: '参加費', value: `${publicFact.fee.toLocaleString('ja-JP')}円` } : null,
      publicFact?.accommodation ? { label: '宿泊', value: publicFact.accommodation } : null,
      publicFact?.minimumParticipants ? { label: '最少催行', value: `${publicFact.minimumParticipants}名` } : null,
    ].filter(Boolean) as { label: string; value: string }[];
const academicItems = publicFact?.academic ?? [];
---
<article class="programme-page">
  <header class="programme-page__hero">
    <div class="site-shell programme-page__hero-inner">
      <div class="programme-page__hero-copy">
        <p class="programme-page__eyebrow">{programme.category}</p>
        <p class="programme-page__code">{programme.code}</p>
        <h1 class={isCustom ? 'programme-page__hero-title programme-page__hero-title--custom' : 'programme-page__hero-title'}>
          {isCustom ? <><span>大学ごとに 日本での</span><span>学びを設計する</span></> : programme.title}
        </h1>
        <p class="programme-page__lead">{isCustom ? '海外大学・教育機関からの学生団体を対象に、教育目的、期間、内容、実施場所を相談しながらつくる短期留学プログラムです。' : programme.lead}</p>
        {programme.isNewProgramme && <p class="programme-page__new">新規企画</p>}
      </div>
      {isCustom && (
        <aside class="programme-page__draft-note" aria-label="海外大学・教育機関向け案内">
          <strong>海外大学・教育機関のご担当者へ</strong>
          <p>学生団体の教育目的や希望時期を伺い、実施可能なプログラムを一緒に組み立てます。個人申込型ではありません。</p>
        </aside>
      )}
    </div>
  </header>

  <nav class="programme-page__jump" aria-label="ページ内ナビゲーション"><div class="site-shell programme-page__jump-inner"><a href="#programme-purpose">特徴</a><a href="#academic-experience">{isCustom ? '設計' : '学び'}</a><a href="#key-facts">基本情報</a><a href="#before-you-apply">{isCustom ? '相談する' : '応募前に'}</a></div></nav>

  <section class="programme-page__section" id="programme-purpose" aria-labelledby="programme-purpose-title"><div class="site-shell programme-page__split"><div><p class="section-kicker">{isCustom ? '大学・機関向け' : 'プログラムの特徴'}</p><h2 id="programme-purpose-title">{isCustom ? '大学ごとに 日本での学びをつくる' : 'ここで何を学ぶのか'}</h2></div><div class="programme-page__body-copy"><p>{programme.emphasis}</p>{isCustom ? <p>海外大学・教育機関の教育目的を起点に、立命館大学での短期留学を大学・機関の担当者と組み立てます。</p> : publicFact?.audience ? <p>対象：{publicFact.audience}</p> : null}</div></div></section>

  {(isCustom || academicItems.length > 0) && (
    <section class="programme-page__section programme-page__section--soft" id="academic-experience" aria-labelledby="academic-experience-title"><div class="site-shell"><div class="programme-page__section-heading"><p class="section-kicker">{isCustom ? 'プログラム設計' : '学びの内容'}</p><h2 id="academic-experience-title">{isCustom ? '期間も 内容も 実施場所も相談する' : '何を どのように学ぶのか'}</h2><p>{isCustom ? '教育目的、期間、参加人数、専門分野、学生レベル等を伺い、授業、交流、文化体験、訪問等を組み合わせます。' : '授業や体験を通して、プログラムのテーマを多角的に学びます。'}</p></div><div class="programme-page__pending-grid" aria-label={isCustom ? 'カスタムプログラムで相談する主な項目' : '主な学習内容'}>{isCustom ? <><div><span>01</span><strong>教育テーマ</strong><p>目的に合わせて相談</p></div><div><span>02</span><strong>期間・構成</strong><p>日程と内容を相談</p></div><div><span>03</span><strong>実施キャンパス</strong><p>教育内容等を踏まえて相談</p></div></> : academicItems.slice(0, 6).map((item, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></div>)}</div></div></section>
  )}

  <section class="programme-page__section" id="key-facts" aria-labelledby="key-facts-title"><div class="site-shell"><div class="programme-page__section-heading programme-page__section-heading--compact"><p class="section-kicker">基本情報</p><h2 id="key-facts-title">{isCustom ? '相談の前に知っておきたいこと' : '参加前に知っておきたいこと'}</h2><p>{isCustom ? '実施場所や内容は、教育目的、施設、宿泊、日程等を踏まえて大学・機関の担当者と相談します。' : '日程、費用、参加条件など、参加判断に必要な情報をご確認ください。'}</p></div>{facts.length > 0 && <dl class="programme-page__facts">{facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>}</div></section>

  <section class="programme-page__section programme-page__section--dark" id="before-you-apply" aria-labelledby="before-you-apply-title"><div class="site-shell programme-page__split"><div><p class="section-kicker">{isCustom ? 'ご相談' : '応募前の確認'}</p><h2 id="before-you-apply-title">{isCustom ? 'まず 大学・機関としてご相談ください' : '大切な条件は 応募する前に'}</h2></div><div class="programme-page__body-copy"><p>{isCustom ? '希望時期、参加人数、教育目的、関心のあるテーマ等を伺い、実施可能な組み合わせをご相談します。留学サポートデスクでは英語での相談・調整が可能です。' : publicFact?.notes?.length ? publicFact.notes.join('。') + '。' : '応募資格、費用、宿泊、キャンセル条件、必要書類などは、各年度の募集案内をご確認ください。'}</p>{isCustom && <a class="action-button action-button--primary" href={`${base}contact/`}>大学・機関として相談する</a>}</div></div></section>
</article>

<style>
  .programme-page__hero-title--custom {
    max-width: none;
    font-size: clamp(2.25rem, 5vw, 4.25rem);
    line-height: 1.06;
    letter-spacing: -0.045em;
  }

  .programme-page__hero-title--custom span {
    display: block;
    white-space: nowrap;
  }

  @media (max-width: 799px) {
    .programme-page__hero-title--custom {
      font-size: clamp(2.15rem, 8vw, 3.4rem);
    }
  }

  @media (max-width: 420px) {
    .programme-page__hero-title--custom {
      font-size: clamp(1.9rem, 7.4vw, 2.4rem);
    }
  }
</style>
