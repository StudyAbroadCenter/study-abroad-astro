---
import type { ProgrammePageDraft } from '../data/programme-page-drafts';
import { getCoreProgramme2027Fact } from '../data/core-programme-2027-facts';
import '../styles/programme-page.css';

interface Props { programme: ProgrammePageDraft; }
const { programme } = Astro.props;
const isCustom = programme.id === 'custom-programs';
const coreFact = getCoreProgramme2027Fact(programme.id);
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const dateLabel = coreFact?.dates
  ? `${coreFact.dates.start.replaceAll('-', '/')}〜${coreFact.dates.end.replaceAll('-', '/')}`
  : '年度別日程は確定後に掲載';
const feeLabel = coreFact?.fee ? `${coreFact.fee.toLocaleString('ja-JP')}円` : '確定後に掲載';
const accommodationLabel = coreFact?.accommodation ?? '確定後に掲載';
const statusLabel = coreFact?.status === 'Confirmed' ? '2027年情報を掲載' : coreFact?.status === 'Working plan' ? '2027年計画情報を掲載' : '詳細情報を確認中';
---
<article class="programme-page">
  <header class="programme-page__hero">
    <div class="site-shell programme-page__hero-inner">
      <div class="programme-page__hero-copy">
        <p class="programme-page__eyebrow">{programme.category}</p>
        <p class="programme-page__code">{programme.code}</p>
        <h1>{isCustom ? '大学ごとに 日本での学びを設計する' : programme.title}</h1>
        <p class="programme-page__lead">{isCustom ? '海外大学・教育機関からの学生団体を対象に、期間・内容・実施場所を相談しながらつくる短期受入プログラムです。' : programme.lead}</p>
        {programme.isNewProgramme && <p class="programme-page__new">新規企画</p>}
      </div>
      <aside class="programme-page__draft-note" aria-label="ページ情報の状態">
        <strong>{isCustom ? '海外大学・教育機関からのご相談を想定' : statusLabel}</strong>
        <p>{isCustom ? '個人申込型ではありません。期間・内容・実施場所等を大学・機関の担当者と相談しながら設計します。' : coreFact?.status === 'Working plan' ? '計画段階の項目は変更される可能性があります。未確定事項は確定扱いせず、正式決定後に更新します。' : '確認済みの年度情報を掲載しています。未確定事項は推測せず、正式決定後に更新します。'}</p>
      </aside>
    </div>
  </header>

  <nav class="programme-page__jump" aria-label="ページ内ナビゲーション"><div class="site-shell programme-page__jump-inner"><a href="#programme-purpose">特徴</a><a href="#academic-experience">{isCustom ? '設計' : '学び'}</a><a href="#key-facts">基本情報</a><a href="#before-you-apply">{isCustom ? '相談する' : '応募前に'}</a></div></nav>

  <section class="programme-page__section" id="programme-purpose" aria-labelledby="programme-purpose-title"><div class="site-shell programme-page__split"><div><p class="section-kicker">{isCustom ? '大学・機関向け' : 'プログラムの特徴'}</p><h2 id="programme-purpose-title">{isCustom ? '大学ごとに 日本での学びをつくる' : 'ここで何を学ぶのか'}</h2></div><div class="programme-page__body-copy"><p>{programme.emphasis}</p><p>{isCustom ? '個人の参加申込を受け付けるプログラムではありません。海外大学・教育機関の教育目的を起点に、立命館大学での短期受入を一緒に組み立てます。' : coreFact ? `対象：${coreFact.audience}` : '学びの内容、体験、参加条件を分かりやすく整理し、自分に合うプログラムかを応募前に判断できるページを目指します。'}</p></div></div></section>

  <section class="programme-page__section programme-page__section--soft" id="academic-experience" aria-labelledby="academic-experience-title"><div class="site-shell"><div class="programme-page__section-heading"><p class="section-kicker">{isCustom ? 'プログラム設計' : '学びの内容'}</p><h2 id="academic-experience-title">{isCustom ? '期間も 内容も 実施場所も相談する' : '何を どのように学ぶのか'}</h2><p>{isCustom ? '教育目的、期間、参加人数、専門分野、学生レベル等を伺い、実施可能性を確認しながらプログラムを設計します。' : coreFact ? '現在確認できている学習内容です。計画情報は正式決定後に更新します。' : '授業内容、学習時間、学習成果、評価方法は、確認済みの学術情報に基づいて掲載します。'}</p></div><div class="programme-page__pending-grid" aria-label={isCustom ? 'カスタムプログラムで相談する主な項目' : '主な学習内容'}>{isCustom ? <><div><span>01</span><strong>教育テーマ</strong><p>目的に合わせて相談</p></div><div><span>02</span><strong>期間・構成</strong><p>日程と内容を相談</p></div><div><span>03</span><strong>実施キャンパス</strong><p>教育内容等を踏まえて相談</p></div></> : coreFact ? coreFact.academic.slice(0, 6).map((item, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong><p>{coreFact.status === 'Working plan' ? '計画情報' : '確認済み'}</p></div>) : <><div><span>01</span><strong>学習テーマ</strong><p>確認後に掲載</p></div><div><span>02</span><strong>授業構成</strong><p>確認後に掲載</p></div><div><span>03</span><strong>学習成果</strong><p>確認後に掲載</p></div></>}</div></div></section>

  <section class="programme-page__section" id="key-facts" aria-labelledby="key-facts-title"><div class="site-shell"><div class="programme-page__section-heading programme-page__section-heading--compact"><p class="section-kicker">基本情報</p><h2 id="key-facts-title">{isCustom ? '相談の前に知っておきたいこと' : '応募前に知っておきたいこと'}</h2><p>{isCustom ? '衣笠・大阪いばらき・びわこ・くさつの3キャンパスを候補に、教育内容、施設、宿泊、日程等を踏まえて実施場所を相談します。参加学生がキャンパスを自由に選択する仕組みではありません。' : coreFact?.status === 'Working plan' ? '以下には2027年の計画情報を含みます。正式決定前の項目は変更される可能性があります。' : '未確認の情報は推測せず、正式に確認できた項目から更新します。'}</p></div><dl class="programme-page__facts"><div><dt>{isCustom ? '対象' : '実施日程'}</dt><dd>{isCustom ? '海外大学・教育機関の学生団体' : coreFact ? dateLabel : '確認中'}</dd></div><div><dt>対象</dt><dd>{isCustom ? '大学・機関単位' : coreFact?.audience ?? '確認中'}</dd></div><div><dt>キャンパス</dt><dd>{isCustom ? '3キャンパスから内容に応じて相談' : coreFact?.campus ?? programme.campus ?? '確認中'}</dd></div><div><dt>{isCustom ? '内容' : '参加費'}</dt><dd>{isCustom ? '教育目的に合わせて相談' : feeLabel}</dd></div><div><dt>{isCustom ? '問い合わせ' : '宿泊'}</dt><dd>{isCustom ? '大学・機関の担当者から' : accommodationLabel}</dd></div><div><dt>{isCustom ? '言語対応' : '最少催行'}</dt><dd>{isCustom ? '留学サポートデスクは英語での対応が可能' : coreFact?.minimumParticipants ? `${coreFact.minimumParticipants}名` : '確定後に掲載'}</dd></div><div><dt>{isCustom ? '個人申込' : '募集期間'}</dt><dd>{isCustom ? '対象外' : '確定後に掲載'}</dd></div><div><dt>{isCustom ? '設計方法' : '情報状態'}</dt><dd>{isCustom ? '担当者との協議により決定' : coreFact?.status === 'Confirmed' ? '確認済み' : coreFact?.status === 'Working plan' ? '計画中' : '確認中'}</dd></div></dl></div></section>

  <section class="programme-page__section programme-page__section--dark" id="before-you-apply" aria-labelledby="before-you-apply-title"><div class="site-shell programme-page__split"><div><p class="section-kicker">{isCustom ? 'ご相談' : '応募前の確認'}</p><h2 id="before-you-apply-title">{isCustom ? 'まず 大学・機関としてご相談ください' : '大切な条件は 応募する前に'}</h2></div><div class="programme-page__body-copy"><p>{isCustom ? '希望時期、参加人数、教育目的、関心のあるテーマ等を伺い、実施可能性を確認します。留学サポートデスクでは英語での相談・調整が可能です。' : coreFact ? coreFact.notes.join('。') + '。' : '応募資格、費用、宿泊、キャンセル条件、必要書類など、参加判断に必要な情報を応募前に確認できる状態を目指します。'}</p><p class="programme-page__status">{isCustom ? '個人学生向けの応募フォームではなく、海外大学・教育機関の担当者向け問い合わせ導線を使用します。' : coreFact?.status === 'Working plan' ? '計画情報は正式決定後に更新します。一般参加者と団体参加者で条件が異なる場合は、誤解が生じないよう案内を分離します。' : '募集状況と応募方法は、正式な情報を確認してから掲載します。'}</p>{isCustom && <a class="action-button action-button--primary" href={`${base}contact/`}>大学・機関として相談する</a>}</div></div></section>
</article>
