---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import ProgramCard from '../components/ProgramCard.astro';
const programs = (await getCollection('programs')).filter(({ data }) => data.featured);
---
<Layout title="Short-term study in Japan | Prototype" description="Explore fictional short-term study programs in Japan through this independent Astro website prototype.">
  <section class="hero">
    <div class="container hero-grid"><div><p class="eyebrow">Short-term study · Lasting perspective</p><h1>See Japan through a new lens.</h1><p class="lede">Join an international learning community for focused, place-based programs designed to connect academic ideas with everyday life.</p><div class="button-row"><a class="button" href="/programs/">Explore programs</a><a class="button secondary" href="/about/">About this prototype</a></div></div><div class="hero-art" role="img" aria-label="Abstract placeholder graphic inspired by a Japanese landscape"><span>LOCAL<br />PLACEHOLDER<br />GRAPHIC</span></div></div>
  </section>
  <aside class="notice"><div class="container"><strong>Prototype notice</strong><p>This is a prototype website created for evaluation purposes. It is not an official university website.</p></div></aside>
  <section class="section intro"><div class="container narrow"><p class="eyebrow">A different kind of classroom</p><h2>Learning that begins with place</h2><p class="large-copy">Our fictional programs bring students together to explore contemporary Japan through seminars, field visits and thoughtful exchange. Each experience is short in duration, but broad in perspective.</p></div></section>
  <section class="section muted"><div class="container"><div class="section-heading"><div><p class="eyebrow">Featured programs</p><h2>Find your next perspective</h2></div><a class="text-link" href="/programs/">View all programs →</a></div><div class="card-grid">{programs.map((program) => <ProgramCard program={program} />)}</div></div></section>
  <section class="section"><div class="container"><p class="eyebrow">Why study with us</p><h2>Designed for meaningful connection</h2><div class="feature-grid"><article><span class="number">01</span><h3>Focused learning</h3><p>Explore a timely theme through an intentional mix of classroom and field-based study.</p></article><article><span class="number">02</span><h3>Local perspective</h3><p>Look beyond the familiar with guided experiences and space for careful reflection.</p></article><article><span class="number">03</span><h3>Global community</h3><p>Share ideas with students from different disciplines, cultures and countries.</p></article></div></div></section>
  <section class="section experience"><div class="container split"><div class="placeholder-block" role="img" aria-label="Placeholder for student experience imagery"><span>STUDENT EXPERIENCE<br />IMAGE PLACEHOLDER</span></div><div><p class="eyebrow">Student experience</p><h2>Belong from day one</h2><p class="large-copy">Arrival support, small learning groups and shared activities make it easier to settle in and participate with confidence.</p><ul class="check-list"><li>Guided orientation and practical support</li><li>Welcoming cross-cultural activities</li><li>Time to explore independently</li></ul></div></div></section>
  <section class="section"><div class="container"><p class="eyebrow">Your program journey</p><h2>From curiosity to campus</h2><ol class="journey"><li><span>1</span><div><h3>Discover</h3><p>Compare themes, dates and learning formats.</p></div></li><li><span>2</span><div><h3>Prepare</h3><p>Review sample requirements and plan your stay.</p></div></li><li><span>3</span><div><h3>Participate</h3><p>Learn, explore and exchange ideas in Japan.</p></div></li><li><span>4</span><div><h3>Reflect</h3><p>Carry your new connections and perspective forward.</p></div></li></ol></div></section>
  <section class="section muted"><div class="container split"><div><p class="eyebrow">Frequently asked questions</p><h2>Plan with confidence</h2><p class="large-copy">Find prototype guidance about eligibility, language, accommodation and what a short program might include.</p><a class="button" href="/faq/">Read all FAQs</a></div><div class="faq-preview"><details open><summary>Do I need to speak Japanese?</summary><p>No. These fictional programs are described as English-taught, and language support varies by program.</p></details><details><summary>Is accommodation included?</summary><p>Each program lists its sample accommodation arrangement and fee information.</p></details><details><summary>Who can apply?</summary><p>For this prototype, detailed eligibility criteria have intentionally not been defined.</p></details></div></div></section>
  <section class="cta"><div class="container"><p class="eyebrow">Start a conversation</p><h2>Questions about the prototype?</h2><p>See how a future study-program website could guide prospective students.</p><a class="button light" href="/contact/">View contact prototype</a></div></section>
</Layout>
