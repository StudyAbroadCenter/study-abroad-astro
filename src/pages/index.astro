---
import StudentRecruitmentLayout from '../components/StudentRecruitmentLayout.astro';
import RecruitmentHero from '../components/RecruitmentHero.astro';
import ProgramFinder from '../components/ProgramFinder.astro';
import ExperiencePillars from '../components/ExperiencePillars.astro';
import InternationalLearningImpact from '../components/InternationalLearningImpact.astro';
import GlobalLearningEvidence from '../components/GlobalLearningEvidence.astro';
import RealPhotoStory from '../components/RealPhotoStory.astro';
import ParticipantDay from '../components/ParticipantDay.astro';
import CampusJourney from '../components/CampusJourney.astro';
import SupportPreview from '../components/SupportPreview.astro';
import PerformanceStyles from '../components/PerformanceStyles.astro';
import '../styles/ja-visual-refinement.css';
import '../styles/ja-typography-polish.css';
---
<StudentRecruitmentLayout
  title="立命館大学 短期受入プログラム"
  description="日本語・日本文化、学生共修、専門テーマ、大学向けCustom Programsを通じて、京都・大阪・滋賀で学ぶ立命館大学の短期受入プログラム。2023–2026年にはRSJP・RWJP系列で522名、27か国・地域、114大学・機関の参加実績があります。"
>
  <RecruitmentHero />
  <ProgramFinder />
  <ExperiencePillars />
  <InternationalLearningImpact context="site" />
  <GlobalLearningEvidence context="site" />
  <RealPhotoStory />
  <ParticipantDay />
  <CampusJourney />
  <SupportPreview />
  <PerformanceStyles />
</StudentRecruitmentLayout>
