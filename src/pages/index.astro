---
import StudentRecruitmentLayout from '../components/StudentRecruitmentLayout.astro';
import RecruitmentHero from '../components/RecruitmentHero.astro';
import ProgramFinder from '../components/ProgramFinder.astro';
import ExperiencePillars from '../components/ExperiencePillars.astro';
import InternationalLearningImpact from '../components/InternationalLearningImpact.astro';
import CoLearningEvidence from '../components/CoLearningEvidence.astro';
import HomeGlobalProof from '../components/HomeGlobalProof.astro';
import RealPhotoStory from '../components/RealPhotoStory.astro';
import ParticipantDay from '../components/ParticipantDay.astro';
import SupportPreview from '../components/SupportPreview.astro';
import PerformanceStyles from '../components/PerformanceStyles.astro';
import '../styles/ja-visual-refinement.css';
import '../styles/ja-typography-polish.css';
import '../styles/ja-mobile-final-fixes.css';
import '../styles/ja-home-visibility-pass.css';
---
<StudentRecruitmentLayout
  title="立命館大学 短期受入プログラム"
  description="立命館大学の短期受入プログラム。日本語・日本文化、学生共修、専門テーマから、自分に合う学びを探せます。海外大学・教育機関向けには、目的に合わせて設計するCustom Programsも用意しています。2023–2026年の定型4プログラムには522名、27か国・地域、114大学・機関から参加がありました。"
>
  <RecruitmentHero />
  <ProgramFinder />
  <ExperiencePillars />
  <InternationalLearningImpact context="site" />
  <CoLearningEvidence />
  <HomeGlobalProof />
  <RealPhotoStory />
  <ParticipantDay />
  <SupportPreview />
  <PerformanceStyles />
</StudentRecruitmentLayout>

<style is:global>
  .programme-pathways--student article > p {
    margin: 0 0 .45rem;
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.45;
    font-weight: 850;
    color: #2b2623;
  }

  .finder-controls {
    gap: 18px;
  }

  .finder-controls fieldset {
    min-height: 148px;
    padding: 24px 24px 22px;
    border: 1px solid #d9d2cc;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 10px 24px rgba(54, 43, 37, .06);
  }

  .finder-controls fieldset legend {
    float: left;
    width: 100%;
    margin: 0 0 18px;
    padding: 0;
    font-size: clamp(1.02rem, 1.8vw, 1.16rem);
    line-height: 1.4;
    font-weight: 850;
    color: #241f1c;
  }

  .finder-controls fieldset legend + * {
    clear: both;
  }

  .finder-controls fieldset legend > span {
    display: inline-grid;
    place-items: center;
    min-width: 2.1rem;
    height: 2.1rem;
    margin-right: .55rem;
    border-radius: 999px;
    background: #9b2335;
    color: #fff;
    font-size: .78rem;
    font-weight: 900;
  }

  .finder-controls__fact-note {
    justify-content: flex-start !important;
  }

  @media (max-width: 760px) {
    .finder-controls fieldset {
      min-height: 0;
      padding: 20px;
    }
  }
</style>
