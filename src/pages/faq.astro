---
import StudentRecruitmentLayout from '../components/StudentRecruitmentLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const faqs = [
  ['どのプログラムが自分に合いますか？', 'まずは「何を学びたいか」から探してください。日程・費用・条件などの重要情報は、各プログラムの詳細ページで確認できます。'],
  ['キャンパスは自分で選べますか？', '個人参加型プログラムでは、実施キャンパスはプログラムごとに決まっています。RWJPやExpress系は衣笠キャンパス、RDSPとRBMPは大阪いばらきキャンパス（OIC）で実施します。参加者が3キャンパスから自由に選択する仕組みではありません。'],
  ['日程や費用は、どこで確認できますか？', '各プログラムの詳細ページで、確認済みの年度別情報を案内します。準備中の項目を推測で埋めることはしません。'],
  ['日本語を勉強したことがなくても参加できますか？', '条件はプログラムごとに異なります。日本語レベルや事前準備の条件は、対象プログラムの「応募前の確認」を見てください。'],
  ['立命館の学生と交流できますか？', '学生との共修・交流の形や頻度は、プログラムと年度により異なります。交流の機会を紹介する場合も、個別の友人関係や一対一のマッチングを保証するものではありません。'],
  ['Custom Programsに個人で申し込めますか？', 'いいえ。Custom Programsは、海外大学・教育機関から学生団体を受け入れるためのプログラムです。大学・機関の担当者と、教育目的、期間、内容、参加人数、実施キャンパス等を相談しながら設計します。'],
  ['英語で相談できますか？', 'はい。留学サポートデスクでは英語での対応が可能です。Custom Programsについても、海外大学・教育機関の担当者から英語で相談・調整できます。'],
  ['掲載されている写真の活動は必ず実施されますか？', 'いいえ。写真は過去の実施・関連活動を含みます。授業、交流、文化体験、訪問先などの実施内容はプログラム・年度により異なります。'],
  ['「準備中」と表示されるページがあるのはなぜですか？', '未確認の日程・費用・条件をそれらしく作らず、確認できた情報から順に公開しているためです。準備中は、情報の不足を隠さないための表示です。'],
  ['英語版はありますか？', 'まず日本語版をマスターとして完成させ、その後に英語版を作ります。英語は直訳ではなく、同じ事実とデザインを使って自然な英語として書き直す方針です。'],
];
---
<StudentRecruitmentLayout
  title="よくある質問 | 立命館大学 短期受入プログラム"
  description="短期受入プログラムを検討するときに迷いやすいポイントを簡潔に案内します。"
  robots="noindex,nofollow"
>
  <article class="jp-utility">
    <div class="site-shell">
      <header class="jp-utility__intro">
        <div>
          <p class="section-kicker">よくある質問</p>
          <h1>迷ったら ここから</h1>
        </div>
        <p class="jp-utility__lead">答えは先に。条件は短く。重要な事実はFAQに隠さず、各プログラムの本文にも表示します。</p>
      </header>

      <section style="max-width:860px; margin-top:2.5rem;" aria-label="よくある質問">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </section>

      <div class="jp-utility__actions">
        <a class="action-button action-button--primary" href={`${base}programs/`}>プログラム一覧を見る</a>
        <a class="action-button action-button--dark" href={`${base}contact/`}>お問い合わせについて</a>
      </div>
    </div>
  </article>
</StudentRecruitmentLayout>
