---
import Layout from '../components/Layout.astro';
const faqs = [
  ['Are these real university programs?', 'No. Every program, place, date, fee and detail on this site is fictional and created only to evaluate an Astro-based content experience.'],
  ['Who would these programs be for?', 'A production website could define eligibility by program. This prototype imagines an international audience interested in short, English-taught study in Japan.'],
  ['Do students need to speak Japanese?', 'The sample programs assume no prior Japanese ability unless a program description says otherwise. Introductory language learning may form part of the experience.'],
  ['What does the sample fee include?', 'Fees are placeholders. A real program page would need a precise breakdown covering tuition, activities, accommodation, meals, transport and insurance.'],
  ['How is accommodation arranged?', 'Each program entry includes a sample accommodation field. The options shown—residence, guesthouse and homestay—are fictional.'],
  ['Can I apply through this website?', 'No. This prototype has no application system, form processing or personal-data collection.'],
  ['Is accessibility considered?', 'The prototype uses semantic structure, keyboard focus styles, responsive layouts, reduced-motion support and contrast-conscious colors as a starting point.'],
];
---
<Layout title="Frequently asked questions | Short Programs Prototype" description="Answers about the fictional programs and the scope of this independent website prototype.">
  <header class="page-hero"><div class="container narrow"><p class="eyebrow">Frequently asked questions</p><h1>Helpful details, clearly explained.</h1><p class="lede">These answers describe the prototype experience. They are not official admissions or travel guidance.</p></div></header>
  <section class="section"><div class="container narrow faq-list">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
  <section class="cta compact"><div class="container"><h2>Still exploring?</h2><p>Browse the fictional programs or view the contact-page concept.</p><div class="button-row"><a class="button light" href="/programs/">Browse programs</a><a class="button outline-light" href="/contact/">Contact prototype</a></div></div></section>
</Layout>
