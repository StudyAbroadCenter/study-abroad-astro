---
import StudentRecruitmentLayout from '../components/StudentRecruitmentLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const faqs = [
  ['どの短期留学プログラムが自分に合いますか？', 'まずは「何を学びたいか」から探してください。日本語・日本文化、専門テーマなどから選び、日程・費用・参加条件は各プログラムの詳細ページで確認できます。'],
  ['キャンパスは自分で選べますか？', '実施キャンパスはプログラムごとに異なります。参加を検討しているプログラムの詳細ページで、実施場所をご確認ください。'],
  ['日程や費用は、どこで確認できますか？', '各プログラムの詳細ページで年度別の情報をご案内します。参加を決める前に、日程、費用、宿泊、応募条件などをご確認ください。'],
  ['日本語を勉強したことがなくても参加できますか？', '条件はプログラムごとに異なります。日本語レベルや事前準備の条件は、対象プログラムの応募条件をご確認ください。'],
  ['立命館の学生と交流できますか？', '学生との共修・交流の形や頻度は、プログラムと年度により異なります。Buddy、ゼミ、学生団体との活動などが組み込まれる場合があります。'],
  ['Custom Programsに個人で申し込めますか？', 'いいえ。Custom Programsは、海外大学・教育機関から学生団体を受け入れるためのプログラムです。大学・機関の担当者と、教育目的、期間、内容、参加人数、実施キャンパス等を相談しながら設計します。'],
  ['海外大学の担当者は英語で相談できますか？', 'はい。留学サポートデスクでは英語での対応が可能です。Custom Programsについても、海外大学・教育機関の担当者から英語で相談・調整できます。'],
  ['掲載されている写真の活動は必ず実施されますか？', 'いいえ。写真は過去のプログラム・関連活動の様子です。授業、交流、文化体験、訪問先などの実施内容はプログラム・年度により異なります。'],
];
---
<StudentRecruitmentLayout
  title="立命館大学の短期留学FAQ｜日程・費用・日本語・国際交流"
  description="立命館大学の短期留学・短期受入プログラムに関するよくある質問。日程、費用、キャンパス、日本語レベル、学生交流、海外大学向けCustom Programsなど、参加前に確認したいポイントをご案内します。"
  robots="noindex,nofollow"
>
  <article class="jp-utility">
    <div class="site-shell">
      <header class="jp-utility__intro">
        <div>
          <p class="section-kicker">よくある質問</p>
          <h1>短期留学の疑問を ここで確認</h1>
        </div>
        <p class="jp-utility__lead">立命館大学の短期留学を検討するときに多い質問をまとめています。詳しい条件は、各プログラムのページもあわせてご確認ください。</p>
      </header>

      <section style="max-width:860px; margin-top:2.5rem;" aria-label="よくある質問">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </section>

      <div class="jp-utility__actions">
        <a class="action-button action-button--primary" href={`${base}programs/`}>プログラム一覧を見る</a>
        <a class="action-button action-button--dark" href={`${base}contact/`}>お問い合わせについて</a>
      </div>
    </div>
  </article>
</StudentRecruitmentLayout>
