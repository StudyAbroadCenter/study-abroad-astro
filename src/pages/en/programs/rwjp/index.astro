---
import EnglishStudentRecruitmentLayout from '../../../../components/EnglishStudentRecruitmentLayout.astro';
import EnglishRwjpFlagshipPage from '../../../../components/EnglishRwjpFlagshipPage.astro';
import { rwjp2027Facts, isKnownFact } from '../../../../data/rwjp/index';
import '../../../../styles/english-rwjp.css';
import '../../../../styles/english-rwjp-layout-fixes.css';
import '../../../../styles/english-rwjp-art-direction.css';
import '../../../../styles/english-rwjp-art-fixes.css';

const f = rwjp2027Facts;
const title = '2027 RWJP | Ritsumeikan Winter Japanese Program | Ritsumeikan University';
const dates = isKnownFact(f.programmeDates)
  ? `${f.programmeDates.value.start} to ${f.programmeDates.value.end}`
  : 'dates to be confirmed';
const fee = isKnownFact(f.programmeFee) ? `¥${f.programmeFee.value.toLocaleString('en-US')}` : 'fee to be confirmed';
const description = `2027 Ritsumeikan Winter Japanese Program in Kyoto: ${dates}. Study Japanese, live in Kyoto and experience university life at Kinugasa Campus. Program fee ${fee}.`;
---
<EnglishStudentRecruitmentLayout title={title} description={description} robots="noindex,nofollow" japaneseHref="/programs/rwjp">
  <EnglishRwjpFlagshipPage />
</EnglishStudentRecruitmentLayout>
