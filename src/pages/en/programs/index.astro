---
import EnglishStudentRecruitmentLayout from '../../../components/EnglishStudentRecruitmentLayout.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<EnglishStudentRecruitmentLayout title="Programs | Ritsumeikan University Short-Term Programs" description="Explore short-term programs at Ritsumeikan University." robots="noindex,nofollow" japaneseHref="/programs/">
  <section class="site-shell" style="padding: clamp(4rem, 8vw, 8rem) 0;">
    <p style="text-transform:uppercase;letter-spacing:.12em;font-size:.75rem;font-weight:700;">English program pages</p>
    <h1 style="font-family:'Source Serif 4',serif;font-size:clamp(2.8rem,6vw,5.5rem);line-height:1;margin:.7rem 0 1.5rem;">Choose the program.<br />Then check the details.</h1>
    <p style="max-width:44rem;line-height:1.7;color:#5c6673;">English detail pages are being published only after their programme facts and English editorial content have been reviewed. RWJP is the first completed detail-page model.</p>
    <a href={`${base}en/programs/rwjp/`} style="display:inline-block;margin-top:1.5rem;font-weight:700;color:#13243a;">2027 Ritsumeikan Winter Japanese Program →</a>
  </section>
</EnglishStudentRecruitmentLayout>
