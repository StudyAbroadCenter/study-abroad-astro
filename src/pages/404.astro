---
import StudentRecruitmentLayout from '../components/StudentRecruitmentLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<StudentRecruitmentLayout
  title="ページが見つかりません | 立命館大学 短期受入プログラム"
  description="お探しのページは見つかりませんでした。トップページまたはプログラム一覧からお進みください。"
  robots="noindex,nofollow"
>
  <article class="jp-utility">
    <div class="site-shell">
      <header class="jp-utility__intro">
        <div>
          <p class="section-kicker">404 · ページが見つかりません</p>
          <h1>その先は まだありません</h1>
        </div>
        <div>
          <p class="jp-utility__lead">URLが変わったか、ページがまだ準備中かもしれません。トップへ戻るか、プログラム一覧から続きを探してください。</p>
          <div class="jp-utility__actions">
            <a class="action-button action-button--primary" href={base}>トップへ戻る</a>
            <a class="action-button action-button--dark" href={`${base}programs/`}>プログラム一覧</a>
          </div>
        </div>
      </header>
    </div>
  </article>
</StudentRecruitmentLayout>
