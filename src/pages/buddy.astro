---
import StudentRecruitmentLayout from '../components/StudentRecruitmentLayout.astro';
import { fiveWeekJapaneseProgrammeEvidence } from '../data/participation-history';
import '../styles/buddy-rebuild.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path}`;

const countryLabels: Record<string, string> = {
  Australia: 'オーストラリア',
  'United States': 'アメリカ',
  'South Korea': '韓国',
  Canada: 'カナダ',
  'New Zealand': 'ニュージーランド',
  'United Kingdom': 'イギリス',
  China: '中国',
  Taiwan: '台湾',
  Macau: 'マカオ',
  Singapore: 'シンガポール',
  Qatar: 'カタール',
  Romania: 'ルーマニア',
  Azerbaijan: 'アゼルバイジャン',
  Finland: 'フィンランド',
  'Hong Kong': '香港',
  Japan: '日本',
  Mexico: 'メキシコ',
  Netherlands: 'オランダ',
  Poland: 'ポーランド',
  'Saudi Arabia': 'サウジアラビア',
  Turkmenistan: 'トルクメニスタン',
};

const mapPositions: Record<string, { x: number; y: number }> = {
  Australia: { x: 64, y: 78 },
  'United States': { x: 88, y: 40 },
  'South Korea': { x: 51, y: 40 },
  Canada: { x: 87, y: 28 },
  'New Zealand': { x: 73, y: 87 },
  'United Kingdom': { x: 24, y: 31 },
  China: { x: 47, y: 44 },
  Taiwan: { x: 52, y: 50 },
  Macau: { x: 49, y: 54 },
  Singapore: { x: 47, y: 67 },
  Qatar: { x: 35, y: 57 },
  Romania: { x: 31, y: 37 },
  Azerbaijan: { x: 36, y: 44 },
  Finland: { x: 29, y: 21 },
  'Hong Kong': { x: 50, y: 52 },
  Japan: { x: 55, y: 45 },
  Mexico: { x: 89, y: 58 },
  Netherlands: { x: 25, y: 32 },
  Poland: { x: 29, y: 33 },
  'Saudi Arabia': { x: 36, y: 60 },
  Turkmenistan: { x: 40, y: 45 },
};

const verifiedRegions = fiveWeekJapaneseProgrammeEvidence.regions.map((region) => ({
  ...region,
  label: countryLabels[region.countryOrRegion] ?? region.countryOrRegion,
  ...(mapPositions[region.countryOrRegion] ?? { x: 50, y: 50 }),
}));

const routePaths = verifiedRegions
  .filter((region) => region.countryOrRegion !== 'Japan')
  .map((region, index) => {
    const sx = region.x * 10;
    const sy = region.y * 5.6;
    const tx = 550;
    const ty = 252;
    const midX = (sx + tx) / 2;
    const lift = Math.max(55, Math.abs(sx - tx) * 0.14) + (index % 3) * 12;
    return `M${sx} ${sy} Q${midX} ${Math.min(sy, ty) - lift} ${tx} ${ty}`;
  });

const story = [
  { no: '1', en: 'MEET', ja: '出会う', body: 'キャンパスで留学生と出会う', image: 'programs/rwjp/real/rwjp-real-kyoto-field.webp', tone: 'coral' },
  { no: '2', en: 'LEARN', ja: '共に学ぶ', body: '一緒に学び 文化を理解する', image: 'programs/rwjp/real/rwjp-real-japanese-class.webp', tone: 'orange' },
  { no: '3', en: 'GO ABROAD', ja: '海外へ行く', body: '次は自分が世界へ踏み出す', image: 'programs/rwjp/real/rwjp-real-academic-presentation.webp', tone: 'green' },
  { no: '4', en: 'MEET AGAIN', ja: '再会する', body: '海外や日本で また会える', image: 'programs/rwjp/real/rwjp-real-learning-hub.webp', tone: 'blue' },
  { no: '5', en: 'STAY CONNECTED', ja: 'つながり続ける', body: '学生時代の出会いを未来へ', image: 'programs/rwjp/real/rwjp-real-culture-tatami.webp', tone: 'purple' },
];

const firstSteps = [
  ['英語に自信がなくても', 'まずは日本語で話してみる。完璧な英語から始めなくていい。'],
  ['1回だけでも', 'ランチや文化体験など、短い参加から国際交流を日常にできる。'],
  ['学生時代だからこそ', '所属や肩書きを越えて人と出会いやすい今の時間を使う。'],
  ['ガクチカの一つにも', '主体的に動いた経験や異文化協働は、自分の言葉で語れる経験になり得る。'],
];
---

<StudentRecruitmentLayout
  title="Buddy & Global Connections | 立命館大学 Study Abroad Center"
  description="立命館大学の学生向け国際交流・国際共修ページ。留学生との出会い、共修、留学、再会へとつながる学生時代の国際交流を紹介します。"
  photoDisclaimer="掲載写真には過去の実施例・関連プログラムの参考写真を含みます。募集内容・実施内容は学期・プログラムにより異なります。"
>
  <main class="buddy-new">
    <section class="buddy-new__hero" aria-labelledby="buddy-title">
      <div class="buddy-new__hero-grid">
        <div class="buddy-new__map-stage">
          <div class="buddy-new__earth" aria-hidden="true">
            <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Land_shallow_topo_2048.jpg?width=2400" alt="" />
            <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Land_shallow_topo_2048.jpg?width=2400" alt="" />
          </div>
          <div class="buddy-new__map-wash" aria-hidden="true"></div>

          <svg class="buddy-new__routes" viewBox="0 0 1000 560" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <marker id="buddy-new-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0L7 3.5L0 7Z" fill="rgba(255,255,255,.94)" /></marker>
            </defs>
            {routePaths.map((path) => <path d={path} marker-end="url(#buddy-new-arrow)" />)}
          </svg>

          {verifiedRegions.filter((region) => region.countryOrRegion !== 'Japan').map((region) => (
            <span class="buddy-new__marker" style={`--x:${region.x}%;--y:${region.y}%`}>
              <i aria-hidden="true"></i><b>{region.label}</b>
            </span>
          ))}

          <div class="buddy-new__hub" aria-label="立命館大学 関西・京都">
            <span>R</span><strong>立命館大学</strong><small>関西・京都</small>
          </div>

          <div class="buddy-new__hero-copy">
            <p class="buddy-new__eyebrow">BUDDY &amp; GLOBAL CONNECTIONS</p>
            <h1 id="buddy-title">世界から立命館へ<br />立命館から世界へ</h1>
            <p class="buddy-new__hero-story">交流が留学を生み<br />留学が再交流を生む<br /><strong>そのつながりは 一生の人的財産になる</strong></p>
            <a class="buddy-new__cta" href="#first-step">Buddyに参加する <span>→</span></a>
          </div>

          <p class="buddy-new__map-caption">世界の出会いが立命館に集まり　また世界へ広がっていく</p>
        </div>

        <aside class="buddy-new__evidence" aria-label="2023–2026年 参加大学・機関の所在地">
          <div class="buddy-new__evidence-head">
            <span>2023–2026</span>
            <strong>{fiveWeekJapaneseProgrammeEvidence.countriesOrRegions}</strong>
            <b>国・地域</b>
            <small>大学・機関の所在地で整理</small>
          </div>
          <div class="buddy-new__country-chips">
            {verifiedRegions.map((region) => <span>{region.flag} {region.label}</span>)}
          </div>
        </aside>
      </div>
    </section>

    <section class="buddy-new__story" aria-labelledby="buddy-story-title">
      <div class="buddy-new__section-head">
        <p>YOUR STORY CAN START HERE</p>
        <h2 id="buddy-story-title">広がるつながりのストーリー</h2>
        <span>ひとつの出会いが、次の世界への入口になる。</span>
      </div>
      <div class="buddy-new__story-track">
        {story.map((step, index) => (
          <article class={`buddy-new__story-card buddy-new__story-card--${step.tone}`}>
            <div class="buddy-new__story-photo"><img src={image(step.image)} alt="" loading="lazy" /></div>
            <div class="buddy-new__story-body">
              <p>{step.en}</p>
              <h3><span>{step.no}</span>{step.ja}</h3>
              <p>{step.body}</p>
            </div>
            {index < story.length - 1 && <span class="buddy-new__story-arrow" aria-hidden="true">›</span>}
          </article>
        ))}
      </div>
    </section>

    <section id="first-step" class="buddy-new__first-step" aria-labelledby="buddy-first-title">
      <div class="buddy-new__first-grid">
        <div class="buddy-new__first-copy">
          <p class="buddy-new__eyebrow">START SMALL</p>
          <h2 id="buddy-first-title">ちょっとした勇気でいい。<br />学生の今、世界へ一歩。</h2>
          <p>最初から留学を決めなくていい。まずは同じキャンパスにいる留学生と話してみる。学生時代だからこそできる、小さくて大きな一歩です。</p>
        </div>
        <div class="buddy-new__first-cards">
          {firstSteps.map(([title, body], index) => (
            <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{body}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="buddy-new__lifelong" aria-labelledby="buddy-life-title">
      <div class="buddy-new__lifelong-inner">
        <p class="buddy-new__eyebrow">FROM ONE ENCOUNTER TO A LIFELONG CONNECTION</p>
        <h2 id="buddy-life-title">交流が留学を生み<br />留学が再交流を生む</h2>
        <p>海外から学生が来る。立命館の学生も海外へ行く。学生時代の出会いが、世界との距離を変えていく。</p>
        <div class="buddy-new__life-line">
          {story.map((step) => <div><span>{step.en}</span><strong>{step.ja}</strong></div>)}
        </div>
        <div class="buddy-new__lifelong-message">
          <span>世界中に また会いたい人がいる</span>
          <strong>そのつながりは<br />一生の人的財産になる</strong>
        </div>
      </div>
    </section>

    <section class="buddy-new__join" aria-labelledby="buddy-join-title">
      <div class="buddy-new__join-panel">
        <div><p class="buddy-new__eyebrow">JOIN THE NEXT OPPORTUNITY</p><h2 id="buddy-join-title">次の出会いを、ここから。</h2><p>日本語講座、文化体験、キャンパス交流などの機会をStudy Abroad Centerから案内します。</p></div>
        <div class="buddy-new__join-status"><span>COMING SOON</span><strong>次回募集情報は準備中</strong><p>募集期間・対象・申込方法は確認後に掲載します。</p></div>
      </div>
    </section>
  </main>
</StudentRecruitmentLayout>
