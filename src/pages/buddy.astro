---
import StudentRecruitmentLayout from '../components/StudentRecruitmentLayout.astro';
import { fiveWeekJapaneseProgrammeEvidence } from '../data/participation-history';
import '../styles/buddy-new-build.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path}`;

const countryLabels: Record<string, string> = {
  Australia:'オーストラリア','United States':'アメリカ','South Korea':'韓国',Canada:'カナダ','New Zealand':'ニュージーランド','United Kingdom':'イギリス',China:'中国',Taiwan:'台湾',Macau:'マカオ',Singapore:'シンガポール',Qatar:'カタール',Romania:'ルーマニア',Azerbaijan:'アゼルバイジャン',Finland:'フィンランド','Hong Kong':'香港',Japan:'日本',Mexico:'メキシコ',Netherlands:'オランダ',Poland:'ポーランド','Saudi Arabia':'サウジアラビア',Turkmenistan:'トルクメニスタン'
};
const flagCodes: Record<string,string> = {
  Australia:'au','United States':'us','South Korea':'kr',Canada:'ca','New Zealand':'nz','United Kingdom':'gb',China:'cn',Taiwan:'tw',Macau:'mo',Singapore:'sg',Qatar:'qa',Romania:'ro',Azerbaijan:'az',Finland:'fi','Hong Kong':'hk',Japan:'jp',Mexico:'mx',Netherlands:'nl',Poland:'pl','Saudi Arabia':'sa',Turkmenistan:'tm'
};
const mapPositions: Record<string,{x:number;y:number}> = {
  Australia:{x:54.7,y:63.9},'United States':{x:90.3,y:28.3},'South Korea':{x:53.0,y:30.0},Canada:{x:88.1,y:18.9},'New Zealand':{x:66.1,y:72.8},'United Kingdom':{x:16.9,y:20.0},China:{x:46.4,y:30.6},Taiwan:{x:51.1,y:36.8},Macau:{x:49.0,y:37.7},Singapore:{x:46.3,y:49.3},Qatar:{x:31.7,y:35.9},Romania:{x:24.4,y:24.4},Azerbaijan:{x:30.7,y:27.7},Finland:{x:24.7,y:14.4},'Hong Kong':{x:49.2,y:37.6},Japan:{x:55.2,y:30.5},Mexico:{x:89.2,y:36.9},Netherlands:{x:19.0,y:21.1},Poland:{x:22.8,y:21.1},'Saudi Arabia':{x:30.0,y:36.7},Turkmenistan:{x:33.9,y:28.3}
};
const verifiedRegions=fiveWeekJapaneseProgrammeEvidence.regions.map(region=>({...region,label:countryLabels[region.countryOrRegion]??region.countryOrRegion,code:flagCodes[region.countryOrRegion]??'jp',...(mapPositions[region.countryOrRegion]??{x:50,y:50})}));
const kyotoHub={x:55.2,y:30.5};
const routePaths=verifiedRegions.filter(r=>r.countryOrRegion!=='Japan').map((r,index)=>{const sx=r.x*10,sy=r.y*5.6,tx=kyotoHub.x*10,ty=kyotoHub.y*5.6,midX=(sx+tx)/2,lift=Math.max(42,Math.abs(sx-tx)*.12)+(index%3)*9;return `M${sx} ${sy} Q${midX} ${Math.min(sy,ty)-lift} ${tx} ${ty}`;});
const story=[
 {no:'1',en:'MEET',ja:'出会う',body:'キャンパスで留学生と出会う',image:'programs/rwjp/real/rwjp-real-kyoto-field.webp',tone:'coral'},
 {no:'2',en:'LEARN',ja:'共に学ぶ',body:'一緒に学び 文化を理解する',image:'programs/rwjp/real/rwjp-real-japanese-class.webp',tone:'orange'},
 {no:'3',en:'GO ABROAD',ja:'海外へ行く',body:'次は自分が世界へ踏み出す',image:'programs/rwjp/real/rwjp-real-academic-presentation.webp',tone:'green'},
 {no:'4',en:'MEET AGAIN',ja:'再会する',body:'海外や日本で また会える',image:'programs/rwjp/real/rwjp-real-learning-hub.webp',tone:'blue'},
 {no:'5',en:'STAY CONNECTED',ja:'つながり続ける',body:'学生時代の出会いを未来へ',image:'programs/rwjp/real/rwjp-real-culture-tatami.webp',tone:'purple'}
];
const firstSteps=[['英語に自信がなくても','まずは日本語で話してみる。完璧な英語から始めなくていい。'],['1回だけでも','ランチや文化体験など、短い参加から国際交流を日常にできる。'],['学生時代だからこそ','所属や肩書きを越えて人と出会いやすい今の時間を使う。'],['ガクチカの一つにも','主体的に動いた経験や異文化協働は、自分の言葉で語れる経験になり得る。']];
---
<StudentRecruitmentLayout title="Buddy & Global Connections | 立命館大学 Study Abroad Center" description="立命館大学の学生向け国際交流・国際共修ページ。留学生との出会い、共修、留学、再会へとつながる学生時代の国際交流を紹介します。" photoDisclaimer="掲載写真には過去の実施例・関連プログラムの参考写真を含みます。募集内容・実施内容は学期・プログラムにより異なります。">
<main class="buddy-new">
<section class="buddy-new__hero" aria-labelledby="buddy-title"><div class="buddy-new__hero-grid"><div class="buddy-new__map-stage">
<div class="buddy-new__geo" aria-hidden="true">
  <div class="buddy-new__earth"><img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Land_shallow_topo_2048.jpg?width=2400" alt=""/><img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Land_shallow_topo_2048.jpg?width=2400" alt=""/></div>
  <div class="buddy-new__map-wash"></div>
  <svg class="buddy-new__routes" viewBox="0 0 1000 560" preserveAspectRatio="none">{routePaths.map(path => <path d={path} />)}</svg>
  {verifiedRegions.filter(r=>r.countryOrRegion!=='Japan').map(r => <span class="buddy-new__flag-marker" style={`--x:${r.x}%;--y:${r.y}%`} title={r.label}><img src={`https://flagcdn.com/w40/${r.code}.png`} alt="" loading="eager"/></span>)}
  <div class="buddy-new__hub buddy-new__hub--logo" style={`--x:${kyotoHub.x}%;--y:${kyotoHub.y}%`}><span>R</span></div>
</div>
<div class="buddy-new__hero-copy"><p class="buddy-new__eyebrow">BUDDY &amp; GLOBAL CONNECTIONS</p><h1 id="buddy-title"><span>世界から立命館へ</span><span>立命館から世界へ</span></h1><p class="buddy-new__hero-story">交流が留学を生み<br/>留学が再交流を生む<br/><strong>そのつながりは 一生の人的財産になる</strong></p><a class="buddy-new__cta" href="#first-step">Buddyに参加する <span>→</span></a></div>
<p class="buddy-new__map-caption">世界の出会いが立命館に集まり　また世界へ広がっていく</p></div>
<aside class="buddy-new__evidence" aria-label="2023–2026年 参加大学・機関の所在地"><div class="buddy-new__evidence-head"><span>2023–2026</span><strong>{fiveWeekJapaneseProgrammeEvidence.countriesOrRegions}</strong><b>国・地域</b><small>大学・機関の所在地で整理</small></div><div class="buddy-new__country-list">{verifiedRegions.map(r => <span><img src={`https://flagcdn.com/w40/${r.code}.png`} alt="" loading="eager"/>{r.label}</span>)}</div></aside></div></section>
<section class="buddy-new__story" aria-labelledby="buddy-story-title"><div class="buddy-new__section-head"><p>YOUR STORY CAN START HERE</p><h2 id="buddy-story-title">広がるつながりのストーリー</h2><span>ひとつの出会いが、次の世界への入口になる。</span></div><div class="buddy-new__story-track">{story.map((step,index) => <article class={`buddy-new__story-card buddy-new__story-card--${step.tone}`}><div class="buddy-new__story-photo"><img src={image(step.image)} alt="" loading="lazy"/></div><div class="buddy-new__story-body"><p>{step.en}</p><h3><span>{step.no}</span>{step.ja}</h3><p>{step.body}</p></div>{index < story.length - 1 ? <span class="buddy-new__story-arrow" aria-hidden="true">›</span> : null}</article>)}</div></section>
<section id="first-step" class="buddy-new__first-step" aria-labelledby="buddy-first-title"><div class="buddy-new__first-grid"><div class="buddy-new__first-copy"><p class="buddy-new__eyebrow">START SMALL</p><h2 id="buddy-first-title"><span>ちょっとした勇気でいい。</span><span>学生の今、世界へ一歩。</span></h2><p>最初から留学を決めなくていい。まずは同じキャンパスにいる留学生と話してみる。学生時代だからこそできる、小さくて大きな一歩です。</p></div><div class="buddy-new__first-cards">{firstSteps.map(([title,body],index) => <article><span>{String(index+1).padStart(2,'0')}</span><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
<section class="buddy-new__lifelong" aria-labelledby="buddy-life-title"><div class="buddy-new__lifelong-inner"><p class="buddy-new__eyebrow">FROM ONE ENCOUNTER TO A LIFELONG CONNECTION</p><h2 id="buddy-life-title"><span>交流が留学を生み</span><span>留学が再交流を生む</span></h2><p>海外から学生が来る。立命館の学生も海外へ行く。学生時代の出会いが、世界との距離を変えていく。</p><div class="buddy-new__life-line">{story.map(step => <div><span>{step.en}</span><strong>{step.ja}</strong></div>)}</div><div class="buddy-new__lifelong-message"><span>世界中に また会いたい人がいる</span><strong>そのつながりは<br/>一生の人的財産になる</strong></div></div></section>
<section class="buddy-new__join" aria-labelledby="buddy-join-title"><div class="buddy-new__join-panel"><div><p class="buddy-new__eyebrow">JOIN THE NEXT OPPORTUNITY</p><h2 id="buddy-join-title">次の出会いを、ここから。</h2><p>日本語講座、文化体験、キャンパス交流などの機会をStudy Abroad Centerから案内します。</p></div><div class="buddy-new__join-status"><span>COMING SOON</span><strong>次回募集情報は準備中</strong><p>募集期間・対象・申込方法は確認後に掲載します。</p></div></div></section>
</main>
<style>
.buddy-new__hero{padding-bottom:0!important}.buddy-new__hero-grid{width:100%!important;max-width:none!important;grid-template-columns:minmax(0,1fr) 292px!important;min-height:552px!important}.buddy-new__map-stage{min-height:552px!important;background:linear-gradient(180deg,#e5f6ff 0%,#f7fcff 100%)!important}.buddy-new__geo{position:absolute;z-index:1;left:25.5%;top:3%;width:66%;height:88%;overflow:hidden}.buddy-new__earth,.buddy-new__map-wash,.buddy-new__routes{position:absolute;inset:0}.buddy-new__earth img{position:absolute;top:0;width:100%;height:100%;object-fit:fill;filter:saturate(.82) brightness(1.28) contrast(.82)}.buddy-new__earth img:first-child{left:-32.5%}.buddy-new__earth img:last-child{left:67.5%}.buddy-new__map-wash{z-index:1;background:rgba(217,242,255,.28)}.buddy-new__routes{z-index:2;width:100%;height:100%}.buddy-new__routes path{fill:none;marker-end:none!important;stroke:rgba(255,255,255,.95)!important;stroke-width:1.65!important;stroke-linecap:round;filter:drop-shadow(0 0 3px rgba(255,255,255,.85))}.buddy-new__flag-marker{position:absolute;z-index:4;left:var(--x);top:var(--y);transform:translate(-50%,-50%);display:grid;place-items:center;width:34px;height:25px;padding:3px;border-radius:7px;background:rgba(255,255,255,.96);box-shadow:0 5px 14px rgba(14,52,80,.15)}.buddy-new__flag-marker img{display:block;width:100%;height:100%;object-fit:cover;border-radius:3px}.buddy-new__hub--logo{position:absolute!important;z-index:5!important;left:var(--x)!important;top:var(--y)!important;transform:translate(-50%,-50%)!important;padding:0!important;background:transparent!important;box-shadow:none!important;display:block!important}.buddy-new__hub--logo span{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:rgba(255,255,255,.97);color:#b51230;font-size:.9rem;font-weight:900;box-shadow:0 0 0 2px rgba(181,18,48,.3),0 5px 14px rgba(20,62,91,.14)}.buddy-new__hero-copy{left:3.6%!important;top:10.5%!important;width:28%!important;min-width:0!important}.buddy-new__hero-copy h1{font-size:clamp(2.35rem,3.15vw,3.45rem)!important;line-height:1.12!important}.buddy-new__hero-copy h1 span{white-space:nowrap}.buddy-new__hero-story{margin-top:25px!important;font-size:.94rem!important}.buddy-new__cta{margin-top:26px!important}.buddy-new__map-caption{left:58%!important;bottom:16px!important;font-size:.74rem!important}.buddy-new__evidence{padding:20px 18px!important;background:rgba(246,251,255,.92)!important;gap:14px!important}.buddy-new__evidence-head{padding:15px 14px 18px!important;border-radius:20px!important}.buddy-new__evidence-head strong{font-size:3.35rem!important}.buddy-new__country-list{display:grid;grid-template-columns:1fr 1fr;gap:8px 10px}.buddy-new__country-list span{display:flex;align-items:center;gap:7px;font-size:.67rem;font-weight:800;white-space:nowrap}.buddy-new__country-list img{width:21px;height:14px;object-fit:cover;border-radius:2px;box-shadow:0 0 0 1px rgba(16,43,70,.08)}.buddy-new__story{padding:18px 4vw 58px!important}.buddy-new__section-head{margin-bottom:20px!important}.buddy-new__section-head>p,.buddy-new__section-head>span{display:none!important}.buddy-new__section-head h2{font-size:1.75rem!important}.buddy-new__story-track{width:min(1320px,100%)!important;gap:14px!important}.buddy-new__story-photo{height:128px!important}.buddy-new__story-body{padding:12px 14px 16px!important}
@media(max-width:1100px){.buddy-new__hero-grid{grid-template-columns:1fr!important}.buddy-new__geo{left:20%;width:78%}.buddy-new__evidence{display:grid!important;grid-template-columns:220px 1fr!important}.buddy-new__hero-copy{width:36%!important}.buddy-new__country-list{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:760px){.buddy-new__map-stage{min-height:650px!important}.buddy-new__geo{left:-12%;top:29%;width:124%;height:62%}.buddy-new__hero-copy{left:24px!important;top:28px!important;width:calc(100% - 48px)!important}.buddy-new__hero-copy h1 span{white-space:normal}.buddy-new__map-caption{left:50%!important}.buddy-new__country-list{grid-template-columns:repeat(2,minmax(0,1fr))}.buddy-new__flag-marker{width:29px;height:22px}.buddy-new__evidence{grid-template-columns:1fr!important}}
</style>
</StudentRecruitmentLayout>