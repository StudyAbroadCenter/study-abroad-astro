---
import StudentRecruitmentLayout from '../components/StudentRecruitmentLayout.astro';
import { fiveWeekJapaneseProgrammeEvidence } from '../data/participation-history';
import '../styles/buddy.css';
import '../styles/buddy-globe-focus.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path}`;

const opportunities = [
  {
    number: '01',
    title: '日本語講座で話す',
    body: '留学生と一緒に学びながら 日本語で会話を楽しむ',
    note: '英語に自信がなくても大丈夫',
  },
  {
    number: '02',
    title: '文化体験を楽しむ',
    body: '日本文化を一緒に体験して 違いを知る',
    note: '1回だけの参加からでも大丈夫',
  },
  {
    number: '03',
    title: 'キャンパスでつながる',
    body: '授業やランチ 学内活動から自然な交流をつくる',
    note: '世界への入口はキャンパスにもある',
  },
];

const story = [
  {
    number: '1',
    title: '出会う',
    body: 'キャンパスで\n留学生と出会う',
    image: 'programs/rwjp/real/rwjp-real-kyoto-field.webp',
    tone: 'coral',
  },
  {
    number: '2',
    title: '共に学ぶ',
    body: '一緒に学び\n文化を理解する',
    image: 'programs/rwjp/real/rwjp-real-japanese-class.webp',
    tone: 'orange',
  },
  {
    number: '3',
    title: '海外へ行く',
    body: '自分も留学に\nチャレンジする',
    image: 'hero/hero-kinugasa-clocktower.jpg',
    tone: 'green',
  },
  {
    number: '4',
    title: '再会する',
    body: '海外や日本で\n再会する',
    image: 'programs/rwjp/real/rwjp-real-learning-hub.webp',
    tone: 'blue',
  },
  {
    number: '5',
    title: 'つながり続ける',
    body: '卒業後も世界中に\n友達がいる',
    image: 'programs/rwjp/real/rwjp-real-culture-tatami.webp',
    tone: 'violet',
  },
];

const capitalMap: Record<string, { city: string; x: number; y: number }> = {
  Australia: { city: 'キャンベラ', x: 67, y: 79 },
  'United States': { city: 'ワシントンD.C.', x: 89, y: 40 },
  'South Korea': { city: 'ソウル', x: 51, y: 39 },
  Canada: { city: 'オタワ', x: 88, y: 28 },
  'New Zealand': { city: 'ウェリントン', x: 73, y: 86 },
  'United Kingdom': { city: 'ロンドン', x: 24, y: 28 },
  China: { city: '北京', x: 47, y: 41 },
  Taiwan: { city: '台北', x: 52, y: 48 },
  Macau: { city: 'マカオ', x: 49, y: 52 },
  Singapore: { city: 'シンガポール', x: 47, y: 66 },
  Qatar: { city: 'ドーハ', x: 35, y: 55 },
  Romania: { city: 'ブカレスト', x: 31, y: 35 },
  Azerbaijan: { city: 'バクー', x: 36, y: 43 },
  Finland: { city: 'ヘルシンキ', x: 29, y: 18 },
  'Hong Kong': { city: '香港', x: 49, y: 50 },
  Japan: { city: '京都', x: 55, y: 44 },
  Mexico: { city: 'メキシコシティ', x: 90, y: 57 },
  Netherlands: { city: 'アムステルダム', x: 25, y: 29 },
  Poland: { city: 'ワルシャワ', x: 29, y: 31 },
  'Saudi Arabia': { city: 'リヤド', x: 36, y: 58 },
  Turkmenistan: { city: 'アシガバート', x: 40, y: 44 },
};

const verifiedCities = fiveWeekJapaneseProgrammeEvidence.regions.map((region) => ({
  ...region,
  ...(capitalMap[region.countryOrRegion] ?? { city: region.countryOrRegion, x: 50, y: 50 }),
}));

const routeCities = verifiedCities.filter((region) => region.countryOrRegion !== 'Japan');
---
<StudentRecruitmentLayout
  title="Buddy & Global Connections | 立命館大学 Study Abroad Center"
  description="立命館大学の学生向け国際交流・国際共修ページ 日本語講座や文化体験 キャンパス交流を通じて留学生と出会い 共に学び 次の留学や長期的なつながりへ広げます"
  photoDisclaimer="掲載写真には過去の実施例・関連プログラムの参考写真を含みます　募集内容・実施内容は学期・プログラムにより異なります"
>
  <section class="buddy-top" aria-labelledby="buddy-title">
    <div class="buddy-top__map" aria-hidden="true">
      <svg viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="topOcean" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#84d5ff" />
            <stop offset="58%" stop-color="#5eb9ea" />
            <stop offset="100%" stop-color="#3a9bd5" />
          </linearGradient>
          <linearGradient id="topLand" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#ecf8c7" />
            <stop offset="100%" stop-color="#84ca8a" />
          </linearGradient>
          <filter id="topHubGlow" x="-100%" y="-100%" width="300%" height="300%">
            <feGaussianBlur stdDeviation="7" result="blur" />
            <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
          <marker id="topArrow" markerWidth="7" markerHeight="7" refX="5.8" refY="3.5" orient="auto" markerUnits="strokeWidth">
            <path d="M0 0 L7 3.5 L0 7 Z" fill="#fff" />
          </marker>
        </defs>

        <rect width="1200" height="620" fill="url(#topOcean)" />

        <g class="buddy-top__grid">
          <path d="M0 103 H1200 M0 205 H1200 M0 310 H1200 M0 414 H1200 M0 516 H1200" />
          <path d="M100 0 V620 M300 0 V620 M500 0 V620 M700 0 V620 M900 0 V620 M1100 0 V620" />
        </g>

        <g fill="url(#topLand)" class="buddy-top__lands">
          <path d="M164 139 L191 111 L226 101 L267 102 L303 119 L333 135 L359 164 L340 185 L308 186 L289 203 L258 196 L232 184 L209 178 L180 167 Z" />
          <path d="M292 193 L317 199 L331 221 L335 246 L322 270 L307 248 L293 220 Z" />
          <path d="M228 214 L278 206 L319 221 L343 253 L340 299 L324 342 L303 386 L278 430 L250 409 L231 369 L217 323 L214 271 Z" />
          <path d="M338 151 L384 136 L438 136 L490 145 L531 164 L564 190 L567 216 L545 237 L502 245 L469 238 L437 243 L402 235 L367 220 L343 194 Z" />
          <path d="M543 164 L586 149 L627 151 L668 160 L704 178 L728 202 L722 226 L697 244 L671 249 L649 267 L620 262 L591 249 L562 229 L545 207 Z" />
          <path d="M559 272 L582 278 L602 292 L613 318 L605 342 L591 359 L575 344 L564 321 L552 299 Z" />
          <path d="M584 361 L610 367 L637 377 L663 389 L650 404 L624 403 L600 393 L575 383 Z" />
          <path d="M654 221 C666 229 672 238 668 249 C677 259 674 272 667 281 C659 274 658 265 650 259 C654 249 651 239 654 229 Z" />
          <path d="M645 286 C654 291 655 299 650 306 C643 303 640 296 645 286 Z" />
          <path d="M572 431 L612 420 L655 426 L686 447 L706 476 L695 513 L665 535 L625 543 L590 529 L563 501 L555 467 Z" />
          <path d="M731 503 L740 511 L745 525 L739 540 L731 530 L726 516 Z M750 532 L758 540 L763 551 L757 564 L749 553 L745 541 Z" />
          <path d="M859 110 L902 91 L950 83 L998 89 L1042 107 L1076 133 L1095 162 L1082 191 L1056 207 L1037 232 L1011 252 L976 255 L947 240 L923 218 L893 205 L872 180 L851 151 Z" />
          <path d="M1010 253 L1033 258 L1049 273 L1057 295 L1045 314 L1028 327 L1015 311 L1004 286 Z" />
          <path d="M1013 326 L1040 333 L1064 351 L1078 381 L1077 418 L1064 455 L1048 491 L1029 530 L1008 551 L994 520 L987 482 L989 441 L996 397 Z" />
          <path d="M1135 121 L1165 111 L1198 108 L1200 171 L1176 173 L1153 159 L1134 143 Z" />
          <path d="M0 124 L30 118 L49 134 L58 151 L39 167 L15 163 L0 154 Z" />
        </g>

        <g class="buddy-top__routes" marker-end="url(#topArrow)">
          {routeCities.map((region, index) => {
            const sx = (region.x / 100) * 1200;
            const sy = (region.y / 100) * 620;
            const tx = 656;
            const ty = 263;
            const midX = (sx + tx) / 2;
            const lift = Math.max(58, Math.abs(sx - tx) * 0.18) + (index % 3) * 12;
            const controlY = Math.min(sy, ty) - lift;
            return <path class="buddy-top__route" d={`M${sx} ${sy} Q${midX} ${controlY} ${tx} ${ty}`} />;
          })}
        </g>

        <g class="buddy-top__hub" filter="url(#topHubGlow)">
          <circle class="buddy-top__hub-ring" cx="656" cy="263" r="31" fill="none" />
          <circle cx="656" cy="263" r="19" fill="#fff" stroke="#a4213a" stroke-width="5" />
          <text x="656" y="270" text-anchor="middle" fill="#a4213a" font-size="21" font-weight="900">R</text>
        </g>
        <text class="buddy-top__hub-main" x="656" y="305" text-anchor="middle">立命館大学</text>
        <text class="buddy-top__hub-sub" x="656" y="327" text-anchor="middle">関西・京都</text>
      </svg>

      {verifiedCities.map((region) => (
        <span
          class:list={['buddy-top__city', region.countryOrRegion === 'Japan' && 'is-japan']}
          style={`--x:${region.x}%; --y:${region.y}%`}
          title={`${region.countryOrRegion} ${region.participants}名 ${region.institutions}大学・機関`}
        >
          <i aria-hidden="true"></i>
          <b>{region.countryOrRegion === 'Japan' ? '京都' : region.city}</b>
        </span>
      ))}
    </div>

    <div class="buddy-top__veil" aria-hidden="true"></div>

    <div class="buddy-top__copy">
      <p class="buddy-top__eyebrow">BUDDY & GLOBAL CONNECTIONS</p>
      <h1 id="buddy-title"><span>世界への最初の一歩は</span><span>キャンパスの中にある</span></h1>
      <p class="buddy-top__lead"><span>交流が留学を生み</span><span>留学が再交流を生む</span><span>そのつながりは</span><span>一生の人的財産になる</span></p>
      <a class="buddy-top__cta" href="#join">Buddyに参加する <span aria-hidden="true">→</span></a>
    </div>

    <aside class="buddy-top__evidence" aria-label="2023年から2026年の実績">
      <span>2023–2026</span>
      <strong>{fiveWeekJapaneseProgrammeEvidence.countriesOrRegions}</strong>
      <p>国・地域</p>
      <small>大学・機関の所在地で整理</small>
      <div class="buddy-top__chips">
        {verifiedCities.filter((region) => region.countryOrRegion !== 'Japan').map((region) => (
          <em>{region.flag} {region.countryOrRegion}</em>
        ))}
      </div>
    </aside>

    <p class="buddy-top__caption">世界の出会いが立命館に集まり　また世界へ広がっていく</p>
  </section>

  <section id="journey" class="buddy-story" aria-labelledby="buddy-story-title">
    <div class="site-shell">
      <h2 id="buddy-story-title">広がるつながりのストーリー</h2>
      <div class="buddy-story__grid">
        {story.map((item, index) => (
          <article class:list={['buddy-story__card', `is-${item.tone}`]}>
            <div class="buddy-story__image">
              <img src={image(item.image)} alt="" loading="lazy" decoding="async" />
            </div>
            <div class="buddy-story__body">
              <div class="buddy-story__title"><span>{item.number}</span><strong>{item.title}</strong></div>
              <p>{item.body.split('\n').map((line) => <span>{line}</span>)}</p>
            </div>
            {index < story.length - 1 && <span class="buddy-story__arrow" aria-hidden="true">›</span>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="buddy-opportunities" aria-labelledby="buddy-opportunities-title">
    <div class="site-shell">
      <header class="buddy-opportunities__header">
        <div>
          <p class="buddy-section-kicker">START SMALL</p>
          <h2 id="buddy-opportunities-title"><span>ちょっと参加したい</span><span>その気持ちからでいい</span></h2>
        </div>
        <p>最初から留学を決めなくていい　国際交流を日常の選択肢に</p>
      </header>
      <div class="buddy-opportunities__list">
        {opportunities.map((item) => (
          <article class="buddy-opportunity">
            <span class="buddy-opportunity__number">{item.number}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <small>{item.note}</small>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="buddy-support" aria-labelledby="buddy-support-title">
    <div class="site-shell buddy-support__grid">
      <div>
        <p class="buddy-section-kicker">SUPPORTED BY STUDY ABROAD CENTER</p>
        <h2 id="buddy-support-title"><span>英語の不安も</span><span>事務局が支える</span></h2>
      </div>
      <div class="buddy-support__copy">
        <p>Study Abroad Centerが英語での連絡や留学生との調整をサポート</p>
        <p>英語に自信がなくても 国際交流の最初の一歩を踏み出せる</p>
      </div>
    </div>
  </section>

  <section id="join" class="buddy-join" aria-labelledby="buddy-join-title">
    <div class="site-shell buddy-join__panel">
      <div>
        <p class="buddy-section-kicker">JOIN THE NEXT OPPORTUNITY</p>
        <h2 id="buddy-join-title"><span>次の出会いを</span><span>ここから始めよう</span></h2>
        <p>半期ごとに日本語講座 文化体験 キャンパス交流などを案内します</p>
      </div>
      <div class="buddy-join__status">
        <span>COMING SOON</span>
        <strong>次回募集情報は準備中</strong>
        <p>募集期間 対象 申込方法は確認後に掲載します</p>
      </div>
    </div>
  </section>
</StudentRecruitmentLayout>
