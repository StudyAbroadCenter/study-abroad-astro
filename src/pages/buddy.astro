---
import StudentRecruitmentLayout from '../components/StudentRecruitmentLayout.astro';
import { fiveWeekJapaneseProgrammeEvidence } from '../data/participation-history';
import '../styles/buddy.css';
import '../styles/buddy-globe-focus.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path}`;

const opportunities = [
  { number: '01', title: '日本語講座で話す', body: '留学生と一緒に学びながら 日本語で会話を楽しむ', note: '英語に自信がなくても大丈夫' },
  { number: '02', title: '文化体験を楽しむ', body: '日本文化を一緒に体験して 違いを知る', note: '1回だけの参加からでも大丈夫' },
  { number: '03', title: 'キャンパスでつながる', body: '授業やランチ 学内活動から自然な交流をつくる', note: '世界への入口はキャンパスにもある' },
];
const journey = [
  ['Meet', '出会う', 'キャンパスで留学生と出会う'],
  ['Learn', '共に学ぶ', 'ことばと文化の違いを知る'],
  ['Go Abroad', '海外へ行く', '交流が留学への一歩になる'],
  ['Meet Again', '再会する', '海外や日本でまた会える'],
  ['Stay Connected', 'つながり続ける', '出会いが一生の人的財産になる'],
];
const countryLabels: Record<string, string> = {Australia:'オーストラリア','United States':'アメリカ','South Korea':'韓国',Canada:'カナダ','New Zealand':'ニュージーランド','United Kingdom':'イギリス',China:'中国',Taiwan:'台湾',Macau:'マカオ',Singapore:'シンガポール',Qatar:'カタール',Romania:'ルーマニア',Azerbaijan:'アゼルバイジャン',Finland:'フィンランド','Hong Kong':'香港',Japan:'日本',Mexico:'メキシコ',Netherlands:'オランダ',Poland:'ポーランド','Saudi Arabia':'サウジアラビア',Turkmenistan:'トルクメニスタン'};
const mapPositions: Record<string, { x: number; y: number }> = {Australia:{x:64,y:77},'United States':{x:88,y:39},'South Korea':{x:51,y:39},Canada:{x:87,y:27},'New Zealand':{x:73,y:86},'United Kingdom':{x:24,y:29},China:{x:47,y:42},Taiwan:{x:52,y:49},Macau:{x:49,y:53},Singapore:{x:47,y:66},Qatar:{x:35,y:55},Romania:{x:31,y:35},Azerbaijan:{x:36,y:43},Finland:{x:29,y:19},'Hong Kong':{x:50,y:51},Japan:{x:55,y:44},Mexico:{x:89,y:57},Netherlands:{x:25,y:30},Poland:{x:29,y:31},'Saudi Arabia':{x:36,y:59},Turkmenistan:{x:40,y:44}};
const verifiedRegions = fiveWeekJapaneseProgrammeEvidence.regions.map(region => ({...region,label:countryLabels[region.countryOrRegion] ?? region.countryOrRegion,...(mapPositions[region.countryOrRegion] ?? {x:50,y:50})}));
const routeRegions = verifiedRegions.filter(region => region.countryOrRegion !== 'Japan');
---
<StudentRecruitmentLayout title="Buddy & Global Connections | 立命館大学 Study Abroad Center" description="立命館大学の学生向け国際交流・国際共修ページ 日本語講座や文化体験 キャンパス交流を通じて留学生と出会い 共に学び 次の留学や長期的なつながりへ広げます" photoDisclaimer="掲載写真には過去の実施例・関連プログラムの参考写真を含みます　募集内容・実施内容は学期・プログラムにより異なります">
  <section class="buddy-hero" aria-labelledby="buddy-title"><div class="buddy-hero__media" aria-hidden="true"><img src={image('hero/hero-kinugasa-clocktower.jpg')} alt="" loading="eager" decoding="async" fetchpriority="high" /></div><div class="buddy-hero__sky" aria-hidden="true"></div><div class="buddy-hero__veil"></div><div class="site-shell buddy-hero__content"><p class="buddy-hero__eyebrow">BUDDY & GLOBAL CONNECTIONS</p><h1 id="buddy-title"><span>世界への最初の一歩は</span><span>キャンパスの中にある</span></h1><p class="buddy-hero__lead"><span>交流が留学を生み</span><span>留学が再交流を生む</span></p><div class="buddy-hero__actions"><a class="action-button action-button--primary" href="#join">参加のしかたを見る</a><a class="action-button action-button--glass" href="#journey">その先を見る</a></div><p class="buddy-hero__note">英語力は問いません　1回から参加できます</p></div></section>
  <section class="buddy-intro" aria-labelledby="buddy-intro-title"><div class="site-shell buddy-intro__grid"><div><p class="buddy-section-kicker">INTERCULTURAL LEARNING</p><h2 id="buddy-intro-title"><span>交流をもっと日常に</span><span>世界をもっと身近に</span></h2></div><div class="buddy-intro__copy"><p>短期留学生を迎えることは 立命館の学生にとっても学びのチャンス</p><p>まず一度 同じテーブルに座ることから始めよう</p></div></div></section>
  <section class="buddy-photo-ribbon" aria-label="国際交流の風景"><figure class="buddy-photo-ribbon__main"><img src={image('programs/rwjp/real/rwjp-real-japanese-class.webp')} alt="教室で日本語を学ぶ短期受入プログラムの学生たち" loading="lazy" decoding="async" /><figcaption><span>LEARN TOGETHER</span><strong>一緒に学ぶ</strong></figcaption></figure><figure><img src={image('programs/rwjp/real/rwjp-real-culture-tatami.webp')} alt="畳の部屋で日本文化を学ぶ学生たち" loading="lazy" decoding="async" /><figcaption><span>SHARE CULTURE</span><strong>文化を共有する</strong></figcaption></figure><figure><img src={image('programs/rwjp/real/rwjp-real-kyoto-field.webp')} alt="京都でグループ活動を行う学生たち" loading="lazy" decoding="async" /><figcaption><span>GO BEYOND CAMPUS</span><strong>街へ出る</strong></figcaption></figure></section>
  <section class="buddy-opportunities" aria-labelledby="buddy-opportunities-title"><div class="site-shell"><header class="buddy-opportunities__header"><div><p class="buddy-section-kicker">START SMALL</p><h2 id="buddy-opportunities-title"><span>ちょっと参加したい</span><span>その気持ちからでいい</span></h2></div><p>最初から留学を決めなくていい　国際交流を日常の選択肢に</p></header><div class="buddy-opportunities__list">{opportunities.map(item => <article class="buddy-opportunity"><span class="buddy-opportunity__number">{item.number}</span><div><h3>{item.title}</h3><p>{item.body}</p><small>{item.note}</small></div></article>)}</div></div></section>
  <section id="journey" class="buddy-journey" aria-labelledby="buddy-journey-title"><div class="site-shell buddy-journey__intro"><p class="buddy-section-kicker">FROM ONE ENCOUNTER TO A LIFELONG CONNECTION</p><h2 id="buddy-journey-title"><span>交流が留学を生み</span><span>留学が再交流を生む</span></h2><p>海外から学生が来る　立命館の学生も海外へ行く　出会いが世界との距離を変えていく</p></div><div class="site-shell buddy-journey__track" role="list">{journey.map(([en,ja,body],index) => <article class="buddy-journey__step" role="listitem"><div class="buddy-journey__index">{String(index+1).padStart(2,'0')}</div><p class="buddy-journey__english">{en}</p><h3>{ja}</h3><p>{body}</p></article>)}</div><div class="site-shell buddy-journey__statement"><p>世界中に また会いたい人がいる</p><strong><span>そのつながりは</span><span>一生の人的財産になる</span></strong></div></section>
  <section class="buddy-global" aria-labelledby="buddy-global-title"><div class="site-shell buddy-global__header"><div><p class="buddy-section-kicker">A CAMPUS CONNECTED TO THE WORLD</p><h2 id="buddy-global-title"><span>世界から立命館へ</span><span>立命館から世界へ</span></h2></div><p>2023–2026年の5週間日本語プログラムでは 21の国・地域に所在する大学・機関から学生が参加</p></div><div class="site-shell buddy-global__scene"><div class="buddy-global__globe" aria-label="日本を中心に世界各地と立命館大学のつながりを示す世界地図"><div class="buddy-global__sun" aria-hidden="true"></div><svg class="buddy-global__sphere" viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid meet" role="img" aria-label="日本を中心に配置した世界地図と立命館大学へ向かう交流ルート"><defs><linearGradient id="mapOcean" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#6bc6f5" /><stop offset="100%" stop-color="#d9f2ff" /></linearGradient><linearGradient id="mapLand" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#dff6bd" /><stop offset="100%" stop-color="#77cf8a" /></linearGradient><marker id="routeArrow" markerWidth="8" markerHeight="8" refX="6.4" refY="4" orient="auto" markerUnits="strokeWidth"><path d="M0 0 L8 4 L0 8 Z" fill="#ffffff" /></marker></defs><rect width="1200" height="620" rx="34" fill="url(#mapOcean)" /><g class="buddy-global__map-grid" aria-hidden="true"><path d="M0 103 H1200 M0 206 H1200 M0 310 H1200 M0 414 H1200 M0 517 H1200" /><path d="M100 0 V620 M300 0 V620 M500 0 V620 M700 0 V620 M900 0 V620 M1100 0 V620" /></g><g fill="url(#mapLand)" class="buddy-global__lands" aria-hidden="true"><path d="M164 139 L191 111 L226 101 L267 102 L303 119 L333 135 L359 164 L340 185 L308 186 L289 203 L258 196 L232 184 L209 178 L180 167 Z" /><path d="M292 193 L317 199 L331 221 L335 246 L322 270 L307 248 L293 220 Z" /><path d="M228 214 L278 206 L319 221 L343 253 L340 299 L324 342 L303 386 L278 430 L250 409 L231 369 L217 323 L214 271 Z" /><path d="M338 151 L384 136 L438 136 L490 145 L531 164 L564 190 L545 213 L504 214 L478 206 L451 213 L421 205 L393 185 L360 181 Z" /><path d="M363 216 L391 206 L423 214 L438 238 L431 275 L416 310 L398 338 L378 320 L365 291 L354 251 Z" /><path d="M507 221 L548 214 L587 224 L621 247 L652 281 L636 307 L604 301 L580 283 L554 272 L534 251 Z" /><path d="M648 367 L689 351 L728 365 L755 397 L747 432 L711 449 L672 439 L650 412 Z" /><path d="M550 234 L563 225 L577 235 L571 250 L556 251 Z" /></g>{routeRegions.map((region,index) => {const sx=region.x*12,sy=region.y*6.2,ex=55*12,ey=44*6.2,cx=(sx+ex)/2,cy=Math.min(sy,ey)-58-((index%4)*14);return <path class="buddy-global__route" d={`M${sx} ${sy} Q${cx} ${cy} ${ex} ${ey}`} marker-end="url(#routeArrow)" />;})}{verifiedRegions.map(region => <g class="buddy-global__country" transform={`translate(${region.x*12} ${region.y*6.2})`}><circle r="4.8" /><text x="9" y="4">{region.label}</text></g>)}<g class="buddy-global__hub" transform="translate(660 273)"><circle r="29" /><text text-anchor="middle" y="8">R</text><text class="buddy-global__hub-name" text-anchor="middle" y="62">立命館大学</text></g></svg><p class="buddy-global__tagline">世界の出会いが立命館に集まり　また世界へ広がっていく</p></div><aside class="buddy-global__stats" aria-label="2023–2026年 5週間日本語プログラム参加実績"><div class="buddy-global__stats-kpi"><span>2023–2026</span><strong>{fiveWeekJapaneseProgrammeEvidence.countriesOrRegions}</strong><b>国・地域</b><small>大学・機関の所在地で整理</small></div><div class="buddy-global__chips">{verifiedRegions.map(region => <span><b>{region.code}</b>{region.label}</span>)}</div></aside></div></section>
  <section id="join" class="buddy-opportunities"><div class="site-shell"><header class="buddy-opportunities__header"><div><p class="buddy-section-kicker">JOIN</p><h2><span>まずは一回</span><span>参加してみる</span></h2></div><p>募集情報はStudy Abroad Centerから案内します</p></header></div></section>
</StudentRecruitmentLayout>