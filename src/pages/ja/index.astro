---
import Layout from '../../components/Layout.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const hero = withBase('/images/Hero/hero-kinugasa-clocktower.jpg');
const programs = [
  ['RSJP','立命館サマー日本語プログラム','夏・5週間','日本語、日本文化、学生交流','成績表あり'],
  ['RSJP Express','RSJP Express','夏・2週間','RSJPの短期集中版','成績表なし'],
  ['RWJP','立命館ウィンター日本語プログラム','冬・5週間','日本語、日本文化、学生交流','成績表あり'],
  ['RWJP Express','RWJP Express','冬・2週間','RWJPの短期集中版','成績表なし'],
  ['RDSP','立命館データサイエンスプログラム','期間未定','AI、ビッグデータ、データ分析','詳細調整中'],
  ['RBMP','立命館ビジネス・マネジメントプログラム','期間未定','ビジネス、経営、イノベーション','詳細調整中'],
  ['CUSTOM','カスタムプログラム','柔軟に設定','海外大学の要望に応じて設計','個別相談'],
];
---
<Layout lang="ja" title="立命館大学 短期受入プログラム | 日本語版プロトタイプ" description="立命館大学の短期受入プログラムを紹介する日本語版デジタルパンフレットのプロトタイプです。">
  <section class="ja-hero" style={`--hero-image:url('${hero}')`}>
    <div class="ja-hero-overlay"></div>
    <div class="container ja-hero-content">
      <p class="eyebrow light-eyebrow">京都・衣笠キャンパスで学ぶ</p>
      <h1>世界とつながる学びを、<br />京都・衣笠から。</h1>
      <p>日本語、日本文化、データサイエンス、ビジネス。立命館大学で学び、学生と交流し、日本を深く知る短期プログラムです。</p>
      <div class="button-row"><a class="button" href="#programs">プログラムを見る</a><a class="button outline-light" href="#eligibility">参加資格を確認</a></div>
    </div>
  </section>

  <aside class="notice"><div class="container"><strong>プロトタイプ</strong><p>本サイトは評価用サンプルです。立命館大学の公式サイトではありません。</p></div></aside>

  <section class="section"><div class="container narrow"><p class="eyebrow">短期受入プログラム</p><h2>学ぶ。体験する。つながる。</h2><p class="large-copy">海外の大学・大学院に在籍する学生を対象に、日本語教育、日本文化、専門分野の学習、立命館の学生との交流を組み合わせたプログラムを提供します。</p></div></section>

  <section class="section muted" id="programs"><div class="container"><div class="section-heading"><div><p class="eyebrow">Programmes</p><h2>自分に合うプログラムを見つける</h2></div></div><div class="ja-program-grid">{programs.map(([code,name,term,focus,record]) => <article class="ja-program-card"><p class="program-code">{code}</p><h3>{name}</h3><p class="format-pill">{term}</p><p>{focus}</p><dl><div><dt>成績表等</dt><dd>{record}</dd></div></dl><a class="text-link" href="#comparison">比較する →</a></article>)}</div></div></section>

  <section class="section" id="eligibility"><div class="container split align-start"><div><p class="eyebrow">全プログラム共通</p><h2>参加資格と単位</h2><p class="large-copy">参加時点で大学または大学院に正規在籍し、在籍証明書を提出できる方が対象です。</p></div><div class="eligibility-panel"><div><strong>参加できる方</strong><p>現役の大学生・大学院生。就業中でも、大学・大学院に正規在籍していれば参加できます。</p></div><div><strong>参加できない方</strong><p>高校生、大学・大学院に在籍していない社会人、既卒者。</p></div><div><strong>単位</strong><p>立命館大学の単位は付与されません。所属大学での単位認定は、所属大学へご確認ください。</p></div></div></div></section>

  <section class="section muted" id="experience"><div class="container"><p class="eyebrow">RSJP / RWJP</p><h2>日本語と日本文化を、キャンパスで学ぶ</h2><div class="feature-grid"><article><span class="number">01</span><h3>日本語講座</h3><p>会話、聴解、読解、作文をバランスよく学び、総合的なコミュニケーション力を養います。</p></article><article><span class="number">02</span><h3>Japan Studies</h3><p>講義、フィールドワークに加え、学生団体との共修を行います。茶道、和太鼓、スポーツ等を予定していますが、内容は年度により異なります。</p></article><article><span class="number">03</span><h3>バディ交流</h3><p>立命館の学生とグループで交流し、日本語を使いながらキャンパス生活や日本文化を学びます。</p></article></div></div></section>

  <section class="section" id="comparison"><div class="container"><p class="eyebrow">Comparison</p><h2>標準版とExpressの違い</h2><div class="ja-comparison"><div><strong>RSJP / RWJP</strong><span>5週間</span><span>日本語講座の成績表を発行</span></div><div><strong>RSJP / RWJP Express</strong><span>2週間</span><span>成績表は発行せず、教員コメントを提供</span></div></div></div></section>

  <section class="section muted" id="faq"><div class="container split"><div><p class="eyebrow">よくある質問</p><h2>参加前に知っておきたいこと</h2><p class="large-copy">将来は、現在開発中のQ&Aアプリと連携し、承認済みの情報を表示する構想です。</p></div><div class="faq-preview"><details open><summary>社会人でも参加できますか？</summary><p>大学または大学院に正規在籍し、在籍証明書を提出できる場合は参加できます。</p></details><details><summary>単位は取得できますか？</summary><p>立命館大学の単位は付与されません。</p></details><details><summary>Japan Studiesの内容は毎年同じですか？</summary><p>茶道、和太鼓、スポーツなどを候補としていますが、学生団体や年度の状況により変わります。</p></details></div></div></section>

  <section class="cta"><div class="container"><p class="eyebrow">Digital Prospectus</p><h2>留学フェアや海外大学との打ち合わせにも。</h2><p>写真、比較情報、参加資格、FAQを一つのサイトで確認できるデジタルパンフレットを目指します。</p></div></section>
</Layout>
