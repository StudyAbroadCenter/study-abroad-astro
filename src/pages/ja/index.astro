---
import Layout from '../../components/Layout.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const image = (name: string) => withBase(`/images/${name}`);
const hero = withBase('/images/hero/hero-kinugasa-clocktower.jpg');
const programs = [
  ['RSJP','立命館サマー日本語プログラム','夏・5週間','日本語 × 日本文化 × 学生交流','成績表あり','IMG_8178.JPG'],
  ['RSJP Express','RSJP Express','夏・2週間','RSJPの短期集中版','成績表なし','IMG_5092.JPG'],
  ['RWJP','立命館ウィンター日本語プログラム','冬・5週間','日本語 × 日本文化 × 学生交流','成績表あり','IMG_8263.JPG'],
  ['RWJP Express','RWJP Express','冬・2週間','RWJPの短期集中版','成績表なし','IMG_1588.JPG'],
  ['RDSP','立命館データサイエンスプログラム','期間未定','AI・ビッグデータ・データ分析','詳細調整中','IMG_3725.JPG'],
  ['RBMP','立命館ビジネス・マネジメントプログラム','期間未定','ビジネス・経営・イノベーション','詳細調整中','IMG_6091.JPG'],
  ['CUSTOM','カスタムプログラム','柔軟に設定','海外大学の要望に応じて設計','個別相談','IMG_1687.JPG'],
];
---
<Layout lang="ja" title="立命館大学 短期受入プログラム | 日本語版プロトタイプ" description="立命館大学の短期受入プログラムを紹介する日本語版デジタルパンフレットのプロトタイプです。">
  <section class="ja-hero" style={`--hero-image:url('${hero}')`}>
    <div class="ja-hero-glow"></div>
    <div class="container ja-hero-grid">
      <div class="ja-hero-copy">
        <p class="eyebrow hero-kicker">SHORT PROGRAMS / KYOTO</p>
        <h1><span>学ぶだけでは、</span><span>終わらない。</span></h1>
        <p class="hero-lede">京都・衣笠キャンパスを舞台に、ことば、文化、専門分野、学生交流を横断する短期留学プログラム。</p>
        <div class="button-row"><a class="button hero-primary" href="#programs">プログラムを見る</a><a class="button hero-secondary" href="#experience">体験から見る</a></div>
      </div>
      <div class="hero-tag" aria-hidden="true"><span>RITSUMEIKAN</span><strong>SHORT<br/>PROGRAMS</strong></div>
    </div>
  </section>

  <aside class="notice"><div class="container"><strong>PROTOTYPE</strong><p>本サイトは評価用サンプルです。立命館大学の公式サイトではありません。</p></div></aside>

  <section class="section manifesto"><div class="container manifesto-grid"><p class="eyebrow">WHY THIS SITE</p><h2><span>大学案内ではなく、</span><span>体験への入口をつくる。</span></h2><p>このサイトは、海外大学との打ち合わせ、留学フェア、学生のスマートフォンで使うデジタルカタログです。説明するだけでなく、見た瞬間に「行ってみたい」と思えることを目指します。</p></div></section>

  <section class="section programme-section" id="programs"><div class="container"><div class="section-heading bold-heading"><div><p class="eyebrow">PROGRAMMES</p><h2><span>選ぶ。</span><span>比べる。</span><span>飛び込む。</span></h2></div><p>期間、季節、学びのテーマから、自分に合うプログラムへ。</p></div><div class="ja-program-grid">{programs.map(([code,name,term,focus,record,file], index) => <article class={`ja-program-card card-${index + 1}`}><div class="ja-program-photo"><img src={image(file)} alt="" loading="lazy" /><span>{code}</span></div><div class="ja-program-body"><p class="program-index">0{index + 1}</p><h3>{name}</h3><p class="format-pill">{term}</p><p class="program-focus">{focus}</p><div class="program-record"><span>成績表等</span><strong>{record}</strong></div><a class="text-link" href="#comparison">比較する →</a></div></article>)}</div></div></section>

  <section class="section experience-section" id="experience"><div class="container"><div class="section-heading bold-heading light"><div><p class="eyebrow">EXPERIENCE</p><h2><span>教室の外まで、</span><span>全部が学びになる。</span></h2></div><p>授業、文化、仲間、京都。短期だからこそ、密度の高い時間を。</p></div><div class="story-grid"><article class="story-photo"><img src={image('IMG_8178.JPG')} alt="日本語講座の授業風景" loading="lazy" /><div><p class="eyebrow">LANGUAGE</p><h3><span>ことばを学び、</span><span>すぐに使う。</span></h3><p>会話、聴解、読解、作文を横断し、キャンパスで使える日本語へ。</p></div></article><article class="story-photo"><img src={image('IMG_5092.JPG')} alt="茶道体験の抹茶と茶筅" loading="lazy" /><div><p class="eyebrow">JAPAN STUDIES</p><h3><span>文化を知り、</span><span>一緒にやってみる。</span></h3><p>茶道、和太鼓、スポーツなど、学生団体との共修を含む体験型プログラム。</p></div></article><article class="story-photo"><img src={image('IMG_1656.JPG')} alt="衣笠キャンパスの時計台と芝生" loading="lazy" /><div><p class="eyebrow">COMMUNITY</p><h3><span>見学者ではなく、</span><span>キャンパスの一員へ。</span></h3><p>バディ交流とサポートを通じて、安心して人とつながる。</p></div></article></div></div></section>

  <section class="section day-section"><div class="container"><div class="section-heading bold-heading"><div><p class="eyebrow">A DAY ON CAMPUS</p><h2><span>一日が、</span><span>あっという間に濃くなる。</span></h2></div></div><ol class="day-timeline"><li><span>09:00</span><div><h3>日本語講座</h3><p>午前は日本語を集中的に学ぶ。</p></div></li><li><span>12:15</span><div><h3>昼休み・学生交流</h3><p>食べる、話す、つながる。</p></div></li><li><span>13:30</span><div><h3>Japan Studies</h3><p>文化講義、共修、フィールドワーク。</p></div></li><li><span>16:30</span><div><h3>京都へ</h3><p>学びを街へ持ち出す。</p></div></li></ol><p class="fine-print">※時間と内容は一例です。実際のスケジュールはプログラムにより異なります。</p></div></section>

  <section class="section eligibility-section" id="eligibility"><div class="container split align-start"><div><p class="eyebrow">ELIGIBILITY</p><h2><span>参加条件は、</span><span>シンプルです。</span></h2><p class="large-copy">参加時点で大学または大学院に正規在籍し、在籍証明書を提出できる方が対象です。</p></div><div class="eligibility-panel"><div><strong>参加できる方</strong><p>現役の大学生・大学院生。就業中でも、大学・大学院に正規在籍していれば参加できます。</p></div><div><strong>参加できない方</strong><p>高校生、大学・大学院に在籍していない社会人、既卒者。</p></div><div><strong>単位</strong><p>立命館大学の単位は付与されません。所属大学での単位認定は、所属大学へご確認ください。</p></div></div></div></section>

  <section class="section comparison-section" id="comparison"><div class="container"><div class="section-heading bold-heading light"><div><p class="eyebrow">COMPARE</p><h2><span>5週間か。</span><span>2週間か。</span></h2></div><p>深く学ぶか、短く集中するか。</p></div><div class="ja-comparison"><div><strong>RSJP / RWJP</strong><span>5週間</span><span>日本語講座の成績表を発行</span></div><div><strong>RSJP / RWJP Express</strong><span>2週間</span><span>成績表は発行せず、教員コメントを提供</span></div></div></div></section>

  <section class="section faq-section" id="faq"><div class="container split"><div><p class="eyebrow">FAQ</p><h2><span>迷ったら、</span><span>ここから。</span></h2><p class="large-copy">将来は、現在開発中のQ&Aアプリと連携し、承認済みの情報を表示する構想です。</p></div><div class="faq-preview"><details open><summary>社会人でも参加できますか？</summary><p>大学または大学院に正規在籍し、在籍証明書を提出できる場合は参加できます。</p></details><details><summary>単位は取得できますか？</summary><p>立命館大学の単位は付与されません。</p></details><details><summary>Japan Studiesの内容は毎年同じですか？</summary><p>茶道、和太鼓、スポーツなどを候補としていますが、学生団体や年度の状況により変わります。</p></details></div></div></section>

  <section class="cta catalog-cta"><div class="container"><p class="eyebrow">DIGITAL PROSPECTUS</p><h2><span>説明するサイトから、</span><span>惹きつけるサイトへ。</span></h2><p>留学フェアでも、海外大学との打ち合わせでも、スマートフォンでも。短期留学プログラムの魅力を、ひとつの体験として届けます。</p></div></section>
</Layout>
