---
import Layout from '../../components/Layout.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const image = (name: string) => withBase(`/images/${name}`);
const hero = withBase('/images/hero/hero-kinugasa-clocktower.jpg');
const programs = [
  ['RSJP','立命館サマー日本語プログラム','夏・5週間','日本語、日本文化、学生交流','成績表あり','IMG_8178.JPG'],
  ['RSJP Express','RSJP Express','夏・2週間','RSJPの短期集中版','成績表なし','IMG_5092.JPG'],
  ['RWJP','立命館ウィンター日本語プログラム','冬・5週間','日本語、日本文化、学生交流','成績表あり','IMG_8263.JPG'],
  ['RWJP Express','RWJP Express','冬・2週間','RWJPの短期集中版','成績表なし','IMG_1588.JPG'],
  ['RDSP','立命館データサイエンスプログラム','期間未定','AI、ビッグデータ、データ分析','詳細調整中','IMG_3725.JPG'],
  ['RBMP','立命館ビジネス・マネジメントプログラム','期間未定','ビジネス、経営、イノベーション','詳細調整中','IMG_6091.JPG'],
  ['CUSTOM','カスタムプログラム','柔軟に設定','海外大学の要望に応じて設計','個別相談','IMG_1687.JPG'],
];
---
<Layout lang="ja" title="立命館大学 短期受入プログラム | 日本語版プロトタイプ" description="立命館大学の短期受入プログラムを紹介する日本語版デジタルパンフレットのプロトタイプです。">
  <section class="ja-hero" style={`--hero-image:url('${hero}')`}>
    <div class="ja-hero-overlay"></div>
    <div class="container ja-hero-content">
      <p class="eyebrow light-eyebrow">京都・衣笠キャンパスで学ぶ</p>
      <h1>世界とつながる学びを、<br />京都・衣笠から。</h1>
      <p>日本語、日本文化、データサイエンス、ビジネス。立命館大学で学び、学生と交流し、日本を深く知る短期プログラムです。</p>
      <div class="button-row"><a class="button" href="#programs">プログラムを見る</a><a class="button outline-light" href="#experience">体験を見る</a></div>
    </div>
  </section>

  <aside class="notice"><div class="container"><strong>プロトタイプ</strong><p>本サイトは評価用サンプルです。立命館大学の公式サイトではありません。</p></div></aside>

  <section class="section"><div class="container narrow"><p class="eyebrow">短期受入プログラム</p><h2>学ぶ。体験する。つながる。</h2><p class="large-copy">海外の大学・大学院に在籍する学生を対象に、日本語教育、日本文化、専門分野の学習、立命館の学生との交流を組み合わせたプログラムを提供します。</p></div></section>

  <section class="section muted" id="programs"><div class="container"><div class="section-heading"><div><p class="eyebrow">Programmes</p><h2>自分に合うプログラムを見つける</h2></div></div><div class="ja-program-grid">{programs.map(([code,name,term,focus,record,file]) => <article class="ja-program-card"><div class="ja-program-photo"><img src={image(file)} alt="" loading="lazy" /><span>{code}</span></div><div class="ja-program-body"><p class="program-code">{code}</p><h3>{name}</h3><p class="format-pill">{term}</p><p>{focus}</p><dl><div><dt>成績表等</dt><dd>{record}</dd></div></dl><a class="text-link" href="#comparison">比較する →</a></div></article>)}</div></div></section>

  <section class="section" id="experience"><div class="container"><p class="eyebrow">Experience</p><h2>日本での学びは、教室の外にも続く。</h2><div class="story-grid"><article class="story-photo"><img src={image('IMG_8178.JPG')} alt="日本語講座の授業風景" loading="lazy" /><div><p class="eyebrow">日本語講座</p><h3>ことばを学び、使う</h3><p>会話、聴解、読解、作文をバランスよく学び、総合的なコミュニケーション力を養います。</p></div></article><article class="story-photo"><img src={image('IMG_5092.JPG')} alt="茶道体験の抹茶と茶筅" loading="lazy" /><div><p class="eyebrow">Japan Studies</p><h3>日本文化を、ともに体験する</h3><p>講義やフィールドワークに加え、学生団体との共修を行います。茶道、和太鼓、スポーツなど、内容は年度により異なります。</p></div></article><article class="story-photo"><img src={image('IMG_1656.JPG')} alt="衣笠キャンパスの時計台と芝生" loading="lazy" /><div><p class="eyebrow">Campus Community</p><h3>キャンパスの一員になる</h3><p>オリエンテーション、バディ交流、実践的なサポートを通じて、安心して学びと交流に参加できます。</p></div></article></div></div></section>

  <section class="section muted"><div class="container"><p class="eyebrow">A day on campus</p><h2>ある一日の過ごし方</h2><ol class="day-timeline"><li><span>09:00</span><div><h3>日本語講座</h3><p>午前は日本語を集中的に学びます。</p></div></li><li><span>12:15</span><div><h3>昼休み・学生交流</h3><p>学内で昼食をとり、バディや参加者と交流します。</p></div></li><li><span>13:30</span><div><h3>Japan Studies</h3><p>文化講義、学生団体との共修、フィールドワークなどを行います。</p></div></li><li><span>16:30</span><div><h3>自由時間</h3><p>キャンパスや京都で、それぞれの時間を過ごします。</p></div></li></ol><p class="fine-print">※時間と内容は一例です。実際のスケジュールはプログラムにより異なります。</p></div></section>

  <section class="section" id="eligibility"><div class="container split align-start"><div><p class="eyebrow">全プログラム共通</p><h2>参加資格と単位</h2><p class="large-copy">参加時点で大学または大学院に正規在籍し、在籍証明書を提出できる方が対象です。</p></div><div class="eligibility-panel"><div><strong>参加できる方</strong><p>現役の大学生・大学院生。就業中でも、大学・大学院に正規在籍していれば参加できます。</p></div><div><strong>参加できない方</strong><p>高校生、大学・大学院に在籍していない社会人、既卒者。</p></div><div><strong>単位</strong><p>立命館大学の単位は付与されません。所属大学での単位認定は、所属大学へご確認ください。</p></div></div></div></section>

  <section class="section muted" id="comparison"><div class="container"><p class="eyebrow">Comparison</p><h2>標準版とExpressの違い</h2><div class="ja-comparison"><div><strong>RSJP / RWJP</strong><span>5週間</span><span>日本語講座の成績表を発行</span></div><div><strong>RSJP / RWJP Express</strong><span>2週間</span><span>成績表は発行せず、教員コメントを提供</span></div></div></div></section>

  <section class="section" id="faq"><div class="container split"><div><p class="eyebrow">よくある質問</p><h2>参加前に知っておきたいこと</h2><p class="large-copy">将来は、現在開発中のQ&Aアプリと連携し、承認済みの情報を表示する構想です。</p></div><div class="faq-preview"><details open><summary>社会人でも参加できますか？</summary><p>大学または大学院に正規在籍し、在籍証明書を提出できる場合は参加できます。</p></details><details><summary>単位は取得できますか？</summary><p>立命館大学の単位は付与されません。</p></details><details><summary>Japan Studiesの内容は毎年同じですか？</summary><p>茶道、和太鼓、スポーツなどを候補としていますが、学生団体や年度の状況により変わります。</p></details></div></div></section>

  <section class="cta"><div class="container"><p class="eyebrow">Digital Prospectus</p><h2>留学フェアや海外大学との打ち合わせにも。</h2><p>写真、比較情報、参加資格、FAQを一つのサイトで確認できるデジタルパンフレットを目指します。</p></div></section>
</Layout>
