---
import StudentRecruitmentLayout from '../../components/StudentRecruitmentLayout.astro';
import { programmes } from '../../data/programs';
import { getProgrammePublicDescriptor } from '../../data/programme-public-descriptors';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const hrefFor = (id: string) => `${base}programs/${id}/`;
const individualProgrammes = programmes.filter((programme) => programme.audience === 'individual');
const partnerProgrammes = programmes.filter((programme) => programme.audience === 'partner');
---
<StudentRecruitmentLayout
  title="プログラム一覧 | 立命館大学 短期受入プログラム"
  description="個人参加型の短期受入プログラムと、海外大学・教育機関向けCustom Programsを分けて案内します。"
  robots="noindex,nofollow"
>
  <article class="jp-utility">
    <div class="site-shell">
      <header class="jp-utility__intro">
        <div>
          <p class="section-kicker">プログラム一覧</p>
          <h1>参加する人で 入口を分ける</h1>
        </div>
        <div>
          <p class="jp-utility__lead">個人で参加する学生向けプログラムと、海外大学・教育機関から学生団体を受け入れるCustom Programsは、申込方法も設計方法も異なります。</p>
          <div class="jp-utility__actions">
            <a class="action-button action-button--primary" href={`${base}#program-finder`}>個人向けを探す</a>
            <a class="action-button action-button--dark" href={hrefFor('custom-programs')}>大学・機関向けを見る</a>
          </div>
        </div>
      </header>

      <section aria-labelledby="individual-programmes-title">
        <p class="section-kicker">個人で参加する方へ</p>
        <h2 id="individual-programmes-title">自分で選び 自分で応募するプログラム</h2>
        <p>実施キャンパスはプログラムごとに決まっています。参加者が衣笠・OIC・BKCから自由に選択する仕組みではありません。</p>
        <div class="jp-utility__programme-list" aria-label="個人参加型短期受入プログラム一覧">
          {individualProgrammes.map((programme) => {
            const publicCopy = getProgrammePublicDescriptor(programme.id);
            return (
              <article>
                <p class="section-kicker">{programme.code}</p>
                <h3>{publicCopy?.name ?? programme.code}</h3>
                <p>{publicCopy?.summary ?? '詳細情報を確認中です。'}</p>
                <p><strong>{publicCopy?.status ?? '詳細確認中'}</strong></p>
                <a href={hrefFor(programme.id)}>詳細ページを見る →</a>
              </article>
            );
          })}
        </div>
      </section>

      <section style="margin-top:4rem;" aria-labelledby="partner-programmes-title">
        <p class="section-kicker">海外大学・教育機関のご担当者へ</p>
        <h2 id="partner-programmes-title">学生団体のために 一緒に設計する</h2>
        <p>Custom Programsは個人申込型ではありません。教育目的、期間、テーマ、参加人数等を伺い、授業、交流、文化体験、フィールドワーク、実施キャンパス等を相談しながら設計します。留学サポートデスクでは英語での対応が可能です。</p>
        <div class="jp-utility__programme-list" aria-label="海外大学・教育機関向けプログラム">
          {partnerProgrammes.map((programme) => {
            const publicCopy = getProgrammePublicDescriptor(programme.id);
            return (
              <article>
                <p class="section-kicker">{programme.code}</p>
                <h3>{publicCopy?.name ?? programme.code}</h3>
                <p>{publicCopy?.summary ?? '大学・機関向けに相談しながら設計するプログラムです。'}</p>
                <p><strong>個人申込対象外</strong></p>
                <a href={hrefFor(programme.id)}>大学・機関向けページを見る →</a>
              </article>
            );
          })}
        </div>
      </section>

      <p class="real-photo-story__note" style="margin-top:2rem;">日程、期間、キャンパス、費用、募集状況などは、確認済みの情報だけを各詳細ページで案内します。比較のために未確認値を推測して補うことはしません。</p>
    </div>
  </article>
</StudentRecruitmentLayout>
