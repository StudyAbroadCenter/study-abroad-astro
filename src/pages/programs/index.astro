---
import StudentRecruitmentLayout from '../../components/StudentRecruitmentLayout.astro';
import { programmes } from '../../data/programs';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const hrefFor = (id: string) => `${base}programs/${id}/`;
---
<StudentRecruitmentLayout
  title="プログラム一覧 | 立命館大学 短期受入プログラム"
  description="立命館大学の短期受入プログラムを一覧で確認できます。日本語・日本文化、専門テーマ、大学向けCustom Programsから目的に合う入口を探せます。"
  robots="noindex,nofollow"
>
  <article class="jp-utility">
    <div class="site-shell">
      <header class="jp-utility__intro">
        <div>
          <p class="section-kicker">PROGRAMMES</p>
          <h1>違いが分かると 選びやすい</h1>
        </div>
        <div>
          <p class="jp-utility__lead">日本語・日本文化、専門テーマ、大学向けオーダーメード。まずは気になるプログラムを開いて、学び方と条件を比べてください。</p>
          <div class="jp-utility__actions">
            <a class="action-button action-button--primary" href={`${base}#program-finder`}>条件から探す</a>
            <a class="action-button action-button--dark" href={base}>トップへ戻る</a>
          </div>
        </div>
      </header>

      <div class="jp-utility__programme-list" aria-label="短期受入プログラム一覧">
        {programmes.map((programme) => {
          const copy = programme.copy.ja;
          return (
            <article>
              <p class="section-kicker">{programme.code}</p>
              <h2>{copy.name}</h2>
              <p>{copy.summary}</p>
              <p><strong>{copy.seasonLabel}</strong> · {copy.duration} · {copy.campusLabel}</p>
              <a href={hrefFor(programme.id)}>詳細ページを見る →</a>
            </article>
          );
        })}
      </div>

      <p class="real-photo-story__note" style="margin-top:2rem;">日程・費用・募集状況などの年度別情報は、確認済みの内容を各プログラム詳細ページで案内します。未確認情報を比較のために推測して補うことはしません。</p>
    </div>
  </article>
</StudentRecruitmentLayout>
