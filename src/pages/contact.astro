---
import StudentRecruitmentLayout from '../components/StudentRecruitmentLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<StudentRecruitmentLayout
  title="立命館大学 短期留学のお問い合わせ｜Study Abroad Center"
  description="立命館大学の短期留学・短期受入プログラムに関するお問い合わせ案内。個人参加プログラム、海外大学・教育機関向けCustom Programs、英語での相談についてご案内します。"
  robots="noindex,nofollow"
>
  <article class="jp-utility jp-contact-page">
    <div class="site-shell">
      <header class="jp-utility__intro">
        <div>
          <p class="section-kicker">お問い合わせ</p>
          <h1 class="jp-contact-page__title"><span>必要な情報へ</span><span>迷わずつながる</span></h1>
        </div>
        <p class="jp-utility__lead">日程、費用、参加条件などの基本情報は各プログラムページでご確認いただけます。個別の相談が必要な場合は、参加を検討しているプログラムやCustom Programsの案内からお問い合わせください。留学サポートデスクでは英語での対応が可能です。</p>
      </header>

      <div class="jp-utility__grid">
        <section class="jp-utility__card">
          <h2>プログラムを決めている方</h2>
          <p>対象プログラムの詳細ページで、日程、費用、参加条件、応募方法などをご確認ください。</p>
          <a class="programme-card__link" href={`${base}programs/`}>プログラム一覧へ →</a>
        </section>
        <section class="jp-utility__card">
          <h2>まだ迷っている方</h2>
          <p>日本語・日本文化、専門テーマなど、学びたい内容から自分に合う短期留学プログラムを探せます。</p>
          <a class="programme-card__link" href={`${base}#program-finder`}>条件から探す →</a>
        </section>
        <section class="jp-utility__card jp-contact-page__institution-card">
          <h2>海外大学・教育機関のご担当者</h2>
          <p>Custom Programsでは、学生団体の受入について、教育目的、期間、テーマ、参加人数、実施キャンパス等を相談しながら設計します。英語での相談・調整も可能です。</p>
          <a class="programme-card__link" href={`${base}programs/custom-programs/`}>Custom Programsを見る →</a>
        </section>
        <section class="jp-utility__card">
          <h2>Study Abroad Center</h2>
          <p><strong>立命館大学 Study Abroad Center</strong></p>
          <p>短期留学・短期受入プログラムの学習、参加、大学間連携に関する情報をご案内します。</p>
        </section>
      </div>
    </div>
  </article>
</StudentRecruitmentLayout>

<style>
  .jp-contact-page__title {
    max-width: none;
    font-size: clamp(2.65rem, 4.35vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .jp-contact-page__title span {
    display: block;
    white-space: nowrap;
  }

  .jp-contact-page__institution-card h2 {
    white-space: nowrap;
    font-size: clamp(1.32rem, 1.7vw, 1.72rem);
    letter-spacing: -0.02em;
  }

  @media (max-width: 760px) {
    .jp-contact-page__title {
      font-size: clamp(2.2rem, 10vw, 3.2rem);
    }

    .jp-contact-page__title span,
    .jp-contact-page__institution-card h2 {
      white-space: normal;
    }
  }
</style>
