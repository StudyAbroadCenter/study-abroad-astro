---
import Layout from '../components/Layout.astro';
---
<Layout title="Contact prototype | Short Programs Prototype" description="A non-functional contact-page concept for this independent study-program website prototype.">
  <header class="page-hero"><div class="container narrow"><p class="eyebrow">Contact prototype</p><h1>How could we help?</h1><p class="lede">This page demonstrates how contact choices could be presented. It does not send messages or collect personal information.</p></div></header>
  <section class="section"><div class="container contact-grid"><div><h2>Choose a topic</h2><div class="contact-options"><article><span aria-hidden="true">01</span><h3>Program questions</h3><p>Dates, course themes, schedules and sample eligibility.</p></article><article><span aria-hidden="true">02</span><h3>Preparing to travel</h3><p>Accommodation, arrival and general preparation topics.</p></article><article><span aria-hidden="true">03</span><h3>Technical feedback</h3><p>Accessibility, content structure and prototype behavior.</p></article></div></div><aside class="form-mockup" aria-labelledby="form-title"><p class="eyebrow">Visual demonstration only</p><h2 id="form-title">Contact form placeholder</h2><p>No fields are provided because this prototype must not collect personal information.</p><div class="fake-field" aria-hidden="true">Name field would appear here</div><div class="fake-field tall" aria-hidden="true">Message field would appear here</div><button disabled>Send message (disabled)</button><p class="fine-print">Do not send or add personal, confidential or sensitive information to this prototype.</p></aside></div></section>
</Layout>
