---
import StudentRecruitmentLayout from '../components/StudentRecruitmentLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<StudentRecruitmentLayout
  title="立命館大学 Study Abroad Center｜短期留学・国際交流"
  description="立命館大学 Study Abroad Centerの短期留学・短期受入プログラムをご案内します。日本語・日本文化、専門分野、学生との国際交流、海外大学向けCustom Programsなど、日本での学びを京都・大阪のキャンパスから広げます。"
  robots="noindex,nofollow"
>
  <article class="jp-utility">
    <div class="site-shell">
      <header class="jp-utility__intro">
        <div>
          <p class="section-kicker">Study Abroad Center</p>
          <h1>日本で学ぶ時間を 立命館から</h1>
        </div>
        <p class="jp-utility__lead">立命館大学の短期留学・短期受入プログラムでは、日本語・日本文化、専門分野、学生交流、京都・大阪での学びを組み合わせ、多様な学習機会を提供します。</p>
      </header>

      <div class="jp-utility__grid">
        <section class="jp-utility__card">
          <h2>日本語・日本文化を学ぶ</h2>
          <p>日本語の授業を軸に、文化体験やキャンパスでの交流へ学びを広げます。短期間でも、日本でことばを使う経験につなげます。</p>
        </section>
        <section class="jp-utility__card">
          <h2>専門分野を英語で学ぶ</h2>
          <p>ビジネス、経営学、AI・データサイエンスなど、プログラムに応じた専門テーマを英語で学ぶ機会があります。</p>
        </section>
        <section class="jp-utility__card">
          <h2>学生と共に学ぶ</h2>
          <p>Buddy、ゼミ、学生団体との活動など、立命館の学生と出会い、共に考え、交流する機会をプログラムに応じて設けます。</p>
        </section>
        <section class="jp-utility__card">
          <h2>海外大学とも一緒につくる</h2>
          <p>海外大学・教育機関向けCustom Programsでは、教育目的、期間、テーマ、参加人数等を伺い、大学単位の短期留学プログラムを相談しながら設計します。</p>
        </section>
      </div>

      <div class="jp-utility__actions">
        <a class="action-button action-button--primary" href={`${base}#program-finder`}>短期留学プログラムを探す</a>
        <a class="action-button action-button--dark" href={`${base}programs/custom-programs/`}>大学・機関向けCustom Programs</a>
      </div>
    </div>
  </article>
</StudentRecruitmentLayout>
