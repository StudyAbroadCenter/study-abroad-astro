---
import PrototypeShell from '../../components/PatternPJPrototypeShell.astro';
import { sharedSiteImages } from '../../data/shared-site-images';
const image=(p:string)=>`/images/${p}`;
const opportunities=[
  {n:'01',title:'日本語講座で話す',body:'留学生と一緒に学びながら 日本語で会話を楽しむ',note:'英語に自信がなくても大丈夫'},
  {n:'02',title:'文化体験を楽しむ',body:'日本文化を一緒に体験して 違いを知る',note:'1回だけの参加からでも大丈夫'},
  {n:'03',title:'キャンパスでつながる',body:'授業やランチ 学内活動から自然な交流をつくる',note:'世界への入口はキャンパスにもある'},
];
const journey=[
  ['Meet','出会う','キャンパスで留学生と出会う'],
  ['Learn','共に学ぶ','ことばと文化の違いを知る'],
  ['Go Abroad','海外へ行く','交流が留学への一歩になる'],
  ['Meet Again','再会する','海外や日本でまた会える'],
  ['Stay Connected','つながり続ける','出会いが一生の人的財産になる'],
];
const sampleFaces=[
  {src:'https://images.unsplash.com/photo-1758600587683-d86675a2f6e9?auto=format&fit=crop&q=80&w=900',credit:'Vitaly Gariev / Unsplash',label:'Buddy profile sample A'},
  {src:'https://images.unsplash.com/photo-1758270703124-b65dce9a2bec?auto=format&fit=crop&q=80&w=900',credit:'Vitaly Gariev / Unsplash',label:'Buddy profile sample B'},
  {src:'https://images.unsplash.com/photo-1773243906614-875ddb4918b6?auto=format&fit=crop&q=80&w=900',credit:'Rohingya Creative Production / Unsplash',label:'Buddy profile sample C'},
];
---
<PrototypeShell active="buddy" title="Buddy & Global Connections | Pattern J Prototype">
  <div class="jPage">
    <section class="jHero">
      <div>
        <span class="hand">Buddy & Global Connections</span>
        <h1>つながるって、<br/>世界が広がること。</h1>
        <p style="font-size:20px;line-height:1.8;max-width:620px">世界への最初の一歩は、キャンパスの中にある。交流が留学を生み、留学が再交流を生む。</p>
        <div class="actions"><a class="btn" style="background:var(--jcoral);color:#fff;border-color:var(--jcoral)" href="#join">参加のしかたを見る →</a><a class="btn" style="color:var(--jink)" href="#journey">その先を見る</a></div>
        <p style="font-size:12px;margin-top:20px">英語力は問いません　1回から参加できます</p>
      </div>
      <div class="organicPhoto"><img src={image('hero/hero-kinugasa-clocktower.jpg')} alt="立命館大学衣笠キャンパス"/></div>
    </section>

    <section class="jSection">
      <p class="kicker">INTERCULTURAL LEARNING</p>
      <h2>交流をもっと日常に。<br/>世界をもっと身近に。</h2>
      <p style="font-size:18px;line-height:1.8;max-width:760px">短期留学生を迎えることは、立命館の学生にとっても学びのチャンス。まず一度、同じテーブルに座ることから始めよう。</p>
    </section>

    <section class="jSection" id="join">
      <p class="kicker">START SMALL</p><h2>ちょっと参加したい。<br/>その気持ちからでいい。</h2>
      <div class="jCards">{opportunities.map(o=><article class="jCard"><div class="jNumber">{o.n}</div><h3>{o.title}</h3><p>{o.body}</p><small>{o.note}</small></article>)}</div>
    </section>

    <section class="jSection">
      <p class="kicker">REAL PROGRAMME SCENES</p><h2>一緒に学ぶ。文化を共有する。</h2>
      <div class="photoStoryGrid">
        <article class="photoStory"><img src={image(sharedSiteImages.rwjp.real.classroom)} alt="教室で日本語を学ぶ短期受入プログラムの学生たち"/><div class="caption"><h3>一緒に学ぶ</h3><small>過去の短期受入プログラム実施写真</small></div></article>
        <article class="photoStory"><img src={image(sharedSiteImages.rwjp.real.culture)} alt="畳の部屋で日本文化を学ぶ学生たち"/><div class="caption"><h3>文化を共有する</h3><small>過去の短期受入プログラム実施写真</small></div></article>
        <article class="photoStory"><img src={image(sharedSiteImages.rwjp.real.kyoto)} alt="京都でグループ活動を行う学生たち"/><div class="caption"><h3>街へ出る</h3><small>過去の短期受入プログラム実施写真</small></div></article>
      </div>
    </section>

    <section class="jSection" id="journey">
      <p class="kicker">FROM ONE ENCOUNTER TO A LIFELONG CONNECTION</p><h2>交流が留学を生み、<br/>留学が再交流を生む。</h2>
      <div class="jJourney">{journey.map((s)=><article class="jStep"><span class="hand">{s[0]}</span><b>{s[1]}</b><small>{s[2]}</small></article>)}</div>
    </section>

    <section class="jSection">
      <p class="kicker">PROFILE LAYOUT TEST</p><h2>Buddyの顔が見えるページへ。</h2>
      <div class="notice" style="margin-bottom:24px">以下3枚はレイアウト確認用のUnsplashサンプル写真です。実際の立命館Buddy・参加者ではありません。プロフィール名・所属・体験談は捏造せず、公開時は同意・確認済み情報だけに置き換えます。</div>
      <div class="faceGrid">{sampleFaces.map(f=><article class="faceCard"><img src={f.src} alt="Buddyプロフィール表示用のサンプル人物写真" referrerpolicy="no-referrer"/><h3>{f.label}</h3><p>Sample image only — not a Ritsumeikan participant.</p><p style="margin-top:8px;font-size:10px">Photo: {f.credit}</p></article>)}</div>
      <div class="jCta"><div><p class="kicker">JOIN THE CONNECTION</p><h2>世界への入口は、キャンパスにもある。</h2></div><a href="#join">参加方法を見る →</a></div>
    </section>
  </div>
</PrototypeShell>