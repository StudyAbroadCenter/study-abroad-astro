---
import PrototypeShell from '../../components/PatternPJPrototypeShell.astro';
import { customProgramPartners, customProgramVisuals } from '../../data/custom-programs-shared';
import { getProgrammePublicDescriptor } from '../../data/programme-public-descriptors';
const descriptor=getProgrammePublicDescriptor('custom-programs')!;
const image=(p:string)=>`/images/${p}`;
---
<PrototypeShell active="custom" title="Custom Programs | 立命館大学 Study Abroad Center" description="海外大学・教育機関向けCustom Programs。教育目的、期間、テーマ、参加人数等を伺い、授業・交流・文化体験・フィールドワーク等を相談しながら設計します。">
  <section class="institutionalHero">
    <div class="copy"><p class="kicker">FOR OVERSEAS UNIVERSITIES & INSTITUTIONS</p><h1>Custom Programs</h1><p>{descriptor.summary}</p><p><strong>{descriptor.experienceLine}</strong></p></div>
    <div><img class="cover" src={image(customProgramVisuals.hero)} alt="Custom Programsの実施イメージ"/></div>
  </section>

  <header class="editorialHead">
    <div><p class="kicker">DESIGN TOGETHER</p><h2><span>大学ごとに、</span><span>日本での学びを設計する。</span></h2></div>
    <div><p>教育目的、期間、テーマ、参加人数等を伺い、授業・交流・文化体験・フィールドワーク・実施キャンパス等を相談しながら設計します。</p></div>
  </header>
  <section class="sectionGridWide">
    <div class="mosaic">
      <article class="mTile tall"><img src={image(customProgramVisuals.gallery[0].image)} alt="授業"/><div class="mOverlay"><h3>Learn</h3><p>授業・学術テーマ</p></div></article>
      <article class="mTile"><img src={image(customProgramVisuals.gallery[1].image)} alt="学生交流"/><div class="mOverlay"><h3>Connect</h3><p>学生との交流・共修</p></div></article>
      <article class="mTile wide"><img src={image(customProgramVisuals.gallery[4].image)} alt="フィールド活動"/><div class="mOverlay"><h3>Field & Culture</h3><p>文化体験・フィールドワーク</p></div></article>
    </div>
  </section>

  <section class="softBand">
    <header class="editorialHead">
      <div><p class="kicker">PARTNER UNIVERSITIES</p><h2><span>海外の大学・機関と、</span><span>学びをつくる。</span></h2></div>
      <div class="partnerCloud">{customProgramPartners.map(p=><span>{p.flag} {p.name}</span>)}</div>
    </header>
  </section>

  <section class="quietSection">
    <h2>ご相談いただく主な項目</h2>
    <div class="infoRows">
      <div class="infoRow"><b>Education purpose</b><div>教育目的</div></div>
      <div class="infoRow"><b>Duration</b><div>期間</div></div>
      <div class="infoRow"><b>Theme</b><div>テーマ</div></div>
      <div class="infoRow"><b>Participants</b><div>参加人数</div></div>
      <div class="infoRow"><b>Possible elements</b><div>授業・交流・文化体験・フィールドワーク・実施キャンパス等</div></div>
    </div>
  </section>
</PrototypeShell>
