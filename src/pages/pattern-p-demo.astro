---
import { programmePublicDescriptors } from '../data/programme-public-descriptors';
import { shortTermParticipationEvidence } from '../data/participation-history';
import { documentedCoLearningActivities } from '../data/co-learning-evidence';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const image = (path: string) => `${base}images/${path}`;

const featuredIds = ['rwjp', 'rwjp-express', 'rdsp', 'rbmp', 'custom-programs'];
const programmes = featuredIds
  .map((id) => programmePublicDescriptors.find((item) => item.id === id))
  .filter(Boolean);

const programmeImages: Record<string, string> = {
  rwjp: 'programs/rwjp/real/rwjp-real-japanese-class.webp',
  'rwjp-express': 'programs/rwjp/real/rwjp-real-culture-tatami.webp',
  rdsp: 'IMG_1588.JPG',
  rbmp: 'IMG_1656.JPG',
  'custom-programs': 'IMG_3725.JPG',
};
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Pattern P × RSJP Experience System — Test</title>
  <meta name="description" content="現行の短期留学サイトの思想をPattern PのEditorial Brand Gridに移植した比較用テストサイト。" />
</head>
<body>
  <main class="page" id="top">
    <header class="header">
      <a class="brand" href="#top"><span class="mark">R</span><span><strong>Ritsumeikan University</strong><small>Study Abroad Center</small></span></a>
      <nav class="nav" aria-label="テストサイト内ナビゲーション">
        <a href="#programmes">プログラム</a>
        <a href="#learning">共修・Buddy</a>
        <a href="#proof">実績</a>
        <a href="#languages">多言語</a>
      </nav>
      <div class="headerAction"><span>日本語 MASTER</span><a href="#programmes">プログラムを探す →</a></div>
    </header>

    <section class="hero">
      <div class="heroMedia">
        <img src={image('programs/rwjp/real/rwjp-real-kyoto-field.webp')} alt="京都でグループ活動を行う短期留学生" />
        <p class="photoNote">REAL PROGRAMME PHOTOGRAPHY</p>
      </div>
      <div class="heroMessage">
        <p class="eyebrow">RITSUMEIKAN SHORT-TERM STUDY</p>
        <h1>短期留学を、<br/>受入で終わらせない。</h1>
        <p class="heroLead">世界から学生が来る。立命館の学生と学ぶ。<br/>その出会いが、次の留学と次のつながりを生む。</p>
        <div class="actions">
          <a class="button buttonLight" href="#programmes">自分に合うプログラムを探す <span>→</span></a>
          <a class="button buttonGhost" href="#learning">共修・Buddyを見る</a>
        </div>
        <div class="heroProof"><strong>Accuracy before persuasion.</strong><span>日程・費用・条件は確認済み情報を優先して提示する。</span></div>
        <div class="heroKanji" aria-hidden="true">学</div>
      </div>
    </section>

    <section class="introBand">
      <p>STUDENT-CENTRED RECRUITMENT EXPERIENCE</p>
      <div><strong>見つける</strong><span>自分に合う入口から</span></div>
      <div><strong>理解する</strong><span>必要な事実をすぐに</span></div>
      <div><strong>想像する</strong><span>リアルな学びと生活を</span></div>
      <div><strong>次へ進む</strong><span>迷わないCTAで</span></div>
    </section>

    <section class="section programmeSection" id="programmes">
      <header class="sectionHead">
        <p class="kicker">PROGRAMME DISCOVERY</p>
        <h2>プログラム名からではなく、<br/>「何をしたいか」から選べる。</h2>
        <p>現行サイトのProgram Finder思想を、Pattern Pの大小モジュールへ置き換える。</p>
      </header>
      <div class="programmeMosaic">
        {programmes.map((programme, index) => programme && (
          <article class:list={['programmeTile', `programmeTile--${index + 1}`]}>
            <img src={image(programmeImages[programme.id])} alt="" />
            <div class="programmeShade"></div>
            <div class="programmeCopy">
              <p>{programme.status}</p>
              <h3>{programme.name}</h3>
              {programme.experienceLine && <strong>{programme.experienceLine}</strong>}
              <span>{programme.summary}</span>
              <a href={`/programs/${programme.id}/`}>詳細を見る →</a>
            </div>
          </article>
        ))}
        <article class="decisionTile">
          <p>DECISION FIRST</p>
          <h3>日程・費用・Eligibility・Accommodation</h3>
          <span>判断に必要な事実は、装飾の下に隠さない。</span>
          <a href="/programs/">すべてのプログラムを見る →</a>
        </article>
      </div>
    </section>

    <section class="ecosystem" id="learning">
      <div class="ecosystemStatement">
        <p class="kickerDark">BEYOND INBOUND</p>
        <h2>世界への最初の一歩は、<br/>キャンパスの中にある。</h2>
        <p>短期留学生を迎えることを、立命館学生の学びにも変える。<br/>交流 → 留学 → 再交流 → 長期的なつながりへ。</p>
        <a href="/buddy/">Buddy & Global Connections →</a>
      </div>
      <div class="journey" aria-label="国際共修の循環">
        <div><small>01</small><strong>MEET</strong><span>出会う</span></div>
        <b>→</b>
        <div><small>02</small><strong>LEARN</strong><span>共に学ぶ</span></div>
        <b>→</b>
        <div><small>03</small><strong>GO ABROAD</strong><span>海外へ行く</span></div>
        <b>→</b>
        <div><small>04</small><strong>MEET AGAIN</strong><span>再会する</span></div>
      </div>
      <div class="activityGrid">
        {documentedCoLearningActivities.map((activity, i) => (
          <figure class:list={['activity', i === 0 && 'activity--large']}>
            <img src={image(activity.image)} alt={activity.imageAlt} />
            <figcaption><small>DOCUMENTED ACTIVITY</small><strong>{activity.title}</strong><span>{activity.summary}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="proof" id="proof">
      <header>
        <p>GLOBAL EVIDENCE / 2023–2026</p>
        <h2>「国際的です」ではなく、<br/>根拠を見せる。</h2>
        <span>公開できる検証済み集計だけを使い、実績の範囲と定義を明示する。</span>
      </header>
      <div class="proofNumbers">
        <article><strong>{shortTermParticipationEvidence.participants}</strong><span>参加者</span></article>
        <article><strong>{shortTermParticipationEvidence.countriesOrRegions}</strong><span>か国・地域</span></article>
        <article><strong>{shortTermParticipationEvidence.institutions}</strong><span>大学・機関</span></article>
      </div>
      <div class="proofScope"><strong>Scope matters.</strong><span>2023–2026年の定型4プログラムの検証済み参加実績。数字を大きく見せるために範囲を曖昧にしない。</span></div>
    </section>

    <section class="languageSection section" id="languages">
      <header class="sectionHead compact">
        <p class="kicker">ONE PRODUCT FAMILY</p>
        <h2>翻訳サイトではなく、<br/>多言語の「同じプロダクト」。</h2>
        <p>事実は一つ。伝え方は、それぞれの言語で自然に。</p>
      </header>
      <div class="languageMosaic">
        <article class="langMaster"><small>CONTROLLED MASTER</small><strong>日本語</strong><p>情報設計・ページ階層・写真・CTA・意味をコントロールするMaster Experience。</p></article>
        <article><strong>English</strong><p>日本語の語順を移さず、海外学生が最初から英語で読める文章として再構成。</p></article>
        <article><strong>한국어</strong><p>英語版のコピーではなく、日本語Masterと同じ検証済み事実から自然な韓国語版へ。</p></article>
        <article class="langColor"><strong>简体中文 / 繁體中文</strong><p>文字変換ではなく、それぞれの読者に合わせた独立したローカライズ。</p></article>
        <article class="langRule"><small>CORE RULE</small><h3>Same facts.<br/>Native communication.</h3><p>Design may localise. Facts may not.</p></article>
      </div>
    </section>

    <section class="institutionalWow">
      <div class="wowCopy">
        <p>SHORT-TERM STUDY ECOSYSTEM</p>
        <h2>プログラムを並べるサイトから、<br/>国際共修の循環を見せるサイトへ。</h2>
      </div>
      <div class="wowDiagram">
        <div class="node red"><span>INBOUND</span><strong>海外学生</strong></div>
        <div class="node yellow"><span>CO-LEARNING</span><strong>共に学ぶ</strong></div>
        <div class="node green"><span>OUTBOUND</span><strong>立命館学生</strong></div>
        <div class="node cream"><span>NETWORK</span><strong>大学・機関</strong></div>
        <div class="centre"><strong>RITSUMEIKAN</strong><span>learning connects people</span></div>
      </div>
    </section>

    <section class="support section">
      <header class="sectionHead compact"><p class="kicker">CLARITY BUILDS TRUST</p><h2>見やすさは、デザインではなく機能。</h2></header>
      <div class="supportGrid">
        <article><span>01</span><h3>重要情報を埋めない</h3><p>日程、期間、費用、募集状況、Eligibility、Accommodationへ最短で到達。</p></article>
        <article><span>02</span><h3>スマホを最初に考える</h3><p>390pxでも「何のプログラムか」「重要な事実」「次の行動」が見える。</p></article>
        <article><span>03</span><h3>リアルな写真を使う</h3><p>観光地の美しさだけでなく、実際の授業・交流・活動を優先する。</p></article>
        <article><span>04</span><h3>分からないことは分からないと書く</h3><p>未確定情報を魅力的なコピーで埋めない。Accuracy before persuasion.</p></article>
      </div>
    </section>

    <section class="finalCta">
      <div><p>START WITH THE RIGHT PROGRAMME</p><h2>あなたの短期留学を、<br/>ここから選ぶ。</h2></div>
      <a href="/programs/">プログラムを探す →</a>
    </section>

    <footer class="footer">
      <div class="footerBrand"><span class="mark">R</span><strong>Ritsumeikan University<br/>Study Abroad Center</strong></div>
      <div><small>PATTERN P TEST SURFACE</small><p>現行RSJP Experience Systemの思想をPattern Pへ移植した比較用ページです。</p></div>
      <div class="footerLinks"><a href="/">現行ホーム</a><a href="/programs/">Programs</a><a href="/buddy/">Buddy</a></div>
    </footer>
  </main>
</body>
</html>

<style>
